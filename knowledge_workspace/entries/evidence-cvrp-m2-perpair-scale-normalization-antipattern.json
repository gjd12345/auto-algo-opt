      },
      {
        "expr": "Correct: s_global(i,j) = (d(0,i) + d(0,j) - lam*d(i,j) + mu*|d(0,i)-d(0,j)|) / mean_{k=1..n} d(0,k) + beta*(q_i+q_j)/Q",
        "variables": {
          "mean_{k=1..n} d(0,k)": "全实例共享的单一距离尺度常数"
        },
        "preconditions": "对全图所有候选对除以同一正数常数，100% 保持径向优先级且与无量纲容量项量级匹配"
