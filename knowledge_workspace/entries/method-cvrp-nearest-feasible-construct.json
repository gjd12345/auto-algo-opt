  "status": "reviewed",
  "summary": "Official CVRP template: among capacity-feasible unvisited customers, pick the nearest; 0 returns to depot.",
  "attributes": {
    "method_family": "construction",
    "online_offline": "offline",
    "objective": "mean route length",
    "knowledge_tier": "verified_experiment",
    "problem_variant": "standard_cvrp",
    "paradigm": "sequential_construct",
    "complexity_class": "O(n^2)",
    "interface": "select_next_node",
    "eoh_map": {
      "status": "possible",
      "adapter_kind": "direct_entrypoint",
      "entrypoint": "select_next_node"
    },
    "applicable_regimes": {
      "strong_on": [
        "fast_reference_baseline",
        "strict_scale_invariance"
      ],
      "weak_on": [
        "eccentric_depot",
        "clustered_multi_route",
        "large_n_200_plus"
      ],
      "scale_notes": "O(n^2) 极快基线（n=200 求解 P50 < 2 ms），但因短视贪心且缺少远端出发与早返机制，在全部多规模与 CVRPLib 套件上均显著弱于 R5 与并行 CW。"
    },
    "interface_blueprint": {
      "skeleton_role": "单车顺序构造循环：维护当前位置、剩余载重与未访问集合；当无可行客户时强制回仓 0 并重置满载",
      "evolvable_hook": "select_next_node(current_node, depot, unvisited_nodes, rest_capacity, demands, distance_matrix) -> int",
      "state_maintained": [
        "current_node",
        "rest_capacity",
        "unvisited_nodes"
      ],
      "invariants_and_constraints": [
        "客户 1..n 恰好访问一次",
        "每步仅在 demands[j] <= rest_capacity 的可行集合中选择或主动返回 0",
        "输入矩阵与需求只读"
      ],
      "typical_pitfalls": [
        "从仓库出发时按最近客户起步（inside-out），将远端孤立客户留到尾程产生高额空驶回程"
      ]
    },
    "math_formulation": [
      {
        "expr": "j* = argmin_{j in F(r)} d(i, j)",
        "variables": {
          "i": "当前所在节点",
          "F(r)": "满足 q_j <= r 的未访问可行客户集",
          "d(i,j)": "节点 i 到 j 的距离"
        },
        "preconditions": "对称非负距离矩阵，且所有单客户需求 q_j <= Q"
      }
    ],
