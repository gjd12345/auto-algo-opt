      "entrypoint": "solve_cvrp"
    },
    "knowledge_tier": "local_implementation",
    "problem_variant": "standard_cvrp",
    "paradigm": "cluster_first",
    "complexity_class": "O(n^2)",
    "applicable_regimes": {
      "strong_on": [
        "central_depot",
        "planar_2d",
        "clustered_sectors",
        "scale_invariant"
      ],
      "weak_on": [
        "eccentric_depot",
        "no_inter_route_relocate"
      ],
      "scale_notes": "纯角度排序 + 比例缩放不变的 2-opt，具备 0.00% 坐标缩放漂移；在中心仓库平面算例上稳定优于单一逐点构造，落后于 CW+跨路线局部搜索。"
    },
    "interface_blueprint": {
      "skeleton_role": "按真实二维坐标极角 atan2(y_i-y_0, x_i-x_0) 排序，在最多 16 个均匀起点与正反两个方向中选出总路程最短的可行容量切片，再逐条路线运行 2-opt",
      "evolvable_hook": "angular_cluster_cut_score 与 intra_route_order_refiner",
      "state_maintained": [
        "polar_angles",
        "cluster_routes",
        "route_loads"
      ],
      "invariants_and_constraints": [
        "必须使用真实二维坐标计算极角，严禁用对称距离矩阵 d[0,i]/d[i,0] 代替坐标差",
        "每条路线严格满足总需求 <= Q"
      ],
      "typical_pitfalls": [
        "HeurAgenix petal_algorithm_b384 误写 atan2(d[0,i], d[i,0]) 导致对称矩阵上所有客户极角恒为 pi/4，退化为单客户首次适应追加"
      ]
    },
    "math_formulation": [
      {
        "expr": "theta_i = atan2(y_i - y_0, x_i - x_0),  i = 1..n",
        "variables": {
          "(x_0, y_0)": "仓库二维坐标",
          "(x_i, y_i)": "客户 i 二维坐标"
        },
        "preconditions": "二维欧氏平面 CVRP；按极角排序后顺/逆时针切分容量可行扇区并做路内 2-opt"
      }
    ],
