        "cluster_loads"
      ],
      "invariants_and_constraints": [
        "客户严格二维坐标定义极角",
        "每个扇区需求总和 <= Q",
        "须枚举多个起始极角消除切口偏置"
      ],
      "typical_pitfalls": [
        "偏心仓库下按单一极角切分易形成狭长径向带，质量明显劣于并行 CW",
        "仅做一次固定 0 弧度起扫会错过更优扇区边界"
      ]
    },
    "math_formulation": [
      {
        "expr": "theta_i = atan2(y_i - y_0, x_i - x_0) in (-pi, pi]",
