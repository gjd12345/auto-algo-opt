    "interface_blueprint": {
      "skeleton_role": "维护互补启发式集合 S（|S|=K），基于逐实例胜出矩阵计算 CPI 与互补贡献度，结合互补交叉与局部精修算子迭代更新集合",
      "evolvable_hook": "集合内每个成员遵循单入口接口（CVRP/TSP select_next_node 或 OBP priority），外层按 CPI 评估互补收益",
      "state_maintained": [
        "heuristic_set_S",
        "instance_performance_matrix",
        "cpi_contributions"
      ],
      "invariants_and_constraints": [
        "显式优化集合级互补指标 CPI 而非单规则均值",
        "部署单次推理时需配合外置实例特征选择器（如方向二 RF/Ridge）"
      ],
      "typical_pitfalls": [
        "CPI 本身等价于事后 Oracle VBS（运行全部 K 个规则取优），与单次求解存在 K 倍算力或选择器遗憾差异"
      ]
    },
