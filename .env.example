# Model Router 使用 OpenAI Chat Completions 兼容协议。
# 真实密钥只放在本地 .env；该示例文件可以提交。
MODEL_ROUTER_API_KEY=
MODEL_ROUTER_API_ENDPOINT=https://model-router.edu-aliyun.com/v1/chat/completions
# PDF 要求 symbol/model_code 形式；实际 symbol 以账号的模型广场授权为准。
MODEL_ROUTER_MODEL=deepseek/deepseek-v4-flash
# RQ4 必须提供第二个已授权、不同的完整模型符号；不默认猜测，不静默fallback。
MODEL_ROUTER_COMPARISON_MODEL=

# OpenCode Zen: fill the secret only in ignored .env.
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_COMPARISON_MODEL=deepseek-v4-pro
