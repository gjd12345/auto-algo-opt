# Shell 脚本固定 LF，避免 Windows 检出后无法执行；不触碰其他历史文本换行。
*.sh text eol=lf

# Runtime and Skill identities hash shipped bytes, including line endings.
agent_skill_loop/**/*.py text eol=lf
agent_skill_loop/*.py text eol=lf
eoh_frozen/**/*.py text eol=lf
eoh_frozen/*.py text eol=lf
skills/algorithm-optimization/**/*.md text eol=lf
skills/algorithm-optimization/*.md text eol=lf
skills/algorithm-optimization/**/*.yaml text eol=lf

# 实验数据和文档资源按二进制处理，禁止换行转换破坏内容。
*.pkl binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.exe binary

# Frozen benchmark manifests are hashed as LF bytes on every platform.
benchmarks/eohs_v1/**/*.json text eol=lf

# Immutable KB releases retain their hashed bytes; exported JSON evidence is
# normalized as LF text so its checked-in representation is stable everywhere.
knowledge_store/releases/** -text
reports/evidence/** text eol=lf
