    "hook_name": "score_merge_static",
    "hook_code": "import numpy as np\n\ndef score_merge_static(distance_matrix, demands, capacity, i_idx, j_idx):\n    \"\"\"Return a 1D array of finite float priority scores (higher = merge earlier).\"\"\"\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n\n    # Global, coordinate-scale-invariant normalization (mean depot radius).\n    scale = float(np.mean(distance_matrix[0, 1:]))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    # Generalized Clarke-Wright savings with mild radial-balance and demand terms.\n    lam = 1.15\n    mu = 0.12\n    savings = d0i + d0j - lam * dij + mu * np.abs(d0i - d0j)\n    savings = savings / scale\n\n    # Demand-aware soft feasibility/priority: prefer pairs whose combined load\n    # fits capacity and whose fill ratio is moderate-to-high.\n    qi = demands[i_idx]\n    qj = demands[j_idx]\n    load = qi + qj\n    inv_cap = 1.0 / float(capacity) if capacity > 0.0 else 0.0\n    fill = np.clip(load * inv_cap, 0.0, 1.0)  # 0..1\n    feasible = np.where(load <= capacity, 1.0, 0.0)\n\n    # Mild dimensionless adjustment: balanced, feasible pair loads slightly preferred.\n    # Penalize over-capacity pairs so they are attempted later.\n    demand_bonus = 0.05 * fill * (1.0 - np.abs(qi - qj) * inv_cap)\n\n    scores = feasible * (savings + demand_bonus) + (1.0 - feasible) * (savings - 0.5)\n\n    # Guard against non-finite values.\n    scores = np.where(np.isfinite(scores), scores, -np.inf)\n    return scores.astype(np.float64)",
