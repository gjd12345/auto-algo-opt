    "hook_name": "score_merge_static",
    "hook_code": "import numpy as np\n\ndef score_merge_static(distance_matrix, demands, capacity, i_idx, j_idx):\n    \"\"\"Return a 1D array of finite float priority scores (higher = merge earlier).\"\"\"\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n\n    # Global, coordinate-scale-invariant normalization\n    scale = float(np.mean(distance_matrix[0, 1:]))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    # Generalized savings (Yellow / Paessens style)\n    lam = 1.10\n    mu = 0.10\n    savings = d0i + d0j - lam * dij + mu * np.abs(d0i - d0j)\n    savings = savings / scale\n\n    # Mild capacity-fill adjustment (dimensionless)\n    cap = float(capacity) if np.isfinite(capacity) and capacity > 0.0 else 1.0\n    fill = (demands[i_idx] + demands[j_idx]) / cap\n    fill = np.clip(fill, 0.0, 1.0)\n    alpha = 0.05\n\n    scores = savings + alpha * fill\n\n    # Guarantee finiteness and float64 output\n    scores = np.asarray(scores, dtype=np.float64)\n    scores = np.where(np.isfinite(scores), scores, 0.0)\n    return scores",
