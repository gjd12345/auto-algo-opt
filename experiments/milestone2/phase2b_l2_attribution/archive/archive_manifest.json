        "hook_name": "score_merge_dynamic",
        "hook_code": "import numpy as np\n\ndef score_merge_dynamic(distance_matrix, demands, capacity, i_idx, j_idx, load_i, load_j, route_dist_i, route_dist_j, remaining_routes):\n    \"\"\"Return a 1D array of finite float priority scores for currently feasible merges (higher = merge now).\"\"\"\n    # Global instance scale (mean depot-to-customer distance); avoid per-pair normalization.\n    scale = float(np.mean(distance_matrix[0, 1:]))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n\n    # Classic Clarke-Wright savings normalized by global scale.\n    cw = (d0i + d0j - dij) / scale\n\n    # Generalized savings: gentle radial-shape and distance terms.\n    lam = 0.15\n    mu = 0.10\n    gen = lam * (dij / scale) + mu * (np.abs(d0i - d0j) / scale)\n\n    # Live route-state signals.\n    combined_load = load_i + load_j\n    fill = combined_load / capacity                       # in [0, 1]\n    slack = 1.0 - fill                                    # small when nearly full\n    # Prefer near-full merges: reward fill, penalize slack mildly.\n    fill_term = 0.35 * fill - 0.10 * slack\n\n    # Route-length balance: reward balanced merges (scale-invariant ratio).\n    ri = route_dist_i / scale\n    rj = route_dist_j / scale\n    denom = ri + rj + 1e-12\n    imbalance = np.abs(ri - rj) / denom\n    balance_term = 0.15 * (1.0 - imbalance)\n\n    # Merge-progress factor: encourage decisive merges early, gentle later.\n    progress = 1.0 / float(max(remaining_routes, 1))\n    progress_term = 0.10 * progress\n\n    return cw + gen + fill_term + balance_term + progress_term",
