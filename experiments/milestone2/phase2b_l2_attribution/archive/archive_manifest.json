        "hook_name": "score_merge_static",
        "hook_code": "import numpy as np\n\ndef score_merge_static(distance_matrix, demands, capacity, i_idx, j_idx):\n    \"\"\"Return a 1D array of finite float priority scores (higher = merge earlier).\"\"\"\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n    scale = np.mean(distance_matrix[0, 1:])\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n    lam = 1.2\n    mu = 0.1\n    savings = d0i + d0j - lam * dij + mu * np.abs(d0i - d0j)\n    base = savings / scale\n    fill = (demands[i_idx] + demands[j_idx]) / capacity\n    score = base + 0.05 * fill\n    return np.where(np.isfinite(score), score, -np.inf)",
