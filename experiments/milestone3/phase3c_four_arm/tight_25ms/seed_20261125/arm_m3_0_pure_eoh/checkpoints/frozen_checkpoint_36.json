    "hook_code": "import numpy as np\n\ndef score_merge_static(distance_matrix, demands, capacity, i_idx, j_idx):\n    \"\"\"Return a 1D array of finite float priority scores (higher = merge earlier).\"\"\"\n    eps = 1e-12\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n\n    saving = d0i + d0j - dij\n\n    load = demands[i_idx] + demands[j_idx]\n    util = np.clip(load / (capacity + eps), 0.0, 1.0)\n    util_term = util * (2.0 - util)\n\n    raw = saving + 0.5 * util_term\n\n    score = np.arctan(raw)\n    return np.where(np.isfinite(score), score, 0.0).astype(np.float64)",
