        "hook_name": "score_merge_static",
        "hook_code": "import numpy as np\n\ndef score_merge_static(distance_matrix, demands, capacity, i_idx, j_idx):\n    \"\"\"Return a 1D array of finite float priority scores (higher = merge earlier).\"\"\"\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n\n    n = distance_matrix.shape[0] - 1\n    depot_d = distance_matrix[0, 1:n + 1]\n    s = np.mean(depot_d)\n    if not np.isfinite(s) or s <= 0.0:\n        s = 1.0\n\n    lam = 1.05\n    mu = 0.10\n    beta = 0.10\n    gamma = 0.12\n\n    savings = (d0i + d0j - lam * dij) / s\n    asym = mu * np.abs(d0i - d0j) / s\n\n    qi = demands[i_idx]\n    qj = demands[j_idx]\n    load_sum = qi + qj\n    fill = np.clip(load_sum / capacity, 0.0, 1.0)\n    imbalance = np.abs(qi - qj) / capacity\n\n    radial = 0.5 * (d0i + d0j) / s\n\n    score = savings + asym + beta * fill - gamma * imbalance + 0.05 * radial\n    score = np.where(np.isfinite(score), score, -1e12)\n    return np.asarray(score, dtype=np.float64)",
