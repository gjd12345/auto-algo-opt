        "hook_name": "score_merge_static",
        "hook_code": "import numpy as np\n\ndef score_merge_static(distance_matrix, demands, capacity, i_idx, j_idx):\n    \"\"\"Return a 1D array of finite float priority scores (higher = merge earlier).\"\"\"\n    # Single global depot-distance scale (invariant: no per-pair normalization).\n    d0 = distance_matrix[0, 1:]\n    scale = float(np.mean(d0))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    d0i = distance_matrix[0, i_idx]\n    d0j = distance_matrix[0, j_idx]\n    dij = distance_matrix[i_idx, j_idx]\n\n    # Evolved generalized savings coefficients (round-1 search family).\n    lam = 1.075\n    mu = 0.115\n    beta = 0.100\n\n    savings = (d0i + d0j - lam * dij + mu * np.abs(d0i - d0j)) / scale\n\n    fill = np.clip((demands[i_idx] + demands[j_idx]) / capacity, 0.0, 1.0)\n    score = savings + beta * fill\n\n    # Guarantee finite output.\n    score = np.where(np.isfinite(score), score, 0.0).astype(np.float64)\n    return score",
