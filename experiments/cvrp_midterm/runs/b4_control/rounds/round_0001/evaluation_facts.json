es]\n    # Demand of each candidate\n    dem = demands[unvisited_nodes]\n\n    # Score: prefer close nodes, but also prefer nodes that are far from depot\n    # (so we don't leave far-away nodes for later, which increases distance),\n    # and prefer nodes that use up more capacity when capacity is tight.\n    # Normalize demand component by current remaining capacity.\n    cap = max(rest_capacity, 1e-9)\n    demand_ratio = dem / cap\n\n    # Weighted combination (tuned for balance)\n    score = d_cur - 0.3 * d_dep + 5.0 * demand_ratio\n\n    # Return candidate with minimum score\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"632e72780a6f1bd5901175502bd4fa54baf5d2b018d7d943ab9a0bde8c58a397","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"85f2ad67370a41b1b5792a5386bdffa9","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.3269545783087362,0.5070929908022715,0.3359212833193582,0.21664715782135271],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.721983973222258,15.858241405542513,16.575749098361033,15.191311261879434],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.34665400256292966,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    # Normalize components\n    max_d_cur = np.max(d_cur) if len(d_cur) > 0 else 1.0\n    max_d_dep = np.max(d_dep) if len(d_dep) > 0 else 1.0\n    max_dem = np.max(dem) if len(dem) > 0 else 1.0\n    if max_d_cur == 0: max_d_cur = 1.0\n    if max_d_dep == 0: max_d_dep = 1.0\n    if max_dem == 0: max_dem = 1.0\n    # Score: prefer close to current, far from depot (to avoid returning), and high demand utilization\n    score = (d_cur / max_d_cur) * 0.6 + (d_dep / max_d_dep) * 0.2 - (dem / max_dem) * 0.2\n    return unvisited_nodes[np.argmin(score)]","code_sha256":"1788518949cda0184576c7036c4bc4717b07d12eebf4cdafc9545cd00678a183","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"ed061f0b82de4b2680d62b1e765386a3","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[0.20772010491126883,0.09155291088828134,0.06030125394898587,0.10911867969135991],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.30927361338474,11.485760781472615,13.155930497990667,13.848688160113415],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.117173237359974,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0001/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"fe10adf28fb8a4853fa423b38388e70dfadc2b26331c0bce9b1840a731c4b766"},"dual_budget":{"baseline_attempts":1,"novel_candidate_evaluations":5,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":0,"total_evaluation_att