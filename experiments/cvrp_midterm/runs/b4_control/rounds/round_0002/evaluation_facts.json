* max(d_cd, 1e-9) * np.maximum(d_dep, 1e-9)\n    cos_theta = (d_cd * d_cd + d_dep * d_dep - d_cur * d_cur) / denom\n    cos_theta = np.clip(cos_theta, -1.0, 1.0)\n\n    # Radial continuity: prefer staying near current depot radius\n    radial_gap = np.abs(d_dep - r_cur) / (r_cur + 1e-9)\n\n    # Load fill preference\n    load_frac = (cap - dem) / cap\n\n    score = 0.50 * prox + 0.25 * cos_theta - 0.20 * radial_gap + 0.15 * load_frac\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"b6f66a142c80ebb0fc0c5d7bcd944e10d983838b798744c68cb9853973777f9f","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"6d0dea5a92c64577a241bad5a096f3fa","generation_parents":[{"algorithm":"Instead of scoring candidates by an additive distance-plus-load formula, evaluate each candidate by the *angle it subtends at the depot* and pick the one that keeps the route sweeping around the depot in a consistent rotational direction while penalizing large jumps in radius — an angular-sweep-with-radial-tiebreak rule.","code_sha256":"7ac4f7af04f6d94bdd54eb6fe2a2376302142acee8a3e7c023263f1f1ae2e730","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[-0.05022566642228453,0.055708409912327006,-0.02032628118564527,0.0053792230726913085],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.253088157485115,11.108590458866779,12.15552590117922,12.55337557461865],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0023660786557278715,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    max_d = float(np.max(distance_matrix))\n    if max_d <= 0.0:\n        max_d = 1.0\n\n    # Proximity to current node (higher = closer)\n    prox = 1.0 - d_cur / max_d\n\n    # Depot-return savings: how much we save by extending the tour to this node\n    # rather than returning to depot now (classic Clarke-Wright style term)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n    savings = d_cur_dep + d_dep - d_cur\n    savings_norm = savings / (max_d + 1e-9)\n\n    # Demand urgency: prefer high-demand nodes so route packs well early\n    max_dem = float(np.max(dem)) if dem.size > 0 else 1.0\n    if max_dem <= 0.0:\n        max_dem = 1.0\n    dem_norm = dem / max_dem\n\n    # Capacity tightness: reward filling the truck close to capacity\n    fill = 1.0 - (cap - dem) / (cap + 1e-9)\n    fill = np.clip(fill, 0.0, 1.0)\n\n    score = 0.40 * prox + 0.30 * savings_norm + 0.20 * dem_norm + 0.10 * fill\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"348939e3d68997a7bde9911976504d12a21dad58d4d222c5d459e0440463f3c7","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"066f8502a8304e08b2b5a303d681eb72","generation_parents":[{"algorithm":"Use a radial-first rule: score each candidate by a weighted mix of closeness to the current node, depot radius continuity, angular sweep consistency 