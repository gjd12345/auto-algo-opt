nvisited_nodes].astype(float)\n\n    # Clarke-Wright savings: going cur -> j instead of cur -> depot -> j\n    savings = d_cur + d_dep - distance_matrix[current_node][depot]\n\n    # Capacity pressure: normalized remaining load after servicing j\n    load_frac = (cap - dem) / cap\n\n    # Prefer high savings and low capacity pressure; mildly reward fuller loads\n    score = savings - 0.6 * cap * (1.0 - load_frac) - 0.25 * d_dep * load_frac\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"c22800ebeb65dfec08ff8979bf3c36163d75bcbf843d7e0721cde3e01a4499f4","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"0e3ed6298f544c0abd5344619cf506c0","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"1788c166bfe9a85cc0e0892c670d27565fcbd798310d9de271ffdfd571c99fdd","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[1.7627340731668486,1.8587640943759107,1.8473457414556607,1.848557625178687],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[32.73334410282902,30.08107091386386,35.32909400873222,35.567687191230505],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":1.8293503835442766,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Geometric proxy for angular position: use squared distances to build a\n    # cosine-like quantity via the law of cosines with the depot as origin.\n    d_cd = float(distance_matrix[current_node][depot])\n    denom = 2.0 * max(d_cd, 1e-9) * np.maximum(d_dep, 1e-9)\n    cos_theta = (d_cd * d_cd + d_dep * d_dep - d_cur * d_cur) / denom\n    cos_theta = np.clip(cos_theta, -1.0, 1.0)\n\n    # Prefer continuing in the current rotational sense: choose direction that\n    # reduces angular deviation (i.e. larger cosine means more \"ahead\").\n    angular_score = cos_theta\n\n    # Radial continuity: prefer candidates whose depot-distance is close to the\n    # current node's depot distance (keeps the route sweeping, not zig-zagging).\n    r_cur = float(distance_matrix[depot][current_node])\n    radial_gap = np.abs(d_dep - r_cur) / (r_cur + 1e-9)\n\n    # Light load term: mildly favor filling the vehicle.\n    load_frac = (cap - dem) / cap\n\n    score = angular_score - 0.35 * radial_gap + 0.10 * load_frac\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"7ac4f7af04f6d94bdd54eb6fe2a2376302142acee8a3e7c023263f1f1ae2e730","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"bb34cfdf208e415eb2af459cc619c63b","generation_parents":[{"algorithm":"Compute for each candidate a Clarke‑Wright-style savings value relative to the depot and current node, then rank candidates by a weighted combination of that saving, the return-to-depot cost, and the fill ratio, choosing the highest score.","code_sha256":"f4dcbf2d1ca9df0f4fe571043cced4961af576ecf47f7328fa710e22277b152b","population_member_indices":[1],"selected_parent