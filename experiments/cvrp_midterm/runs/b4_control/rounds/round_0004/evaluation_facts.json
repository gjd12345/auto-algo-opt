score = -np.abs(fit - 0.85)\n\n    # Normalized proximity: closer to current node is better, but we cap the\n    # influence using a scale based on route geometry so it does not dominate.\n    span = np.maximum(np.max(d_cur) if d_cur.size else 1.0, 1e-9)\n    prox = -d_cur / span\n\n    # Depot-reach term: mild preference for customers moderately far from depot\n    # (avoids picking tiny near-depot hops that fragment the route).\n    dspan = np.maximum(np.max(d_dep) if d_dep.size else 1.0, 1e-9)\n    dep_term = d_dep / dspan\n\n    # Composite: capacity fit dominates, proximity refines, depot term regularizes.\n    score = 2.0 * fit_score + 1.0 * prox + 0.25 * dep_term\n\n    return int(unvisited_nodes[int(np.argmax(score))])","code_sha256":"1119935b7f99531d921bf155a279ff8c9b51bf54dae62b99c7c3be22854be2fe","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"4b66ed8369294e1d910e35935898d451","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"1788c166bfe9a85cc0e0892c670d27565fcbd798310d9de271ffdfd571c99fdd","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the previous heuristic's small depot-distance and residual-load penalties with a strong \"savings\"-style score that rewards customers far from the depot and close to the current node, scaled by a larger residual-load balance term, to favor fuller and more geographically coherent routes.","code_sha256":"fb901ee9366444021d273f8386819a3bcffed4d87e1b6a109bcef04352f83635","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[0.2895460610696241,0.16610883201096824,0.23624373418463418,0.17888496624825545],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.278761486100706,12.2702683086072,15.338977092534874,14.719804627906042],"referenc