utward = d_dep / (d_dep + d_cur + 1e-9)\n\n    # Capacity pressure: fill the vehicle efficiently when nearly full.\n    fill = cap / max(cap + dem.max() if dem.size else cap, 1e-9)\n    demand_term = (dem / max(cap, 1e-9)) * (1.0 - fill)\n\n    score = -savings_norm - 0.25 * outward + 0.5 * demand_term\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"a47e8ee78027bc9cea1c94ed26a3ca9409318ce43eeae542d395884364912c60","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"a376e818e38941c68f9aacc27afcd686","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"1788c166bfe9a85cc0e0892c670d27565fcbd798310d9de271ffdfd571c99fdd","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Use a normalized nearest-neighbor score where each candidate's distance from the current node is divided by its depot distance, then add a mild penalty for low residual capacity favor large demand customers when the load is high, encouraging coherent routes and fuller vehicles.","code_sha256":"7b5da5522fe3ce67c099ac9f485625a203114eca2dc27ba1c2e3707220d07783","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[-0.0014578141250784842,0.0741203536477192,-0.08094991415882283,0.04104121159548342],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.830897982145709,11.302328370384558,11.403324299077566,12.998658633379435],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.008188459239825325,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        return depot\n\n    load_after = (cap - dem) / cap\n\n    # Savings-style score: prefer customers far from depot but close to current node,\n    # strongly reward filling the vehicle (small residual load), and penalize\n    # leaving a residual near 0.5 (unbalanced).\n    savings = d_dep + d_cur - d_dep * d_cur / (np.abs(d_dep) + np.abs(d_cur) + 1e-9) * 0.0\n    score = (\n        d_cur\n        - 0.60 * d_dep\n        + 0.55 * dem\n        + 0.80 * d_cur * np.abs(load_after - 0.5)\n        - 0.50 * d_dep * load_after\n    )\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"3b66bde332f34980e7483290045e2024b94c2153a990429e8190b408aac584b4","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"f783a02f036a4aac90f0cbe1409f5400","generation_parents":[{"algorithm":"Explicit parent","code_sha