node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    denom = rest_capacity + 1e-9\n    load_pressure = dem / denom\n\n    # Blend: prefer nearby customers, moderately favor those farther from\n    # the depot (saving them for while the vehicle is still full), and\n    # lightly penalize high demand when capacity is tight.\n    scores = d_cur + 0.35 * d_depot - 0.25 * d_depot * load_pressure \\\n             + 0.15 * d_cur * load_pressure\n\n    best_idx = int(np.argmin(scores))\n    best_node = int(unvisited_nodes[best_idx])\n\n    # Early return to depot if the current detour is unusually expensive\n    # relative to heading straight back and restarting a fresh route.\n    d_back = distance_matrix[current_node][depot]\n    if d_cur[best_idx] > d_back + distance_matrix[depot][best_node]:\n        return depot\n\n    return best_node","code_sha256":"a080a782d8b22e2e2b20340467cfe7805a12de6a077b85a88cbc6ac60543b967","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"079aadb916d24b838db41b97245a87b5","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[-0.005718765247073363,0.12977853552447075,-0.03389513644800406,-0.000667390711263457],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.780413507133709,11.887986249348788,11.987167223771227,12.47787628833674],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.022374310779532468,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    cur_d = distance_matrix[current_node][unvisited_nodes]\n    depot_d = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Savings when serving this node before returning to depot:\n    # connecting current -> node vs current -> depot -> node.\n    saving = distance_matrix[current_node][depot] + depot_d - cur_d\n\n    # Favor nearby nodes and nodes with strong depot-return savings,\n    # slightly penalizing high-demand nodes to preserve remaining capacity usage.\n    # Avoid division by zero for demand 0.\n    demand_factor = 1.0 + dem / (rest_capacity + 1.0)\n    score = cur_d - 0.5 * saving + 0.3 * depot_d / demand_factor\n\n    # Prefer the feasible customer with minimal score.\n    idx = int(np.argmin(score))\n    node = int(unvisited_nodes[idx])\n    return node","code_sha256":"0359b025ddc1d762d0a68121728ad22a03042d88e88cb8cae142e8cebc8d42ab","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"732a2e78eb2f4abc8baa15c960738a77","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json",