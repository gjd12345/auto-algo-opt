rix[current_node][unvisited_nodes]\n\n    # Distances from each unvisited customer back to the depot.\n    d_depot = distance_matrix[depot][unvisited_nodes]\n\n    # Demand-based load pressure: customers that fill capacity more fully are\n    # slightly preferred, but only as a mild tie-breaker.\n    dem = demands[unvisited_nodes]\n    # Normalize demand contribution by remaining capacity to keep scale ~1.\n    load_penalty = dem / (rest_capacity + 1e-12)\n\n    # Core score: nearest-neighbour with a depot-awareness term so that we do\n    # not strand far customers by greedily consuming close ones first.\n    # A modest weight on the depot distance encourages serving remote nodes\n    # earlier while they are still reachable, and the load term discourages\n    # tiny incremental stops when large demands fit.\n    score = d_cur + 0.35 * d_depot - 0.5 * load_penalty\n\n    best_idx = int(np.argmin(score))\n    return int(unvisited_nodes[best_idx])","code_sha256":"f13b839a325c3a270b37e8e7a923a67924e371a0561c6be7dac0fba475984604","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"56fe78f379ab4927afadab113cfa9eb3","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.1376020046011343,-0.02270901562591936,-0.03237506115189744,0.10859209777517854],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.478502411921477,10.283450621991365,12.006027905933783,13.842113148005621],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.04777750639962401,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_current = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Capacity-aware term: prefer nodes that use up remaining capacity\n    # without disqualifying close options. Normalize by remaining capacity.\n    cap = max(rest_capacity, 1e-9)\n    fill = dem / cap\n\n    # Score: mostly nearest-neighbor, plus a pull toward the depot\n    # and a mild preference for demand that fills the vehicle.\n    score = d_current + 0.35 * d_depot - 0.25 * (fill * d_current.mean() if d_current.size else 0.0)\n\n    best = int(np.argmin(score))\n    return int(unvisited_nodes[best])","code_sha256":"b34598ffa9a91cf4fa72d4ce3ecd028d4cb6d0ebed2f81d7034ffd158dfe4a33","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"39820770a31a4f3d903a80c2b4770ca7","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[0.08429406668483372,-0.038610279515476714,0.010551177169125658,0.058168274872451145],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.846900879159286,10.116131098277304,12.538645033177824,13.212510733036849],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.028600809802733454,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a29