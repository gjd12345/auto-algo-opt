stance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Savings when serving this node before returning to depot:\n    # connecting current -> node vs current -> depot -> node.\n    saving = distance_matrix[current_node][depot] + depot_d - cur_d\n\n    # Favor nearby nodes and nodes with strong depot-return savings,\n    # slightly penalizing high-demand nodes to preserve remaining capacity usage.\n    # Avoid division by zero for demand 0.\n    demand_factor = 1.0 + dem / (rest_capacity + 1.0)\n    score = cur_d - 0.5 * saving + 0.3 * depot_d / demand_factor\n\n    # Prefer the feasible customer with minimal score.\n    idx = int(np.argmin(score))\n    node = int(unvisited_nodes[idx])\n    return node","code_sha256":"0359b025ddc1d762d0a68121728ad22a03042d88e88cb8cae142e8cebc8d42ab","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"a377c6bc6c784c4f90ca75156944e9d2","generation_parents":null,"generation_request_ref":null,"instance_objectives":[-0.008801841755766922,0.12414529810666634,-0.1419395167160847,-0.004478395219103798],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.743884691264459,11.828711049071517,10.646581845595552,12.430291287766238],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.007768613896072272,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0004/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"fdc5aceafc771bf9e14818d6f34ff48750ed2a94a3d20f535c8512bfdf5a9e59"},"dual_budget":{"baseline_attempts":4,"novel_candidate_evaluations":15,"phase_ev