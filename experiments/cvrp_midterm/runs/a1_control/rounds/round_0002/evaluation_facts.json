rix[current_node][depot]\n    detour = np.maximum(detour, 1e-9)\n\n    # Fill efficiency: fraction of remaining capacity this customer consumes,\n    # boosted when it nearly exhausts capacity (better packing, fewer routes).\n    fill = dem / (rest_capacity + 1e-9)\n    after = np.maximum(rest_capacity - dem, 0.0)\n    near_full_bonus = 1.0 / (1.0 + after / (rest_capacity + 1e-9))\n\n    # Depot pull: penalize customers far from depot to keep routes compact.\n    depot_pull = depot_d / (distance_matrix[current_node][depot] + 1e-9)\n\n    # Value per unit detour: maximize (demand packed + packing bonus) / detour,\n    # tempered by a depot-compactness factor.\n    value = (fill + 0.5 * near_full_bonus) / (detour / (cur_d + 1e-9))\n    score = value / (1.0 + 0.3 * depot_pull)\n\n    idx = int(np.argmax(score))\n    node = int(unvisited_nodes[idx])\n    return node","code_sha256":"52ae486476fcd577ffafdb116629357092805ac1ef7660ba43e966922c324ab9","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"19c7084b9ccc44a396aeca30847336e4","generation_parents":[{"algorithm":"For each feasible customer, compute a score combining proximity to the current node, radial distance from the depot, and remaining-capacity slack, then pick the customer minimizing it.","code_sha256":"4d9c805469c3228b7d415b7536df36bf7d3d6553faab0432935f391bf3b0b8ed","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"0359b025ddc1d762d0a68121728ad22a03042d88e88cb8cae142e8cebc8d42ab","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[1.0447172631967792,1.0152802327782102,0.9926792804306898,0.9678697466441325],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[24.22615857938669,21.205592903860644,24.724624271163517,24.57