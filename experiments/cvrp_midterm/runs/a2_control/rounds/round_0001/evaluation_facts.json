tance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    # Priority: nearer nodes preferred, but reward nodes that use more capacity\n    # so leftover capacity is minimized (reduces extra depot trips).\n    load_factor = dem / np.maximum(rest_capacity, 1e-9)\n    score = d_current + 0.3 * d_depot - 1.5 * load_factor * d_current.mean()\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"50f103fd4a05f18b562b6f8602e467394306d8b885171d4db987b25ec344f777","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"13afb9047e8b45daaebd243ae7472ce9","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.11481135903630768,0.16507364338677807,0.063794671757691,0.0934419450987469],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.208474959462418,12.25937563562493,13.199275879051566,13.652945168207108],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.10928040481988091,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = max(rest_capacity, 1e-9)\n    fill = dem / cap\n\n    score = d_cur + 0.30 * d_dep - 0.25 *