 int(depot)\n\n    d_cur = distance_matrix[cur, candidates].astype(float)\n    d_dep = distance_matrix[dep, candidates].astype(float)\n    dem = demands[candidates].astype(float)\n\n    max_d_cur = np.max(d_cur) if d_cur.size > 0 else 1.0\n    max_d_dep = np.max(d_dep) if d_dep.size > 0 else 1.0\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    max_dem = np.max(dem) if dem.size > 0 else 1.0\n\n    if max_d_cur <= 0.0:\n        max_d_cur = 1.0\n    if max_d_dep <= 0.0:\n        max_d_dep = 1.0\n    if max_dem <= 0.0:\n        max_dem = 1.0\n\n    score = (\n        0.55 * (d_cur / max_d_cur)\n        + 0.30 * (d_dep / max_d_dep)\n        + 0.15 * (dem / cap)\n    )\n\n    return int(candidates[np.argmin(score)])","code_sha256":"cba4eaf98d47564876dfadc1d5d910fe401b9c7a634f737e9a16b876437e4a42","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"1b0af8dc6f844fdeb551445cc61bb189","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[0.1793881927357618,0.11912785578236149,0.03828794510942762,0.044416478735872435],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.97359228982219,11.775915493586346,12.882795329994378,13.040802925906663],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.09530511809085584,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\