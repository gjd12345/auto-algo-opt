"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    idx = np.asarray(unvisited_nodes, dtype=int)\n    d_cur = distance_matrix[current_node][idx]\n    d_dep = distance_matrix[depot][idx]\n    dem = demands[idx].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    fill = dem / cap               # 0..1 how much this node fills the vehicle\n    savings = d_dep - d_cur        # positive if node is farther from depot than current\n\n    # Rebalanced score: stronger depot preference, stronger fill preference,\n    # and a mild savings term to avoid backtracking toward the depot too early.\n    score = 1.00 * d_cur - 0.35 * d_dep + 0.80 * (1.0 - fill) * d_cur - 0.10 * savings\n    return int(idx[np.argmin(score)])","code_sha256":"f50ab0370b0f85efac5e0e8c97e18ab57da057d04107028094bb80de2db206fe","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"c8e211087ea84c65806716899c7adcd5","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"619f29852de761f7fc7a54e1d44ec527857195dccb912de7e4783bed7b7bbe23","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_14.json","instance_objectives":[-0.07119788798566166,0.02248549320717734,-0.017760971756867118,-0.1374072527064432],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_object