(big, 0.0)\n    lookahead = np.min(sub + big, axis=1)  # nearest other candidate\n\n    # Savings-style score: node is good if it is close to current,\n    # close to depot, fills capacity, and leaves cheap continuation.\n    # Lower cost path: immediate + discounted lookahead\n    path_cost = d_cur + 0.5 * lookahead - 0.30 * d_dep\n    # Demand fill reward scaled by closeness\n    fill = dem / cap  # 0..1\n    reward = 0.40 * fill * (1.0 + d_dep) / (1.0 + d_cur)\n\n    score = path_cost - reward\n    return int(idx[np.argmin(score)])","code_sha256":"d619107388dcca0e2614cba9e245cc3bc7e15f85b3f8860e30ab09a7a691dd43","elapsed_seconds":0.203,"error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"07b345c91d61487bb2bf6273ead64258","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"619f29852de761f7fc7a54e1d44ec527857195dccb912de7e4783bed7b7bbe23","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"619f29852de761f7fc7a54e1d44ec527857195dccb912de7e4783bed7b7bbe23","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_15.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    idx = np.asarray(unvisited_nodes, dtype=int)\n    d_cur = distance_matrix[current_node][idx].astype(float)\n    d_dep = distance_matrix[depot][idx].astype(float)\n    dem = demands[idx].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    max_d_cur = np.max(d_cur) if d_cur.size > 0 else 1.0\n    max_d_dep = np.max(d_dep) if d_dep.size > 0 else 1.0\n    max_d = max(max_d_cur, max_d_dep, 1e-9)\n\n    fill = dem / cap\n    norm_cur = d_cur / max_d\n    norm_dep = d_dep / max_d\n\n    score = 0.60 * norm_cur + 0.25 * norm_dep - 0.15 * fill\n    return int(idx[np.argmin(score)])","code_sha256":"3ef93360adce83f0c06721dd10b2e4c4678bd25afb90b2305ab3828eedbbbc35","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"275fa20d6b724af8bfd79279c20a1739","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"619f29852de761f7fc7a54e1d44ec527857195dccb912de7e4783bed7b7bbe23","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[0.06604467649338881,0.09338127666270524,-0.012501928362688665,-0.06527079755011761],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.630678994249958,11.504999584920975,12.252608349725985,11.671224618164532],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.020413306810821943,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    idx = np.asarray(unvisited_nodes, dtype=int)\n    dep = int(depot)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    cur_vec = None\n    if int(current_node) != dep:\n        x0 = distance_matrix[dep][int(current_node)]\n        if x0 > 1e-12:\n            # direction from depot to current node (proxy for heading)\n            pass\n\n    # approximate positions from distance matrix relative to depot\n    # place depot at origin; use distance to depot as radius and\n    # angle inferred from pairwise distances via law of cosines\n    r_cur = distance_matrix[dep][int(current_node)]\n    r_idx = distance_matrix[dep][idx]\n\n    # bearing of each candidate relative to depot->current direction\n    # cos(angle between vectors) = (r_cur^2 + r_i^2 - d(cur,i)^2) / (2 r_cur r_i)\n    d_ci = distance_matrix[int(current_node)][idx].astype(float)\n    r_cur_f = float(r_cur)\n    r_i = r_idx.astype(float)\n    denom = 2.0 * r_cur_f * r_i\n    denom = np.where(denom < 1e-12, 1e-12, denom)\n    cosang = (r_cur_f * r_cur_f + r_i * r_i - d_ci * d_ci) / denom\n    cosang = np.clip(cosang, -1.0, 1.0)\n    # deviation angle; straight ahead = 0\n    angle = np.arccos(cosang)\n\n    dem = demands[idx].astype(float)\n    fill = dem / cap\n\n    # direction-aware score: prefer small angular deviation, small leg distance,\n    # high demand fill; add slight pull away from depot for radial sweep\n    score = 1.2 * angle + 0.9 * d_ci - 0.4 * r_i / (r_cur_f + 1.0) - 0.5 * fill\n    return int(idx[np.argmin(score)])","code_sha256":"b5b100adeb2a60a0463258eee8335cc0e6db8c2142056b2d60348be13e096a05","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"836b7311c0e6444b999c4dcb6289afb9","generation_parents":[{"algorithm":"The heuristic scores candidates by combining current-leg distance, depot proximity, and demand fill ratio with rebalanced coefficients (stronger depot pull and demand preference) plus a mild savings term to favor nodes that are far from the depot relative to the current position.","code_sha256":"f50ab0370b0f85efac5e0e8c97e18ab57da057d04107028094bb80de2db206fe","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The heuristic scores candidates by combining current-leg distance, depot proximity, and demand fill ratio with rebalanced coefficients (stronger depot pull and demand preference) plus a mild savings term to favor nodes that are far from the depot relative to the current position.","code_sha256":"f50ab0370b0f85efac5e0e8c97e18ab57da057d04107028094bb80de2db206fe","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.034526990052447935,0.0807394751784584,-0.03696342725645917,0.10858662752662718],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.257252074295335,11.371977441654678,11.949096703272152,13.842044845336364],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.04672241637526858,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    idx = np.asarray(unvisited_nodes, dtype=int)\n    if idx.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][idx].astype(float)\n    d_dep = distance_matrix[depot][idx].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n    dem = demands[idx].astype(float)\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    # Clarke-Wright style saving: extending current route to this node vs returning to depot\n    savings = d_cur_dep + d_dep - d_cur\n\n    # Urgency from fill ratio: prefer nodes whose demand uses a large fraction of remaining capacity\n    fill = dem / cap\n\n    # Primary score: larger saving is better, so minimize the negative\n    score = -savings + 0.5 * d_dep * (1.0 - fill)\n\n    # Penalize very small fills to avoid stranding capacity\n    score = score + 0.3 * (1.0 - fill) * np.max(d_cur + 1e-9)\n\n    return int(idx[np.argmin(score)])","code_sha256":"4e70f33dbd393445449d66c11c2e483baf0c839c98ead06907af7982627792f8","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"638f14a20f934a3cbe5e4c83899c439d","generation_parents":[{"algorithm":"Use a normalized convex combination of nearest-neighbor distance, depot proximity, and demand-fill ratio to prioritize the next customer.","code_sha256":"3ef93360adce83f0c06721dd10b2e4c4678bd25afb90b2305ab3828eedbbbc35","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[-0.0008187540065641685,0.05579550446183381,0.0827028136090518,0.04494250836365993],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.83846967533359,11.109506902908132,13.433882976908134,13.047371042025883],"reference_kind":["solver_reference","solver_reference","solver_refer