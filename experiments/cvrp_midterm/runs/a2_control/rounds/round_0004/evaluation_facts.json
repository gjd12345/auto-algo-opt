 np.clip(dem / cap, 0.0, 1.0)\n    # Relative position: how much closer to depot vs current node\n    closeness = d_cur / (d_cur + d_dep + 1e-9)\n\n    score = d_cur * (1.0 + 0.8 * closeness) - 0.9 * d_dep * fill + 1.4 * d_cur * (1.0 - fill)\n\n    return int(idx[np.argmin(score)])","code_sha256":"252443522b869426ace82766bde0e34760f31e7f5ed8f23c95c26aae79c82934","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"c2ac957c9d064b0c9d69091698b5a34a","generation_parents":[{"algorithm":"This algorithm uses a different weighting of distance, depot-return incentive, and vehicle-fill preference, favoring closer customers with higher fill ratios and stronger avoidance of early depot returns.","code_sha256":"cca1e77d3e7501d7b68ded264129babe2f49b4a4f88e9a407f563646ca1c74d4","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[-0.01297068216541665,0.05217057370542406,-0.0796418185660144,-0.10899005631150659],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.694491559669125,11.07136391679888,11.419554794551962,11.125336795459873],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0373579958343784,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    idx = np.asarray(unvisited_nodes, dtype=int)\n    d_cur = distance_matrix[current_node][idx]\n    d_dep = distance_matrix[depot][idx]\n    dem = demands[idx].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    fill = np.clip(dem / cap, 0.0, 1.0)\n\n    # Detour cost of inserting this node before returning to depot:\n    # going current -> node -> depot vs current -> depot.\n    detour = d_cur + d_dep - distance_matrix[current_node][depot]\n\n    # Concave fill reward: sqrt amplifies the value of nearly-full loads\n    # without over-rewarding tiny demands.\n    fill_reward = np.sqrt(fill + 1e-9)\n\n    # Demand-adjusted detour ratio: pay detour per unit of fill benefit.\n    ratio = detour / (fill_reward + 1e-6)\n\n    # Mild tie-break toward the farther depot leg to avoid premature returns.\n    score = ratio - 0.05 * d_dep\n\n    return int(idx[np.argmin(score)])","code_sha256":"3e2d761725add0ec4c3411e09653a5fc0defee48054a99401d889743efe8eba0","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"555c43a935fd45c79da9d5d3411a1c26","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"f50ab0370b0f85efac5e0e8c97e18ab57da057d04107028094bb80de2db206fe","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The new algorithm selects the next customer by minimizing a nonlinear score combining current distance, depot distance, and dema