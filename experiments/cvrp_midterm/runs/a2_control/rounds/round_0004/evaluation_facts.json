556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    idx = np.asarray(unvisited_nodes, dtype=int)\n    d_cur = distance_matrix[current_node][idx].astype(float)\n    d_dep = distance_matrix[depot][idx].astype(float)\n    dem = demands[idx].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    # Detour-to-progress ratio: how far we travel now per unit of depot-progress\n    # made, penalized when the node barely fills the remaining capacity.\n    detour = d_cur + 1e-9\n    progress = d_dep + 1e-9\n    ratio = detour / progress                       # small => heading outward\n    scarcity = 1.0 + 2.0 * (1.0 - fill)             # under-filled nodes penalized\n    score = ratio * scarcity * (1.0 + 0.5 * d_cur / (d_dep + d_cur + 1e-9))\n    # mild absolute-distance tiebreaker keeps routes compact\n    score = score * (1.0 + 0.15 * d_cur)\n    return int(idx[np.argmin(score)])","code_sha256":"65b8dfc6508cc9abe47693ff1f31091fb1ddd8ee0a9b757a077083c463e99493","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"3450ad963e244355964b9c9ae6157796","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"f50ab0370b0f85efac5e0e8c97e18ab57da057d04107028094bb80de2db206fe","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"This algorithm uses a different weighting of distance, depot-return incentive, and vehicle-fill preference, favoring closer customers with higher fill ratios and stronger avoidance of early depot returns.","code_sha256":"cca1e77d3e7501d7b68ded264129babe2f49b4a4f88e9a407f563646ca1c74d4","popu