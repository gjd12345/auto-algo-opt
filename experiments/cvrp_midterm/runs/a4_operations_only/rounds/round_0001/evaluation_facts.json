ong near-tied\n    for idx in candidate_set:\n        if abs(score[idx] - best_score) <= tol:\n            if dem[idx] > dem[best_idx]:\n                best_idx = idx\n    return int(unvisited_nodes[best_idx])","code_sha256":"4e657e2a81c4d62ffaf52fa82c5ae046e7b4f5991ad45b9941f4392c2f0555cc","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"137b49244dfb48eeadcb77e1f8214a32","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[-0.06282903037022171,-0.00598042938418537,0.037628770109653584,0.10638362276895116],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.10376135366135,10.459475565783078,12.874616465307817,13.814537666471798],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.018800733281049416,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0001/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"b83271fd8306fff05e24cf96a7e5506afc5c7b23a44482241b07eee4e8b842e4"},"dual_budget":{"baseline_attempts":1,"novel_candidate_evaluations":5,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":0,"total_evaluation_attempts":6},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:9a001b765f3947c68e08a711e5c8e850","evaluation:5f89edb9b4fb46b0aeae3bb7f4fdb721","evaluation:b672b167c46c4c998a37b043d8638882","evaluation:18843e38106342ecb13ecc96c143170f","evaluation:abbe308d72a24e5187156a107199e827","evaluation:137b49244dfb48eeadcb77e1f8214a3