][depot]\n    scores = d_cur + d_dep - cur_to_depot\n\n    # Find best primary score\n    best_idx = int(np.argmin(scores))\n    best_score = scores[best_idx]\n\n    # Secondary ordering: among candidates whose primary score is close (within 1e-9),\n    # prefer the one closer to the depot.\n    near_ties = np.where(np.abs(scores - best_score) <= 1e-9)[0]\n    if near_ties.size > 1:\n        tie_dep = d_dep[near_ties]\n        chosen = near_ties[int(np.argmin(tie_dep))]\n    else:\n        chosen = best_idx\n\n    return int(unvisited_nodes[chosen])","code_sha256":"34108ce68fb8ffc560557df01cb68aac606e28adf16a707284ee8ca5a6f64045","elapsed_seconds":0.203,"error_code":"candidate_error","error_detail":null,"evaluation_id":"18843e38106342ecb13ecc96c143170f","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # savings-style: prefer nodes close to current and far from depot\n    score = d_cur - d_dep\n    # secondary ordering among near-ties: prefer larger demand\n    best = np.min(score)\n    tie = np.abs(score - best) <= 1e-9\n    if np.any(tie):\n        cand = unvisited_nodes[tie]\n        cand_scores = score[tie]\n        # among ties, largest demand first\n        return int(cand[np.argmax(demands[cand])])\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"9ff0d1a074d3d3c184dbc4eaed3149b8b7787aa690296862ba87