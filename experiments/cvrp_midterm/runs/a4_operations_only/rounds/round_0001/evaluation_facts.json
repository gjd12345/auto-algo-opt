emaining capacity (fuller loads)\n    cap = max(rest_capacity, 1e-9)\n    tie_nodes = unvisited_nodes[tied]\n    ratio = demands[tie_nodes] / cap\n    best_ratio_idx = int(np.argmax(ratio))\n    # Final tie-break: shorter distance to current node\n    candidates = tie_nodes[ratio >= ratio[best_ratio_idx] - 1e-12]\n    dists = distance_matrix[current_node][candidates]\n    return int(candidates[np.argmin(dists)])","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"5f89edb9b4fb46b0aeae3bb7f4fdb721","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[-0.03113620054936924,-0.08539233393319424,-0.1130907007153073,-0.1024245933295996],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.479263402227756,9.623871418927017,11.004530133256267,11.207314541510007],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0830109571318676,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select next node using a capacity-aware savings score with a nearest tie-break.\"\"\"\n    d_cur_depot = distance_matrix[current_node, depot]\n    d_depot_nodes = distance_matrix[depot, unvisited_nodes]\n    d_cur_nodes = distance_matrix[current_node, unvisited_nodes]\n    scores = d_cur_depot + d_depot_node