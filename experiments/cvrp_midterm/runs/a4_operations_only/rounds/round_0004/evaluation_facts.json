ied = order[scores[order] >= best_score - tol]\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n    tie_nodes = unvisited_nodes[tied]\n    # Secondary: smaller detour cost (insertion-ish cost of going through the node)\n    detour = (distance_matrix[current_node][tie_nodes]\n              + distance_matrix[depot][tie_nodes]\n              - cur_dep)\n    best = detour.min()\n    cands = tie_nodes[detour <= best + 1e-12]\n    # Final tie-break: shorter distance to current node\n    return int(cands[np.argmin(distance_matrix[current_node][cands])])","code_sha256":"96024793be151a475a99403bdc424b073c1dc0300bd8db0b0e162948dc8cc348","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"b263a78bf83c4285b7337f03c7706b51","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the depot-distance penalty term with a normalized demand-fill ratio term (demand/rest_capacity) as the secondary score component, and change the tie-break secondary stage to prefer nodes with larger demand-to-current-distance density, keeping the primary nearest-neighbor distance term intact.","code_sha256":"c915bcafcb7f2c7fad633097484260ba386baa0b8ed7c3c62adfc6514e08fae8","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[1.009329308567241,1.0284247393801722,1.1970166636840216,1.3466093294163424],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[23.806876062392153,21.34390471349868,27.25998712413573,29.3002556279577],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":1.1453450102619442,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings relative to returning to depot from current node\n    savings = d_cur_depot - cur - d_depot\n    max_sav = float(np.max(np.abs(savings))) if savings.size > 0 else 1.0\n    if max_sav <= 0:\n        max_sav = 1.0\n\n    # Primary score: nearest distance minus normalized savings bonus\n    scores = cur - (savings / max_sav)\n\n    order = np.argsort(scores)\n    best_score = scores[order[0]]\n    tol = 1e-9 + 1e-6 * (abs(best_score) + 1.0)\n    tied = order[scores[order] <= best_score + tol]\n\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n\n    tie_nodes = unvisited_nodes[tied]\n    cap = max(rest_capacity, 1e-9)\n    fill = demands[tie_nodes] / cap\n    best_fill = float(np.max(fill))\n    candidates = tie_nodes[fill >= best_fill - 1e-12]\n\n    cand_dists = distance_matrix[current_node][candidates]\n    return int(candidates[np.argmin(cand_dists)])","code_sha256":"b2dfde80cc363558a6311f0d10080d882d17111355238d3e709d8fc27515cb4e","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"b0c912d90ed2468bae6ddeed13a8930a","generation_parents":[{"algorithm":"Replace the depot-distance penalty term with a normalized demand-fill ratio term (demand/rest_capacity) as the secondary score component, and change the tie-break secondary stage to prefer nodes with larger demand-to-current-distance density, keeping the primary nearest-neighbor distance term intact.","code_sha256":"c915bcafcb7f2c7fad633097484260ba386baa0b8ed7c3c62adfc6514e08fae8","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.042302582074611225,0.14178742623354246,0.015578654772215258,-0.01718650814325659],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.349378613630673,12.014348649704628,12.601024612264537,12.271615127845216],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.04562053873427809,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep_from = distance_matrix[depot][unvisited_nodes]\n    dep_to_dep = distance_matrix[unvisited_nodes][depot] if False else dep_from\n\n    cap = max(rest_capacity, 1e-9)\n    dem = demands[unvisited_nodes]\n    fill = dem / cap\n\n    # Route-closure savings: benefit of inserting node vs. returning to depot now.\n    # If we go current -> node -> depot, extra cost over current -> depot is\n    # d(cur,node) + d(node,depot) - d(cur,depot). Prefer nodes that keep this\n    # insertion overhead small relative to the demand they consume.\n    cur_dep = distance_matrix[current_node][depot]\n    insertion = cur + dep_to_dep - cur_dep\n    safe_ins = np.where(insertion <= 1e-12, 1e-12, insertion)\n    safe_dem = np.where(dem <= 1e-12, 1e-12, dem)\n\n    # Priority: low insertion cost per unit demand, with mild fill preference.\n    priority = safe_ins / safe_dem - 0.5 * fill\n\n    order = np.argsort(priority)\n    best = priority[order[0]]\n    tol = 1e-9 + 1e-6 * (abs(best) + 1.0)\n    tied = order[priority[order] <= best + tol]\n\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n\n    tie_nodes = unvisited_nodes[tied]\n    # Secondary: prefer larger fill ratio (better capacity utilization).\n    tie_fill = demands[tie_nodes] / cap\n    best_fill = float(np.max(tie_fill))\n    cand = tie_nodes[tie_fill >= best_fill - 1e-12]\n\n    # Final tie-break: nearest to current node.\n    cand_dists = distance_matrix[current_node][cand]\n    return int(cand[np.argmin(cand_dists)])","code_sha256":"5c9f92fa8a9f39fe88c513a8e723ecef627f36d58c1822d65c5a4c9ce42acbde","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"f464e366c8eb4dbfa0fdb8368024da53","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the depot-distance penalty term with a normalized demand-fill ratio term (demand/rest_capacity) as the secondary score component, and change the tie-break secondary stage to prefer nodes with larger demand-to-current-distance density, keeping the primary nearest-neighbor distance term intact.","code_sha256":"c915bcafcb7f2c7fad633097484260ba386baa0b8ed7c3c62adfc6514e08fae8","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.48250187