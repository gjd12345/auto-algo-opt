e to remaining capacity (fuller loads)\n    cap = max(rest_capacity, 1e-9)\n    tie_nodes = unvisited_nodes[tied]\n    ratio = demands[tie_nodes] / cap\n    best_ratio_idx = int(np.argmax(ratio))\n    # Final tie-break: shorter distance to current node\n    candidates = tie_nodes[ratio >= ratio[best_ratio_idx] - 1e-12]\n    dists = distance_matrix[current_node][candidates]\n    return int(candidates[np.argmin(dists)])","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"7ad112c3b74a4050ba9421a7472f9cc4","generation_parents":null,"generation_request_ref":null,"instance_objectives":[-0.03113620054936924,-0.08539233393319424,-0.1130907007153073,-0.1024245933295996],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.479263402227756,9.623871418927017,11.004530133256267,11.207314541510007],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0830109571318676,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep = distance_matrix[depot][unvisited_nodes]\n    max_dep = float(np.max(dep)) if dep.size > 0 else 1.0\n    if max_dep <= 0:\n        max_dep = 1.0\n    # Primary: closest current distance penalized slightly by depot distance\n    scores = cur - 0.5 * (dep / max_dep)\n    order = np.argsort(scores)\n    # Cheap secondary ordering among near-tied candidates\n    best_score = scores[order[0]]\n    tol = 1e-9 + 1e-6 * (abs(best_score) + 1.0)\n    tied = order[scores[order] <= best_score + tol]\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n    # Secondary: prefer larger demand relative to remaining capacity (fuller loads)\n    cap = max(rest_capacity, 1e-9)\n    tie_nodes = unvisited_nodes[tied]\n    ratio = demands[tie_nodes] / cap\n    best_ratio_idx = int(np.argmax(ratio))\n    # Final tie-break: shorter distance to current node\n    candidates = tie_nodes[ratio >= ratio[best_ratio_idx] - 1e-12]\n    dists = distance_matrix[current_node][candidates]\n    return int(candidates[np.argmin(dists)])","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"8e431b877e334b4a8c5f4304eee8fc32","generation_parents":null,"generation_request_ref":null,"instance_objectives":[-0.03113620054936924,-0.08539233393319424,-0.1130907007153073,-0.1024245933295996],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.479263402227756,9.623871418927017,11.004530133256267,11.207314541510007],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0830109571318676,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n    # Demand-fill ratio per candidate\n    fill = demands[unvisited_nodes] / cap\n    max_fill = float(np.max(fill)) if fill.size > 0 else 1.0\n    if max_fill <= 0:\n        max_fill = 1.0\n    # Primary: closest current distance, with larger demand-fill preferred\n    scores = cur - 0.5 * (fill / max_fill)\n    order = np.argsort(scores)\n    best_score = scores[order[0]]\n    tol = 1e-9 + 1e-6 * (abs(best_score) + 1.0)\n    tied = order[scores[order] <= best_score + tol]\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n    tie_nodes = unvisited_nodes[tied]\n    # Secondary: prefer larger demand density (demand / distance to current)\n    dists = distance_matrix[current_node][tie_nodes]\n    safe_dists = np.where(dists <= 1e-12, 1e-12, dists)\n    density = demands[tie_nodes] / safe_dists\n    best_density_idx = int(np.argmax(density))\n    candidates = tie_nodes[density >= density[best_density_idx] - 1e-12]\n    # Final tie-break: shorter distance to current node\n    cand_dists = distance_matrix[current_node][candidates]\n    return int(candidates[np.argmin(cand_dists)])","code_sha256":"c915bcafcb7f2c7fad633097484260ba386baa0b8ed7c3c62adfc6514e08fae8","elapsed