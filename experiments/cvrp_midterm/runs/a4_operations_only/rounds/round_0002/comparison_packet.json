te\n@@ -3,26 +3,33 @@\n                      distance_matrix: np.ndarray) -> int:\n     if unvisited_nodes.size == 0:\n         return depot\n+\n     cur = distance_matrix[current_node][unvisited_nodes]\n     dep = distance_matrix[depot][unvisited_nodes]\n+    dem = demands[unvisited_nodes].astype(float)\n+\n     max_dep = float(np.max(dep)) if dep.size > 0 else 1.0\n-    if max_dep <= 0:\n+    if max_dep <= 0.0:\n         max_dep = 1.0\n-    # Primary: closest current distance penalized slightly by depot distance\n-    scores = cur - 0.5 * (dep / max_dep)\n-    order = np.argsort(scores)\n-    # Cheap secondary ordering among near-tied candidates\n-    best_score = scores[order[0]]\n-    tol = 1e-9 + 1e-6 * (abs(best_score) + 1.0)\n-    tied = order[scores[order] <= best_score + tol]\n-    if tied.size == 1:\n-        return int(unvisited_nodes[tied[0]])\n-    # Secondary: prefer larger demand relative to remaining capacity (fuller loads)\n-    cap = max(rest_capacity, 1e-9)\n-    tie_nodes = unvisited_nodes[tied]\n-    ratio = demands[tie_nodes] / cap\n-    best_ratio_idx = int(np.argmax(ratio))\n-    # Final tie-break: shorter distance to current node\n-    candidates = tie_nodes[ratio >= ratio[best_ratio_idx] - 1e-12]\n-    dists = distance_matrix[current_node][candidates]\n-    return int(candidates[np.argmin(dists)])+\n+    cap = float(rest_capacity) if rest_capacity > 0.0 else 1e-9\n+\n+    # Closeness ratio: how much of the tour leg is spent closing on the depot.\n+    # 1 means the candidate is on the direct path away from current toward depot;\n+    # large values mean the candidate is \"forward\" relative to the depot direction.\n+    leg = cur + 1e-9\n+    forward = (cur + dep) / leg  # in [1, ...], reward forward progress\n+\n+    # Route-balance reward: prefer candidates that leave a small residual gap\n+    # relative to capacity, scaled by their demand (fills vehicles evenly).\n+    residual = cap - dem\n+    balance = 1.0 - (residual / cap) ** 2  # in [0,1], 1 = tight fit\n+\n+    # Depot-relative pull: slightly prefer candidates near the depot for the\n+    # end-of-tour effect, normalized so scale is comparable across instances.\n+    depot_pull = dep / max_dep\n+\n+    # Single additive score: maximize (we take negative for argmin-style choice)\n+    score = forward + 2.0 * balance - 0.25 * depot_pull\n+\n+    return int(unvisited_nodes[int(np.argmax(score))])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":{"candidate_id":"candidate_1","code_sha256":"13687487ab46e19e2a56643f4567551d5874c22bd60bf2fb70e037ade1ef0125","error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"6de5a8baa33d46ae880f0ce84e74b39e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":1}],"instance_objectives":[],"lineage_status":"verified","origin":"generated","revision":"original","source_request_index":8,"valid":false},"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"13687487ab46e19e2a56643f4567551d5874c22bd60bf2fb70e037ade1ef0125","error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"6de5a8baa33d46ae880f0ce84e74b39e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":1}],"instance_objectives":[],"lineage_status":"verified","origin":"generated","revision":"