:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    max_dep = float(np.max(dep)) if dep.size > 0 else 1.0\n    if max_dep <= 0:\n        max_dep = 1.0\n    cap = max(rest_capacity, 1e-9)\n\n    # Composite base cost: distance from current + slight depot penalty\n    # minus a reward for filling capacity (larger demand is preferred).\n    fill = dem / cap\n    base = cur + 0.30 * (dep / max_dep) - 0.60 * fill\n\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    # Regret: for each candidate, compare its best \"second chance\" cost.\n    # Regret = (second best base cost including self-removal) - own base cost.\n    # High regret means the candidate is relatively good and would be costly\n    # to defer; pick the maximum regret.\n    order = np.argsort(base)\n    n = order.size\n    sorted_vals = base[order]\n\n    # Second-best value for each position in sorted order:\n    # if this candidate is the best, second best is the next one;\n    # otherwise second best is the best one.\n    second_best = np.empty(n, dtype=float)\n    second_best[0] = sorted_vals[1] if n > 1 else sorted_vals[0]\n    second_best[1:] = sorted_vals[0]\n\n    regret = second_best - sorted_vals\n\n    # Tiny tie-break: prefer closer to current node.\n    cur_sorted = cur[order]\n    combined = regret - 1e-9 * cur_sorted\n    best_local = int(np.argmax(combined))\n    return int(unvisited_nodes[order[best_local]])","code_sha256":"13687487ab46e19e2a56643f4567551d5874c22bd60bf2fb70e037ade1ef0125","elapsed_seconds":0.265,"error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"6de5a8baa33d46ae880f0ce84e74b39e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_posit