ate is \"forward\" relative to the depot direction.\n    leg = cur + 1e-9\n    forward = (cur + dep) / leg  # in [1, ...], reward forward progress\n\n    # Route-balance reward: prefer candidates that leave a small residual gap\n    # relative to capacity, scaled by their demand (fills vehicles evenly).\n    residual = cap - dem\n    balance = 1.0 - (residual / cap) ** 2  # in [0,1], 1 = tight fit\n\n    # Depot-relative pull: slightly prefer candidates near the depot for the\n    # end-of-tour effect, normalized so scale is comparable across instances.\n    depot_pull = dep / max_dep\n\n    # Single additive score: maximize (we take negative for argmin-style choice)\n    score = forward + 2.0 * balance - 0.25 * depot_pull\n\n    return int(unvisited_nodes[int(np.argmax(score))])","code_sha256":"18bb83285019c01c5fec89fcd9d72f0f64e66129f4bd2f5c10f6e1e2addd54d8","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"617e4924e5a0433facd3b2c77a88b22b","generation_parents":[{"algorithm":"Replace the depot-distance penalty term with a normalized squared depot-distance penalty and change the secondary stage to prefer the candidate minimizing the combined current+depot distance among near-tied scores.","code_sha256":"e23617ae6ec58143dad9403103ca14865615d55a94b22e13668255eae6b82fd0","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[-0.008740368489112433,0.05311690020549242,-0.08669718873780739,0.0007799344011694759],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.744613037003583,11.08132154660549,11.332013674259963,12.495947892859677],"reference_kind":["solver_refe