d_nodes]\n    dem_max = float(np.max(dem)) if dem.size > 0 else 1.0\n    rel_dem = dem / max(dem_max, 1e-9)\n    scale = d_cur_depot + float(np.max(dep_from_depot)) + 1e-12\n    # Primary score: maximize savings plus relative demand contribution.\n    scores = -(savings + 0.5 * rel_dem * scale)\n    order = np.argsort(scores)\n    best_score = scores[order[0]]\n    tol = 1e-9 + 1e-6 * (abs(best_score) + 1.0)\n    tied = order[scores[order] <= best_score + tol]\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n    # Secondary: among near-ties, prefer smallest depot-distance-to-current ratio.\n    tie_nodes = unvisited_nodes[tied]\n    cur_d = distance_matrix[current_node][tie_nodes]\n    dep_d = distance_matrix[depot][tie_nodes]\n    ratio = dep_d / (cur_d + 1e-9)\n    return int(tie_nodes[np.argmin(ratio)])","code_sha256":"479d90027fe76d16c1a6b8d89c50a7853516c0a737a053fe8af8a154d79c0699","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"41d23a4bb1ff40989fbf85da07d8cc26","generation_parents":[{"algorithm":"Replace the linear distance-minus-depot score with a Clarke-Wright-style savings ratio: for each candidate compute savings = d(depot,current) + d(current,node) - d(depot,node) times a capacity-utilization factor, then break near-ties by nearest-neighbor distance to current node.","code_sha256":"c0aa25e15872e42aa4fe920b90de1c62b395e32e3aad68417791d018a98e7603","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.07535234112093395,0.09326857977067093,0.05218944298637561,0.0395402870820268],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.740957790897921,11.50381374268666,13.055281346780596,12.979917775507927],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"