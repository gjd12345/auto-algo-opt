es = unvisited_nodes[tied]\n    tie_detour = (distance_matrix[current_node][tie_nodes]\n                  + distance_matrix[depot][tie_nodes]\n                  - root_dep)\n    tie_detour = np.maximum(tie_detour, 1e-9)\n    tie_dem = demands[tie_nodes]\n    density = tie_dem / tie_detour\n    tie_dep = distance_matrix[depot][tie_nodes]\n    key = -density + 1e-6 * tie_dep\n    return int(tie_nodes[np.argmin(key)])","code_sha256":"be9651e8bf728381bf27ff675e203c3b043ee1db675a0ead714e491f8c578447","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"a433f3f8825b40cab39ae941ded46cb6","generation_parents":[{"algorithm":"The new algorithm uses a regret-based lookahead score that combines the saving of serving a customer now versus the extra distance incurred by postponing it, weighted by a capacity-utilization bonus and a normalized depot-proximity tie-break to encourage fuller routes before returning to the depot.","code_sha256":"69c6c6995af0a55b57dff4ac2a061f38456ffd06f9d8ad526faf5b6ec6368731","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[-0.011353537432922068,-0.027437784839925025,-0.07291388283409082,-0.016019555601498623],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.71365176604112,10.233692601614083,11.503033197085657,12.286185941721468],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03193119017710914,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep_from_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n    # Classic Clarke-Wright savings: how much we save by linking current->node\n    # instead of going back to depot from current and out to node.\n    savings = d_cur_depot + dep_from_depot - cur\n    cap = max(rest_capacity, 1e-9)\n    util = demands[unvisited_nodes] / cap\n    # Primary score: maximize savings, boosted slightly by capacity utilization\n    scores = -(savings + 0.5 * util * (d_cur_depot + float(np.max(dep_from_depot)) + 1e-12))\n    order = np.argsort(scores)\n    best_score = scores[order[0]]\n    tol = 1e-9 + 1e-6 * (abs(best_score) + 1.0)\n    tied = order[scores[order] <= best_score + tol]\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n    # Secondary: among near-ties, pick the node closest to current node\n    tie_nodes = unvisited_nodes[tied]\n    dists = distance_matrix[current_node][tie_nodes]\n    return int(tie_nodes[np.argmin(dists)])","code_sha256":"c0aa25e15872e42aa4fe920b90de1c62b395e32e3aad68417791d018a98e7603","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"953947aee2af4a6cad36fa3dc798333e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"d597e7fc5120f8d5ef670f3d9ea05ebb8c8d1840dbb03b58b69daaef53e2dc45","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.009128709709042549,0.027491867109923414,-