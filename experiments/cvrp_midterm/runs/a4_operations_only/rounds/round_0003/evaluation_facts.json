]\n\n    if tied.size == 1:\n        return int(unvisited_nodes[tied[0]])\n\n    # Secondary: prefer the candidate whose return trip to depot is cheapest\n    # relative to its demand, so routes fill up while staying cheap to close.\n    tie_nodes = unvisited_nodes[tied]\n    tie_dep = distance_matrix[depot][tie_nodes]\n    tie_dem = demands[tie_nodes]\n    tie_cap = max(rest_capacity, 1e-9)\n    closeness = tie_dep * (1.0 + tie_dem / tie_cap)\n    return int(tie_nodes[np.argmin(closeness)])","code_sha256":"69c6c6995af0a55b57dff4ac2a061f38456ffd06f9d8ad526faf5b6ec6368731","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"200f8f4d296a44ac8986a2c16590f06d","generation_parents":[{"algorithm":"\"I will change the depot-distance penalty weight from 0.5 to 0.75 and replace the max-normalization with a mean-normalization to explore a stronger depot-avoidance term while keeping the same primary/secondary structure.\"","code_sha256":"2d9e4e2353694594699b10900f797e637dd7bd910295c1d649d44caf93d325f4","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"\"I will change the depot-distance penalty weight from 0.5 to 0.75 and replace the max-normalization with a mean-normalization to explore a stronger depot-avoidance term while keeping the same primary/secondary structure.\"","code_sha256":"2d9e4e2353694594699b10900f797e637dd7bd910295c1d649d44caf93d325f4","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_15.json","instance_objectives":[0.1823195216262359,0.23772263510765435,0.09568760785456046,0.11343897712388692],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.00832317405111,13.023817681079356,13.594994783565339,13.902632298822407],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objecti