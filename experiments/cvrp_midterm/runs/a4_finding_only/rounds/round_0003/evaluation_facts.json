s].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    mean_dem = np.mean(dem) if len(dem) > 0 else 1.0\n    if mean_dem <= 0:\n        mean_dem = 1.0\n    fit = 1.0 - np.abs(dem - cap * 0.5) / cap  # prefer mid-fill, then closer to full\n    # blend absolute fill fraction with relative demand consistency\n    util = dem / cap\n    fit_score = 0.5 * fit + 0.5 * util\n\n    # Priority: maximize savings ratio, boost by load fit\n    score = savings_ratio + 0.4 * fit_score\n\n    idx = int(np.argmax(score))\n    best = int(unvisited_nodes[idx])\n\n    # Guard: if returning to depot is cheaper than a detour, do so early\n    if d_cur_n[idx] > 2.0 * d_dep_n[idx]:\n        return depot\n\n    return best","code_sha256":"4d21781fb327aaa4d6e61b31eba7dbc5a0a754cb69e3316f7c971fa8ae5b40e8","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"b943e4ffb42d4263950489dce2bdbdee","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.024460812950937483,-0.0033845434466425227,0.05870703590016885,-0.10848139645526378],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.137986292595954,10.48679052651214,13.136149872653514,11.131688028973166],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.007174522762699993,"origin":"generated","repair_request_ref":null,"revis