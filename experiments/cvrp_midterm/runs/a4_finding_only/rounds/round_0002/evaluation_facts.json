gnment, and capacity-fill; the new rule replaces the additive blend with a lexicographic cascade (primary: scale-free \"radial progress\" ratio d(cur,node)/d(depot,node) to sweep outward while curving toward the depot ring, secondary: capacity-fill tiebreak, tertiary: nearest-node distance), so the decision is a strict ordered filter rather than one weighted sum.","code_sha256":"30d8c6ca72620ca395f88c6216eca97fd6d8abc447f5267b6af34b3178daecef","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.10900158116813305,0.17371112152191193,0.05537038192371257,0.0022986649142834256],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.139639721222506,12.3502626706241,13.094749574722512,12.514911080172704],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.08509543738201025,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    dm = distance_matrix\n    d_cur = dm[current_node][unvisited_nodes].astype(float)\n    d_dep = dm[depot][unvisited_nodes].astype(float)\n\n    # Scale-normalized nearest-distance feature in [0,1].\n    scale = float(np.mean(d_cur)) if len(d_cur) > 0 else 1.0\n    if scale <= 0.0:\n        scale = 1.0\n    near = d_cur / scale\n\n    # Scale-invariant radial progress ratio in [0,1]-ish.\n    safe_dep = np.where(d_dep > 0.0, d_dep, 1.0)\n    radial = d_cur / safe_dep\n    rmax = float(np.max(radial)) if len(radial) > 0 else 1.0\n    if rmax <= 0.0:\n        rmax = 1.0\n    radial_n = radial / rmax\n\n    # Capacity fill in [0,1].\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    util = np.clip(dem / cap, 0.0, 1.0)\n\n    # Smooth weighted sum (lower is better).\n    score = 0.5 * near + 0.3 * radial_n - 0.2 * util\n    idx = np.argmin(score)\n    return int(unvisited_nodes[idx])","code_sha256":"ed693876b9b44dd7a94ccabdea236e2b3a1e6864649b839182ff17f3214128a6","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"5f277be3203841b7bacdc2149dd8190b","generation_parents":[{"algorithm":"Both parents greedily rank feasible customers by a scale-normalized blend of insertion-cost/savings, depot-distance alignment, and capacity-fill; the new rule replaces the additive blend with a lexicographic cascade (primary: scale-free \"radial progress\" ratio d(cur,node)/d(depot,node) to sweep outward while curving toward the depot ring, secondary: capacity-fill tiebreak, tertiary: nearest-node distance), so the decision is a strict ordered filter rather than one weighted sum.","code_sha256":"30d8c6ca72620ca395f88c6216eca97fd6d8abc447f5267b6af34b3178daecef","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[-0.029648124670210493,0.01783492666455609,-0.009915011927962467,-0.136168221862851],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.496894378830506,10.71007036496587,12.28470610750248,10.785984527414723],"reference_kind":["solver_reference","solver_reference","solver_reference"