turn int(unvisited_nodes[idx])","code_sha256":"5abc6bd0aa251f58401b6c3a304dfe5f016319d8b851ad921d187c3265b1ef46","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"6f131a94e7724062a71b14283dfe5c1f","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[0.20930679591213866,0.1286996240092137,-0.010306521317167052,0.0057765433829628475],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.328072998754754,11.876633506440033,12.27984836514435,12.558336599238812],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.08336911049678705,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    dm = distance_matrix\n    d_cur = dm[current_node][unvisited_nodes].astype(float)\n    d_dep = dm[depot][unvisited_nodes].astype(float)\n\n    # Scale-invariant ratio: ratio of step length to depot distance.\n    # Small ratio => node lies near the current \"ring\", moving tangentially or inward.\n    safe_dep = np.where(d_dep > 0.0, d_dep, 1.0)\n    radial = d_cur / safe_dep\n\n    # Hierarchical lexicographic order implemented by rounding to coarse bins,\n    # then tie-breaking on capacity utilization, then raw closeness.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    util = dem / cap\n\n    # Primary key: coarse-binned radial ratio (bins of width 0.15 keep ties meaningful)\n    primary = np.round(radial / 0.15)\n    # Secondary: prefer higher utilization => use negative\n    secondary = -util\n    # Tertiary: nearest first\n    tertiary = d_cur\n\n    # Lexicographic combination via large-magnitude offsets (all bounded arrays)\n    score = primary * 1e6 + secondary * 1e3 + tertiary\n    idx = np.argmin(score)\n    return int(unvisited_nodes[idx])","code_sha256":"30d8c6ca72620ca395f88c6216eca97fd6d8abc447f5267b6af34b3178daecef","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"649b0752effc4ba7aa7448683e9a9355","generation_parents":[{"algorithm":"Replace the linear savings/load score with a scale-invariant angular-plus-detour priority: rank candidates by the detour overhead d(cur,node)+d(node,depot)-d(cur,depot) normalized by depot distance, penalized by a capacity-fill term, encouraging nodes that both save distance and pack the vehicle.","code_sha256":"5abc6bd0aa251f58401b6c3a304dfe5f016319d8b851ad921d187c3265b1ef46","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[0.013686819098784827,-0.04684385928634878,-0.11273034151116451,0.012562756359694486],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.010334177414263,10.029494045066158,11.009001372563358,12.64307067