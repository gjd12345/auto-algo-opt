essure: if little capacity remains, prefer closing soon.\n    pressure = 1.0 - fill.mean() if fill.size > 0 else 0.0\n    pressure = 0.0  # keep per-node, computed below\n\n    # Per-node closing bonus: prefer nodes that leave the vehicle nearly full.\n    residual_after = rest_capacity - dem\n    residual_ratio = np.clip(residual_after / cap, 0.0, 1.0)\n\n    # Composite score (lower is better): small detour, big saving,\n    # high fill, and prefer allocating capacity to larger-demand nodes.\n    score = 1.0 * detour_n - 0.6 * saving_n + 0.7 * residual_ratio - 0.5 * fill\n\n    # Tie-break: among near-ties, break by smaller current distance\n    # (scale-invariant because distance and score share scaling).\n    best_val = np.min(score)\n    span = np.max(score) - np.min(score) if score.size > 1 else 0.0\n    tol = 1e-9 * (span + 1.0)\n    cand_mask = score <= best_val + tol\n    if np.count_nonzero(cand_mask) > 1:\n        # use normalized current distance among ties\n        d_cur_n = d_cur / scale\n        tie_idx = np.argmin(np.where(cand_mask, d_cur_n, np.inf))\n        return int(unvisited_nodes[tie_idx])\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"9ecdc000801f73af33a2b5e2ab5334d0661515b7c218c6a4423b43c93743f7e6","elapsed_seconds":0.203,"error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"5a5f4b22ece84b1b988f11846fef0959","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original