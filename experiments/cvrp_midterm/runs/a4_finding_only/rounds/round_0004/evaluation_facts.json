angular ordering around depot using centroid geometry is unavailable,\n    # so use a swept-score: proximity to current node, load fill, and a\n    # \"return-toward-depot\" pull weighted by how full the vehicle is.\n    load_used = 1.0 - (cap - np.sum(dem)) / cap if cap > 0 else 0.0\n    load_used = min(max(load_used, 0.0), 1.0)\n\n    # As the vehicle fills up, weight depot pull more strongly to start closing the tour.\n    score = (1.0 - 0.5 * load_used) * d_cur_n \\\n            - (0.35 + 0.55 * load_used) * (1.0 - d_dep_n) \\\n            - 0.25 * util\n\n    idx = np.argmin(score)\n    return int(unvisited_nodes[idx])","code_sha256":"5cc57b57888b2696900a94459a2fae63605316e93e4e2f550ff24330454faa8d","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"ea378afdd17f467d8b05f89857661466","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"This variant replaces the savings/load weighting with a pure distance-plus-depot-pull rule: score = normalized current distance minus a normalized depot-distance term scaled by remaining load fraction, emphasizing both closeness and avoiding far-from-depot detours.","code_sha256":"42a6dcdc8eb56b40ee1714be2f87bfc62040d24fa8a275665bc9dee14d82616f","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.16248224561086888,0.10606849349725124,0.1378564202307065,0.0073996258176024735],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.773287747304632,11.638499606853657,14.118213975033047,12.578602746502455],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.5