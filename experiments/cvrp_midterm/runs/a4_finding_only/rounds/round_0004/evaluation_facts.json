pressure: how much filling this node relieves the need to\n    # return soon. Emphasize nodes whose demand uses a big share of the\n    # remaining capacity (they are harder to place later).\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    # Residual capacity fraction after serving this node.\n    residual = np.clip((cap - dem) / cap, 0.0, 1.0)\n\n    # Multiplicative score: minimize detour_ratio, weakly trade off with\n    # a depot-proximity term, and penalize leaving awkward residuals.\n    geom = (detour_ratio ** 2) * (direct_ratio ** 0.5)\n    pressure = 1.0 / (0.5 + fill)  # rewards using capacity well\n    penalty = 1.0 + 0.25 * residual  # mild penalty for leaving slack\n\n    score = geom * pressure * penalty\n    idx = np.argmin(score)\n    return int(unvisited_nodes[idx])","code_sha256":"841b93afca55cb9e546c3e57bad63ff8aac406e3107b351bd108a7b3e274ce2c","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"9150e1fbd724424fb91afbb59b85f6bc","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"This variant replaces the savings/load weighting with a pure distance-plus-depot-pull rule: score = normalized current distance minus a normalized depot-distance term scaled by remaining load fraction, emphasizing both closeness and avoiding far-from-depot detours.","code_sha256":"42a6dcdc8eb56b40ee1714be2f87bfc62040d24fa8a275665bc9dee14d82616f","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[0.04240878979910618,0.030414865794974582,-0.05638837371572273,-0.029040185672347868],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.350636980849595,10.84244156754907,11.708077233952958,