    load = min(1.0, max(0.0, rest_capacity / (rest_capacity + dem.sum())))\n    # use a demand-based proxy for vehicle fill that is scale invariant\n    fill = 0.0\n    if rest_capacity > 0:\n        fill = max(0.0, min(1.0, 1.0 - (dem.max() / rest_capacity)))\n    # savings-like term: prefer far-from-depot customers when light, near when heavy\n    savings = (nd - nc)\n\n    # priority: small score is better\n    score = (\n        1.00 * nc\n        + 0.35 * nd\n        + 0.25 * nq\n        + (0.20 * savings) * (0.5 + 0.5 * fill)\n    )\n\n    score = np.asarray(score, dtype=float)\n    score[~np.isfinite(score)] = np.inf\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"f756a7aeb6d14e982cfda710d3f5471a82e864c20926efe20223606c1749a14a","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"42951417e5f0479c88eb0cbe6ed699dd","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[0.12105503572127031,0.15683948879380236,0.07491492767656797,0.1265188382840574],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.282451104825341,12.172732533903348,13.33725299965172,14.065950185087912],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.11983207261892452,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = distance_matrix[current_node][depot]\n\n    dem = demands[unvisited_nodes]\n    dem0 = float(np.sum(demands)) if demands.size else 1.0\n    if rest_capacity > 0:\n        load_frac = rest_capacity / (rest_capacity + 1e-12 + float(np.sum(dem)))\n    else:\n        load_frac = 0.0\n\n    # Load-aware weight: more detour penalty when capacity is tight.\n    lam = 0.5 + 0.3 * (1.0 - load_frac)\n\n    # Detour relative to going straight back to depot (span-normalised by d_cd).\n    detour = (d_cur + d_dep - d_cd)\n    span = d_cd + 1e-9\n\n    priority = d_cur + 0.5 * d_dep - lam * detour\n\n    # Prefer larger demands when distances tie (helps pack routes).\n    priority = priority - 1e-6 * dem\n\n    return int(unvisited_nodes[np.argmin(priority)])","code_sha256":"112f0d578d019cbbd9899fe8821535b0c5563052a3221b8c5cb04495849a3f0f","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"aa9000be0c454426aea908f72483ac62","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[-0.041096049006702676,-0.06952156245470131,-0.049163558383473575,-0.07395697639747287],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.361257420424296,9.790870089171088,11.797720783857182,11.562767169595123],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.058434536560587606,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Scale normalization: use a representative length scale of the instance.\n    dm = distance_matrix\n    n = dm.shape[0]\n    # max distance among customer-depot distances as scale reference (invariant to uniform scaling)\n    scale = np.max(d_dep) if np.max(d_dep) > 0 else 1.0\n    # also consider max pairwise to be safe; but keep cheap and scale-consistent\n    # use max over depot distance is fine since it scales linearly.\n\n    d_cur_n = d_cur / scale\n    d_dep_n = d_dep / scale\n\n    # savings: how much going via current node saves vs depot roundtrip\n    savings_n = d_dep_n - d_cur_n  # positive means current->node is closer than depot->node\n\n    # load utilization contribution\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    # remaining capacity after visiting (utilization is how much this fills)\n    util = dem / cap  # between 0 and 1 per feasible node\n\n    # Priority: prefer near, prefer high savings, prefer filling capacity\n    # Weights chosen to be modest; all components scale-invariant.\n    score = 1.0 * d_cur_n - 0.5 * savings_n - 0.3 * util\n\n    idx = np.argmin(score)\n    return int(unvisited_nodes[idx])","code_sha256":"c2fa0a34c6e2fd18104e2edc8fcddb8ee4172caa1732db5bf98f0f05a4ff54de","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"7f5e6d40439348a2b0a6301acc3614fc","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[-0.045350920709276175,-0.08