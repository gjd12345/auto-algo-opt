efinition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.140883818145007,11.393604558248754,11.933801602574238,12.486209468554943],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0037742922308497927,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    cap = max(rest_capacity, 1e-12)\n    load_penalty = dem / cap\n    scores = d_cur + 0.3 * d_dep + 0.2 * d_cur * load_penalty\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"6a7ec21379701640d33eac765b3642861828316e5b807d290d230cc7dcdcd878","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"a1a6b6ae3e84410997749f74f010b5df","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[-0.006595869128917722,0.2381612339182922,0.0022276940163233005,-0.007825999297693457],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.770021430872301,13.028432794985218,12.435369510818843,12.388492402023179],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.05649176487700108,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Capacity-aware penalty: customers whose demand nearly fills the remaining\n    # capacity are preferred slightly less, and the depot-return term grows as\n    # the load is consumed, so the route does not strand far customers.\n    cap = float(rest_capacity)\n    load_frac = 1.0 - (dem / (cap + 1e-9))\n    load_frac = np.clip(load_frac, 0.0, 1.0)\n\n    scores = d_cur + 0.15 * d_dep * load_frac + 0.05 * dem\n\n    best = int(np.argmin(scores))\n    return int(unvisited_nodes[best])","code_sha256":"a92db0bf95587b5b7f875f399a9582586e5bc011dbaf88b707f3a129a9cd4d6c","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"3c0b10e41fd54d27aa04a663d5691267","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.01888577563030938,0.21733783994952907,0.08504007610780415,0.09948448852407689],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.071932300366058,12.809320629740805,13.462883096331387,13.728393631138617],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.10518704505292986,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Savings-like: prefer nodes that are close to current and far from depot,\n    # scaled slightly so demand can favor fuller loads without dominating distance.\n    demand_weight = 0.15 * (dem / max(rest_capacity, 1e-9))\n    scores = d_cur - 0.35 * d_dep - demand_weight * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f4983ff92121340f0d042d","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"de126819972e470095345131510b15ec","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[-0.07517745830536252,-0.028038302385886407,-0.11538130349915089,0.07585285810786471],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[10.957455075161436,10.227373713350227,10.976108954925566,13.433324143678318],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.035686051520633776,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0001/comparison_packet.json","schema_version":"alg