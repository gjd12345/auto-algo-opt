y,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = max(rest_capacity, 1e-9)\n    fill = dem / cap\n\n    # Detour overhead: extra distance incurred vs. going straight back to depot.\n    detour = d_cur + d_dep - distance_matrix[current_node][depot]\n\n    # Reward customers whose demand fills the remaining capacity well (packing).\n    # Use a concave transform via sqrt to penalize extreme small fills less.\n    pack_bonus = np.sqrt(fill)\n\n    # Radial preference: prefer customers farther from depot earlier (sweep-like),\n    # but discounted by how cheap the detour is.\n    radial = d_dep / (d_cur + 1e-9)\n\n    # Composite multiplicative score: minimize detour, maximize fill and radial pull.\n    scores = detour / (1.0 + pack_bonus) - 0.35 * radial\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"7f5682c2b04384bbe59cb8ef0a8f8c7949620b8849a91a61378880bff57de8f5","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"a83eb280a7ca4124bf872048ceb3c26a","generation_parents":[{"algorithm":"The heuristic scores each feasible customer with a weighted combination of proximity to the current node, radial distance from the depot, and demand-to-capacity fill ratio, tuned with different coefficients than the parent to favor depot-return efficiency and late-route packing.","code_sha256":"d1dd72574cd6dd5375b2b471b0885db7406051e60a66e4b3d55febac86951c62","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"The heuristic scores each feasible customer with a weighted combination of proximity to the current node, radial distance from the depot, and demand-to-capacity fill ratio, tuned with different coefficie