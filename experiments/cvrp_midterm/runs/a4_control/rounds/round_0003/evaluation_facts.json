ng forward in angular order to form a coherent tour.\n    ang_cur = np.arctan2(current_node - depot if current_node != depot else 0.0, 1.0)\n    # Use vectors to compute actual angle difference\n    cur_vec_x = distance_matrix[depot][current_node]  # proxy magnitude (not exact coords)\n    # Approximate angular cost using law of cosines with depot distance and current radius\n    r_cur = max(d_dep_cur, eps)\n    r_c = np.maximum(d_dep, eps)\n    cos_gap = (r_cur * r_cur + r_c * r_c - d_cur * d_cur) / (2.0 * r_cur * r_c)\n    cos_gap = np.clip(cos_gap, -1.0, 1.0)\n\n    # Reward mild angular turns (cos close to 1 means straight radial continuation)\n    sweep = cos_gap - 0.5 * (1.0 - cos_gap)\n\n    # Combine: prefer close-but-productive candidates, penalize long jumps\n    scores = pressure * 1.0 / (prox + eps) + 0.25 * sweep + 0.15 * d_dep ** 0.5 * frac\n\n    return int(unvisited_nodes[np.argmax(scores)])","code_sha256":"14c98f58fa793c6da6e84e27a44c0e2a293ab5f60fa0f665acea055f647d2f07","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"81c4849c7e4c47e09a30d4fce4932427","generation_parents":[{"algorithm":"Build a Clarke–Wright-style savings score for each candidate: compute the saving from linking current node to the candidate versus returning to depot, then add a radial-angle/quadrant coherence term and a capacity-slack reward, and pick the candidate maximizing the combined score.","code_sha256":"bc2856f7510be3b320f191cf2578dbf5f88380b22a0eb203ddff5ddafece5288","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[-0.008801841755766922,-0.03063074407886451,-0.10053980189753789,-0.07523592625199586],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.743884691264459,10.200094994354158,11.160258283080593,11.54679793381177],"refere