le\n\n    # Packing term: encourage filling remaining capacity.\n    pack_term = fill\n\n    # Directional alignment: prefer customers roughly in line with current\n    # radial direction from depot (sweep-like) discounted by detour.\n    d_cur_safe = d_cur + 1e-9\n    radial = d_dep / d_cur_safe\n    radial_scale = max(float(np.max(radial)), 1e-9)\n    radial_norm = radial / radial_scale\n\n    # Composite score to minimize: detour penalty minus packing and radial pull.\n    scores = detour_norm - 0.55 * pack_term - 0.30 * radial_norm\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"832cb358e18332b387e11f8944d2cd5301252d56345a8d461941ca1dca501c4a","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"afdf8a15d93f43ba82ebe3465ace2689","generation_parents":[{"algorithm":"The heuristic scores each feasible customer by the detour cost relative to the depot (round-trip overhead), combined with a normalized demand fill ratio and an angular/directional preference, rather than a linear combination of raw distances.","code_sha256":"7f5682c2b04384bbe59cb8ef0a8f8c7949620b8849a91a61378880bff57de8f5","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[0.13828627311226105,0.02357377010822379,-0.13028920196078694,0.007428437422981742],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.486609741849097,10.77045679451847,10.791135792532398,12.578962494242345],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.009749819670669908,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep_cur = distance_matrix[depot][current_node]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = max(rest_capacity, 1e-9)\n\n    # Clarke-Wright savings: gain from servicing candidate after current instead of a separate depot leg\n    savings = d_dep_cur + d_dep - d_cur\n\n    # Capacity slack reward: prefer candidates that consume a moderate fraction,\n    # leaving room to keep chaining (peak reward near 40% of remaining capacity)\n    frac = dem / cap\n    slack = 1.0 - np.abs(frac - 0.4)\n\n    # Directional coherence: reward candidates roughly aligned with the current\n    # radial vector from depot (extends outward sweep), penalize sharp turns.\n    eps = 1e-9\n    cos_cur = (d_dep_cur * d_dep_cur - d_dep * d_dep - d_cur * d_cur) / (2.0 * np.maximum(d_cur, eps) * np.maximum(d_dep_cur, eps))\n    cos_cur = np.clip(cos_cur, -1.0, 1.0)\n\n    scores = savings + 0.35 * d_dep * slack + 0.15 * d_cur * cos_cur\n\n    return int(unvisited_nodes[np.argmax(scores)])","code_sha256":"bc2856f7510be3b320f191cf2578dbf5f88380b22a0eb203ddff5ddafece5288","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"21f62e2cbd9a42ae8ec45aed21255221","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7b84fb3d6b2332f72d3d80adf7487066ec4967f99d1ba5599bce382adc22f4f8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7b84fb3d6b2332f72d3d80adf7487066ec4967f99d1ba5599bce382