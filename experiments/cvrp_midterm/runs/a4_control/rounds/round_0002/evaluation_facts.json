n\n    dem = demands[unvisited_nodes].astype(float)\n    fill = dem / max(rest_capacity, 1e-9)\n\n    # Insertion-style savings: adding a node between current and depot saves\n    # (d_cur_dep) minus the detour (d_cur + d_dep - d_cur_dep) -> higher is better.\n    savings = d_cur_dep - (d_cur + d_dep - d_cur_dep)\n\n    # Normalize distances so weights are scale-invariant.\n    max_d = float(np.max(d_cur)) if d_cur.size else 1.0\n    scale = max(max_d, 1e-9)\n\n    scores = (\n        0.55 * (d_cur / scale)          # prefer nearby customers\n        - 0.30 * (d_dep / scale)        # prefer customers far from depot (fill route)\n        - 0.20 * (savings / scale)      # reward large insertion savings\n        - 0.25 * fill                   # prefer customers that use remaining capacity\n    )\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"bbe741f67313e25cc6cf4919b19e35a2ddff5012063646052b5ffe322a77ef3a","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"1d360d81cb0c48b092bfb859e5cca97e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f4983ff92121340f0d042d","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[-0.01706422328032502,-0.12785075548470115,-0.07764118142777299,0.013203201294598834],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.645990586949814,9.177106751603032,11.444378157765366,12.6510674055748],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.05233823972455008,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n\n    dem = demands[unvisited_nodes].astype(float)\n    fill = dem / max(rest_capacity, 1e-9)\n\n    eps = 1e-9\n    # Detour ratio: how much extra travel relative to direct depot return.\n    detour = (d_cur + d_dep) / max(d_cur_dep, eps)\n    # Urgency: prefer nodes far from depot (they benefit from being served now).\n    spread = d_dep / max(float(np.mean(d_dep)), eps)\n    # Capacity pressure: prefer filling vehicle near end of route.\n    used_frac = 1.0 - rest_capacity / max(rest_capacity + dem.max(), eps)\n\n    # Multiplicative score: lower is better.\n    # Balanced product: compact detour, high spread, high fill (esp. when nearly full).\n    scores = (1.0 + detour) * (1.0 - 0.5 * fill) / (1.0 + spread * (0.5 + used_frac))\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"78638e07f4b61faed58cf47539881dba6bb8e036a58090be12cda08cc2d72d30","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"1f48a3d15a5349f7adb63e4685877dcf","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f4983ff92121340f0d042d","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"The new heuristic ranks feasible customers by a weighted combination of proximity to the current node, centrality relative to depot-return cost (via the triangle-inequality savings term `d_cur + d_dep - d_cur_to_dep`), and demand fill ratio, encouraging routing that fills the vehicle efficiently while keeping detours short.","code_sha256":"bbe741f67313e25cc6cf4919b19e35a2ddff5012063646052b5ffe322a77ef3a","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[0.22005449222441464,0.07477700537914021,-0.02195700167163959,0.014308646325423242],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.455413536202562,11.30923792522941,12.13529236349784,12.664870223785647],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.07179578556433462,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n\n    dem = demands[unvisited_nodes].astype(float)\n    fill = dem / max(rest_capacity, 1e-9)\n    fill = np.clip(fill, 0.0, 1.0)\n\n    eps = 1e-9\n    detour = (d_cur + d_dep) / max(d_cur_dep, eps)\n    spread = d_dep / max(float(np.mean(d_dep)), eps)\n\n    alpha = 1.5\n    beta = 0.85\n    gamma = 2.0\n    delta = 0.3\n\n    scores = (np.power(1.0 + detour, alpha) *\n              np.power(np.maximum(1.0 - beta * fill, eps), gamma) /\n              (1.0 + delta * spread))\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"c00ae5172e9b8944678476287c610258287d9fcfad7565c1a6a6832fca280188","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"e430fc14e96147e4bb5c5c25300bd669","generation_parents":[{"algorithm":"Use a multiplicative/geometric score where small detour, high depot savings, and large demand fill ratio are combined via ratios and a softmax-style urgency term rather than additive weights, emphasizing balance between route compactness and capacity utilization.","code_sha256":"78638e07f4b61faed58cf47539881dba6bb8e036a58090be12cda08cc2d72d30","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.315995565864197,0.18341414391880853,0.1903612947192665,0.3302666172676098],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.592139726228522,12.452361792889581,14.769680222955124,16.609987632229384],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.25500940544247047,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = max(rest_capacity, 1e-9)\n    # Fill preference: reward customers whose demand fits well into remaining capacity\n    fill = dem / cap\n    # Reward customers far from depot (savings-style), penalize detour from current node\n    scores = d_cur - 0.6 * d_dep - 0.25 * fill * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"7b84fb3d6b2332f72d3d80adf7487066ec4967f99d1ba5599bce382adc22f4f8","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"b5987579c85344d0bbddbb823b933c0b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f4983ff92121340f0d042d","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[-0.08414032654856025,-0.10745995457127756,-0.09926347699986973,-0.03725641339478405],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[10.851261484832776,9.391666997925519,11.176094576383123,12.021018086860593],"reference_kind":["solver_reference","solver_reference","solver_reference