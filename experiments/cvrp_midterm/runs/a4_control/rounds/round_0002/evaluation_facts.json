ady filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Savings-like: prefer nodes that are close to current and far from depot,\n    # scaled slightly so demand can favor fuller loads without dominating distance.\n    demand_weight = 0.15 * (dem / max(rest_capacity, 1e-9))\n    scores = d_cur - 0.35 * d_dep - demand_weight * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f4983ff92121340f0d042d","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"b0b5932f626c41c9955a9e5f25a5918d","generation_parents":null,"generation_request_ref":null,"instance_objectives":[-0.07517745830536252,-0.028038302385886407,-0.11538130349915089,0.07585285810786471],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[10.957455075161436,10.227373713350227,10.976108954925566,13.433324143678318],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.035686051520633776,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Insertion cost: marginal detour of visiting this node before returning to depot,\n    # normalized by the direct depot round-trip length.\n    insertion = (d_cur + d_dep) / np.maximum(d_cur + d_dep + 1e-9, 1e-9)\n    insertion_cost = (d_cur + d_dep) - distance_matrix[current_node][depot]\n    round_trip = 2.0 * d_dep + 1e-9\n\n    # Fill ratio favors customers that consume more of the remaining capacity.\n    fill = dem / max(rest_capacity, 1e-9)\n\n    # Angular coherence: prefer customers roughly aligned with the direction\n    # already traveled from depot to current node (behavioral sweep).\n    if current_node != depot:\n        vx = 0.0\n        # Use the cosine similarity via the distance matrix (law of cosines).\n        a = distance_matrix[depot][current_node]\n        b = d_dep\n        c = d_cur\n        cos_ang = (a * a + b * b - c * c) / np.maximum(2.0 * a * b, 1e-9)\n        aligned = -cos_ang  # prefer forward continuation\n    else:\n        aligned = np.zeros_like(d_cur)\n\n    score = (\n        0.55 * (insertion_cost / round_trip)\n        + 0.30 * aligned\n        - 0.25 * fill\n    )\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"2d472fb01dfb76afe6ae422ba67cdd6df217f74881807e2fd01c4ca624cac46c","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"6d1fd9e5aae64c64ae7c11ea14d54824","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f4983ff92121340f0d042d","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"cd1637c4029cb9c7b248ed5a1246f848b30aa1f859f