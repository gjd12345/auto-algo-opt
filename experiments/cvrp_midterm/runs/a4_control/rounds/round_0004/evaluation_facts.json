approximate alignment via cosine on distance vectors\n        cur_dep = distance_matrix[depot][current_node]\n        cos_align = (cur_dep**2 + d_dep**2 - d_cur**2) / (2.0 * cur_dep * d_dep + 1e-9)\n        cos_align = np.clip(cos_align, -1.0, 1.0)\n    else:\n        cos_align = np.ones_like(d_cur)\n\n    # Combine: dense, aligned, and load-fill aware\n    fill = dem / cap\n    scores = -(density * (0.5 + 0.5 * cos_align) + 0.3 * fill)\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"ab8a943e3a209582d958e8f37770c15d90d44d70995be417e88c555bc573873f","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"6e61847b22f5474c8ab0a4239b63c74a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7b84fb3d6b2332f72d3d80adf7487066ec4967f99d1ba5599bce382adc22f4f8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The common backbone combines detour distance from the current node with a depot-based savings term and a demand-fill correction; the new algorithm instead ranks candidates by a normalized regret-to-capacity ratio that compares marginal travel cost per unit of demand consumed against the customer's isolation from the depot, encouraging dense packing of remote clusters before returning.","code_sha256":"aae2b8bcbad4a9d54980ea48bfbdc01035db1d52a2cd6004fbb8bd367609d36c","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.19845307669826223,0.23197519390157315,0.1638711354434176,0.1419149717996089],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.199476283901175,12.963340782396628,14.440997508475812,14.258189533168927],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.