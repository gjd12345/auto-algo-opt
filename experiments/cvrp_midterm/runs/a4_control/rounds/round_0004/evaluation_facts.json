on\n    # relative to their immediate cost), and cheap per unit demand\n    scores = unit_cost + 0.35 * (1.0 / (1.0 + isolation)) - 0.5 * dem / cap\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"aae2b8bcbad4a9d54980ea48bfbdc01035db1d52a2cd6004fbb8bd367609d36c","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"514ea7cff14b4c85bf8a881cf77def27","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7b84fb3d6b2332f72d3d80adf7487066ec4967f99d1ba5599bce382adc22f4f8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Use a squared-distance Clarke-Wright savings score that weighs current-leg distance against depot savings with a demand-fill correction term to diversify route construction.","code_sha256":"9c5e519b90823a9e64a288dc5489a6546b38f72b0db5d398acb64ee0830b9ebe","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[0.2382424209012328,0.28538649876321787,0.18824466846226742,0.2690741755180511],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.670907214612791,13.52535611353429,14.743417698202284,15.845925986652047],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.2452369409111923,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = max(rest_capacity, 1e-9)\n\n    # Clarke-Wright style savings: benefit of linking current -> candidate\n    # instead of returning to depot from both ends.\n    savings = d_cur * 0.0 + (d_cur + d_dep - d_cur)  # placeholder replaced below\n    savings = distance_matrix[depot][current_node] + d_dep - d_cur\n\n    # Capacity fill: prefer demands that pack the vehicle tightly.\n    fill = dem / cap\n\n    # Combine: maximize savings, and reward tight remaining-fit.\n    scores = -savings / (1.0 + d_cur) - 0.6 * fill + 0.15 * (d_cur / (1.0 + d_dep))\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"323189bae471e4dda7f302cba6c2223a36386e69643fef3f8df8701c0eb707d7","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"d957d2aeb0d0442fa891e62bb6085229","generation_parents":[{"algorithm":"The common backbone combines detour distance from the current node with a depot-based savings term and a demand-fill correction; the new algorithm instead ranks candidates by a normalized regret-to-capacity ratio that compares marginal travel cost per unit of demand consumed against the cu