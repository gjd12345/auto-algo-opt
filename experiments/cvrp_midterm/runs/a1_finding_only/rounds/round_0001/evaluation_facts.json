p\n\n    # Scale-homogeneous near-tie refinement band\n    span = float(np.max(d_cur) - np.min(d_cur)) if d_cur.size > 1 else 0.0\n    span_dep = float(np.max(d_dep) - np.min(d_dep)) if d_dep.size > 1 else 0.0\n    scale = span + span_dep\n    band = 1e-3 * scale + 1e-12\n\n    base_min = float(np.min(base))\n    near = base <= base_min + band\n\n    if np.count_nonzero(near) <= 1:\n        return int(unvisited_nodes[np.argmin(base)])\n\n    # Refinement inside the near-tie band: prefer the true nearest next hop,\n    # with a slight bias toward higher-demand nodes and lower depot distance.\n    idx = np.nonzero(near)[0]\n    refine = d_cur[idx] - 0.25 * load_frac[idx] * d_dep[idx]\n    return int(unvisited_nodes[idx[np.argmin(refine)]])","code_sha256":"3590dc3d8c9e6a68eca4fed5cd31de21ee2b2d8ba6cd0ced9b0d0de5468e6ae7","elapsed_seconds":0.25,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"ea9cf6b36f574dfd8ad17d3ae92ca269","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # span of distances among candidates and depot, scale-free normalization\n    all_d = np.concatenate((d_cur, d_dep, distance_matrix[current_node][[depot]]))\n    span = float(all_d.max() - all_d.min())\n    if span <= 0.0:\n        span = 1.0\n    # normalized terms\n    cur_n = d_cur / span\n    dep_n = d_dep / span\n    dem = demands[unvisited_nodes]\n    cap = max(rest_capacity, 1e-12)\n    # load pressure: high when remaining capacity after this customer is small relative to its demand\n    load_n = dem / cap  # in [0,1]\n    # Score: prefer close to current, close to depot (cheap return), and filling capacity\n    score = -1.0 * cur_n - 0.45 * dep_n + 0.35 * load_n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"c11d6d665b00ac101c20e9be5a63ad718d893e486679aa750c1d1f27993ada1f","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"d2580de8974843fd85d3a5c2ccaa5421","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.1245555269577752,0.11584259612791631,0.020353920308350787,-0.03938072662034311],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.323925521522316,11.741346664059545,12.660274812402347,11.994493466949441],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.05534282919342481,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    base = d_cur - 0.6 * d_dep\n    span = float(d_cur.max() - d_cur.min()) if d_cur.size > 1 else 0.0\n    band = 1e-3 * span + 1e-12\n    bmin = base.min()\n