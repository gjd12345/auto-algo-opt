nt-node proximity, weaker depot pull than the parent.\n    alpha = 0.35\n    base = (d_cur - alpha * d_dep) / norm\n\n    # Capacity pressure: when little capacity remains, bias toward filling it fully.\n    cap_frac = rest_capacity / (rest_capacity + 1e-12)\n    dem = demands[unvisited_nodes].astype(float)\n    fill = dem / (rest_capacity + 1e-12)\n    load_term = 1e-3 * (fill - cap_frac)\n\n    score = base - load_term\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"fc46e7201c113017f3fcfbec7edf0eb6cdebdc39cb82a844a8c762eaa0ae37fc","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"71d5a5f8c6f74cd699f7b91aa7874915","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_20.json","instance_objectives":[0.019975892384455164,-0.028038302385886407,-0.07393439358731467,-0.046932371541611326],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.084848189438512,10.227373713350227,11.490370976332958,11.900202046630337],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03223229378258931,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Clarke-Wright style savings: serving a customer now (cur -> c) vs. a\n    # direct depot round-trip (cur -> depot -> c). Higher savings = better.\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Capacity-utilization correction: prefer customers that fill remaining capacity well.\n    dem = demands[unvisited_nodes].astype(float)\n    util = dem / (rest_capacity + 1e-12)\n    # Penalize over-large relative demands slightly so tight loads stay flexible.\n    util_term = 0.05 * util\n\n    score = savings - util_term\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"8cbf044a9d69b46bc7bdf4e6c12274e3bc04af304cc6e6eea544aa49e7b1095c","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"eb84e3ee776f411089bcea63905e0ec8","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the pure nearest-neighbour baseline with a scale-normalised combined score that strongly weights proximity to the current node, moderately penalises distance from the depot, and adds a capacity-pressure 