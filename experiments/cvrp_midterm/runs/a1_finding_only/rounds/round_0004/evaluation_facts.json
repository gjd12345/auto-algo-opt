  prox = d_cur / scale\n\n    # Capacity-aware: fraction of remaining capacity this customer fills.\n    rc = float(rest_capacity) + 1e-12\n    dem = demands[unvisited_nodes].astype(float)\n    fill = dem / rc\n\n    # Combine: reward savings, penalise distance, mildly reward fill.\n    w_fill = 0.08 * (dem / (dem + 1e-12))  # value demand magnitudes\n    score = -0.55 * saving + 0.75 * prox - w_fill * fill\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"8b95c7a0e768b7118866216c1b4bb0dc7b3aa5b0194f97e899676eabfe20e709","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"4b4601f3de654f66b6ee4d0611fb8afd","generation_parents":[{"algorithm":"Replace the pure nearest-neighbour baseline with a scale-normalised combined score that strongly weights proximity to the current node, moderately penalises distance from the depot, and adds a capacity-pressure term so fuller vehicles prefer filling remaining capacity with nearby, high-demand customers.","code_sha256":"fc46e7201c113017f3fcfbec7edf0eb6cdebdc39cb82a844a8c762eaa0ae37fc","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.030969332482402752,-0.07370926514267742,-0.004367697243845918,-0.10687516794695912],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.215100341136727,9.746805389404146,12.353535684156203,11.151743734582222],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03849569946276993,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    span = float(np.max(d_cur) - np.min(d_cur)) if d_cur.size > 1 else 0.0\n    norm = span + 1e-12\n\n    # Multiplicative \"value per unit detour\" form instead of an additive score.\n    # Detour: extra distance paid relative to the closest remaining customer.\n    detour = d_cur - float(np.min(d_cur))\n    detour_frac = detour / norm\n\n    # Depot-proximity benefit, guarded against zero distance.\n    dep_benefit = 1.0 / (d_dep / (span + 1.0) + 1e-9)\n\n    # Demand density gating: prefer customers that consume a good chunk of\n    # the remaining capacity while still being nearby.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = rest_capacity + 1e-12\n    fill = dem / cap\n    density = fill / (1.0 + detour_frac)\n\n    # Regret-ratio: larger benefit per unit detour, scaled by demand density.\n    score = (dep_benefit * density) / (1.0 + detour_frac)\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"49fb380d4c477dd0dac93d3e655e82497cbc739b8f9c28890154c5e19652221c","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"740a353a080c4d748cd281b6162e4863","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the pure nearest-neighbour baseline with a scale-normalised combined score that strongly weights proximity to the current node, moderately penalises distance from the depot, and adds a capacity-pressure term so fuller vehicles prefer filling remaining capacity with nearby, high-demand customers.","code_sha256":"fc46e7201c113017f3fcfbec7edf0eb6cdebdc39cb82a844a8c762eaa0ae37fc","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.26218596461085986,0.22788055774548074,0.16685364275323925,0.14718381532578761],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.954594400759504,12.92025536628265,14.478003650580828,14.323977417093834],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.20102599510884187,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    # Scale-normalised components using current-leg span for invariance.\n    span = float(np.max(d_cur) - np.min(d_cur)) if d_cur.size > 1 else 0.0\n    norm = span + 1e-12\n\n    dep_span = float(np.max(d_dep) - np.min(d_dep)) if d_dep.size > 1 else 0.0\n    dep_norm = dep_span + 1e-12\n\n    d_cur_n = d_cur / norm\n    d_dep_n = d_dep / dep_norm\n\n    # Multiplicative savings-style penalty: near customers that are also near\n    # the depot are strongly preferred; far-from-depot customers are penalised\n    # super-linearly through the product term.\n    beta = 0.35\n    score = d_cur_n * (1.0 + beta * d_dep_n)\n\n    # Fill-aware demand bonus: reward large demand that fits snugly into the\n    # remaining capacity, encouraging better vehicle packing.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0.0 else 1.0\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    score = score - 1e-6 * fill\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"800243a17c2f9196690d02f5f8ced28acd137aaeab56f22bdb7082db46c920c5","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"a4593f962dd644da8e0154fc66d696ef","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[-0.038074071525749924,-0.03775450307924843,0.0,-0.000667390711263457],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.397062324600846,10.12513592372451,12.407728887420175,12.47787628833674],"reference_kind":["solver_reference","solver_reference","solver_refer