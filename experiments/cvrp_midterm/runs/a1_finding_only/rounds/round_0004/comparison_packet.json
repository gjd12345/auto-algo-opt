tion.\n+\n+    Args:\n+        current_node:    index of the current node (0 = depot)\n+        depot:           index of the depot (always 0)\n+        unvisited_nodes: array of feasible unvisited customer indices\n+                         (already filtered to satisfy remaining capacity)\n+        rest_capacity:   remaining vehicle capacity\n+        demands:         demand of every node (index 0 = depot demand = 0)\n+        distance_matrix: pairwise Euclidean distance matrix\n+    Returns:\n+        Index of the next node to visit, or 0 to return to the depot early.\n+    \"\"\"\n     if unvisited_nodes.size == 0:\n         return depot\n \n-    d_cur = distance_matrix[current_node][unvisited_nodes]\n-    d_dep = distance_matrix[depot][unvisited_nodes]\n+    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n+    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n \n-    # Scale-aware combination: pull toward close customers that are also near depot.\n-    # Use span-normalised score so behaviour is invariant to coordinate scale.\n     span = float(np.max(d_cur) - np.min(d_cur)) if d_cur.size > 1 else 0.0\n     norm = span + 1e-12\n \n-    # Weight depot-distance term; sign favours smaller d_dep (closer to depot).\n-    alpha = 0.6\n-    score = (d_cur - alpha * d_dep) / norm\n+    # Multiplicative \"value per unit detour\" form instead of an additive score.\n+    # Detour: extra distance paid relative to the closest remaining customer.\n+    detour = d_cur - float(np.min(d_cur))\n+    detour_frac = detour / norm\n \n-    # Small deterministic tie-breaker: prefer higher demand served now (better packing).\n-    # Added at relative magnitude well below score resolution.\n+    # Depot-proximity benefit, guarded against zero distance.\n+    dep_benefit = 1.0 / (d_dep / (span + 1.0) + 1e-9)\n+\n+    # Demand density gating: prefer customers that consume a good chunk of\n+    # the remaining capacity while still being nearby.\n     dem = demands[unvisited_nodes].astype(float)\n-    dem_max = float(np.max(dem)) if dem.size > 0 else 1.0\n-    dem_norm = dem / (dem_max + 1e-12)\n-    score = score - 1e-9 * dem_norm\n+    cap = rest_capacity + 1e-12\n+    fill = dem / cap\n+    density = fill / (1.0 + detour_frac)\n \n-    idx = int(np.argmin(score))\n+    # Regret-ratio: larger benefit per unit detour, scaled by demand density.\n+    score = (dep_benefit * density) / (1.0 + detour_frac)\n+\n+    idx = int(np.argmax(score))\n     return int(unvisited_nodes[idx])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"fc46e7201c113017f3fcfbec7edf0eb6cdebdc39cb82a844a8c762eaa0ae37fc","evaluation_id":"71d5a5f8c6f74cd699f7b91aa7874915","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":0}],"instance_objectives":[0.019975892384455164,-0.028038302385886407,-0.07393439358731467,-0.046932371541611326],"lineage_status":"verified","objective":-0.03223229378258931,"origin":"generated","revision":"original","source_request_index":20,"valid":true},"generated_count":5},"suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6"}
