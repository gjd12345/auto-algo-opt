ax(d_cur) - np.min(d_cur)) if d_cur.size > 1 else 0.0\n    prox = 1.0 - (d_cur - np.min(d_cur)) / (span_cur + 1e-12)\n\n    # Component 2: depot-return saving (larger is better).\n    saving = d_dep - d_cur\n    span_sav = float(np.max(saving) - np.min(saving)) if saving.size > 1 else 0.0\n    sav_n = (saving - np.min(saving)) / (span_sav + 1e-12)\n\n    # Component 3: capacity fill ratio (larger is better).\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-12\n    fill = np.clip(dem / cap, 0.0, 1.0)\n\n    # Additive blend with tuned weights.\n    score = 0.45 * prox + 0.35 * sav_n + 0.20 * fill\n\n    # Tie-break: prefer larger residual capacity after serving (less waste).\n    residual = (cap - dem) / cap\n    score = score - 1e-6 * residual\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"6582e4bc107683f25f0f5b1b4a0b00f06d00f007b180875679fbcd2e6c43e675","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"19c8ce1f8bbb4fb09ad8362dfa4ea87c","generation_parents":[{"algorithm":"Implement a two-stage insertion-urgency rule: first compute a per-customer \"savings\" proxy = d(current,depot) + d(customer,depot) − d(current,customer) normalised by its own span, combine it multiplicatively with a capacity-fill ratio (demand/rest_capacity) so that customers advancing tour closure and packing are favoured, and pick the argmax; ties broken by smaller depot distance.","code_sha256":"5fefcfcb68f683b3a517bceb2da03f412c4e88b8f3cd45f3a76894c56c2e47a3","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[-0.0611864677122509,-0.10318730181910968,-0.03467918842311692,-0.09936778429551017],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.123222715945916,9.436625576592828,