 d_dep - d_cur  # larger -> more promising detour\n    span = float(np.max(savings) - np.min(savings)) if savings.size > 1 else 0.0\n    savings_n = (savings - np.min(savings)) / (span + 1e-12)\n\n    # Capacity-fill ratio: prefer customers that use up residual capacity.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-12\n    fill = np.clip(dem / cap, 0.0, 1.0)\n\n    # Multiplicative blend: savings amplified by packing tightness.\n    urgency = (0.5 + savings_n) * (0.5 + fill)\n\n    # Tie-break by smaller current-distance, deterministic.\n    urgency = urgency - 1e-9 * d_cur\n\n    idx = int(np.argmax(urgency))\n    return int(unvisited_nodes[idx])","code_sha256":"5fefcfcb68f683b3a517bceb2da03f412c4e88b8f3cd45f3a76894c56c2e47a3","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"8b54c6fbe20c4ece92a0f7c2878a462d","generation_parents":[{"algorithm":"Replace the single fixed combination with a scale-normalised two-term score that blends relative distance saving against a radial depot-closeness term and a residual-capacity-aware demand packing bonus, using different weights (alpha=0.35, beta=0.15, gamma=0.25) to explore a new point in the distance/load trade-off space.","code_sha256":"8b46db3fb526babfb74e538afdcedd297235e95807bb48f5282d74d1980849a5","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Replace the single fixed combination with a scale-normalised two-term score that blends relative distance saving against a radial depot-closeness term and a residual-capacity-aware demand packing bonus, using different weights (alpha=0.35, beta=0.15, gamma=0.25) to explore a new point in the distance/load trade-off space.","code_sha256":"8b46db3fb526babfb74e538afdcedd297235e95807bb48f5282d74d1980849a5","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_15.json","instance_objectives":[0.04334820