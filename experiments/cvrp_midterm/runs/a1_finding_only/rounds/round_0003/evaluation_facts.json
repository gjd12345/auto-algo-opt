cust,depot) - d(cur,cust)\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Normalise savings to [0,1] using its own span (scale-free).\n    s_min = float(np.min(savings))\n    s_max = float(np.max(savings))\n    span = s_max - s_min\n    if span > 1e-12:\n        savings_n = (savings - s_min) / span\n    else:\n        savings_n = np.ones_like(savings)\n\n    # Capacity-fill ratio: fraction of residual capacity the customer uses.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-12\n    fill = np.clip(dem / cap, 0.0, 1.0)\n\n    # Geometric-mean-style blend: balanced emphasis on savings and packing.\n    score = np.sqrt((0.5 + savings_n) * (0.5 + fill))\n\n    # Deterministic tie-breaking: stronger savings first, then closer node.\n    score = score + 1e-9 * savings_n - 1e-12 * d_cur\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"7c62beaa76affa306b694d7e782850a66bf24a6af27a94281db1bedb4f4b9f10","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"7b4cfacc00cc4ed7928bdab8789d8344","generation_parents":[{"algorithm":"Implement a two-stage insertion-urgency rule: first compute a per-customer \"savings\" proxy = d(current,depot) + d(customer,depot) − d(current,customer) normalised by its own span, combine it multiplicatively with a capacity-fill ratio (demand/rest_capacity) so that customers advancing tour closure and packing are favoured, and pick the argmax; ties broken by smaller depot distance.","code_sha256":"5fefcfcb68f683b3a517bceb2da03f412c4e88b8f3cd45f3a76894c56c2e47a3","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[0.04334820873470935,0.12386128162662503,-0.04827240652469148,0.0984661507654171],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.36176737648719,11.825722512908762,11.80877795451847,13.715678452574252],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.054350808650514996,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Rank-based normalization (0 = smallest, 1 = largest) -> scale invariant.\n    def to_rank(x):\n        order = np.argsort(x, kind=\"stable\")\n        ranks = np.empty(x.shape[0], dtype=float)\n        ranks[order] = np.arange(x.shape[0], dtype=float)\n        if x.shape[0] > 1:\n            ranks /= (x.shape[0] - 1)\n        return ranks\n\n    r_cur = to_rank(d_cur)\n    r_dep = to_rank(d_dep)\n    r_dem = to_rank(dem)\n\n    # Fill ratio: how full the vehicle is after serving each candidate.\n    cap = float(rest_capacity) + 1e-12\n    fill = np.clip((cap - dem) / cap, 0.0, 1.0)  # small dem -> high fill\n\n    # Preference: near current, near depot, and packing-friendly (high fill).\n    score = 0.55 * r_cur + 0.30 * r_dep - 0.15 * (1.0 - fill) + 0.001 * (1.0 - r_dem)\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"167b1ecbf1ea2770183195900fafeab4e271970aa29b4fc7f783032