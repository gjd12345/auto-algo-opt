variant to coordinate scale.\n-    span = float(np.max(d_cur) - np.min(d_cur)) if d_cur.size > 1 else 0.0\n-    norm = span + 1e-12\n+    total = 0.0\n+    for v in unvisited_nodes:\n+        total += distance_matrix[depot][v]\n+    total = total if total > 0 else 1.0\n \n-    # Weight depot-distance term; sign favours smaller d_dep (closer to depot).\n-    alpha = 0.6\n-    score = (d_cur - alpha * d_dep) / norm\n+    # Savings: how much return distance is avoided by visiting this customer now.\n+    denom = d_cur + d_dep\n+    denom = np.where(denom <= 0.0, 1e-12, denom)\n+    savings = (d_dep) / denom  # in [0,1], larger when customer is close but far from depot\n+    # Actually use classic savings-like ratio: (d_dep) / (d_cur + d_dep)\n+    score = savings\n \n-    # Small deterministic tie-breaker: prefer higher demand served now (better packing).\n-    # Added at relative magnitude well below score resolution.\n-    dem = demands[unvisited_nodes].astype(float)\n-    dem_max = float(np.max(dem)) if dem.size > 0 else 1.0\n-    dem_norm = dem / (dem_max + 1e-12)\n-    score = score - 1e-9 * dem_norm\n+    # Load-aware bonus: prefer customers that fill the truck (reduces number of routes).\n+    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n+    dem_frac = dem / cap\n+    score = score + 0.35 * dem_frac\n \n-    idx = int(np.argmin(score))\n+    # Prefer customers closer to depot (route-cluster cohesion) at small weight.\n+    dep_norm = d_dep / (float(np.max(d_dep)) + 1e-12)\n+    score = score - 0.25 * dep_norm\n+\n+    # Deterministic tie-break: nearer customer.\n+    score = score - 1e-9 * (d_cur / (float(np.max(d_cur)) + 1e-12))\n+\n+    idx = int(np.argmax(score))\n     return int(unvisited_nodes[idx])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":{"candidate_id":"candidate_1","code_sha256":"078b5484d1cbe83bc01cf54b09811b5dfe1287183902b7c3db3d