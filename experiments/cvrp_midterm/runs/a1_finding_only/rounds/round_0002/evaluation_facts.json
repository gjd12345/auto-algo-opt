ding.\n    r_dem[np.argsort(-dem_frac, kind=\"stable\")] = np.arange(n)\n\n    # Composite rank: emphasise closeness to current node, then depot,\n    # with demand fill as a secondary shaping term.\n    score = 2.0 * r_cur + 1.0 * r_dep + 0.5 * r_dem\n\n    # Tiny deterministic tie-break: nearer customer.\n    score = score + 1e-9 * d_cur\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"f4e1bc7fd93bef2cca0a918c0f94cbf0d69aeede254e6d4eaf59c2dfc25ea722","elapsed_seconds":0.235,"error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"f43646ef5b1b4bfc91cac19f1dbf94e7","generation_parents":[{"algorithm":"Scale-normalised savings score that balances distance from the current node and distance from the depot, weighted by the fraction of capacity consumed, to favour customers that save the most return-distance while packing the truck fuller.","code_sha256":"523e70bf38896fe99112ebcb2792222551a9111202c8b7746822cf6975c8f8cc","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n