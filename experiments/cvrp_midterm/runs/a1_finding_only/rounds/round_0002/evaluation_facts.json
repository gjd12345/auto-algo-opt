id":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    denom = d_cur + d_dep\n    denom = np.where(denom <= 0.0, 1e-12, denom)\n    near_ratio = d_cur / denom\n    score = -near_ratio\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    dem_frac = dem / cap\n    score = score + 0.55 * dem_frac\n\n    max_dep = float(np.max(d_dep)) + 1e-12\n    dep_norm = d_dep / max_dep\n    score = score - 0.15 * dep_norm\n\n    max_cur = float(np.max(d_cur)) + 1e-12\n    score = score - 1e-9 * (d_cur / max_cur)\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"777910c75ecde4aadc7b8ec8625793996486c5ee574a0474062dac1453c54605","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"9e2865373aaf4b48bb97ee5dc19afed9","generation_parents":[{"algorithm":"Scale-normalised savings score that balances distance from the current node and distance from the depot, weighted by the fraction of capacity consumed, to favour customers that save the most return-distance while packing the truck fuller.","code_sha256":"523e70bf38896fe99112ebcb2792222551a9111202c8b7746822cf6975c8f8cc","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[0.06565612383621869,0.06849759832443983,-0.025119599422761582,0.08195943303873317],"lineage_status":"verified","metrics":{"fitness_definition":"mean((r