_matrix[depot][unvisited_nodes].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n\n    # Clarke-Wright style savings: how much we gain by inserting this node now\n    # rather than returning to the depot immediately.\n    savings = d_cur_dep + d_dep - d_cur\n    s_span = float(np.max(savings) - np.min(savings))\n    s_norm = savings / (s_span + 1e-12)\n\n    # Capacity-urgency: prefer larger demands when they fit, giving better packing\n    # (reduces number of routes). Scaled into [0,1].\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(rest_capacity, 1e-12)\n    fill_ratio = dem / cap\n    fr_span = float(np.max(fill_ratio) - np.min(fill_ratio))\n    fr_norm = (fill_ratio - float(np.min(fill_ratio))) / (fr_span + 1e-12)\n\n    # Multiplicative-style blend (via a shifted product so we can argmax).\n    # Both terms prefer \"good\" = large. A small additive tie-break on proximity.\n    prox = -d_cur\n    prox_span = float(np.max(prox) - np.min(prox))\n    prox_norm = prox / (prox_span + 1e-12)\n\n  score = (s_norm + 1e-3) * (0.5 + fr_norm) + 1e-4 * prox_norm\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"078b5484d1cbe83bc01cf54b09811b5dfe1287183902b7c3db3dd07405755803","elapsed_seconds":0.25,"error_code":"invalid_code","error_detail":"line_34_column_63","evaluation_id":"305b09e03cb74774a4e9f96b8ed3a581","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"043b7c174ca01507c49e73bc915d78726016a55fa2c272e23f6f563f7feab8e1","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"origi