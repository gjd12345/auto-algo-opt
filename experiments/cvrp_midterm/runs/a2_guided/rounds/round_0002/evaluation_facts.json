visited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    scale = float(np.mean(d_dep)) if d_dep.size > 0 else 1.0\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n\n    s_cur = d_cur / scale\n    s_dep = d_dep / scale\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    s_cap = 1.0 - fill\n\n    # Different weights: less emphasis on current distance, more on depot\n    # proximity and capacity filling to diversify the construction.\n    score = 0.70 * s_cur + 0.55 * s_dep + 0.40 * s_cap\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"67820a00ae590e6aa73b560641ebea383e4685c0a34b2042488d81992982d73b","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"19b23d04db5b4c0a81d19138f627128b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"12a76beea1b7f1b0dc07b346873a5277ab644609e933131fca67e58b8ab07a0a","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.10583444164964413,0.18668294418685608,0.03630602505562489,0.06747086983128722],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.102114912487828,12.486757430102124,12.858204203290253,13.328664882294],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.09907357018085308,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    scale = float(np.mean(d_dep))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n\n    s_cur = d_cur / scale\n    s_dep = d_dep / scale\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    s_cap = 1.0 - fill\n\n    # Load ratio: how full the vehicle currently is (0 empty, 1 full).\n    total_dem = float(np.sum(dem)) + cap  # rough original load proxy\n    if total_dem <= 0.0:\n        load_ratio = 1.0\n    else:\n        load_ratio = 1.0 - cap / total_dem\n    load_ratio = min(max(load_ratio, 0.0), 1.0)\n\n    # Adaptive depot weight: high when nearly empty, low when nearly full.\n    w_dep = 0.55 - 0.45 * load_ratio\n\n    score = 1.0 * s_cur + w_dep * s_dep + 0.20 * s_cap\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"f2f9168bbecd75f9f18ecbf6941f73053eadaa4f798cf9cce2e4b61266bc0