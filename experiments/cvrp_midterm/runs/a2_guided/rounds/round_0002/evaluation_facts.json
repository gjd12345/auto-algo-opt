plicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    # Scale from the current leg: span-proportional and scale-equivariant.\n    span = float(np.max(d_cur)) + float(np.mean(d_dep))\n    if not np.isfinite(span) or span <= 0.0:\n        span = 1.0\n\n    # Detour relative to the current->depot baseline: how much extra travel\n    # the visit costs compared with heading back to the depot now.\n    base = float(distance_matrix[current_node][depot])\n    detour = (d_cur + d_dep - base) / span  # smaller is better\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n\n    # Residual-capacity shaping: prefer customers whose demand leaves a\n    # residual that is small relative to the vehicle capacity (tight packing),\n    # weighted by how near they are to the depot (cheap to serve).\n    resid = (cap - dem) / cap\n    resid = np.clip(resid, 0.0, 1.0)\n    prox = d_dep / (span + 1e-12)\n    pack = resid * (1.0 - np.clip(prox, 0.0, 1.0))  # smaller is better\n\n    score = detour + 0.35 * pack\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"27526367e7275ea524291ff20a9fdbb7fa6c3990d5421638bb01cedd390216c4","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"31df02ba815b49c3b5a18bba8f02c9d2","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"12a76beea1b7f1b0dc07b346873a5277ab644609e933131fca67e58b8ab07a0a","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"12a76beea1b7f1b0dc07b346873a5277ab644609e933131fca67e58b8ab07a0a","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[0.08144374298493552,0.1724908859229972,-0.01115814450277122,0.023168343846535003],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.813129758232591,12.337422858603658,12.269281655543132,12.775494262862285],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.06648620706292413,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    scale = float(np.mean(d_dep)) if d_dep.size > 0 else 1.0\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n\n    s_cur = d_cur / scale\n    s_dep = d_dep / scale\n    fill = np.clip(dem / cap, 0.0, 1.0)\n\n    # Multiplicative urgency: shorter effective distance when filling fast.\n    # (1 - 0.5*fill) in [0.5, 1.0] keeps nearest-neighbour dominant.\n    urgency = 1.0 - 0.5 * fill\n    score = s_cur * urgency + 0.30 * s_dep\n\n    order = np.lexsort((-dem, score))\n    return int(unvisited_nodes[int(order[0])])","code_sha256":"d30d92ae9cacfb75fe6380a41d3d92f963f88606a7f7aa5923ac125780865e05","elapsed_seconds":0.203,"error_code":"forbidden_attribute","error_detail":"lexsort","evaluation_id":"a2c35652da9f4435bf9256cbe139f216","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"12a76beea1b7f1b0dc07b346873a5277ab644609e933131fca67e58b8ab07a0a","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    # Scale-equivariant reference length: mean depot distance of unvisited set.\n    scale = float(np.mean(d_dep))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n\n    # Numerator: Clarke-Wright savings-like term -- how much closer to depot\n    # the customer is relative to the detour it imposes from the current node.\n    # Larger saving means inserting this customer is cheaper than returning.\n    saving = (d_dep + float(distance_matrix[current_node][depot]) - d_cur) / scale\n\n    # Denominator: proximity penalty -- how far the customer is from current\n    # position, plus a mild capacity-utilization bonus folded in multiplicatively.\n    proximity = d_cur / scale\n    fill = np.clip(dem / cap, 0.0, 1.0)  # 1 = fills vehicle well\n    # Shrink proximity when demand fills capacity -> favors full loads.\n    prox_eff = proximity * (1.0 + 0.5 * (1.0 - fill))\n\n    # Multiplicative score: maximize saving, minimize effective proximity.\n    # A small epsilon prevents division blow-up on coincident points.\n    score = prox_eff / (1e-9 + saving)\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"6e6769b846e0b901d5a846b81824c7ff7795b1adb590