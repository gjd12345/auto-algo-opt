alized distance-to-depot: mild pull back toward depot proximity.\n    s_dep = d_dep / scale\n    # Capacity-pressure term: reward filling the vehicle (larger demand relative\n    # to remaining capacity -> better). Bounded in [0, 1].\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    s_cap = 1.0 - fill  # lower is better when demand closer to capacity\n\n    # Combine with readable weights: current distance dominates, depot mild,\n    # capacity pressure mild. All terms are dimensionless (scale-invariant).\n    score = 1.0 * s_cur + 0.30 * s_dep + 0.20 * s_cap\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"12a76beea1b7f1b0dc07b346873a5277ab644609e933131fca67e58b8ab07a0a","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"cea7d29396294326802efd9c1d7f2feb","generation_parents":null,"generation_request_ref":null,"instance_objectives":[-0.01465469962714208,-0.0277741248004607,-0.03549991722785388,0.06791267573228112],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.674539033805264,10.230153496647729,11.967255538931107,13.334181363318253],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.002504016480793885,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matr