.max() - d_dep.min())\n    if span_dep <= 0.0:\n        span_dep = 1.0\n\n    # Primary score: normalized current distance + normalized depot distance\n    score = d_cur / span_cur + d_dep / span_dep\n\n    order = np.argsort(score)\n    best_i = int(order[0])\n    best_score = float(score[best_i])\n\n    # Secondary ordering: among candidates within a small score band,\n    # prefer the one closest to the depot (helps route closure).\n    # Band is proportional to the score spread so it stays scale-invariant.\n    spread = float(score.max() - score.min())\n    band = 0.02 * spread\n\n    if band > 0.0:\n        candidates = [int(i) for i in order if float(score[i]) - best_score <= band]\n        if len(candidates) > 1:\n            best_i = min(candidates, key=lambda i: float(d_dep[i]))\n\n    return int(unvisited_nodes[best_i])","code_sha256":"78611fbfe9afc20b4e37539f8e3fb4b216fcb7ed170ce0b996631eb9ab96aead","elapsed_seconds":0.203,"error_code":"forbidden_syntax","error_detail":null,"evaluation_id":"349a6d9748b54b8d8b4d795d7f903482","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Scale-invariant depot term: closeness to depot relative to the current\n    # node's own depot distance (span-proportional part only).\n    span = distance_matrix[current_node][depot]\n    if span > 0:\n        depot_term = d_dep / span\n    else:\n        depot_term = d_dep.copy()\n\n    # Capacity term: prefer larger remaining capacity after serving the node.\n    cap = np.maximum(rest_capacity - demands[unvisited_nodes], 0.0)\n    if rest_capacity > 0:\n        cap_term = cap / rest_capacity\n    else:\n        cap_term = cap\n\n    score = d_cur + depot_term - cap_term\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"7c594fe0f067b679d8c05fda882d436381c04d2f70dcdc1c605191521b41abd9","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"feb061f4423d40ce95c7cb9abe19e950","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[0.23868352924775174,0.4954647718859407,0.2900316970430748,0.18469191495146028],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.676133541472648,15.73588458760422,16.00636355308903,14.79231140578741],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.3022179782820569,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    # Span-proportional scale: mean distance from depot to unvisited customers.\n    # This is scale-equivariant, so the score is invariant to coordinate scale.\n    scale = float(np.mean(d_dep))\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n\n    # Normalized distance-to-current: dominant term, preserving greedy NN behaviour.\n    s_cur = d_cur / scale\n    # Normalized distance-to-depot: mild pull back toward depot proximity.\n    s_dep = d_dep / scale\n    # Capacity-pressure term: reward filling the vehicle (larger demand relative\n    # to remaining capacity -> better). Bounded in [0, 1].\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    s_cap = 1.0 - fill  # lower is better when demand closer to capacity\n\n    # Combine with readable weights: current distance dominates, depot mild,\n    # capacity pressure mild. All terms are dimensionless (scale-invariant).\n    score = 1.0 * s_cur + 0.30 * s_dep + 0.20 * s_cap\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"12a76beea1b7f1b0dc07b346873a5277ab644609e933131fca67e58b8ab07a0a","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"e709d5e3b0ff4beca743a90e2747655a","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[-0.01465469962714208,-0.0277741248004607,-0.03549991722785388,0.06791267573228112],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.674539033805264,10.230153496647729,11.967255538931107,13.334181363318253],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.002504016480793885,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # span-normalised depot term: proportional, not additive in absolute length\n    span = float(np.max(d_dep))\n    if span <= 0.0:\n        span = 1.0\n    dep_norm = d_dep / span\n\n    score = d_cur + dep_norm\n\n    # cheap secondary stage: among near-ties, prefer smaller demand\n    best = float(np.min(score))\n    tol = 1e-9 * (abs(best) + 1.0)\n    tied = np.nonzero(score <= best + tol)[0]\n    if tied.size > 1:\n        cand = unvisited_nodes[tied]\n        dd = demands[cand]\n        return int(cand[int(np.argmin(dd))])\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"ee2aaae060698eef44fd6c12343c31c3ec46475ae807eb0d2ca6a41a202e264c","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"6281608d91bc403aa4ee802c76ac74fc","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[0.20370817959422177,0.25047380757327176,0.041004610336475344,0.2251342569995512],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.261739638546828,13.157990670004097,12.916502975609468,15.297282959998821],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.18008021362588,"origin":"generated","repair_request_ref":nu