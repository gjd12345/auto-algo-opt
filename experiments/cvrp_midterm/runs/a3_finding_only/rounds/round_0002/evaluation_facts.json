m = demands[unvisited_nodes].astype(np.float64)\n\n    # Normalize each factor to be dimensionless / scale-invariant.\n    span_cur = np.max(d_cur)\n    if span_cur <= 0:\n        span_cur = 1.0\n    f_hop = d_cur / span_cur  # in [0, 1]\n\n    span_dep = np.max(d_dep)\n    if span_dep <= 0:\n        span_dep = 1.0\n    f_dep = d_dep / span_dep  # in [0, 1]\n\n    cap = max(rest_capacity, 1e-9)\n    # Fraction of capacity that this customer would consume (0, 1].\n    frac = np.clip(dem / cap, 0.0, 1.0)\n    # Prefer high fraction (well-filled) but never zero out; use 1 - frac/2 in (0.5, 1].\n    f_fill = 1.0 - 0.5 * frac\n\n    # Multiplicative geometric-mean style score (smaller better).\n    # Slight bias toward depot-proximity so route closure is favored.\n    eps = 1e-9\n    score = (f_hop + eps) * (0.6 + f_dep) * f_fill\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"45cb8dec5aea71eaf6f8f3bf0ae36c13f8cc413e37829ce09806884456128585","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"6f68790f9fa148adb546e009911fcd6e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Combine the distance from the current node with a scaled depot-return saving and a capacity-utilization bonus, selecting the customer with the smallest priority score.","code_sha256":"955f0704f39894cce51f9b193b8b9a8c3c852159a71f13b3e9a9d31d240283f7","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[0.017271365412206023,-0.022098931398662456,-0.033940925324133,0.038803321538039656],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.052804492986564,10.289870174741328,11.98659908781016,12.970715869354596],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":8.707556862556226e-06,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    dem = demands[unvisited_nodes].astype(np.float64)\n\n    span_cur = np.max(d_cur)\n    if span_cur <= 0:\n        span_cur = 1.0\n    f_hop = d_cur / span_cur\n\n    span_dep = np.max(d_dep)\n    if span_dep <= 0:\n        span_dep = 1.0\n    f_dep = d_dep / span_dep\n\n    cap = max(rest_capacity, 1e-9)\n    frac = np.clip(dem / cap, 0.0, 1.0)\n\n    # Additive weighted score (smaller better):\n    # dominant hop term, moderate depot pull, mild penalty for empty fills.\n    score = 3.0 * f_hop + 1.2 * f_dep + 0.8 * (1.0 - frac)\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"bd20cdfa2a9ca007ac5e2f6025ba5ce7c0098f8ac210d20ed90c7e6acadf947a","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"b553134c41e84e7f80db6aff5983e208","generation_parents":[{"algorithm":"The common backbone is a greedy nearest-neighbor rule augmented by additive penalty/bonus terms that mix proximity, depot distance, and capacity; the new algorithm instead uses a multiplicative (geometric-mean) criterion combining normalized current-hop distance, normalized depot-return proximity, and fractional capacity fill, so no single additive weight dominates and the rule stays scale-invariant.","code_sha256":"45cb8dec5aea71eaf6f8f3bf0ae36c13f8cc413e37829ce09806884456128585","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.030600553950598613,0.11550844605519937,0.04404098968358128,-0.03938072662034311],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.210730990247503,11.737830601977667,12.95417754734772,11.994493466949441],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.03769231576725904,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    # Scale-normalising span: use the depot's reach as a proportional reference\n    # so that all terms stay invariant to instance coordinate scale.\n    depot_dists = distance_matrix[depot]\n\n    # Proportional normaliser: max distance from depot among feasible customers.\n    if unvisited_nodes.size > 0:\n        span = float(np.max(depot_dists[unvisited_nodes]))\n    else:\n        span = 0.0\n    if not np.isfinite(span) or span <= 0.0:\n        span = 1.0\n\n    # Travel distance from current node to each candidate (proportional term).\n    d_cur = distance_matrix[current_node][unvisited_nodes] / span\n\n    # Return-to-depot distance for each candidate (proportional term).\n    d_dep = depot_dists[unvisited_nodes] / span\n\n    # Load factor: prefer filling the vehicle with customers whose demand\n    # leaves room for further stops (soft remaining-load pressure).\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        cap = 1.0\n    remaining_after = cap - demands[unvisited_nodes]\n    load_frac = np.clip(remaining_after / cap, 0.0, 1.0)\n\n    # Combined priority: minimise travel + a share of the depot pull,\n    # minus a small reward for keeping capacity headroom (encourages\n    # packing more stops per route without any absolute-scale constant).\n    w_depot = 0.30\n    w_load = 0.15\n    scores = d_cur + w_depot * d_dep - w_load * load_frac\n\n    return int(unvisited_nodes[int(np.argmin(scores))])","code_sha256":"e770579469d7fb02c5ab5bd0aa5d54d0c662744d54321707fbeb02e6320fe23e","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"3fbf3026ca284766b4c3ecd311b1db7a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[0.12413631971278884,0.23779920074108818,0.013282138311089431,-0.014956678674458216],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.318958682645635,13.024623335611473,12.57253005862939,12.299457245671789],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.09006524502262706,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"601df652d10cb872fc63500f1d0c7d7dd2a921a2522047898fd293649134ed0b"},"dual_budget":{"baseline_attempts":2,"novel_candidate_evaluations":10,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":2,"total_evaluation_attempts":14},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:1bdca3c0904c49b1a442c2b53e1bdc90","evaluation:32551298b06c46b5b5afeddd9b7dbce2","evaluation:f7f7fffdc0574c0191155f1a92765d38","evaluation:a9382b82ffde4a3ab8cbc81e01918e33","evaluation:fd84d4d2ee544eccb488a0452d53e1e3","evaluation:6f68790f9fa148adb546e009911fcd6e","evaluation:b553134c41