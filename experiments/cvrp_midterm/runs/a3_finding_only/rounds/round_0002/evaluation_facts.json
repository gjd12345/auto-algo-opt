ormalized immediate travel cost\n    travel = d_cur / span\n    # savings of serving this node directly vs. going via depot\n    saving = (d_cur + d_dep - distance_matrix[current_node][depot]) / span\n    # capacity fill ratio after serving this node (higher = better packing)\n    node_demands = demands[unvisited_nodes]\n    if rest_capacity > 0.0:\n        fill = (rest_capacity - node_demands) / rest_capacity\n    else:\n        fill = np.zeros_like(d_cur)\n    # scale-invariant priority: prefer short travel, high saving, high fill\n    score = travel - 0.5 * saving - 0.5 * fill\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"eb2c783eec82850eb4196cb2b72e9a8636bb5811c516aac633387248f185d46f","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"a9382b82ffde4a3ab8cbc81e01918e33","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[0.10398686862145341,0.09784804542713192,0.05836033789527314,0.0024426564922216537],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.080224552400601,11.55200073070383,13.131848137802958,12.516708989176548],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.06565947710902002,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = max(rest_capacity, 1e-9)\n    # scale for depot-proximity preference: proportional to current span\n    span = np.max(d_cur) if d_cur.size > 0 else 1.0\n    if span <= 0:\n        span = 1.0\n\n    # saving: how much closer to depot than to current node (favor finishing nearby)\n    saving = d_cur - d_dep\n\n    # capacity utilization: prefer larger demands when capacity is scarce\n    dem_scale = np.max(dem) if dem.size > 0 else 1.0\n    if dem_scale <= 0:\n        dem_scale = 1.0\n    util = dem / (cap + dem)\n\n    score = d_cur + 0.5 * saving * (dem_scale / span) - 0.3 * span * util\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"955f0704f39894cce51f9b193b8b9a8c3c852159a71f13b3e9a9d31d240283f7","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"fd84d4d2ee544eccb488a0452d53e1e3","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc26