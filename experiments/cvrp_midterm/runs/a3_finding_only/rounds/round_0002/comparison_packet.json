_nodes.size > 0:\n+        span = float(np.max(depot_dists[unvisited_nodes]))\n+    else:\n+        span = 0.0\n+    if not np.isfinite(span) or span <= 0.0:\n+        span = 1.0\n+\n+    # Travel distance from current node to each candidate (proportional term).\n+    d_cur = distance_matrix[current_node][unvisited_nodes] / span\n+\n+    # Return-to-depot distance for each candidate (proportional term).\n+    d_dep = depot_dists[unvisited_nodes] / span\n+\n+    # Load factor: prefer filling the vehicle with customers whose demand\n+    # leaves room for further stops (soft remaining-load pressure).\n+    cap = float(rest_capacity)\n+    if cap <= 0.0:\n+        cap = 1.0\n+    remaining_after = cap - demands[unvisited_nodes]\n+    load_frac = np.clip(remaining_after / cap, 0.0, 1.0)\n+\n+    # Combined priority: minimise travel + a share of the depot pull,\n+    # minus a small reward for keeping capacity headroom (encourages\n+    # packing more stops per route without any absolute-scale constant).\n+    w_depot = 0.30\n+    w_load = 0.15\n+    scores = d_cur + w_depot * d_dep - w_load * load_frac\n+\n+    return int(unvisited_nodes[int(np.argmin(scores))])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"eb2c783eec82850eb4196cb2b72e9a8636bb5811c516aac633387248f185d46f","evaluation_id":"a9382b82ffde4a3ab8cbc81e01918e33","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"instance_objectives":[0.10398686862145341,0.09784804542713192,0.05836033789527314,0.0024426564922216537],"linea