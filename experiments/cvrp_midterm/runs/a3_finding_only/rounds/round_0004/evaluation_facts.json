n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = max(float(rest_capacity), 1e-9)\n\n    # Round-trip cost of extending to candidate and closing at depot:\n    # d_cur costs the detour, d_dep is the closure leg back to depot.\n    round_trip = d_cur + d_dep\n    # Capacity left after serving this candidate (relative to current cap).\n    left = cap - dem\n    left_frac = np.clip(left / cap, 0.0, 1.0)\n\n    # Closure-awareness: when little capacity remains, we should already be\n    # positioned close to the depot, so weight the return leg more heavily.\n    closure_weight = 0.5 + 0.5 * (1.0 - left_frac)\n\n    # Prefer large demand served at small round-trip cost.\n    dimless = round_trip / cap\n    score = dimless * (1.0 + closure_weight) - dem / cap\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"9ed190d07068a1893d46f2eb10123d439da3b50e31dfd87fea56ad6fd4ba3b7e","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"4655f1fc018d402b906f65404d44e2fd","generation_parents":[{"algorithm":"Use a scale-invariant priority score that combines distance-to-current-node, a depot-proximity saving term normalized by the current span, and a capacity-utilization term weighted by span, with tuned weights favoring distance and load over the saving term.","code_sha256":"9874f26c97fddfbbc25591403eee939599bc90cd7aa9b6c99bbd04f9e712c58d","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"955f0704f39894cce51f9b193b8b9a8c3c852159a71f13b3e9a9d31d240283f7","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[0.5013709168390772,0.6631154581163294,0.469315519545691,0.47634786013912594],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives