e way back\".\n    saving = d_cur_dep + d_dep - d_cur\n\n    # Capacity pressure: fraction of remaining capacity this demand consumes,\n    # in [0,1). Prefers larger demands late in the route to reduce leftover trips.\n    util = dem / (cap + dem)\n\n    # Scale-invariant normalization: divide length terms by span so the rule\n    # is stable under uniform coordinate rescaling.\n    score = d_cur / span - 0.6 * saving / span + 0.35 * util\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"473e40e4885148db2e1d1556b9d95abc9b7895b7519dce7b0c1c62d68921a850","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"d9e3fd887fa948c1a96eb4f76aed3d79","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"955f0704f39894cce51f9b193b8b9a8c3c852159a71f13b3e9a9d31d240283f7","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.011257330106616257,-0.03536875842518448,-0.06786142666774093,-0.029004284393959964],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.981549177820172,10.150239692959074,11.5657227034133,12.12405589812642],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03024428484506728,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cur_dep = distance_matrix[current_node][depot]\n    dem = demands[unvisited_nodes]\n\n    cap = max(rest_capacity, 1e-9)\n\n    # Scale-invariant shape of the d(cur,.) triangle relative to d(dep,.) and d(cur,dep):\n    # use the law-of-cosines-like alignment proxy without needing coordinates.\n    # cos_angle ~ (d_cur^2 + d_cur_dep^2 - d_dep^2) / (2 * d_cur * d_cur_dep)\n    denom = 2.0 * d_cur * max(d_cur_dep, 1e-9)\n    cos_ang = np.where(denom > 0, (d_cur * d_cur + d_cur_dep * d_cur_dep - d_dep * d_dep) / denom, 1.0)\n    cos_ang = np.clip(cos_ang, -1.0, 1.0)\n\n    # Angular pull: strongly prefer candidates aligned with the depot-outward direction\n    # (cos_ang near +1) so the route sweeps outward rather than zig-zagging.\n    angular = 0.5 * (1.0 - cos_ang)\n\n    # Normalized demand pressure in [0,1): prefer larger demands when capacity is scarce.\n    util = dem / (cap + dem)\n\n    # Single normalized blend: angular shape plus capacity pressure.\n    score = angular - 0.55 * util\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"70f00d8d520cc61ec21a6926bdc1655d3001325020b4d21d6c28450ec2530214","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"8655c7a5d90044b49436fa01b6a0c0c9","generation_parents":[{"algorithm":"Use a scale-invariant priority score that combines distance-to-current-node, a depot-proximity saving term normalized by the current span, and a capacity-utilization term weighted by span, with tuned weights favoring distance and load over the saving term.","code_sha256":"9874f26c97fddfbbc25591403eee939599bc90cd7aa9b6c99bbd04f9e712c58d","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"This heuristic scores each candidate by a scale-invariant combination: the insertion-cost proxy d(cur,n) + d(n,depot) − d(cur,depot) (a Clarke-Wright-style saving term) plus a normalized capacity-pressure term that gently prefers larger demands when few feasible candidates remain, all terms normalized by the current span so the rule is invariant to coordinate scale.","code_sha256":"473e40e4885148db2e1d1556b9d95abc9b7895b7519dce7b0c1c62d68921a850","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[1.9370110580610111,1.955520881294885,1.8166178754409585,2.016183882086804],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[34.79820751880197,31.09918492139364,34.947830977932824,37.660703747415056],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":1.9313334242209148,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = max(rest_capacity, 1e-9)\n    span = np.max(d_cur) if d_cur.size > 0 else 1.0\n    if span <= 0:\n        span = 1.0\n\n    saving = (d_cur - d_dep) / span\n    util = dem / (cap + dem)\n\n    score = d_cur + 0.25 * span * saving - 1.1 * span * util\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"518c0a7c0ae24ff937f3d7775cb0866930f6f5f1b0a6b2a13d502b52533be7f9","elapsed_seconds":0.204,"error_code":null,"error_detail":null,"evaluation_id":"1b85314815d24038ba454c3795cefcd1","generation_parents":[{"algorithm":"Use a scale-invariant priority score that combines distance-to-current-node, a depot-proximity saving term normalized by the current span, and a capacity-utilization term weighted by span, with tuned weights favoring distance and load over the saving term.","code_sha256":"9874f26c97fddfbbc25591403eee939599bc90cd7aa9b6c99bbd04f9e712c58d","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[0.09666457179679742,0.06326854351358485,0.05768819941616925,0.015985786917623365],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_obj