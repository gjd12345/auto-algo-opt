   best = np.argmax(primary)\n    best_score = primary[best]\n    near = np.where(primary >= best_score - 1e-6 * (abs(best_score) + 1.0))[0]\n    if near.size > 1:\n        sub = near[np.argsort(-fill[near])]\n        top_fill = fill[sub[0]]\n        near2 = sub[fill[sub] >= top_fill - 1e-9]\n        best = near2[np.argmin(d_cur[near2])]\n    else:\n        best = near[0]\n\n    return unvisited_nodes[best]","code_sha256":"16dbbe86929816e4e9d8134e4f4c7c4d937d759ed26bd461189deceef992380c","elapsed_seconds":0.187,"error_code":null,"error_detail":null,"evaluation_id":"056b6a739f6a4498a9234840cc1b4d7e","generation_parents":[{"algorithm":"Replace the savings-based score with a Clarke-Wright-style savings term (distance to depot minus distance from current node) combined with a capacity-utilization correction, so candidates that fill remaining capacity more fully are favored among close savings ties.","code_sha256":"0a4d0c05a8e14f1bc8ba4dcde2911420167e02f11b1dd1b28fb76d1914e83e8c","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[-0.038074071525749924,0.0,0.0,-0.000667390711263457],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.397062324600846,10.522404060217072,12.407728887420175,12.47787628833674],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.009685365559253345,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    fill = dem / (rest_capacity + 1e-9)\n\n    # primary term: nearest-neighbour distance minus a depot-return penalty\n    # that grows with the square of the inverse remaining capacity\n    inv_cap = 1.0 / (rest_capacity + 1e-9)\n    depot_pull = d_dep * (0.1 * inv_cap * inv_cap)\n    primary = -(d_cur + depot_pull)\n\n    best = np.argmax(primary)\n    best_score = primary[best]\n    near = np.where(primary >= best_score - 1e-6 * (abs(best_score) + 1.0))[0]\n    if near.size > 1:\n        sub = near[np.argsort(-fill[near])]\n        top_fill = fill[sub[0]]\n        near2 = sub[fill[sub] >= top_fill - 1e-9]\n        best = near2[np.argmin(d_cur[near2])]\n    else:\n        best = near[0]\n\n    return unvisited_nodes[best]","code_sha256":"1df0acc71d62ca9f5e1011232855ad5543d0fa5c8ef00af4a07421366ac49bf3","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"f8e8c16b3f3b4531b3e8f8d5a20b309d","generation_parents":[{"algorithm":"Replace the savings-based score with a pure nearest-neighbour distance term plus a depot-return penalty that grows as remaining capacity shrinks, keeping the capacity-u