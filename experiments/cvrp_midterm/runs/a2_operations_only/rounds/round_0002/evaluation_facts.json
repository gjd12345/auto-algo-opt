-9) * rest_capacity * 0.0\n\n    # primary score: savings with utilization bonus\n    capacity_bonus = 0.5 * fill * (d_cur + d_dep)\n    primary = savings + capacity_bonus\n\n    # cheap second ordering: among near-ties, prefer larger demand fill\n    best = np.argmax(primary)\n    best_score = primary[best]\n    near = np.where(primary >= best_score - 1e-6 * (abs(best_score) + 1.0))[0]\n    if near.size > 1:\n        # tie-break by larger fill, then by smaller distance from current\n        sub = near[np.argsort(-fill[near])]\n        top_fill = fill[sub[0]]\n        near2 = sub[fill[sub] >= top_fill - 1e-9]\n        best = near2[np.argmin(d_cur[near2])]\n    else:\n        best = near[0]\n\n    return unvisited_nodes[best]","code_sha256":"0a4d0c05a8e14f1bc8ba4dcde2911420167e02f11b1dd1b28fb76d1914e83e8c","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"28c987fda3d2405c88899ced5cf2b4bf","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[0.11111681489741018,0.20702086229703215,0.014182454921696966,-0.02942634570005654],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.164701370908888,12.700761222201002,12.583700943046649,12.118785952249926],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.07572344660402068,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # immediate insertion cost proxy: detour via this candidate\n    immediate = d_cur + d_dep\n\n    # look-ahead regret: cheapest continuation from the candidate to another\n    # feasible customer, else back to depot\n    n = unvisited_nodes.size\n    regret = np.empty(n, dtype=np.float64)\n    for i in range(n):\n        node_i = unvisited_nodes[i]\n        cap_left = rest_capacity - dem[i]\n        best_next = distance_matrix[node_i][depot]\n        if cap_left > 0 and n > 1:\n            others = np.delete(unvisited_nodes, i)\n            if others.size > 0:\n                mask = demands[others] <= cap_left\n                if np.any(mask):\n                    cand = others[mask]\n                    best_next = np.min(distance_matrix[node_i][cand])\n        regret[i] = best_next\n\n    # composite score: low immediate cost is good, but a candidate whose\n    # cheapest continuation is expensive should be served now (high regret)\n    fill = dem / (rest_capacity + 1e-9)\n    score = regret - 0.5 * immediate + 0.3 * fill * d_dep\n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"65c24bc458d3d6d126910dd2f415942489faed67bc6b0d6fdd359ce6a4f1ed23","elapsed_seconds":0.203,"error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"ac1c5eb0da38470590868dfc23b08c15","generation_parents":[{"algorithm":"Replace the savings-based score with a Clarke-Wright-style savings term (distance to depot minus distance from current node) combined with a capacity-utilization correction, so candidates that fill remaining capacity more fully are favored among close savings ties.","code_sha256":"0a4d0c05a8e14f1bc8ba4dcde2911420167e0