0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    remaining_after = rest_capacity - demands[unvisited_nodes]\n    # product form: penalize both far-from-current and far-from-depot candidates,\n    # scaled by residual capacity slack so fuller vehicles stay local.\n    score = (d_cur * d_dep) / np.maximum(remaining_after, 1e-6)\n    return unvisited_nodes[np.argmin(score)]","code_sha256":"6b0e3240243f006399ce112b2ee9ac1e14fec840eb4c286c6a82b5b59d90b072","elapsed_seconds":0.204,"error_code":null,"error_detail":null,"evaluation_id":"ee8271a69a6145819d165662dc25c636","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/res