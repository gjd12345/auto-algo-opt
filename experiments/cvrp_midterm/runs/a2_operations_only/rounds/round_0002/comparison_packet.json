P greedy construction.\n+\n+    Args:\n+        current_node:    index of the current node (0 = depot)\n+        depot:           index of the depot (always 0)\n+        unvisited_nodes: array of feasible unvisited customer indices\n+                         (already filtered to satisfy remaining capacity)\n+        rest_capacity:   remaining vehicle capacity\n+        demands:         demand of every node (index 0 = depot demand = 0)\n+        distance_matrix: pairwise Euclidean distance matrix\n+    Returns:\n+        Index of the next node to visit, or 0 to return to the depot early.\n+    \"\"\"\n     d_cur = distance_matrix[current_node][unvisited_nodes]\n     d_dep = distance_matrix[depot][unvisited_nodes]\n-    order = np.argsort(d_cur)\n-    # secondary ordering only among near-ties of the primary savings score\n-    savings = d_dep - d_cur\n-    return unvisited_nodes[np.argmax(savings)]+    remaining_after = rest_capacity - demands[unvisited_nodes]\n+    # product form: penalize both far-from-current and far-from-depot candidates,\n+    # scaled by residual capacity slack so fuller vehicles stay local.\n+    score = (d_cur * d_dep) / np.maximum(remaining_after, 1e-6)\n+    return unvisited_nodes[np.argmin(score)]","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":{"candidate_id":"candidate_3","code_sha256":"65c24bc458d3d6d126910dd2f415942489faed67bc6b0d6fdd359ce6a4f1ed23","error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"ac1c5eb0da38470590868dfc23b08c15","generation_parents":[{"algorithm":"Replace the savings-based score with a Clarke-Wright-style savings term (distance to depot minus distance from current node) combined with a capacity-utilization correction, so candidates that fill remaining capacity more fully are favored among close savings ties.","code_sha256":"0a4d0c05a8e14f1bc8ba4dcde2911420167e02f11b1dd1b28fb76d1914e83e8c","p