:"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The shared backbone is a Clarke–Wright-style savings score (depot distance minus current distance); the new algorithm combines this savings term with a capacity-pressure penalty so that, among near-tied savings candidates, it prefers customers whose demand better fits remaining capacity, biasing toward fuller truck utilization.","code_sha256":"60deb4db0121a587e26402521854584b60a248b5c06e583c75555fc959246598","population_member_indices":[2],"selected_parent_position":1}],"instance_objectives":[0.05219164126453933,0.15420366219543552,0.004084937853769301,0.07263295479496717],"lineage_status":"verified","objective":0.07077829902717783,"origin":"generated","revision":"original","source_request_index":23,"valid":true},"objective_delta":0.14980087226008393,"reference":{"candidate_id":"explicit_parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","evaluation_id":"f4c23167162b484da3dfe93203137f9c","instance_objectives":[-0.07096711615848021,-0.032431723698829226,-0.14855556629067174,-0.06413588678364318],"objective":-0.07902257323290608,"origin":"explicit_parent","revision":"original","valid":true},"selection":"largest_absolute_objective_change","source_behavior_effect":{"behavior_reason":"missing_or_incomplete_evidence","behavior_relation":"not_comparable","instance_effect_delta":[0.12315875742301954,0.18663538589426476,0.15264050414444102,0.13676884157861036],"reference_code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","reference_evaluation_id":"f4c23167162b484da3dfe93203137f9c","role":"actual_generation_parent","source_delta":{"candidate_structure":{"functions":["select_next_node"],"node_count":191},"reference_structure":{"functions":["select_next_node"],"node_count":86},"text":"--- actual_generation_parent\n+++ candidate\n@@ -1,9 +1,33 @@\n def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                      rest_capacity: float, demands: np.ndarray,\n                      distance_matrix: np.ndarray) -> int:\n+    \"\"\"Select the next node to visit in a CVRP greedy construction.\n+\n+    Args:\n+        current_node:    index of the current node (0 = depot)\n+        depot:           index of the depot (always 0)\n+        unvisited_nodes: array of feasible unvisited customer indices\n+                         (already filtered to satisfy remaining capacity)\n+        rest_capacity:   remaining vehicle capacity\n+        demands:         demand of every node (index 0 = depot demand = 0)\n+        distance_matrix: pairwise Euclidean distance matrix\n+    Returns:\n+        Index of the next node to visit, or 0 to return to the depot early.\n+    \"\"\"\n     d_cur = distance_matrix[current_node][unvisited_nodes]\n     d_dep = distance_matrix[depot][unvisited_nodes]\n-    order = np.argsort(d_cur)\n-    # secondary ordering only among near-ties of the primary savings score\n     savings = d_dep - d_cur\n-    return unvisited_nodes[np.argmax(savings)]+\n+    cap_denom = rest_capacity if rest_capacity > 1e-9 else 1e-9\n+    fill = demands[unvisited_nodes] / cap_denom\n+\n+    # multiplicative ratio: savings relative to demand pressure\n+    # small-demand customers only win when their savings is proportionally large\n+    ratio = savings / np.maximum(fill, 1e-6)\n+\n+    best = np.max(ratio)\n+    tol = 1e-6 * (abs(best) + 1.0)\n+    near = np.where(ratio >= best - tol)[0]\n+    if near.size > 1:\n+        return unvisited_nodes[near[np.argmin(d_cur[near])]]\n+    return unvisited_nodes[np.argmax(ratio)]","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":{"candidate_id":"candidate_1","code_sha256":"56a5d209b45e705b12bb7041628b4d6649019dfc22a4c9df486f3b987564694d","error_code":"forbidden_attribu