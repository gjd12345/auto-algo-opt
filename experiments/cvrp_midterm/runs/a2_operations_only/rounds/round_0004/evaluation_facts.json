ectives":[0.1053537074516466,0.057026159327467046,-0.09728878884481441,-0.028297073381051863],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.096419091786919,11.122456350662997,11.20059597164825,12.13288628297206],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.009198501138311842,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    savings = d_dep - d_cur\n\n    cap_denom = rest_capacity if rest_capacity > 1e-9 else 1e-9\n    fill = demands[unvisited_nodes] / cap_denom\n\n    # multiplicative ratio: savings relative to demand pressure\n    # small-demand customers only win when their savings is proportionally large\n    ratio = savings / np.maximum(fill, 1e-6)\n\n    best = np.max(ratio)\n    tol = 1e-6 * (abs(best) + 1.0)\n    near = np.where(ratio >= best - tol)[0]\n    if near.size > 1:\n        return unvisited_nodes[near[np.argmin(d_cur[near])]]\n    return unvisited_nodes[np.argmax(ratio)]","code_sha256":"0af7f79463a72de6cda925d3e3615165d16de5aca0b77bc2bbdfc237ffc57e69","elapsed_seconds":0.204,"error_code":null,"error_detail":null,"evaluation_id":"efbbabc9f11042469460d86954fdb01c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The shared backbone is a Clarke–Wright-style savings score (depot distance minus current distance); the new algorithm combines this savings term with a capacity-pressure penalty so that, among near-tied savings candidates, it prefers customers whose demand better fits remaining capacity, biasing toward fuller truck utilization.","code_sha256":"60deb4db0121a587e26402521854584b60a248b5c06e583c75555fc959246598","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.05219164126453933,0.15420366219543552,0.004084937853769301,0.07263295479496717],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.46654587213055,12.144997301402665,12.458413688831705,13.393119756444985],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.07077829902717783,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    alpha = 1.2\n    cap_weight = rest_capacity / (rest_capacity + dem + 1e-9)\n    score = d_cur - alpha * d_dep * cap_weight\n    order = np.argsort(score)\n    best = order[0]\n    # secondary ordering among near-ties of the primary score\n    tie_band = score[best] + 0.05 * d_cur[best]\n    ties = order[score[order] <= tie_band]\n    if ties.size > 1:\n        best = ties[np.argmin(d_cur[ties])]\n    return int(unvisited_nodes[best])","code_sha256":"78fef09b83a383b5b2b4e956bbb1d1d8b0136834b336fc756fbb0067e588e968","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"3b4a286560ea4cfea96bab13670f569c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[-0.044913819205798136,-0.00042564509390205757,-0.084811