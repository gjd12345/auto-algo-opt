299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n    dem = demands[unvisited_nodes]\n    fill_frac = np.clip(dem / cap, 0.0, 1.0)\n    # normalized savings: reward depot-distance advantage per unit of capacity used\n    savings = (d_dep - d_cur) * (0.5 + fill_frac)\n    # primary: savings; secondary: prefer closer nodes among near-ties\n    best_idx = int(np.argmax(savings))\n    best_score = savings[best_idx]\n    tol = 1e-9 + 0.05 * abs(best_score)\n    tie_mask = np.abs(savings - best_score) <= tol\n    if np.count_nonzero(tie_mask) > 1:\n        tie_pos = np.nonzero(tie_mask)[0]\n        return int(unvisited_nodes[tie_pos[np.argmin(d_cur[tie_pos])]])\n    return int(unvisited_nodes[best_idx])","code_sha256":"56a5d209b45e705b12bb7041628b4d6649019dfc22a4c9df486f3b987564694d","elapsed_seconds":0.203,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"ebbdb073f3a74346a4e2cf2d8af96bd1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_20.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    savings = d_dep - d_cur\n    # capacity-pressure term: prefer filling the vehicle's remaining capacity\n    cap_denom = rest_capacity if rest_capacity > 1e-9 else 1e-9\n    fill = demands[unvisited_nodes] / cap_denom  # larger => better utilization\n    score = savings + fill\n    # secondary ordering: among near-tied primary scores, take the closest node\n    best = np.max(score)\n    tol = 1e-6 * (abs(best) + 1.0)\n    near = np.where(score >= best - tol)[0]\n    if near.size > 1:\n        return unvisited_nodes[near[np.argmin(d_cur[near])]]\n    return unvisited_nodes[np.argmax(score)]","code_sha256":"60deb4db0121a587e26402521854584b60a248b5c06e583c75555fc959246598","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"e883a529d2574115a55b2bddb9893073","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position"