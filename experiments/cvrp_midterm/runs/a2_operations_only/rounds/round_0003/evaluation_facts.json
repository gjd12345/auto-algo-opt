-alignment detour penalty: how much extra vs direct depot leg\n    detour = d_cur + d_dep - distance_matrix[current_node][depot]\n    align = 1.0 / (detour + 1.0)\n\n    # capacity slack term: prefer large demand khi capacity is tight\n    slack = dem / (rest_capacity + 1.0)\n\n    score = 0.55 * prox + 0.30 * align + 0.15 * slack\n\n    # tie-break: among near-tied candidates prefer largest demand per unit travel\n    best = np.max(score)\n    near = np.where(score >= best - 1e-9)[0]\n    if near.size > 1:\n        ratio = dem[near] / (d_cur[near] + 1e-9)\n        return int(unvisited_nodes[near[np.argmax(ratio)]])\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"a59bdf8c542358fbb86d5ad33fb456472b023122b184336135d1d0e9bea8bf69","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"07add8ee68e94b06b22524f2a162ce1e","generation_parents":[{"algorithm":"Replace the depot-distance term in the savings score with a capacity-utilization term, scoring candidates by d_dep - d_cur + rest_capacity/(demands+eps)-style fill urgency, keeping distance terms readable and adding a nearest-neighbor tie-break.","code_sha256":"4714d384bbde855dc90a75d3824ae2e28f8e4082440ebfa880bbb4b35008284b","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Replace the depot-distance term in the savings score with a capacity-utilization term, scoring candidates by d_dep - d_cur + rest_capacity/(demands+eps)-style fill urgency, keeping distance terms readable and adding a nearest-neighbor tie-break.","code_sha256":"4714d384bbde855dc90a75d3824ae2e28f8e4082440ebfa880bbb4b35008284b","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_15.json","instance_objectives":[0.14436515735190356,-0.002285419428432502,-0.02973594090586114,-0.021269015537044415],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.558633398237204,10.498355953544035,12.038773394447903,12.220640085369457],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.022768695370141378,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # savings term: how much we save by visiting now vs going depot->node directly\n    d_cur_dep = distance_matrix[current_node][depot]\n    savings = (d_dep + d_cur_dep) - d_cur\n    savings_norm = savings / (d_dep + d_cur_dep + 1.0)\n\n    # depot-alignment detour penalty (kept from base)\n    detour = d_cur + d_dep - d_cur_dep\n    align = 1.0 / (detour + 1.0)\n\n    # capacity slack term (kept from base)\n    slack = dem / (rest_capacity + 1.0)\n\n    score = 0.55 * savings_norm + 0.30 * align + 0.15 * slack\n\n    best = np.max(score)\n    near = np.where(score >= best - 1e-9)[0]\n    if near.size > 1:\n        ratio = dem[near] / (d_cur[near] + 1e-9)\n        return int(unvisited_nodes[near[np.argmax(ratio)]])\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"f88d816631e301d0532615e5c684f971ad8c6c51265dfa4ad77c79f6c3124d33","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"c18cf06793da49e1ae74818b9869eb59","generation_parents":[{"algorithm":"The algorithm selects the next customer by maximizing a composite score combining proximity-normalized current-node closeness, a depot-alignment detour penalty, and a remaining-capacity slack term, then breaks near-ties by preferring the customer with the largest demand-to-travel ratio to encourage fuller loads per route.","code_sha256":"a59bdf8c542358fbb86d5ad33fb456472b023122b184336135d1d0e9bea8bf69","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[0.06686400360737461,0.05974094410209821,-0.14709144953107706,0.08937925676002129],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.640386521519904,11.151022412998191,10.582658059980924,13.602217590604324],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.017223188734604267,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n    # gravity score: pull toward current node, push away from depot,\n    # damped by capacity slack so tighter loads stay compact\n    score = (d_dep + 1e-9) / (d_cur + 1e-9) * (cap / (cap + 1e-9))\n    order = np.argsort(-score)\n    best = order[0]\n    best_score = score[best]\n    tol = 1e-6 * (abs(best_score) + 1e-9)\n    # secondary ordering among near-ties: prefer larger demand (better packing)\n    near = [i for i in order if best_score - score[i] <= tol]\n    if len(near) > 1:\n        best = max(near, key=lambda i: demands[unvisited_nodes[i]])\n    return int(unvisited_nodes[best])","code_sha256":"e9d14a8556aad2b0787a52380a47f5f4080ef918154e30fa196c75bd10bfd437","elapsed_seconds":0.204,"error_code":"forbidden_syntax","error_detail":null,"evaluation_id":"c9388751d98e4303804107dbdd16f1a1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    d_cur_dep = distance_matrix[current_node][depot]\n\n    # squared-detour efficiency proximity term (replaces savings-based term)\n    detour = d_cur + d_dep - d_cur_dep\n    efficiency = 1.0 / (detour * detour / (d_dep + 1.0) + 1.0)\n\n    # depot-alignment detour penalty (kept)\n    align = 1.0 / (detour + 1.0)\n\n    # capacity slack term (kept)\n    slack = dem / (rest_capacity + 1.0)\n\n    score = 0.55 * efficiency + 0.30 * align + 0.15 * slack\n\n    best = np.max(score)\n    near = np.where(score >= best - 1e-9)[0]\n    if near.size > 1:\n        # secondary: prefer demand that best fills remaining capacity\n        fill = -np.abs(rest_capacity - dem[near])\n        return int(unvisited_nodes[near[np.argmax(fill)]])\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"b0c99e4dab7e3a326e2e9229cf4554cfb24ae6ffdfccf05a2e059022d2032367","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"5095b0ebe1de43979b0df45c7afcb28b","generation_parents":[{"algorithm":"Replace the normalized proximity term with a savings-based term (depot distance minus current-leg detour saved) while keeping the depot-alignment penalty and capacity-slack term, then break near-ties by preferring larger demand-to-savings ratio.","code_sha256":"f88d816631e301d0532615e5c684f971ad8c6c51265dfa4ad77c79f6c3124d33","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.0528888480626103,0.1619546203200824,0.004875736779738846,0.048576421617151325],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.47480649708673,12.226556014644022,12.468225707509598,13.092744844099535],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.06707390669489571,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"8ddd89422d2427cffd3104f1a0cefe7fe28e0ed8018eec29c3fd6497cef8c31e"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":15,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":4,"total_evaluation_attemp