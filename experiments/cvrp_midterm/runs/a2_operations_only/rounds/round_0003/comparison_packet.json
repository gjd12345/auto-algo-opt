a CVRP greedy construction.\n+\n+    Args:\n+        current_node:    index of the current node (0 = depot)\n+        depot:           index of the depot (always 0)\n+        unvisited_nodes: array of feasible unvisited customer indices\n+                         (already filtered to satisfy remaining capacity)\n+        rest_capacity:   remaining vehicle capacity\n+        demands:         demand of every node (index 0 = depot demand = 0)\n+        distance_matrix: pairwise Euclidean distance matrix\n+    Returns:\n+        Index of the next node to visit, or 0 to return to the depot early.\n+    \"\"\"\n     d_cur = distance_matrix[current_node][unvisited_nodes]\n     d_dep = distance_matrix[depot][unvisited_nodes]\n-    order = np.argsort(d_cur)\n-    # secondary ordering only among near-ties of the primary savings score\n+    # savings relative to serving the customer from the depot directly\n     savings = d_dep - d_cur\n-    return unvisited_nodes[np.argmax(savings)]+    # capacity term: prefer customers that fill the remaining capacity well\n+    dem = demands[unvisited_nodes]\n+    cap_term = np.where(rest_capacity > 0, dem / (rest_capacity + 1e-9), 0.0)\n+    score = savings + 0.5 * cap_term\n+    # nearest-neighbor tie-break among near-equal primary scores\n+    best = np.max(score)\n+    near = np.where(score >= best - 1e-9)[0]\n+    if near.size > 1:\n+        return int(unvisited_nodes[near[np.argmin(d_cur[near])]])\n+    return int(unvisited_nodes[np.argmax(score)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":{"candidate_id":"candidate_4","code_sha256":"e9d14a8556aad2b0787a52380a47f5f4080ef918154e30fa196c75bd10bfd437","error_code":"forbidden_syntax","evaluation_id":"c9388751d98e4303804107dbdd16f1a1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5762f0bbcfc2fae3eaa994896d2385fdc72c85018489c46e7ceb83af5f8355d4","population_memb