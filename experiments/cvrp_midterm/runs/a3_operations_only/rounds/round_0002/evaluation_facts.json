etour = d_cur / (d_dep + d_cur + 1e-9)\n\n    # Capacity-fill reward: prefer customers that use up more of the\n    # remaining capacity (fewer, fuller routes), capped to avoid dominance.\n    fill = np.minimum(dem / cap, 1.0)\n\n    # Primary score: minimise detour, maximise fill.\n    scores = detour - 0.5 * fill\n\n    best = int(np.argmin(scores))\n    # Second ordering stage: among near-tied candidates, take the closest.\n    cutoff = scores[best] + 0.02 * (abs(float(scores[best])) + 1.0)\n    mask = scores <= cutoff\n    if int(np.sum(mask)) > 1:\n        close = unvisited[mask]\n        close_d = distance_matrix[current_node][close]\n        return int(close[int(np.argmin(close_d))])\n    return int(unvisited[best])","code_sha256":"e68f2c9b374aedb72d84c80ed743848bfa83d58a42150ce36e4ea7970dc7f598","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"90e4d4254ce6411c8bb9fae7fb72912f","generation_parents":[{"algorithm":"Replace the additive score with a ratio-based savings rule: for each candidate compute the Clarke-Wright-style savings of inserting it now, i.e. (d(candidate,depot) - d(current,candidate)) scaled by a capacity-pressure factor, then break near-ties by the larger detour-adjusted radial gap, keeping feasibility unchanged.","code_sha256":"a46eb864f6d827037d7037315e3fd921faa5094677020ab2b80395ab5dee504f","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[0.029667626335743852,0.04684716128018931,-0.02448549817999522,0.017669007287284186],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.199677504884336,11.01534882028138,12.103919464329374,12.706828394645397],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.4