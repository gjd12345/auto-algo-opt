_d = d_cur[close_idx]\n        close_pen = demand_penalty[close_idx]\n        secondary = close_pen + 0.02 * close_d\n        return int(unvisited[close_idx[int(np.argmin(secondary))]])\n    return int(unvisited[best])","code_sha256":"1d63e6eea32336c24ac4831ddee19ddc273ab2167e11e9418ffaccf724c0589a","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"49222b9cc484494e88302dc812d0b142","generation_parents":[{"algorithm":"Replace the demand-discount factor with a normalized-demand penalty based on rest_capacity fraction, keep the Clarke-Wright savings and urgency terms, and use a tighter relative (rather than absolute) second-stage band to break near-ties by smallest d_cur.","code_sha256":"0df8298bccc0b27fd5fe4eb48c18c50e640da6465ae28f1a1bb55949f64ba42b","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.09030665116700405,0.06697811724617952,-0.09346445716360494,0.08475484620698215],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.918139004722565,11.227174873073967,11.248047242324269,13.544476231770481],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.037143789364140194,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    unvisited = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited]\n    d_dep = distance_matrix[depot][unvisited]\n    dem = demands[unvisited]\n\n    cap = max(rest_capacity, 1e-9)\n    fill = np.clip(dem / cap, 0.0, 1.0)\n\n    # Vector from current to each candidate, and from candidate to depot.\n    # Use squared-distance proxies to avoid trigonometry: polar pull toward\n    # the depot direction is approximated by radial decay relative to the\n    # distance the vehicle has already travelled from the depot.\n    travelled = distance_matrix[depot][current_node]\n    denom = d_cur + d_dep + 1e-9\n\n    # Radial term: how much closer to the depot this move brings the vehicle,\n    # normalized by the total leg length (a \"return-home efficiency\").\n    radial = (travelled + d_cur - d_dep) / denom\n\n    # Angular-proxy term: penalize moves that swing far sideways, i.e. where\n    # the sum d_cur + d_dep is much larger than the direct current->depot leg.\n    spread = (d_cur + d_dep - travelled) / (travelled + 1e-9)\n\n    # Capacity-scaled radial weight: when the truck is nearly empty, the\n    # radial (return-home) preference should dominate; when nearly full,\n    # spread (angular) matters more to avoid stranding capacity.\n    load_ratio = 1.0 - fill.mean() if fill.size else 1.0\n    w_radial = 0.5 + 1.5 * load_ratio\n\n    scores = -w_radial * radial + (2.0 - w_radial) * spread + 0.1 * fill\n\n    best = int(np.argmin(scores))\n\n    # Secondary stage: among near-tied candidates, pick the one that would\n    # most reduce the next-hop \"stranded distance\", i.e. min over next hops\n    # of (d_cur + d_next) - a cheap one-step lookahead.\n    span = np.abs(scores[best]) + 0.5\n    cutoff = scores[best] + 0.06 * span\n    close_mask = scores <= cutoff\n    if np.sum(close_mask) > 1:\n        close_idx = np.where(close_mask)[0]\n        candidate_nodes = unvisited[close_idx]\n        lookahead = np.empty(close_idx.size)\n        for k, node in enumerate(candidate_nodes):\n            nbr = np.delete(unvisited, close_idx[k])\n            if nbr.size == 0:\n                lookahead[k] = distance_matrix[node][depot]\n            else:\n                lookahead[k] = distance_matrix[node][depot] + 0.5 * np.min(\n                    distance_matrix[node][nbr] + distance_matrix[nbr][depot]\n                )\n        return int(candidate_nodes[int(np.argmin(lookahead + 0.02 * d_cur[close_idx]))])\n    return int(unvisited[best])","code_sha256":"ff70b6584eede9ad5048b457d5e3d63bcc2b960bf409552b7c99f16d3708f7ba","elapsed_seconds":0.204,"error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"f985f781c6374e3bbd51c7e584de930f","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"a46eb864f6d827037d7037315e3fd921faa5094677020ab2b80395ab5dee504f","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the multiplicative demand-penalty factor with an additive normalized-demand penalty inside the Clarke-Wright savings score (savings/urgency kept), and use a secondary stage that reorders near-tied candidates by the additive penalty plus small d_cur term instead of pure smallest d_cur.","code_sha256":"1d63e6eea32336c24ac4831ddee19ddc273ab2167e11e9418ffaccf724c0589a","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited]\n    d_dep = distance_matrix[depot][unvisited]\n    dem = demands[unvisited]\n\n    cap = max(rest_capacity, 1e-9)\n    total_cap = cap\n    fill = cap / (total_cap + 1e-9)\n    urgency = fill * fill\n\n    reward = (d_dep * (1.0 + dem / (cap + 1e-9))) / (d_cur + 1e-9)\n    scores = -reward * urgency * (1.0 + dem / (cap + 1e-9))\n\n    order = np.argsort(scores)\n    best = order[0]\n    cutoff = scores[best] + 0.01 * (np.abs(scores[best]) + 1.0)\n    close = unvisited[scores <= cutoff]\n    if close.size > 1:\n        close_d = distance_matrix[current_node][close]\n        return int(close[np.argmin(close_d)])\n    return int(unvisited[best])","code_sha256":"9db4322bf3b16b0b2d7f96f005d825c2501dd382e34e5140efb6d2759d9cc2a4","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"036db47101fe462982ad31248e578356","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"a46eb864f6d827037d7037315e3fd921faa5094677020ab2b80395ab5dee504f","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[0.07462172201050321,0.04313568550825907,-0.07459092074558021,-0.029040185672347868],"lineage_status":"verified","metrics":{"fitness_definitio