# cost of inserting this node = distance from current + detour to depot,\n    # minus a reward for serving far customers, plus a convex penalty for\n    # consuming a large fraction of the remaining capacity.\n    insert_cost = d_cur + 0.5 * d_dep\n    far_reward = 0.6 * d_dep\n    cap_penalty = (fill * fill) * (0.5 * cap + 1.0)\n\n    scores = insert_cost - far_reward + cap_penalty\n\n    best = int(np.argmin(scores))\n\n    # Second ordering stage: near-tie band resolved by a composite of\n    # nearest-neighbor distance and depot proximity (depot-closeness helps\n    # preserve possibility of a short return leg).\n    span = np.abs(scores[best]) + 1.0\n    cutoff = scores[best] + 0.06 * span\n    close_mask = scores <= cutoff\n    if np.sum(close_mask) > 1:\n        close = unvisited[close_mask]\n        close_d = distance_matrix[current_node][close]\n        close_dep = distance_matrix[depot][close]\n        secondary = close_d + 0.25 * close_dep\n        return int(close[np.argmin(secondary)])\n    return int(unvisited[best])","code_sha256":"56c9f91159397d0ba924f11f2babf4a1b673f8f509c92522d68c62a22c44e25e","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"0d58500bfa7f4853866c3ea8f5035819","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"a46eb864f6d827037d7037315e3fd921faa5094677020ab2b80395ab5dee504f","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the demand-discount factor with a normalized-demand penalty based on rest_capacity fraction, keep the Clarke-Wright savings and urgency terms, and use a tighter relative (rather than absolute) second-stage band to break near-ties by smallest d_cur.","code_sha256":"0df8298bccc0b27fd5fe4eb48c18c50e640da6465ae28f1a1bb55949f64ba42b","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[0.32745427160321383,0.36607722916953