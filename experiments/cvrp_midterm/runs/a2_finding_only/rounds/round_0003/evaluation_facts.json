(dem / total_dem, 0.0, 1.0)\n\n    pressure = 1.0 + fill * fill + share\n\n    score = detour / pressure\n\n    return int(idx[np.argmin(score)])","code_sha256":"8fb4b501a5831c56304ebb4d293839353afb7d40fdbbbf65fc6eb5e88cc1791e","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"88941490f06d47f9acefef7c8238edb3","generation_parents":[{"algorithm":"The heuristic scores each candidate by the detour it induces relative to its projection onto the depot ray, penalizing large demand and low residual capacity via a multiplicative feasibility factor rather than additive weighted terms, so the selection is a product of geometric opportunity and load pressure instead of a linear sum.","code_sha256":"f1a23fe6411a4e3d8f9e4fa37dddaa5bcb2c56f26ff2145fb4fb16d5b56507e1","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.07622508546725976,-0.014808768114643787,-0.05443298301043996,0.09959765488181699],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.751298214639586,10.366580218480731,11.732339191693088,13.729806649986154],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.02664524730599825,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"b4ffe436b1c547efdd5eec4bdb0e62f9881e9f93e2973fd046b1dfe8243d9356"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":15,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_ree