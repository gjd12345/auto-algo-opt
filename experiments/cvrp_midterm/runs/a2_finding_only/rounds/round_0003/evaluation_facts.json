urrent -> depot directly then depot -> candidate.\n    saving = d_cur_dep + d_dep - d_cur\n\n    # Normalise demand to (0,1] to form a savings-per-demand density.\n    safe_dem = np.maximum(dem, 1e-9)\n    density = saving / safe_dem\n\n    # Load-balancing: penalise candidates whose residual capacity after\n    # service would be large relative to remaining capacity (over-serving\n    # too early leaves awkward leftover), and also penalise tiny demand\n    # usage that wastes the remaining trip.\n    new_rest = np.maximum(cap - dem, 0.0)\n    leftover_frac = new_rest / (cap + 1e-12)\n    # Prefer moderate leftover: a mild U-shape around ~0.25 of capacity.\n    balance = (leftover_frac - 0.25) ** 2\n\n    # Combined score: maximise density, minimise imbalance.\n    score = -density + 1.5 * balance\n    return int(idx[np.argmin(score)])","code_sha256":"7dc34600cb426406fce03022bb44a4d2610613f248025f11521cb63c6e78d483","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"feaa9bc8643340538ed2804b82422203","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"33340f20741dbc5e214e7a04e1dfaf7a64587db34a4cb038d8246cac5664ed12","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"33340f20741dbc5e214e7a04e1dfaf7a64587db34a4cb038d8246cac5664ed12","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.4499669124146329,0.424607434839697,0.2820838561474015,0.36209476564927967],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[17.17945507052729,14.990295056572656,15.907748898015166,17.007400559919162],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486