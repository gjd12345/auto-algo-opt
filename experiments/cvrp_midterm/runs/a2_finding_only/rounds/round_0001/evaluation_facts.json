:\n        span = 1.0\n\n    d_cur = dm[current_node][idx]\n    d_dep = dm[depot][idx]\n    dem = demands[idx]\n\n    # Normalised terms; d_dep/span is small for near-depot customers\n    # (which are cheaper to defer to the end of a route).\n    travel = d_cur / span\n    depot_term = d_dep / span\n\n    cap = float(rest_capacity)\n    if cap > 0.0:\n        load_fill = dem / cap\n    else:\n        load_fill = np.zeros_like(dem, dtype=np.float64)\n\n    # Lower priority = chosen. Reward near-depot deferral via depot_term,\n    # mildly favour larger demands to pack the route.\n    score = travel + 0.30 * depot_term - 0.10 * load_fill\n\n    return int(idx[np.argmin(score)])","code_sha256":"08f18861cb16ee2014d1ccc5a4adc360a53546bd7eb06283fe6b2dc469b5ce4b","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"ca2e528b28d547c0a72383bbab1c1e6a","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[-0.04903706858908609,-0.0277741248004607,0.010551177169125658,0.06393503603356657],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.267170867164575,10.230153496647729,12.538645033177824,13.284515720849663],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.000581245046713641,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Scale-invariant normalization of distances by instance distance span\n    span = float(np.max(distance_matrix))\n    if span <= 0 or not np.isfinite(span):\n        span = 1.0\n\n    # Capacity fit: prefer demands that fill remaining capacity well\n    # (high utilization) but penalize oversized relative to remaining.\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    util = np.clip(dem / cap, 0.0, 1.0)\n\n    # Score: near current, moderate depot pull, encourage good capacity fill.\n    # Weights chosen to keep nominal-scale regression near zero while\n    # favoring filling capacity to reduce number of routes.\n    score = (d_cur / span) + 0.35 * (d_dep / span) * (1.0 - util) - 0.25 * util\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"e34dc33d034e772a07f65cf3e507e436beba3eb24bac8cc0ed56c3786150b9e7","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"cf9036b77a1e4e1c9022b5fce1581391","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[0.0515060675261046,0.05214838268133915,-0.03144517429083307,-0.0030179447081781353],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.458423077647359,11.071130413876949,12.017565690001843,12.448526778764114],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.017297832802108136,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round