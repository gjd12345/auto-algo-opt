route instead of running it round-trip from the depot.\n    savings = d_dep - 0.5 * (d_cur + distance_matrix[unvisited_nodes][depot] * 0.0 + d_dep)\n    # (pure savings reduces to d_dep - 0.5*(d_cur + d_dep) = 0.5*(d_dep - d_cur))\n    savings = 0.5 * (d_dep - d_cur)\n\n    # Capacity pressure: prefer customers whose demand roughly matches the\n    # remaining capacity so the vehicle is filled well.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = dem / cap  # in (0, 1]; 1 means exactly fills remaining capacity\n\n    # Normalise each component into a comparable range.\n    d_cur_n = (d_cur - np.min(d_cur)) / span_cur\n    d_dep_n = (d_dep - np.min(d_dep)) / span_dep\n    savings_n = (savings - np.min(savings)) / (float(np.max(savings) - np.min(savings)) or 1.0)\n\n    score = 0.55 * d_cur_n - 0.25 * d_dep_n - 0.15 * savings_n - 0.15 * fill\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"e1ba8121d7e8b6fffe60b3c4d61b4d6584b16d40a73f83733721e405364edc44","elapsed_seconds":0.234,"error_code":"candidate_error","error_detail":null,"evaluation_id":"f0889396f46e44288c74ad6308af0b2d","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    total_demand = float(np.sum(demands))\n    if total_demand <= 0:\n 