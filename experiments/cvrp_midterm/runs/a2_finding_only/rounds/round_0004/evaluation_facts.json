n\n    d_dep = dm[depot][idx] / span\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        return depot\n\n    dem = demands[idx].astype(np.float64)\n    util = np.clip(dem / (cap + 1e-12), 0.0, 1.0)\n\n    # Lexicographic rank: bucket candidates by utilisation band so that\n    # the vehicle is packed as tightly as possible before distance matters.\n    # Bands are scale-free because util is already a ratio in [0, 1].\n    n_bands = 4\n    band = np.minimum((util * n_bands).astype(np.int64), n_bands - 1)\n\n    # Within a band, prefer near candidates that also pull us depot-ward\n    # (saving is the fraction of the two-leg distance the step removes).\n    saving = (d_dep - d_cur) / (d_cur + d_dep + 1e-12)\n    local_cost = d_cur - 0.35 * saving\n\n    # Scan bands from most-utilised to least; take the best local_cost\n    # among the tightest non-empty band.\n    best = None\n    best_cost = float(\"inf\")\n    for b in range(n_bands - 1, -1, -1):\n        mask = band == b\n        if not np.any(mask):\n            continue\n        cand_idx = idx[mask]\n        costs = local_cost[mask]\n        j = int(np.argmin(costs))\n        if costs[j] < best_cost:\n            best_cost = float(costs[j])\n            best = int(cand_idx[j])\n        break\n\n    return best if best is not None else int(idx[np.argmin(d_cur)])","code_sha256":"9fd1b6d69e561d9b010c535749c4abcda8e868a18e99aba5e4d14fee88711ce8","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"e7c69da31b9545f2aa216118a65a77ec","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"33340f20741dbc5e214e7a04e1dfaf7a64587db34a4cb038d8246cac5664ed12","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The common backbone is a span-normalised additive priority score blending nearest-neighbour distance, depot-return saving, and capacity utilisation; the new algorithm instead uses a multiplicative/geometric composite that rewards candidates close to the current node and far from the depot while penalising wasted residual capacity, dropping the additive linear form entirely.","code_sha256":"2ed73bafc32342ab8ab0e5d8bba8e91f2e2993a585b338e96876da3879cd3599","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.4536797421718783,0.2653091059711942,0.3552019627732002,0.382507735531967],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[17.2234453102031,13.314093674100928,16.814978541789557,17.2622811777497],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.36417463661205995,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    dm = distance_matrix\n    idx = unvisited_nodes\n\n    span = float(np.max(dm))\n    if not np.isfinite(span) or span <= 0.0:\n        span = 1.0\n\n    d_cur = dm[current_node][idx] / span\n    d_dep = dm[depot][idx] / span\n\n    cap = float(rest_capacity)\n    dem = demands[idx].astype(np.float64)\n\n    # Fill ratio: how much of the remaining capacity this candidate uses.\n    fill = np.clip(dem / (cap + 1e-12), 0.0, 1.0)\n\n    # Depot pull: candidates far from depot are penalized more, scale free.\n    depot_pull = d_dep * d_dep\n\n    # Return-incentive: prefer moving toward the depot when it is a short hop.\n    toward = np.clip(d_cur - d_dep, 0.0, None) / span\n\n    score = (1.00 * d_cur\n             + 0.35 * depot_pull\n             - 0.25 * fill\n             - 0.15 * toward)\n\n    return int(idx[np.argmin(score)])","code_sha256":"a26ba3f0a45d96affbf386f9809fe148705df7172fcc719df9d58c512ee4e79f","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"f3ebb539ce694126a7e096f9e34ea714","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"33340f20741dbc5e214e7a04e1dfaf7a64587db34a4cb038d8246cac5664ed12","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[0.04076449668682626,-0.011418468399837869,-0.11087572127912351,0.005245564853308632],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.331155115847483,10.402254321965158,11.032012997591647,12.551706690094244],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.019071032034706625,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0004/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"de8a3cfa1de80764fc8d58098fcbb56877717e94c75f75ac85cd076dd642fe1a"},"dual_budget":{"baseline_attempts":4,"novel_candidate_evaluations":20,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":6,"total_evaluation_attempts":30},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:f5ca126a614040299fc7a4eec744642a","evaluation:644ae6bf70d24f2490fb3006f7704259