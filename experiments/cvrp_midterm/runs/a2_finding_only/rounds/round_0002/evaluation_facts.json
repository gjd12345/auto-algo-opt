:\n        span = 1.0\n\n    d_cur = dm[current_node][idx]\n    d_dep = dm[depot][idx]\n    dem = demands[idx]\n\n    travel = d_cur / span            # local move cost\n    depot_term = d_dep / span        # defer near-depot customers\n\n    cap = float(rest_capacity)\n    if cap > 0.0:\n        load_fill = dem / cap\n        cap_pressure = (dem / cap) ** 2\n    else:\n        load_fill = np.zeros_like(dem, dtype=np.float64)\n        cap_pressure = np.zeros_like(dem, dtype=np.float64)\n\n    # Stronger demand packing and depot deferral than the parent rule,\n    # plus a quadratic capacity-pressure term to avoid leaving usable\n    # capacity stranded late in a route.\n    score = travel + 0.45 * depot_term - 0.35 * load_fill - 0.20 * cap_pressure\n\n    return int(idx[np.argmin(score)])","code_sha256":"18257a9e813acd10e904aa985cc441a8496ea44e35da078d8d1078c266b0dfa5","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"7c42eb816d2f49be80076ce84099959b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"08f18861cb16ee2014d1ccc5a4adc360a53546bd7eb06283fe6b2dc469b5ce4b","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.22519095449927992,0.10342526703757372,-0.06526536056917472,0.03054245658442059],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.516271216551665,11.610686510022273,11.597933987738132,12.867568979152264],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.0734733293880249,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    dm = distance_matrix\n    idx = unvisited_nodes\n\n    span = float(np.max(dm))\n    if not np.isfinite(span) or span <= 0.0:\n        span = 1.0\n\n    d_cur = dm[current_node][idx] / span\n    d_dep = dm[depot][idx] / span\n\n    cap = float(rest_capacity)\n    dem = demands[idx]\n    if cap > 0.0:\n        load_fill = dem / cap\n    else:\n        load_fill = np.zeros_like(dem, dtype=np.float64)\n\n    eps = 1e-12\n    savings = d_dep - d_cur\n    savings_term = savings / (d_cur + d_dep + eps)\n\n    new_rest = cap - dem\n    frag = np.maximum(new_rest, 0.0) / (cap + eps)\n\n    # Rebalanced weights: stronger savings pull, weaker fragmentation,\n    # moderate demand preference, slightly lighter nearest-neighbour weight.\n    score = (0.85 * d_cur\n             - 0.55 * savings_term\n             - 0.20 * load_fill\n             + 0.04 * frag)\n\n    return int(idx[np.argmin(score)])","code_sha256":"3c46b7bdef558cc76b6c808ccc9da8e4b94503b26dfc3c271c9739aa544ee1b3","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id