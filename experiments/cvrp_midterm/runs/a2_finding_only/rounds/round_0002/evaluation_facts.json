istance_matrix\n    idx = unvisited_nodes\n\n    span = float(np.max(dm))\n    if not np.isfinite(span) or span <= 0.0:\n        span = 1.0\n\n    d_cur = dm[current_node][idx] / span\n    d_dep = dm[depot][idx] / span\n\n    cap = float(rest_capacity)\n    dem = demands[idx].astype(np.float64)\n\n    # Tightness of residual capacity after serving the candidate:\n    # prefer candidates that leave a small leftover relative to the\n    # current remaining capacity (no absolute-length term; scale free).\n    new_rest = np.maximum(cap - dem, 0.0)\n    tightness = 1.0 - new_rest / (cap + 1e-12)\n\n    # Utilisation: fraction of the current load this candidate consumes.\n    util = np.clip(dem / (cap + 1e-12), 0.0, 1.0)\n\n    # Depot-return alignment: how much closer to the depot this step\n    # moves us, normalised by the total path length to the candidate.\n    saving = (d_dep - d_cur) / (d_cur + d_dep + 1e-12)\n\n    # Weighted score: nearest-neighbour dominant, with a positive pull\n    # toward tight capacity use and a mild depot-return preference.\n    score = (1.00 * d_cur\n             - 0.30 * saving\n             - 0.20 * util\n             - 0.10 * tightness)\n\n    return int(idx[np.argmin(score)])","code_sha256":"33340f20741dbc5e214e7a04e1dfaf7a64587db34a4cb038d8246cac5664ed12","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"cf3f2f7871054fcd9a8086958d35dcea","generation_parents":[{"algorithm":"Combine nearest-neighbour travel with a \"savings\" term that rewards customers whose insertion direction aligns with the depot-return vector and penalises residual-capacity fragmentation, scoring candidates by a multi-term geometric priority rather than a pure distance-plus-demand blend.","code_sha256":"815ae10ba19a2037d059bd1256f5814152b390ca0ff8081941759af0c0de740b","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives"