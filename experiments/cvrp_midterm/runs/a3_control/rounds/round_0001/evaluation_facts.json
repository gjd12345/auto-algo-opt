                      (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Encourage filling the vehicle when capacity is tight, while still\n    # preferring nearby nodes that do not stray too far from the depot.\n    load_ratio = np.clip(dem / (rest_capacity + 1e-9), 0.0, 1.0)\n\n    # Lower score is better: near current node, near depot, high demand fill.\n    score = 1.0 * d_cur + 0.3 * d_depot - 0.5 * load_ratio * np.maximum(d_cur, 1.0)\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"8edb1bbe40363d0b3bf8076202fc1f33387371f9ebe53c7c4dc6cf1f37630d3b","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"8891fa5a04754d77a02937b3062c1078","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.1376020046011343,-0.02270901562591936,-0.02829746945516767,0.11401235140307105],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.478502411921477,10.283450621991365,12.056621558220401,13.909791570176182],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.05015196773077958,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a2