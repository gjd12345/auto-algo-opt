                               - (d_cur[mask] + distance_matrix[current_node][others] * 0.0)))\n        else:\n            follow = 0.0\n            alt_savings = 0.0\n\n        # Incremental detour cost vs. going straight to depot afterwards\n        detour = d_cur[i] + follow - d_depot[i]\n\n        # Capacity slack pressure: low remaining capacity -> prefer small demands\n        slack = max(rest_capacity - dem[i], 0.0) / cap\n        fill = dem[i] / cap\n        slack_pen = (slack ** 2) * 0.0 + (1.0 - slack) * 0.0\n        # Density: prefer fills that use remaining capacity well without overflowing\n        density = fill * (1.0 - 0.35 * fill)\n\n        # Demand-weighted proximity: closer customers weighted by their size\n        proximity = (mean_cur - d_cur[i]) / scale\n\n        # Lookahead: prefer nodes whose departure is cheap relative to depot return\n        depart_gain = (d_depot[i] - follow) / scale\n\n        # Combined multiplicative/additive blend\n        base = (proximity * 1.0) + (depart_gain * 0.5) + (density * 0.45)\n        penalty = (detour / scale) * (0.6 + 0.4 * fill)\n        score = base - penalty\n\n        if best_score is None or score > best_score:\n            best_score = score\n            best_idx = int(node_i)\n\n    return best_idx","code_sha256":"fe7e82371d08bdd44d9fd14fcbbdf6334fb20c712cbd91cc57e2c2777ac1c792","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"8e248b3118ea439d8febdb5b7173d01e","generation_parents":[{"algorithm":"For each candidate I compute a savings term from inserting it now versus serving it later from the depot, then combine a normalized nearest-neighbor distance, remaining-capacity slack penalty, and a demand-aware depot-return cost into a single additive priority that favors customers whose immediate service saves the most detour while keeping the route balanced.","code_sha256":"e5e78bb7d28c457c4e2b917fe036ccecab5b71a20f2dbb027fbe519b9ff9f094","population_member_indices":[2],"