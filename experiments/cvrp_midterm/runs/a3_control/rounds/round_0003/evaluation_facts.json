       rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = rest_capacity if rest_capacity > 1e-9 else 1.0\n\n    # Regret / look-ahead: how much we save by not returning to depot yet\n    return_saving = d_cur + d_depot - distance_matrix[depot][depot]\n    # Efficiency of serving this customer relative to capacity left\n    demand_eff = dem / cap\n    # Prefer nodes that are close now but also close to depot (cheap return later),\n    # weighted by their demand efficiency.\n    score = d_cur + 0.30 * d_depot - 0.50 * demand_eff * return_saving\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"0fa924052c77886f2f854c41ec70630c88d61504e7fb4c741880a3cda587149a","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"f629ec5bfada44feadc5899eceb96b67","generation_parents":[{"algorithm":"Use a nearest-neighbor priority that blends current-node distance with a milder depot-distance penalty and a demand-fill bonus weighted by a squared load ratio to prefer high-demand customers when capacity is tight.","code_sha256":"e3a18aebbd7cc9bb59b912fb5710d5ba6180e552162f7224fee9e6cd9559af55","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Use a nearest-neighbor priority that blends current-node distance with a milder depot-distance penalty and a demand-fill bonus weighted by a squared load ratio to prefer high-demand customers when capacity is tight.","code_sha256":"e3a18aebbd7cc9bb59b912fb5710d5ba6180e552162f7224fee9e6cd9559af55","population_member_