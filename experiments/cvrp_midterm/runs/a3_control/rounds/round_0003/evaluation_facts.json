lse:\n            follow_cost = 0.0\n\n        # Regret: how much worse to go via depot than via a follow-up trip\n        depot_cost = d_depot[i] + float(distance_matrix[depot][node_i])\n        # Extra distance if we serve this node now instead of a direct return\n        detour = d_cur[i] + follow_cost - d_depot[i]\n        if detour < 0:\n            detour = 0.0\n\n        fill = dem[i] / cap  # 0..1, fill ratio\n\n        # Combined priority: prefer high fill and small detour, penalize\n        # nodes that are far from depot (leaving them stranded is costly).\n        urgency = 1.0 / (1.0 + depot_cost)\n        score = (fill + 0.5) * urgency - 0.3 * detour / (1.0 + d_cur[i] + d_depot[i])\n\n        if best_score is None or score > best_score:\n            best_score = score\n            best_idx = int(node_i)\n\n    return best_idx","code_sha256":"50955dbe9a0482f1e9f63303471f670875e2a87a1a46f3fa302c1ca97a639430","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"322a2c40de1f4fa3b1cb1dd12b1c4465","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d5c2e70ebaa21e020ccdabc351dd20973e5d24f73214eca03fb7190376054973","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"d5c2e70ebaa21e020ccdabc351dd20973e5d24f73214eca03fb7190376054973","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_15.json","instance_objectives":[0.49879885088420833,0.6319944663587833,0.5166544332259121,0.5727635976208979],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[17.75802419907919,17.172505199065455,18.818237023371022,19.637855724412592],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12