e:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = rest_capacity if rest_capacity > 1e-9 else 1.0\n    load_ratio = dem / cap  # fraction of remaining capacity used\n\n    eps = 1e-6\n    savings = d_cur + d_depot  # detour cost via current node\n    score = (d_cur * d_depot + eps) / (savings * (1.0 + load_ratio) + eps)\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"c95f87ef2037ecfee15ab6658cc4d4110281de9f624daaaaca3acd75166ed98c","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"9cfaf43b53ee4ccf84854ff9b72a0e65","generation_parents":[{"algorithm":"Replace the squared load-ratio penalty on the current distance with a combined score that weights current distance positively, subtracts a scaled depot-distance savings term, and applies a linear (not squared) load-ratio penalty with a larger coefficient, aiming to prefer closer nodes with fuller loads while still accounting for proximity to depot.","code_sha256":"672df7de963613f6095bd46b6eaca5dd2eaa1939f1cd1564608407ba5d4d49d2","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.06012692377183936,-0.01925513368736642,-0.0092708444006