de (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    cap = rest_capacity if rest_capacity > 1e-9 else 1.0\n    load_ratio = dem / cap\n\n    score = d_cur - 0.25 * d_depot * (1.0 - load_ratio) + 0.60 * load_ratio * d_cur\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"672df7de963613f6095bd46b6eaca5dd2eaa1939f1cd1564608407ba5d4d49d2","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"65a39d577c7c446eb3b1f14fb4eff210","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"e3a18aebbd7cc9bb59b912fb5710d5ba6180e552162f7224fee9e6cd9559af55","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_20.json","instance_objectives":[-0.019782637358508673,-0.011806879815808862,-0.027770594137648576,-0.011678033684497132],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.61378235370022,10.39816730010471,12.063158884317652,12.340395093789471],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.017759536249115