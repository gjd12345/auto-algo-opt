_dep = np.argsort(np.argsort(d_depot)).astype(np.float64)\n    # Higher load ratio is better -> invert ranking\n    rank_load = np.argsort(np.argsort(-load_ratio)).astype(np.float64)\n\n    denom = float(n) if n > 1 else 1.0\n    score = (0.55 * rank_cur + 0.30 * rank_dep + 0.15 * rank_load) / denom\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"4379eef2c6630cc6e8caa9f7d21ae397c92e81095f6adb7daaa9801f4a50f07f","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"91677de0f93f4a9e9bc0c8524b5b3a8a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"e3a18aebbd7cc9bb59b912fb5710d5ba6180e552162f7224fee9e6cd9559af55","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Use a multiplicative geometric score that normalizes current distance by a depot-distance-based savings factor and divides by a linear load-fill term, preferring near customers whose inclusion also leaves the route close to the depot and consumes a substantial share of remaining capacity.","code_sha256":"c95f87ef2037ecfee15ab6658cc4d4110281de9f624daaaaca3acd75166ed98c","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.33248179491370744,0.1882725035220133,0.2383943768139802,0.24926067689783327],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.787471377463813,12.503483415704338,15.365661683213528,15.598530492575083],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.25210233803688353,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","