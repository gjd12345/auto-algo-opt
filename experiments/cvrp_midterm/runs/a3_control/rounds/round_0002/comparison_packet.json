ce_matrix: pairwise Euclidean distance matrix\n-    Returns:\n-        Index of the next node to visit, or 0 to return to the depot early.\n-    \"\"\"\n+    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n     if unvisited_nodes.size == 0:\n         return depot\n     d_cur = distance_matrix[current_node][unvisited_nodes]\n     d_depot = distance_matrix[depot][unvisited_nodes]\n     dem = demands[unvisited_nodes]\n-    # Normalize demand relative to remaining capacity (load-aware)\n     cap = rest_capacity if rest_capacity > 1e-9 else 1.0\n-    load_ratio = dem / cap\n-    # Priority: favor near-current, near-depot, higher-demand (to fill truck)\n-    score = d_cur - 0.25 * d_depot - 0.5 * load_ratio * d_cur\n+    # Savings: closing the triangle current->customer->depot\n+    savings = d_cur + d_depot - distance_matrix[depot][current_node]\n+    # Geometric: prefer customers that extend the route far from depot while\n+    # staying close to the current node (elongation ratio)\n+    elong = d_depot / (d_cur + 1e-9)\n+    # Load pressure: fill the truck rather than leaving slack\n+    load = dem / cap\n+    # Multiplicative score; lower is better\n+    score = (d_cur * (1.0 + 0.5 * load)) / (savings + 1e-6) - 0.3 * elong * load\n     idx = int(np.argmin(score))\n     return int(unvisited_nodes[idx])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"f8092865437f27e880f05986c110ee5bba08a0b6abe1d055ca3d83a23c640ac4","evaluation_id":"0486cf32c8344d35a1618f97014ced46","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","popu