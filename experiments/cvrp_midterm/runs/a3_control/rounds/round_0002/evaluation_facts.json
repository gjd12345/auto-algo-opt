 node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    # Savings-style score: prefer customers far from depot (high savings) and close to current\n    score = d_cur - 0.7 * d_dep + 0.15 * dem\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"f928fcb524cbd08e4a136583d92a319f7351156a1b8b9c4223a0e49ef2dca913","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"d1d5f5627587452a98baf6942e33f68e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[0.2731641034818589,0.3235765480727144,0.1735087104506542,0.07782505095907556],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.084665260913315,13.927207243448427,14.56057792629778,13.457949356730923],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.21201860324107574,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"49ca94c273aaa532bb8c587ec044f527dcf03aeb4d31569cce554cae897f5b2f"},"dual_budget":{"baseline_attempts":2,"novel_candidate_evalu