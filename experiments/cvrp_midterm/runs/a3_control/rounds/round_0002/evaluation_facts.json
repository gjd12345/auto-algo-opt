apacity shrinks\n    depot_w = 1.0 + (1.0 - min(rest_capacity / (cap + 1e-9), 1.0))\n    score = d_cur + 0.15 * depot_w * d_dep + 0.3 * load_ratio * d_cur\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"f8092865437f27e880f05986c110ee5bba08a0b6abe1d055ca3d83a23c640ac4","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"0486cf32c8344d35a1618f97014ced46","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[-0.030154801583928085,0.09336955688844648,0.00010622693629474144,0.013187711991051903],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.490891184412787,11.50487626472073,12.409046922446262,12.65087400288619],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.019127173557966257,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    # Normalize demand relative to remaining capacity (load-aware)\n    cap = rest_capacity if rest_capacity > 1e-9 else 1.0\n    load_ratio = dem / cap\n    # Priority: favor near-current, near-depot, higher-demand (to fill truck)\n    score = d_cur - 0.25 * d_depot - 0.5 * load_ratio * d_cur\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"d5c2e70ebaa21e020ccdabc351dd20973e5d24f73214eca03fb7190376054973","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"c7368f06148e45d0908d23dca1242073","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[-0.07119788798566166,0.05542434265778802,-0.04133953983439853,-0.1374072527064432],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.004605702477098,11.105601388434243,11.894799084824252,10.77051372876363],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.04863008446717884,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 1e-9 else 1.0\n    # Savings: closing the triangle current->customer->depot\n    savings = d_cur + d_depot - distance_matrix[depot][current_node]\n    # Geometric: prefer customers that extend the route far from depot while\n    # staying close to the current node (elongation ratio)\n    elong = d_depot / (d_cur + 1e-9)\n    # Load pressure: fill the truck rather than leaving slack\n    load = dem / cap\n    # Multiplicative score; lower is better\n    score = (d_cur * (1.0 + 0.5 * load)) / (savings + 1e-6) - 0.3 * elong * load\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"05dfca5ca2d33b9a6bca946f81665f2955b6a7be9f38b033f10f35df469cb59b","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"4b44b7e7fc9749369d4e66badbbb64dd","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Combine travel distance, depot proximity, demand magnitude and remaining capacity into a weighted priority score, then pick the unvisited customer with the minimum score to balance route compactness and load utilization.","code_sha256":"d5c2e70ebaa21e020ccdabc351dd20973e5d24f73214eca03fb7190376054973","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[0.7002257355850726,0.9787697148475168,0.5878725183654329,0.6680030626755367],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[20.144564254639604,20.82141448174609,19.701891715663404,20.82703563475793],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.7337177578683898,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n    load_ratio = dem / cap\n    # stronger capacity pressure: encourages consolidation when nearing full\n    fill = min(rest_capacity / (cap + 1e-9), 1.0)\n    depot_w = 1.0 + 2.0 * (1.0 - fill)\n    # weight demand contribution more heavily; emphasize proximity to depot as load grows\n    score = d_cur + 0.35 * depot_w * d_dep + 0.7 * load_ratio * d_cur - 0.1 * dem\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"6a0f5e0e5806f64861787bd1567fc7684d01a2fcd78e3bc27cd8bd1b742ea981","elapsed_seconds