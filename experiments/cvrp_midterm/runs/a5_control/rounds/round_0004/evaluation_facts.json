turn int(unvisited_nodes[np.argmin(score)])","code_sha256":"3b89c3ba7ef55b26446faa9733437f259263566c3183a0b516c0a8c64d4d00c8","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"72de0fbcf8f5447ca58910512d01718f","generation_parents":null,"generation_request_ref":null,"instance_objectives":[0.012146232273341596,-0.019139308785043725,-0.10889342056560451,-0.09597623793113572],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.992081042171423,10.32101251974758,11.05660884741833,11.287830057742914],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.05296568375211059,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    current_node = int(current_node)\n    depot = int(depot)\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=int)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    demand = demands[unvisited_nodes].astype(float)\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[depot][unvisited_nodes].astype(float)\n    d_depot_cur = float(distance_matrix[depot][current_node])\n\n    cap = float(rest_capacity)\n    fill = demand / cap if cap > 0.0 else np.zeros_like(demand)\n\n    # Normalize distances to make combination scale-free.\n    max_depot = float(np.max(d_depot)) if d_depot.size > 0 else 1.0\n    if max_depot <= 0.0:\n        max_depot = 1.0\n    far_norm = d_depot / max_depot  # in [0, 1]\n\n    # Multiplicative interaction: nearby AND far-from-depot is rewarded.\n    proximity = d_cur / (1.0 + 0.8 * far_norm)\n\n    # Strongly discourage moves that head back inward toward the depot while\n    # capacity is still available.\n    inward = np.maximum(d_depot_cur - d_depot, 0.0)\n    inward_norm = inward / max_depot\n\n    # Quadratic penalty for tiny fills (wasteful stops) plus a mild reward\n    # for substantial fills.\n    low_fill_penalty = (1.0 - fill) * d_cur if cap > 0.0 else np.zeros_like(d_cur)\n\n    score = (\n        proximity\n        + 0.9 * inward_norm * d_cur\n        - 0.25 * d_cur * far_norm\n        + 0.15 * low_fill_penalty\n    )\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"d22e3a7262df5a1222c2d7c2e2689be26fc4e05952aeacfe9032e9a5fda16c3e","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"acfd3b804fa149f08e75adff7c54b89d","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"3b89c3ba7ef55b26446faa9733437f259263566c3183a0b516c0a8c64d4d00c8","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_20.json","instance_objectives":[-0.007786440500351438,-0.03770888440284241,-0.131979986794098,-0.07138083501188533],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.755915338375514,10.125615941870347,10.770156992713712,11.594933410556182],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0622140366772943,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    current_node = int(current_node)\n    depot = int(depot)\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=int)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = float(rest_capacity)\n    fill = dem / cap if cap > 0.0 else np.zeros_like(dem)\n\n    # Margin-based priority: reward customers whose depot distance exceeds the\n    # detour cost, scaled by how well they fill the vehicle. This is a\n    # ratio/dominance construction rather than an additive weighted sum.\n    detour = d_cur + d_depot\n    margin = d_depot * (0.5 + fill) - 0.5 * detour\n\n    # Lexicographic tie-break: among high-margin candidates prefer nearest.\n    best_margin = float(np.max(margin))\n    tol = 0.35 * max(1.0, abs(best_margin))\n    near_best = np.where(margin >= best_margin - tol)[0]\n    if near_best.size == 0:\n        return int(unvisited_nodes[int(np.argmax(margin))])\n\n    choice = near_best[int(np.argmin(d_cur[near_best]))]\n    return int(unvisited_nodes[int(choice)])","code_sha256":"c5dc3684320aa8732f6c12f97c43be5ec353035d20cd627dfe94bc282ab0745c","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"49736477e8ac4a92b73d564df85b3a1c","generation_parents":[{"algorithm":"This variant replaces the additive fill-reward and inward terms with a multiplicative depot-distance-weighted proximity score plus a stronger load-balance term, so far-from-depot customers are prioritized primarily when the