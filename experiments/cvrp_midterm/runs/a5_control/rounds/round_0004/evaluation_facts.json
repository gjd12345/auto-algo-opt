max_depot = float(np.max(d_depot)) if d_depot.size > 0 else 1.0\n    if max_depot <= 0.0:\n        max_depot = 1.0\n    far_norm = d_depot / max_depot\n\n    # Clarke-Wright style savings from extending current -> customer.\n    savings = d_depot_cur + d_depot - d_cur\n    savings_norm = savings / max_depot\n\n    # Reward far-from-depot customers modestly, but only when the extension\n    # yields real savings; penalize going back inward toward the depot.\n    inward = np.maximum(d_depot_cur - d_depot, 0.0) / max_depot\n\n    # Load-balance term: prefer customers that fill the vehicle well.\n    load_bonus = fill * (0.5 + 0.5 * far_norm)\n\n    score = (\n        -1.0 * savings_norm\n        + 0.45 * d_cur / max_depot\n        - 0.30 * far_norm * (1.0 - fill)\n        + 0.20 * inward * d_cur / max_depot\n        - 0.55 * load_bonus\n    )\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"ae3913941e3b0e9917582bf5283310254dad641ef4cb1909721517eefa9593d5","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"71eb6238b5e04cacbd679c9356ad4701","generation_parents":[{"algorithm":"This variant replaces the additive fill-reward and inward terms with a multiplicative depot-distance-weighted proximity score plus a stronger load-balance term, so far-from-depot customers are prioritized primarily when they also fill the vehicle well.","code_sha256":"d22e3a7262df5a1222c2d7c2e2689be26fc4e05952aeacfe9032e9a5fda16c3e","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[-0.12554781242923804,0.001965750673270913,-0.0653833411602708,-0.04642085489144844],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[10.360658535772393,10.543088483082872,11.596470116549835,11.906588950670924],"reference_kind":["solver_reference","solver_referenc