rox = 1.0 - d_cur / (dmax_cur + eps) if dmax_cur > eps else np.ones_like(d_cur)\n\n    # Urgency to serve far-from-depot customers: larger depot distance => higher.\n    dmax_depot = d_depot.max()\n    far = d_depot / (dmax_depot + eps) if dmax_depot > eps else np.zeros_like(d_depot)\n\n    # Capacity utilization preference: prefer larger demand chunks when capacity tight.\n    tightness = 1.0 - cap\n    if tightness < 0.0:\n        tightness = 0.0\n    fill = demand / (cap + eps)\n\n    # Multiplicative blend of proximity and urgency, weighted by fill.\n    score = prox * (1.0 + 0.5 * far + 0.3 * fill + 0.4 * tightness * fill)\n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"cfeb8f00ea9a8363e3605d91265f13c0e678125a8471df7668e12307e8cf2219","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"45445e23fda44704b2dc1cfea9adbe27","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"3b89c3ba7ef55b26446faa9733437f259263566c3183a0b516c0a8c64d4d00c8","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[-0.01848289791288127,-0.006845576179489644,-0.04899523711961469,-0.10924144047502932],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.62918188814364,10.450372141631485,11.79980926846513,11.12219796013705],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.04589128792175373,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    current_node = int(current_node)\n    depot = int(depot)\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=int)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cap = float(rest_capacity)\n    if cap <= 0.0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n    demand = demands[unvisited_nodes].astype(float)\n\n    # Clarke-Wright style savings: benefit of linking current -> node -> depot\n    # instead of current -> depot plus node -> depot separately.\n    savings = d_cur_dep + d_dep - d_cur\n\n    # Fill ratio in [0,1]; larger chunks reduce route count pressure.\n    fill = np.clip(demand / (cap + 1e-12), 0.0, 1.0)\n\n    # Urgency: far-from-depot and high-fill customers are cheaper to merge now.\n    urgency = 1.0 + fill\n\n    # Composite benefit to maximize.\n    benefit = savings * urgency\n\n    return int(unvisited_nodes[np.argmax(benefit)])","code_sha256":"be08ba32f445d88da42ccf21623a7e46b5a8d8144dde7c7cc1684684909612e5","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"9e6dc8ceb04842bca304ca8270c7bfdf","generation_parents":[{"algorithm":"This variant replaces the additive fill-reward and inward terms with a multiplicative depot-distance-weighted proximity score plus a stronger load-balance term, so far-from-depot customers are prioritized primarily when they also fill the vehicle well.","code_sha256":"d22e3a7262df5a1222c2d7c2e2689be26fc4e05952aeacfe9032e9a5fda16c3e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the linear penalty score with a normalized, multiplicative priority that bala