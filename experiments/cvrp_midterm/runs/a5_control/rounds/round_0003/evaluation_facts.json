(the \"later\" cost\n    # is approximated by pure depot round-trip, scaled by remaining slack).\n    slack = np.maximum(cap - demand, 0.0) / max(cap, 1e-9)\n    regret = savings / (slack + 1e-6)\n\n    # Slight preference for larger fill when regrets tie, to reduce leftover waste.\n    fill = demand / max(cap, 1e-9)\n\n    score = regret + 0.05 * fill\n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"9ac0ce716da2720ce4418c4a28ce75c6306250963b8a77af13ab7ec7109c5e50","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"4c7f2e5750d64f609755a30613664475","generation_parents":[{"algorithm":"Score each feasible customer by a weighted blend of its direct distance from the current node, its depot proximity (favoring customers far from the depot early to lock in long-haul stops), and its demand fill ratio, using a radial-progress factor to discourage backtracking toward the depot.","code_sha256":"3b89c3ba7ef55b26446faa9733437f259263566c3183a0b516c0a8c64d4d00c8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Score each feasible customer by a weighted blend of its direct distance from the current node, its depot proximity (favoring customers far from the depot early to lock in long-haul stops), and its demand fill ratio, using a radial-progress factor to discourage backtracking toward the depot.","code_sha256":"3b89c3ba7ef55b26446faa9733437f259263566c3183a0b516c0a8c64d4d00c8","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.025009614749507015,0.14695275770857955,0.04954764698138371,0.19002163749687712],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.144488589827999,12.068700354589925,13.022502658174787,14.858859437898765],"reference_kind":["solver_reference","solver_reference","solver_