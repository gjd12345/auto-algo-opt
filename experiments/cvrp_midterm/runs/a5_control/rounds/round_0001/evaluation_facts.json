visited_nodes, dtype=int)\n    demand = demands[unvisited_nodes].astype(float)\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    # Balance routes: prefer customers that fill the remaining capacity well,\n    # but strongly penalize long detours from the current position.\n    cap = float(rest_capacity)\n    fill = demand / cap if cap > 0.0 else np.zeros_like(demand)\n\n    # Score: minimize distance to customer, encourage substantial demand delivery,\n    # and mildly prefer customers closer to the depot (good route closing).\n    score = d_cur + 0.25 * d_depot - 0.5 * d_cur * fill\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"685dfddaca927ea0742a5643591b91c94a20517a11dcd449e09ccf782a427f98","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"9129dc1a1e734cd4a85dffe79b973864","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[-0.061190620237248215,-0.030020766085048632,-0.033940925324133,-0.033822849077992205],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.123173516122106,10.20651342927293,11.98659908781016,12.063890290143812],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.039743790181105514,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n    # Weighted score: prefer near current node, near depot, and high demand\n    score = d_cur + 0.3 * d_dep - 0.5 * dem\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"9618ad176bfe6242e9d6bb103ec88805906539d778240c17bd7f028cdd22e50a","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"913d01594df8447893fb7a4c83255acd","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[0.4790048750033415,0.4949202340105583,0.4461982996573113,0.499500474753029],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[17.523501799705148,15.730154740053354,17.94403641959596,18.723077025963903],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.47990597085606,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Normalise load pressure: closer to full remaining capacity -> stronger penalty on depot proximity\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    load_pressure = np.clip(dem / cap, 0.0, 1.0)\n\n    # Reward far-from-depot nodes when load pressure is high (fill up route before returning)\n    score = d_cur - 0.35 * d_dep * (0.5 + load_pressure)\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"23ad7846ea4c1bfc69175a1acc3a0aadd34b13e3a5720420ab07cb9938784a2a","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"89a4c5d661cb4e95826b1e98088c58c7","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[-0.00023510426329118983,-0.02899081003099461,-0.012706969966253728,-0.11480459182015795],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.845384856953,10.217351043037953,12.250064249098308,11.052735287136501],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03918436902017437,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Normalize roughly to avoid domination by large distances.\n    dc_max = np.max(d_cur)\n    dd_max = np.max(d_dep)\n    cap = rest_capacity\n    if cap <= 0:\n        return 0\n\n    # Reward filling the vehicle: higher demand is slightly preferred when it fits.\n    fill = dem / cap\n\n    # Score: nearest neighbor dominant, slight depot closeness effect,\n    # and load-fill preference. Lower is better.\n    score = d_cur + 0.15 * d_dep - 0.25 * (dc_max + 1.0) * fill\n\n    # Early return if nearest remaining customer is disproportionately far future work.\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"82df571abd1546c40709f0c29471bf6a17ad8c230232d0b524b4f0f9f4555454","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"56d60db930734027b68ee18ecab7304a","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.1486299363927527,0.012180301002977935,-0.021534471113274944,0.0010486692289601353],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.609163227084114,10.650570108945473,12.140535008112678,12.499303372210967],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.035081108877853956,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Normalize by capacity usage so load term scales with remaining capacity\n    cap_scale = max(rest_capacity, 1e-9)\n\n    score = d_cur + 0.35 * d_depot - 0.6 * (dem / cap_scale) * float(np.mean(d_cur) + 1e-9)\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"bb76265526d780412ae73acbed46e8bc2d1ace6c164aaebc1da6da47e08c0275","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"270f43bb08a04dac907f04c737b39a76","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[0.02638202827609069,-0.002285419428432502,-0.04672549068700144,-0.03938072662034311],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.160749179167148,10.498355953544035,11.82