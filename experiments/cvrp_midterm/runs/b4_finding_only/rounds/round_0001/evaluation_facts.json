0.234,"error_code":null,"error_detail":null,"evaluation_id":"606f19dd127a4e9090b1000256f6289c","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[0.12719812054151103,0.23779920074108818,0.013282138311089431,-0.014956678674458216],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.355235420632946,13.024623335611473,12.57253005862939,12.299457245671789],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.0908306952298076,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Scale-free proximity: closeness to current node relative to the\n    # depot detour scale (d_cur + d_dep). Value in [0, 1]-ish, invariant\n    # to uniform rescaling of the distance matrix.\n    denom = d_cur + d_dep\n    denom = np.where(denom > 0, denom, 1.0)\n    proximity = d_dep / denom  # small when current node is \"on the way\"\n\n    # Load-utilization: prefer customers whose demand fills the remaining\n    # capacity well (relative term, scale-free w.r.t. capacity units).\n    if rest_capacity > 0:\n        load_fill = demands[unvisited_nodes] / rest_capacity\n    else:\n        load_fill = np.zeros_like(d_cur, dtype=float)\n    load_fill = np.clip(load_fill, 0.0, 1.0)\n\n    # Combine: primarily proximity, secondarily load fill.\n    # Both components are dimensionless, so the rule survives\n    # re-expression of the instance at a different scale.\n    score = proximity - 0.25 * load_fill\n\n    best_idx = int(np.argmin(score))\n    return int(unvisited_nodes[best_idx])","code_sha256":"af749502f9a65110089a499e5822d9de6fe9acc41c9010c1998f1e977f592f06","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"3c419406086e4262b61e54c2843ce19d","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[1.9717689623247696,1.9330895214317863,1.9333379327563134,2.0022826312697455],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[35.210025091694405,30.863153089293974,36.39606180482589,37.487129817838344],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":1.9601197619456534,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Scale-invariant load ratio in [0,1]: how much of remaining capacity this node consumes.\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    load_ratio = dem / cap\n\n    # Primary: nearest distance. Secondary: prefer customers whose depot distance is\n    # small relative to the current leg (saves a long deadhead back) and that fill\n    # capacity well. Both secondary terms are dimensionless multipliers, so the\n    # rule is invariant to re-expression of the distance scale.\n    depot_rel = d_dep / (d_cur + 1e-9)\n\n    score = d_cur * (1.0 + 0.3 * depot_rel - 0.2 * load_ratio)\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"fcbb4c03e7fc99873e6967446065bee0cabacf0729a4f8e20bd2dd0cb8d1046f","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"d07162c62e87406c88c1afe35f3a1110","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[-0.008654080106910364,0.23703617907089922,-0.03549991722785388,-0.01718650814325659],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.745635396460518,13.016594513291043,11.967255538931107,12.271615127845216],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.043923918398219595,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node]\n    dep = distance_matrix[depot]\n\n    # Extra distance incurred by inserting the customer on the current leg\n    # instead of heading straight back to the depot.\n    detour = cur[unvisited_nodes] + dep[unvisited_nodes] - cur[depot]\n\n    # Relative demand pressure: prefer low-demand customers now so that\n    # heavy customers are pushed to fresh (full-capacity) loads.\n    dem = demands[unvisited_nodes]\n    total_dem = float(np.sum(dem)) if np.sum(dem) > 0 else 1.0\n    load_frac = dem / total_dem\n\n    # Normalised detour so absolute scale does not dominate.\n    scale = float(np.max(detour)) if np.max(detour) > 0 else 1.0\n    score = detour / scale + load_frac\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"3621d33d44f466a27afc07bb4b117da1d3ef581cb72b0bd434779f5a29c0c2b7","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"9456ca21a5504ab891b1a997715406bd","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.04575042188601192,0.1388736397479649,0.10666144139734236,-0.010176861117397115],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.390229207270561,11.98368861095818,13.731155135019854,12.35913904891073],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.07027716047848051,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Scale reference: max depot distance keeps the rule invariant under\n    # re-expression of the instance (e.g. scaling all distances by 1e-3).\n    scale = float(np.max(distance_matrix[depot])) if distance_matrix.size else 1.0\n    if scale <= 0.0:\n        scale = 1.0\n\n    # Capacity pressure: prefer larger-demand customers when capacity is tight\n    # so leftover capacity is smaller and fewer routes are needed; keep this\n    # term dimensionless and comparable in magnitude to the normalized distance.\n    cap = float(rest_capacity) if rest_capacity > 0.0 else 1.0\n    load_pressure = dem / cap  # in [0, 1]\n\n    # Priority: nearest-neighbor distance, nudged by depot proximity and load.\n    # All terms are normalized by `scale` or dimensionless, preserving\n    # scale invariance of the argmin.\n    score = (d_cur / scale) + 0.15 * (d_dep / scale) - 0.25 * load_pressure\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"1a983cd2775b19da834351006923908b39c89908da6f4d65869141f9193c5b9c","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"d04492248090459cb54b5f85