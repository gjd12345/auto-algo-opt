p.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    scale = float(np.max(distance_matrix[depot])) if distance_matrix.size else 1.0\n    if scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity) if rest_capacity > 0.0 else 1.0\n    fill = dem / cap\n    # saturating fill factor in (0,1]\n    fill_factor = fill / (1.0 + fill)\n\n    # Multiplicative savings-style primary score.\n    primary = (d_cur / scale) * (1.0 + 0.45 * (d_dep / scale)) * (1.0 - 0.5 * fill_factor)\n\n    best = float(np.min(primary))\n    band = abs(best) * 0.03 + 1e-6\n    in_band = primary <= best + band\n\n    # Narrow tie-break: prefer larger demand and slightly shorter detour.\n    secondary = np.where(in_band, -0.85 * fill_factor + 0.08 * (d_cur / scale), np.inf)\n\n    return int(unvisited_nodes[np.argmin(secondary)])","code_sha256":"14dd6a73cd105aa712861c6d157623c6d35f0df4342f090083b5abd46669faa6","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"fe0ae14d785446edb964d123f6b56173","generation_parents":[{"algorithm":"Replace the reference's cubic load-pressure bonus and 3% secondary band with a stronger normalized-distance-plus-depot term and a relative-width tie-break band driven by a squared load-pressure term, yielding a distinct distance/depot/load priority mix.","code_sha256":"a48fecf44d7854d393a0af511f5521b6170b0cfb64fc952e11bbc26ea7b6fc45","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[-0.020192535194232402,-0.022540547795746043,-0.0344