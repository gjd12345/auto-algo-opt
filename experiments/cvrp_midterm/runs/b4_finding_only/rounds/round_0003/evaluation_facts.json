pot proximity moderates, packing pulls toward fuller loads.\n    primary = (d_cur / scale) * 1.0 + 0.30 * (d_dep / scale) - 0.55 * pack_factor\n\n    best = float(np.min(primary))\n    band = abs(best) * 0.025 + 1e-6\n    in_band = primary <= best + band\n\n    # Narrow tie-break within band: larger demand, shorter detour, near depot.\n    secondary = np.where(\n        in_band,\n        -0.90 * pack_factor + 0.10 * (d_cur / scale) + 0.05 * (d_dep / scale),\n        np.inf,\n    )\n\n    return int(unvisited_nodes[np.argmin(secondary)])","code_sha256":"0073a6adb451a6bd7e2242c6cc97d2b1e8b2109856026ded969a9e4a192fba2b","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"fb44d6ea2f2c4f20bee15c4093593765","generation_parents":[{"algorithm":"Replace the squared-load bonus and banded secondary rule with a multiplicative savings-style score combining current distance, depot proximity, and a saturating load-fill factor, followed by a narrow absolute relative band whose tie-break prefers high demand and short detour, yielding a distinct distance/depot/load priority mix.","code_sha256":"14dd6a73cd105aa712861c6d157623c6d35f0df4342f090083b5abd46669faa6","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.1690273712518673,0.05043838134194102,-0.11685731069673377,0.003929526166579611],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.850835511269286,11.05313708884029,10.957795057782077,12.535274355383024],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.026634492015913534,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430