nvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    scale = float(np.max(distance_matrix[depot])) if distance_matrix.size else 1.0\n    if scale <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity) if rest_capacity > 0.0 else 1.0\n    load_pressure = dem / cap\n\n    # Primary score: nearest-neighbor with slight depot-return bias.\n    primary = (d_cur / scale) + 0.10 * (d_dep / scale)\n\n    # Second stage: only act within a relative band of the best primary score.\n    best_primary = float(np.min(primary))\n    band = 0.05 * (1.0 + abs(best_primary))\n    in_band = primary <= best_primary + band\n\n    # Within the band, prefer larger demand (reduces leftover capacity).\n    score = np.where(in_band, primary - 0.20 * load_pressure, primary)\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"6e40f42725f74b744e4a6285c7ce2c4e2a042457b17c73c002f2f74152f76bfa","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"80d33e37b2ef4887b0d62263b65277b3","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"1a983cd2775b19da834351006923908b39c89908da6f4d65869141f9193c5b9c","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[0.08510530401106027,-0.011626154607274248,-0.01986623381970762,-0.000667390711263457],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.85651255724526,10.400068963772778,12.161234044171145,12.47787628833674],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.013236381218203738,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011