t_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cur_dep = distance_matrix[current_node][depot]\n    dem = demands[unvisited_nodes].astype(float)\n\n    scale = float(np.max(distance_matrix[depot])) if distance_matrix.size else 1.0\n    if scale <= 0.0:\n        scale = 1.0\n\n    low = np.minimum(d_cur, d_dep)\n    high = np.maximum(d_cur, d_dep)\n    safe_low = np.where(low > 0.0, low, 1.0)\n    cos_angle = (d_cur_dep * d_cur_dep + safe_low * safe_low - high * high) / (2.0 * d_cur_dep * safe_low + 1e-12)\n    cos_angle = np.clip(cos_angle, -1.0, 1.0)\n    angle = np.arccos(cos_angle)\n\n    detour = (d_cur + d_dep - d_cur_dep) / scale + 0.05 * angle\n\n    cap = float(rest_capacity) if rest_capacity > 0.0 else 1.0\n    tightness = 1.0 - cap / max(cap + float(np.sum(dem)), 1e-9)\n    load_term = dem / cap\n\n    score = detour / (load_term + 0.1) - 0.1 * tightness * load_term\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"8f654664c6d84ee3859418c818d8876bf260abc130429710b1c804ec9f869e0f","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"1081a16f034d46f58f1d71a708d0e3fd","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"1a983cd2775b19da834351006923908b39c89908da6f4d65869141f9193c5b9c","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"1a983cd2775b19da834351006923908b39c89908da6f4d65869141f9193c5b9c","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","