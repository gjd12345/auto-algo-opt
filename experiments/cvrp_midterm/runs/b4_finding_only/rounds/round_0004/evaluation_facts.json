e <= 0.0:\n        scale = 1.0\n\n    cap = float(rest_capacity) if rest_capacity > 0.0 else 1.0\n    load_frac = dem / cap\n\n    detour = 2.0 * (d_cur / scale)\n    depot_pull = d_dep / scale\n\n    # Stronger load-fill and depot-pull weighting than the parent.\n    primary = detour * (1.0 - 0.55 * load_frac) - 0.35 * depot_pull\n\n    best = float(np.min(primary))\n    band = max(abs(best), 1e-9) * 0.08 + 1e-9\n    in_band = primary <= best + band\n\n    # Tie-break: favor nodes close to depot plus high remaining demand.\n    secondary = np.where(in_band, depot_pull - 0.9 * load_frac, np.inf)\n\n    return int(unvisited_nodes[np.argmin(secondary)])","code_sha256":"30f61f2cf152884b6187d0cacaa1b2b1cfe240872b833515a06b8726cd90e690","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"264b00d13ad947919b98b5ed3615541a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"92b31f34fe0222867061cf4ccd7f54138f0a417d94374356e4772d89d9990ad5","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[-0.00470458600332117,0.002510655006903611,0.015608779585494996,-0.136168221862851],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.792429675642332,10.548822186655519,12.601398392780496,10.785984527414723],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03068834331844339,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0004/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"