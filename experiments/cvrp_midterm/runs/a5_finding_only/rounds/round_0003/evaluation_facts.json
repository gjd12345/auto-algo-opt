ds[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-12\n    load_frac = np.clip(dem / cap, 0.0, 1.0)\n\n    # Scale-invariant savings ratio: how much of a detour current->c saves vs depot->c\n    # savings_ratio in (-inf, 1], 1 means c lies on the depot->current ray extension\n    denom = np.maximum(d_cur + d_dep, 1e-12)\n    savings_ratio = (d_dep - d_cur) / denom  # in [-1, 1]\n\n    # Capacity fill factor: prefer candidates whose demand nearly fills remaining cap.\n    # Use (1 - load_frac) so a full-fit candidate (load_frac ~ 1) drives factor toward 0.\n    fill = 1.0 - load_frac  # in [0, 1]\n\n    # Dimensionless score: base unit-distance (divide out by d_cur + d_dep),\n    # then discount by savings_ratio and penalize by fill factor.\n    # score = normalized distance * (1 - savings_ratio) * (1 + fill)\n    # All terms dimensionless -> invariant to instance scale.\n    base = d_cur / denom  # in [0, 1]\n    score = base * (1.0 - savings_ratio) * (1.0 + fill)\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"46f080a6526a143f6e3f4e730f695e322b1e16869f71320d1707ef15797e4a56","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"627e2db706ca483d9a4a98f19f5c7ef3","generation_parents":[{"algorithm":"For each candidate I form a savings-like score that discounts the direct current→candidate distance by the candidate's proximity to the depot and by its slack fit to remaining capacity, then pick the customer whose discounted distance is smallest, so the rule combines a Clarke-Wright-style \"how much would a depot detour cost\" term with a capacity-fill term instead of using a normalized per-step blend of proximity, angle continuation and demand packing.","code_sha256":"3a2a53ba50102eea688aa4835692c3e37777751c96670ab0416368130cdb1532","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[0.1380426457845833,0.06879059205738094,-0.06623110002862823,-0.10197664811559498],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.483723203753671,11.246246465386394,11.58595135434935,11.212907679282505],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.009656372424435261,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_to_depot = distance_matrix[unvisited_nodes, depot].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = float(rest_capacity) + 1e-9\n    cap_scale = cap if cap > 1e-6 else 1.0\n\n    # Lookahead: insertion cost now + best possible return cost afterwards.\n    # After serving candidate i, remaining = cap - dem[i]; the return cost is\n    # approximated by the depot distance from i (tour continues then returns).\n    insertion = d_cur + d_to_depot\n\n    # Load-aware urgency: when remaining capacity is tight relative to the\n    # average demand, prefer candidates that use capacity efficiently.\n    total_dem = float(np.sum(dem)) if len(dem) > 0 else 0.0\n    mean_dem = total_dem / max(len(dem), 1)\n    if mean_dem > 1e-9:\n        fill_ratio = dem / mean_dem\n    else:\n        fill_ratio = np.ones_like(dem)\n    tightness = max(0.0, 1.0 - cap_scale / max(total_dem, 1e-9))\n\n    # Scale-invariant proximity term.\n    mean_ins = float(np.mean(insertion)) if len(insertion) > 0 else 1.0\n    if mean_ins <= 1e-12:\n        mean_ins = 1.0\n    ins_norm = insertion / mean_ins\n\n    # Reward candidates whose depot distance is small relative to their\n    # insertion cost (i.e. cheap to close the loop) and pack well when tight.\n    loop_balance = d_to_depot / (insertion + 1e-12)\n\n    score = ins_norm + 0.35 * loop_balance - (0.25 + 0.35 * tightness) * fill_ratio\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"7802de73c37e5b6eef5ce75543d5805dec7c40162f546bfcdd79cd4d543684d9","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"b7f7db400f3946b98c08442f47c98ba2","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"4736ec893d48cb32ba42445b369e8001b89d290c50c0aea62e34c9784408c433","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"4736ec893d48cb32ba42445b369e8001b89d290c50c0aea62e34c9784408c433","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.3267255370451082,0.45281939310009495,0.26308852685096257,0.32860987374405076],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.719270253299339,15.287152680718542,15.672060001977682,16.589301185558554],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.34281083268505413,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-9\n\n    # relative quantities (scale-invariant)\n    scale = d_cur + d_dep + 1e-9\n    near_frac = d_cur / scale          # how close to current node (0..1)\n    depot_frac = d_dep / scale         # how close to depot (0..1)\n\n    # capacity fill: prefer candidates whose demand fits snugly (low residual after serving)\n    residual_frac = np.clip((cap - dem) / cap, 0.0, 1.0)\n\n    # combine: prioritize proximity to current node, moderately penalize depot pull,\n    # and penalize leaving a large relative residual capacity\n    score = 1.0 * near_frac + 0.35 * depot_frac + 0.9 * residual_frac\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"df4e24c3751d79ff877d9a3b5db391b9149fe5dd50e694541b39edea2913029e","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"fff96ac6f05f47a08e7cf674dbd13ad3","generation_parents":[{"algorithm":"For each candidate I form a savings-like score that discounts the direct current→candidate distance by the candidate's proximity to the depot and by its slack fit to remaining capacity, then pick the customer whose discounted distance is smallest, so the rule combines a Clarke-Wright-style \"how much would a depot detour cost\" term with a capacity-fill term instead of using a normalized per-step blend of proximity, angle continuation and demand packing.","code_sha256":"3a2a53ba50102eea688aa4835692c3e37777751c96670ab0416368130cdb1532","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.22622701191607153,0.23486677629371586,0.1802217025518757,0.10291300942879904],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.52854660138277,12.993767180700162,14.64387091231313,13.771202861322298],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.18605712504761554,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"95a30bd80f8a1c0d09525f5de0a0c987a370c025c7cfdc7fc05af0aefe4c5d3d"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":15,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":4,"total_evaluation_attempts":22},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluat