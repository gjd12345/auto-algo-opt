[unvisited_nodes].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n\n    # Relative insertion cost normalised by the direct return chord.\n    # Keeps only the relative part -> scale-invariant.\n    denom = d_cur_dep if d_cur_dep > 1e-12 else 1.0\n    elong = (d_cur + d_dep) / denom - 1.0\n\n    # Depot pull: normalise by row scale so it stays relative.\n    scale = float(np.mean(d_dep)) if len(d_dep) > 0 else 1.0\n    if scale <= 1e-12:\n        scale = 1.0\n    far_pull = d_dep / scale\n\n    # Capacity packing reward: relative demand fraction of remaining capacity.\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-9\n    load_frac = dem / cap\n\n    score = elong - 0.55 * far_pull - 0.85 * load_frac\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"55965bc493d4489c4c3a7ba6ffa6b67ef5748b1761f7adacfb1eaa0e393a73e8","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"c493b9191ca14cfab46d2b477c3a24c2","generation_parents":[{"algorithm":"Score each candidate by its incremental cost of insertion as a \"detour\" arc measured against the direct depot-return chord, penalising routes that would strand far customers by inflating their future depot distance, and reward demand packing — a route-elongation/regret hybrid rather than a direction-following greedy.","code_sha256":"2a613cc08b81be440f2cd7ede39e57aa22bae73656af7cf9c69a6605f87de5ce","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.047968417170013954,0.17994897258280274,0.09297126280779716,0.021819021578956727],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.41650839336916,12.415899859954246,13.561291110660413,12.758646342388717],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.08567691853489263,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n    mean_dep = float(np.mean(d_dep)) if len(d_dep) > 0 else 1.0\n    if mean_dep <= 0:\n        mean_dep = 1.0\n    rel_dep = d_dep / mean_dep\n    load_frac = dem / (float(rest_capacity) + 1e-9)\n    score = d_cur - 0.25 * d_dep + 0.6 * mean_dep * load_frac * rel_dep\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"904f4af646e84e6bf025692ecf590ebbda2ba4c5bb68cf4428ac28323f4b0012","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"175fdeb91534492aa9eeb4c613d44759","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"9412548cd88a85f20e64b1e692807952558acc225b95c0923b504c0c3a2c6005","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[-0.07282966486932313,0.01201219072699121,-0.016038973305412096,-0.020702238986089146],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[10.985272131884578,10.648801184694866,12.208721655014052,12.22771697610655],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.52