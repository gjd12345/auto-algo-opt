6bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    # Direction vectors in the metric (distance matrix) sense:\n    # \"depot direction\" seen from current node vs candidate direction.\n    # Approximate cos of angle at current node using distances.\n    cur_to_dep = distance_matrix[current_node][depot]\n    # Law of cosines: cos(angle at current between depot and candidate)\n    # side a = d_cur (current->cand), side b = cur_to_dep (current->depot)\n    # side c = d_dep (depot->cand)\n    a = d_cur\n    b = float(cur_to_dep)\n    c = d_dep\n    denom = 2.0 * a * b + 1e-12\n    cos_angle = (a * a + b * b - c * c) / denom\n    cos_angle = np.clip(cos_angle, -1.0, 1.0)\n\n    # Prefer continuing away from depot (cos close to -1 means straight away\n    # from depot direction). Map to a \"continuation\" reward in [-1, 1].\n    continuation = -cos_angle  # +1 straight away from depot, -1 back to depot\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity) + 1e-9\n    load_frac = dem / cap\n\n    # Scale-invariant score: mix of proximity, continuation, and packing.\n    # Normalize d_cur by its mean to keep scale invariance.\n    mean_dcur = float(np.mean(d_cur)) if len(d_cur) > 0 else 1.0\n    if mean_dcur <= 0:\n        mean_dcur = 1.0\n    near = d_cur / mean_dcur\n\n    # Reward high demand early while capacity is plentiful, mild penalty otherwise.\n    pack = load_frac * (1.0 + 0.5 * load_frac)\n\n    score = 1.0 * near - 0.6 * continuation - 0.35 * pack\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"4736ec893d48cb32ba42445b369e8001b89d290c50c0aea62e34c9784408c433","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"b3d3af02bf5547dbbd176e127a058f2a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"9412548cd88a85f20e64b1e692807952558acc225b95c0923b504c0c3a2c6005","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"9412548cd88a85f20e64b1e692807952558acc225b95c0923b504c0c3a2c6005","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[-0.0028801998064826037,-0.034214612705404476,-0.11243556891808029,-0.08443482971016694],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.814045314200376,10.16238408056697,11.012658830981788,11.431938498352032],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.05849130278503358,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35