x[current_node][best]\n    home_leg = distance_matrix[current_node][depot]\n    if home_leg > 0.0 and cur_leg > home_leg:\n        return int(depot)\n\n    return int(best)","code_sha256":"ffd5aa60045d99a1547e48bc2a2824c3f51052b62da9d26bce59f8b7ca63d6ab","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"c452820aa3ca4506b16388e3012869e0","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.10220777774731908,0.09543544010479399,0.003348805689230721,-0.06696358690125481],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.059145580544838,11.52661432266436,12.4492799605088,11.650088095740093],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.033507109160022246,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n    total_dep = float(np.mean(d_dep)) if len(d_dep) > 0 else 1.0\n    if total_dep <= 0:\n        total_dep = 1.0\n    # scale-invariant relative terms\n    rel_dep = d_dep / total_dep\n    load_frac = dem / (float(rest_capacity) + 1e-9)\n    # savings-style closeness: nearer current node is better; also reward\n    # customers that are relatively far from depot (harder to serve later)\n    score = d_cur - 0.5 * d_dep + 0.3 * total_dep * load_frac\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"9412548cd88a85f20e64b1e692807952558acc225b95c0923b504c0c3a2c6005","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"58aeaffe4f134d3ebeba85df4f43291a","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[0.04344266268724196,-0.06227915069007896,-0.12817052931257808,-0.039495966823641156],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.362886483012915,9.867077672128914,10.817423708352566,11.993054553631863],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.046625746034764055,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0001/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"b750161af4aa1ddec48aede679a66b65e3f36acef6df84c78529a129e99082b9"},"dual_budget":{"b