ity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited].astype(np.float64)\n    dep = distance_matrix[depot][unvisited].astype(np.float64)\n\n    scale = float(np.mean(dep)) if dep.size > 0 else 1.0\n    if not np.isfinite(scale) or scale <= 0.0:\n        scale = 1.0\n\n    to_cust = cur / scale\n    back = dep / scale\n    saving = (dep - cur) / scale\n\n    dem = np.asarray(demands, dtype=np.float64)[unvisited]\n    cap = float(rest_capacity)\n    if not np.isfinite(cap) or cap <= 0.0:\n        cap = 1.0\n    load_ratio = np.clip(dem / cap, 0.0, 1.0)\n\n    # Prefer close customers that save return distance and reduce remaining load.\n    score = to_cust - 0.30 * saving + 0.20 * load_ratio * back\n\n    return int(unvisited[int(np.argmin(score))])","code_sha256":"72463f8d9a6cc1f496deb63095a31b312020f8c505e2a8d12ca1304a83b5d7c5","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"8fb9faffddaa406ea98100cd02f33faf","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[-0.044033868666424246,-0.0597595799054624,-0.002048654885245126,0.053361099721087664],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.326449632455224,9.893589613982968,12.382309733020165,13.152487337144892],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0131202509340