er = np.argsort(score)\n    best = order[0]\n\n    # Cheap second ordering stage: among near-ties on relative score, break by absolute distance.\n    best_score = score[best]\n    tol = 0.05 * (abs(best_score) + 1e-9)\n    near_mask = np.abs(score - best_score) <= tol\n    candidates = np.where(near_mask)[0]\n    if candidates.size > 1:\n        sub = distance_matrix[current_node][unvisited_nodes[candidates]]\n        best = candidates[np.argmin(sub)]\n\n    return int(unvisited_nodes[best])","code_sha256":"68b0dcb1981e384075b79ece6e41f4f92d5a420a3e0c6a8b97efffcfc89896bb","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"3289198b64484a4aa974ba62ef8015f0","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.23483105991773665,0.23055308056643042,0.07306715910921603,0.11343213786179301],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.630488828342358,12.948376731264833,13.314326388221321,13.902546902363293],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.16297085936379402,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    d_cur_node = distance_matrix[current_node]\n    # savings of inserting node between current and depot\n    d_cur_dep = d_cur_node[depot]\n    # distance from current_node to each candidate is cur\n    save = cur + dep - cur  # placeholder replaced below\n    # proper savings: d(current,depot) + d(depot,node) - d(current,node)\n    save = d_cur_dep + dep - cur\n    dem_safe = np.where(dem > 0, dem, 1.0)\n    score = save / dem_safe\n    # primary: maximize savings per unit demand\n    best = np.argmax(score)\n    # secondary near-tie handling\n    s_best = score[best]\n    scale = np.abs(score).max()\n    tol = 1e-9 * (scale if scale > 0 else 1.0)\n    # near-tie gate: relative closeness\n    close_mask = np.abs(score - s_best) <= tol * 100.0 + 1e-12\n    if np.count_nonzero(close_mask) > 1:\n        cand_idx = np.nonzero(close_mask)[0]\n        # tie-break: larger demand first, then nearer distance\n        d_vals = dem[cand_idx]\n        max_d = d_vals.max()\n        sub = cand_idx[d_vals == max_d]\n        if sub.size == 1:\n            return int(unvisited_nodes[sub[0]])\n        # final tie-break by nearest distance to current node\n        local = np.argmin(cur[sub])\n        return int(unvisited_nodes[sub[local]])\n    return int(unvisited_nodes[best])","code_sha256":"759a4235ca80c314e9e43e6be0acfbdf8998b795cc3fa32d70a5a55682e257a0","elapsed_seconds":0.234,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"16ee05dccb9d4d4980e6992cbeef6d3d","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false}],"comparison_packet":{"ref":"rounds/round_0001/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"c77203e29de6e120f8663b84526979aa0bbac0b2cf0