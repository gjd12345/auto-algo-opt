 scale = np.mean(dist_term) if dist_term.size else 1.0\n    if scale <= 1e-12:\n        scale = 1.0\n\n    primary = dist_term + 0.1 * scale * fill_term\n\n    # secondary ordering: among near-ties, use savings (2*depot - d_cur - d_dep)\n    order = np.argsort(primary)\n    best_idx = order[0]\n    if primary.size > 1:\n        tol = 1e-9 * scale + 0.0\n        # near-tie gate that is relative to scale (scale-invariant)\n        gate = 0.02 * scale\n        near = np.where(primary <= primary[best_idx] + gate)[0]\n        if near.size > 1:\n            savings = 2.0 * d_dep[near] - d_cur[near] - d_dep[near]\n            best_idx = near[np.argmax(savings)]\n\n    return int(unvisited_nodes[best_idx])","code_sha256":"fe0768538e1984a56da849526acc780d5da5303d5ed4387ef539fcb4bb883411","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"ba1dde9c5b3c4392ae75b65ac481b905","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[0.03512488894387292,0.10596401203849581,0.0025848443418913752,0.013476895428209663],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.264336082250281,11.637400210727831,12.439800935230545,12.65448480785738],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.03928766018811744,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # Scale-free relative proximity: distance to current node normalised by\n    # the sum of distances to current node and depot. Ranges in [0, 1].\n    denom = d_cur + d_dep\n    denom = np.where(denom <= 0, 1.0, denom)\n    score = d_cur / denom\n    # Secondary cheap ordering among near-ties: prefer larger demand served\n    # (fills the vehicle efficiently) when primary scores are close.\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    # Near-tie window relative to best score (scale-free)\n    window = 0.05\n    chosen = best\n    best_demand = demands[unvisited_nodes[best]]\n    for idx in order[1:]:\n        if score[idx] - best_score > window:\n            break\n        dem = demands[unvisited_nodes[idx]]\n        if dem > best_demand:\n            best_demand = dem\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"4ea4072c58d4ab32fe3b93a24bc895e165817177ee50673b6dabd64b03a192a4","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"0fee061792b644d6a16eb01a5328ff50","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[0.1301731696332716,0.04989354252075174,-0.15107343494421924,-0.1323092068725308],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.39048430925717,11.047404074616043,10.533250664540994,10.834168996926154],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.025828982415681677,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    c = distance_matrix[current_node][unvisited_nodes]\n    d = distance_matrix[depot][unvisited_nodes]\n    # Scale-invariant score: relative saving of serving near-current vs depot\n    denom = c + d\n    denom = np.where(denom <= 0.0, 1.0, denom)\n    score = c / denom\n\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n\n    # Cheap relative near-tie gate: spread-normalized, hence scale-invariant\n    spread = score[order[-1]] - best_score\n    if spread > 0.0:\n        thr = best_score + 0.25 * spread\n    else:\n        thr = best_score\n\n    cand = order[score[order] <= thr]\n    if cand.size > 1:\n        # Secondary criterion: prefer larger remaining capacity after service\n        # (i.e. smaller demand) then nearer current node, both mild tie-breaks.\n        best = cand[np.argmin(demands[unvisited_nodes[cand]] * 1.0 + 1e-9 * c[cand])]\n\n    return int(unvisited_nodes[best])","code_sha256":"42ada97a6e16dadef8cce07e22395f3b5228b42f8865c40065e42dd499c93b4b","elapsed_seconds":0.281,"error_code":null,"err