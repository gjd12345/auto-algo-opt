ys 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    if rest_capacity <= 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    denom = d_cur + d_dep\n    denom = np.where(denom <= 0, 1.0, denom)\n    proximity = d_cur / denom  # scale-free, in [0, 1]\n\n    dem = demands[unvisited_nodes].astype(float)\n    util = dem / rest_capacity  # capacity utilisation of this candidate\n\n    # Priority: high utilisation and high proximity are both good for\n    # packing the vehicle efficiently without wandering far.\n    eps = 1e-9\n    score = util / (proximity + eps)\n\n    order = np.argsort(-score)\n    best = order[0]\n    best_score = score[best]\n\n    # Break exact/near-exact ties (relative to best score) by raw distance.\n    rel_window = 1e-6 * (abs(best_score) + 1.0)\n    chosen = best\n    best_d = d_cur[best]\n    for idx in order[1:]:\n        if best_score - score[idx] > rel_window:\n            break\n        if d_cur[idx] < best_d:\n            best_d = d_cur[idx]\n            chosen = idx\n\n    return unvisited_nodes[chosen]","code_sha256":"5205c5ddbd6af18e938470f1bc48c6ddbcfa5f5f1cd776dab5f80d8a947bc1c4","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"cd3e7aaa85484d6ebc07f3a1283e36fd","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"4ea4072c58d4ab32fe3b93a24bc895e165817177ee50673b6dabd64b03a192a4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":