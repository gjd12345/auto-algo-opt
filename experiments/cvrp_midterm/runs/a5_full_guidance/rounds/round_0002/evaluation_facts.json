:]:\n        if score[idx] - best_score > window:\n            break\n        dem = demands[unvisited_nodes[idx]]\n        if dem > best_demand:\n            best_demand = dem\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"1c10e72a2e9d4feebfec86b1f7587b37","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"4ea4072c58d4ab32fe3b93a24bc895e165817177ee50673b6dabd64b03a192a4","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[0.12871711091487928,0.04989354252075174,-0.16591037945568765,-0.13615220099788664],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.3732326774313,11.047404074616043,10.349157879524997,10.786184567290535],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03086298175448582,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Scale-free normalisers over the candidate set.\n    dc_sum = np.sum(d_cur)\n    if dc_sum <= 0:\n        dc_sum = 1.0\n    dd_sum = np.sum(d_dep)\n    if dd_sum <= 0:\n        dd_sum = 1.0\n\n    prox = d_cur / dc_sum                 # prefer near candidates\n    dep = d_dep / dd_sum                  # prefer customers far from depot (hard to leave)\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    fill = dem / cap                      # prefer filling the vehicle\n    fill = np.clip(fill, 0.0, 1.0)\n\n    # Single composite score: proximity dominates, depot-return and fill act as\n    # continuous modifiers instead of a discrete near-tie window.\n    score = prox - 0.35 * dep - 0.25 * fill\n    return unvisited_nodes[np.argmin(score)]","code_sha256":"7110a3f3a6a9ea93631b2fba62e2c54e5b55cb9332ca319d218ed20faa71aeb9","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"313097506f124c2fa9b1090839a1a491","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"4ea4072c58d4ab32fe3b93a24bc895e165817177ee50673b6dabd64b03a192a4","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Replace the scale-free distance ratio with a scale-free savings-style term (d_cur + d_dep - d_cur_depot_pair approximated by d_dep only relative to d_cur) using a relative margin around the depot-return distance, keeping the demand-based near-tie secondary stage.","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[0.3461594337205739,0.3019572515855582,0.17686353536253094,0.19922750661789734],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.949526372885853,13.699720270312937,14.60220368426911,14.973805848083925],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.848170412329