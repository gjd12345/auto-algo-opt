wer(1.0 - proximity + eps, w_prox)\n             * np.power(util + eps, w_util)\n             * np.power(dep_ratio + eps, w_dep))\n\n    order = np.argsort(-score)\n    best = order[0]\n    best_score = score[best]\n\n    # Near-tie window in absolute score space, scaled by magnitude.\n    rel_window = 1e-4 * (abs(float(best_score)) + 1.0)\n    chosen = best\n    best_d = d_cur[best]\n    for idx in order[1:]:\n        if best_score - score[idx] > rel_window:\n            break\n        if d_cur[idx] < best_d:\n            best_d = d_cur[idx]\n            chosen = idx\n\n    return unvisited_nodes[chosen]","code_sha256":"201cb0f588c99e192e61c1984a93eda14d0b693da0ac4d8caecdbfc235b60e74","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"e76bea4e777b4cd9a9b38e36eb6ae984","generation_parents":[{"algorithm":"Replace the fixed near-tie width with a demand-density priority: score each feasible customer by the ratio of its capacity utilisation (demand relative to remaining capacity) to its scale-free proximity, then pick the maximum, breaking exact ties by the smallest raw distance to the current node.","code_sha256":"5205c5ddbd6af18e938470f1bc48c6ddbcfa5f5f1cd776dab5f80d8a947bc1c4","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.12018115151401246,0.09089652825244456,-0.03231498550750436,0.1057935252411145],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.272097175817107,11.47885405816023,12.006773308242149,13.807169585132353],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.07113905487501679,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cur_dep = distance_matrix[current_node][depot]\n    # Clarke-Wright style savings, scale-normalised by the two depot legs.\n    savings = d_cur_dep + d_dep - d_cur\n    scale = d_cur_dep + d_dep\n    scale = scale if scale > 0 else 1.0\n    savings_rel = savings / scale\n    # Primary: maximise relative savings -> minimise negative savings.\n    score = -savings_rel\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    # Relative near-tie window (scale-free in score space)\n    spread = score[order[-1]] - best_score\n    window = 0.05 * spread if spread > 0 else 0.0\n    cand = unvisited_nodes\n    dem = demands[cand]\n    # Secondary: prefer higher demand per unit detour (fills vehicle efficiently).\n    denom_det = np.where(d_cur > 0, d_cur, 1.0)\n    eff = dem / denom_det\n    chosen = best\n    best_eff = eff[best]\n    for idx in order[1:]:\n        if score[idx] - best_score > window:\n            break\n        if eff[idx] > best_eff:\n            best_eff = eff[idx]\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"d0baaaa9cdd6af670ce10464116b2fddb2b80644947efe78c31567e482ae6fad","elapsed_seconds":0.234,"error_code":"candidate_error","error_detail":null,"evaluation_id":"c107eeb42fd949dc804a124ccdcf060b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"4ea4072c58d4ab32fe3b93a24bc895e165817177ee50673b6dabd64b03a192a4","population_member_indices":[1],"selected_parent_position":0}],"gener