smaller is better\n    # Secondary: among near-ties, prefer filling remaining capacity efficiently.\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    spread = score[order[-1]] - best_score\n    if spread <= 0:\n        spread = 1.0\n    window = 0.10 * spread\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    chosen = best\n    best_util = demands[unvisited_nodes[best]] / cap\n    for idx in order[1:]:\n        if score[idx] - best_score > window:\n            break\n        util = demands[unvisited_nodes[idx]] / cap\n        if util > best_util:\n            best_util = util\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"5dd8e7e2424d23bbf5ed6b2c535d52716a6f5aa2cd6c736481aab9f62d23622b","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"e69a4e33789a405f8678b41eed2555c4","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_17.json","instance_objectives":[0.0780571322405118,0.09283097799711233,0.00021475956194048315,0.0050509753495281105],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.773004617012434,11.499209120007809,12.410393565840714,12.549277004789658],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.04403846128727318,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cur_dep = distance_matrix[current_node][depot]\n    # Clarke-Wright savings normalised by the depot round-trip from the current node.\n    savings = d_cur_dep + d_dep - d_cur\n    trip = d_cur + d_dep\n    trip = np.where(trip <= 0, 1.0, trip)\n    score = -(savings / trip)\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    # Scale-invariant relative near-tie gate: window is a fraction of the best magnitude.\n    mag = max(abs(best_score), 1e-9)\n    window = 0.05 * mag\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    chosen = best\n    best_util = demands[unvisited_nodes[best]] / cap\n    for idx in order[1:]:\n        if score[idx] - best_score > window:\n            break\n        util = demands[unvisited_nodes[idx]] / cap\n        if util > best_util:\n            best_util = util\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"503cfa607bdef3b16fef579868fc25b2fa77f82e8f5ad52c27ca61f45a3a2670","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"d6bc8b53112d4a78bafe7f707708ec0c","generation_parents":[{"algorithm":"The new algorithm replaces the prior relative-proximity score with a scale-free \"savings-angle\" priority: it ranks candidates by the classic Clarke-Wright savings (d_cur + d_dep - d_depot_cur pair reduction), normalized by total round-trip distance, and then breaks near-ties by preferring the customer whose insertion most increases remaining-route utilization (largest demand relative to rest_capacity), all while keeping the same feasibility filter and depot-return semantics.","code_sha256":"5dd8e7e2424d23bbf5ed6b2c535d52716a6f5aa2cd6c736481aab9f62d23622b","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.0775458002427717,0.1675614683216055,-0.000668320362236197,0.00017819000771554028],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.766946268365933,12.285553534820268,12.399436549555606,12.488434386316483],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.06115428455246414,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"9e47f7d58fdb8cfd0617d75fd879135443e32beb1805f89e07fb5f1f0ef2569e"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":15,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":4,"total_evaluation_attempts":22},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:9c88e13c573145339b07ed154b2fa6d2","evaluation:85794294708d439bb4d92478f53801ec","evaluation:3964b55e370f4baeabef5620f48efd64","evaluation:532413c869af43ea9c67a696f0b21e2a","evaluation:8e9ec2f97ae24d088fde3f4a20008286","evaluation:053cf31ccb334069a67390d2723d179a","evaluation:e69a4e33789a405f8678b41eed2555c4","evaluation:d6bc8b53112d4a78bafe7f707708ec0c","rounds/round_0003/execution_delta.json","rounds/round_0003/comparison_packet.json"],"ex