        best_fill = fill\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"11e056d271fb2bc0f5718afe8391607e97423d7f3afaeb7ece85b9f285ac4440","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"8e9ec2f97ae24d088fde3f4a20008286","generation_parents":[{"algorithm":"Replace the relative-proximity term with a savings-based term (d_cur + d_dep − d_cur·d_dep/scale-free normaliser) so that insertion savings drive selection, keep the demand tie-break but widen the near-tie window to 0.20·spread to make the second stage fire more often.","code_sha256":"652988c0c3589161fb8aa1b35048fa31f825f7841f2c9a94090e1fe75215086b","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Replace the relative-proximity term with a savings-based term (d_cur + d_dep − d_cur·d_dep/scale-free normaliser) so that insertion savings drive selection, keep the demand tie-break but widen the near-tie window to 0.20·spread to make the second stage fire more often.","code_sha256":"652988c0c3589161fb8aa1b35048fa31f825f7841f2c9a94090e1fe75215086b","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_15.json","instance_objectives":[0.14011732611666883,0.09819475489178092,-0.05248066785623861,-0.06655406929661481],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.508304369879328,11.555648947782368,11.75656298882922,11.65520141833269],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.02981933596389908,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # Clarke-Wright style savings: going depot->cur->cand saves vs. two trips.\n    saving = d_dep + d_dep - d_cur\n    # Normalise by a per-step scale so the score is dimensionless.\n    scale = np.maximum(d_cur + d_dep, 1e-12)\n    score = saving / scale\n    # Lower saving = more attractive next hop; pick smallest first.\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    spread = score[order[-1]] - best_score\n    if spread <= 0:\n        spread = 1.0\n    window = 0.20 * spread\n    chosen = best\n    best_demand = demands[unvisited_nodes[best]]\n    for idx in order[1:]:\n        if score[idx] - best_score > window:\n            break\n        dem = demands[unvisited_nodes[idx]]\n        if dem > best_demand:\n            best_demand = dem\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"8a945309f9d774a4958adb329e0b610617e1b253f9fcf314bd103fd673d6a17d","elapsed_seconds":0.25,"error_code":null,"err