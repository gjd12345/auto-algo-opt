 unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # Primary: insertion-saving style term, normalised so it is scale-free.\n    saving = d_cur + d_dep - 0.5 * (d_cur + d_dep)\n    denom = d_cur + d_dep\n    denom = np.where(denom <= 0, 1.0, denom)\n    score = saving / denom\n    # Secondary: among near-ties (relative to local spread), prefer larger demand.\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    spread = score[order[-1]] - best_score\n    if spread <= 0:\n        spread = 1.0\n    window = 0.20 * spread\n    chosen = best\n    best_demand = demands[unvisited_nodes[best]]\n    for idx in order[1:]:\n        if score[idx] - best_score > window:\n            break\n        dem = demands[unvisited_nodes[idx]]\n        if dem > best_demand:\n            best_demand = dem\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"652988c0c3589161fb8aa1b35048fa31f825f7841f2c9a94090e1fe75215086b","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"532413c869af43ea9c67a696f0b21e2a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_14.json","instance_objectives":[1.195960683328823,1.1174638490887383,1.1309012025881569,1.4618596626296763],"lineage_status