],"lineage_status":"verified","objective":0.02895033526572028,"origin":"generated","revision":"original","source_request_index":24,"valid":true},"selection":"closest_aggregate_then_largest_instance_l1","status":"available"},"lineage_contrast":{"candidate":{"candidate_id":"candidate_4","code_sha256":"ace2f83e8bd80e7d8e2477909bf8f3385b46eca556db831783292adb9b643d61","evaluation_id":"7b113c337e1e4096bf2b3c529aef0fd1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the additive demand penalty with a multiplicative capacity-urgency factor, scoring candidates by the product of the scale-free relative proximity and a radial-depot term raised to a capacity-dependent exponent, so demand pressure reshapes the geometry rather than shifting the score.","code_sha256":"eb7614dfdfd2a2d985ba39b46a3abbfa8179e7c8cf90592f7da56323fe613e7a","population_member_indices":[2],"selected_parent_position":1}],"instance_objectives":[0.589007594586183,0.8066928795402902,0.6015035139428211,0.7082647337690922],"lineage_status":"verified","objective":0.6763671804595967,"origin":"generated","revision":"original","source_request_index":23,"valid":true},"objective_delta":0.7072301622140824,"reference":{"candidate_id":"explicit_parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","evaluation_id":"7a1161fef646450e953b253c00a11192","instance_objectives":[0.12871711091487928,0.04989354252075174,-0.16591037945568765,-0.13615220099788664],"objective":-0.03086298175448582,"origin":"explicit_parent","revision":"original","valid":true},"selection":"largest_absolute_objective_change","source_behavior_effect":{"behavior_reason":"missing_or_incomplete_evidence","behavior_relation":"not_comparable","instance_effect_delta":[0.46029048367130376,0.7567993370195385,0.7674138933985087,0.8444169347669788],"reference_code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","reference_evaluation_id":"7a1161fef646450e953b253c00a11192","role":"actual_generation_parent","source_delta":{"candidate_structure":{"functions":["select_next_node"],"node_count":439},"reference_structure":{"functions":["select_next_node"],"node_count":243},"text":"--- actual_generation_parent\n+++ candidate\n@@ -1,30 +1,76 @@\n def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                      rest_capacity: float, demands: np.ndarray,\n                      distance_matrix: np.ndarray) -> int:\n+    \"\"\"Select the next node to visit in a CVRP greedy construction.\n+\n+    Args:\n+        current_node:    index of the current node (0 = depot)\n+        depot:           index of the depot (always 0)\n+        unvisited_nodes: array of feasible unvisited customer indices\n+                         (already filtered to satisfy remaining capacity)\n+        rest_capacity:   remaining vehicle capacity\n+        demands:         demand of every node (index 0 = depot demand = 0)\n+        distance_matrix: pairwise Euclidean distance matrix\n+    Returns:\n+        Index of the next node to visit, or 0 to return to the depot early.\n+    \"\"\"\n     if unvisited_nodes.size == 0:\n         return depot\n+\n     d_cur = distance_matrix[current_node][unvisited_nodes]\n     d_dep = distance_matrix[depot][unvisited_nodes]\n-    # Primary: relative proximity that also rewards being far from depot\n-    # (i.e., customers that would be expensive to leave behind). Scale-free.\n+\n+    # Scale-free radial coordinate of each candidate in [0, 1]:\n+    # r = share of the closed trip (cur -> cand -> depot) that is depot-side.\n     denom = d_cur + d_dep\n     denom = np.where(denom <= 0, 1.0, denom)\n-    score = d_cur / denom\n-    # Secondary: among near-ties (relative to local spread), prefer larger demand.\n-    order = np.argsort(score)\n+    r = d_dep / denom\n+\n+    # Angular coordinate via law of cosines on the cur-depot-cand triangle.\n+    # cos(theta) between (cand - cur) and (depot - cur).\n+    a = d_cur            # |cur - cand|\n+    b = d_dep            # |depot - cand|\n+    c = distance_matrix[current_node][depot]  # |cur - depot|\n+    if c <= 0:\n+        cos_t = np.ones_like(a)\n+    else:\n+        cos_t = (a * a + c * c - b * b) / (2.0 * a * c + 1e-12)\n+    cos_t = np.clip(cos_t, -1.0, 1.0)\n+    theta = np.arccos(cos_t)  # in [0, pi]\n+\n+    # Capacity-urgency radius: as the vehicle fills, pull the ring outward\n+    # (depot-side customers become relatively more valuable to grab first\n+    # since leaving them forces a costly return).\n+    cap = rest_capacity if rest_capacity > 0 else 1.0\n+    dem = demands[unvisited_nodes]\n+    pressure = np.clip(dem / cap, 0.0, 1.0)  # how much this pickup uses\n+    fill = np.clip(1.0 - rest_capacity / (rest_capacity + 1.0), 0.0, 1.0)\n+    # Ring radius target: small when nearly full -> grab far customers now?\n+    # Use fill to bias the radial term: heavier when vehicle is near full.\n+    target_r = 1.0 - fill  # drives toward depot-side first when full\n+\n+    # Geometric cost: squared polar distance to the per-step ring point.\n+    # Ring point sits at (target_r, theta); candidates near the ring win,\n+    # and among them the closest angularly to the current ray wins.\n+    dr = r - target_r\n+    # Use theta normalized to [0,1]; weight radial and angular parts equally.\n+    ta = theta / np.pi\n+    cost = dr * dr + ta * ta\n+\n+    # Cheap secondary: break near-ties by preferring the larger demand\n+    # (uses remaining capacity more fully, fewer restarts).\n+    order = np.argsort(cost)\n     best = order[0]\n-    best_score = score[best]\n-    spread = score[order[-1]] - best_score\n-    if spread <= 0:\n-        spread = 1.0\n-    window = 0.10 * spread\n+    best_cost = cost[best]\n     chosen = best\n-    best_demand = demands[unvisited_nodes[