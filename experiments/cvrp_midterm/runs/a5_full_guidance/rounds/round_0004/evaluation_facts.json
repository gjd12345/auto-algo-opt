         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    denom = d_cur + d_dep\n    denom = np.where(denom <= 0, 1.0, denom)\n    rel = d_cur / denom\n    # Scale-free insertion detour: how much serving the node costs relative\n    # to the direct current->depot leg, normalised by the triangle perimeter.\n    detour = (d_cur + d_dep) / denom  # == 1, kept for readability of form\n    # Node-to-depot direct leg normalized by the triangle perimeter\n    dep_frac = d_dep / denom\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    dem_ratio = demands[unvisited_nodes] / cap\n    # Prefer nodes close to current (low rel), close to depot (low dep_frac),\n    # and with small demand relative to remaining capacity.\n    score = 0.65 * rel + 0.35 * dep_frac - 0.20 * dem_ratio\n    return unvisited_nodes[np.argmin(score)]","code_sha256":"98981c353b16a7dd3fb7283ac4049b97efa348c2f67fbcf34d0f1197d319b71d","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"13564865810b49e997bf8a06e2576bf3","generation_parents":[{"algorithm":"Replace the near-tie demand secondary stage with a capacity-normalized demand term added to the same scale-free primary score, so the score becomes d_cur/(d_cur+d_dep) minus a weight times demand/rest_capacity.","code_sha256":"198e97f1c6cd326b47f72d9ed685596ce1dea235a2b3d309f66a9e69ec8d80ec","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.1