ular coordinate via law of cosines on the cur-depot-cand triangle.\n    # cos(theta) between (cand - cur) and (depot - cur).\n    a = d_cur            # |cur - cand|\n    b = d_dep            # |depot - cand|\n    c = distance_matrix[current_node][depot]  # |cur - depot|\n    if c <= 0:\n        cos_t = np.ones_like(a)\n    else:\n        cos_t = (a * a + c * c - b * b) / (2.0 * a * c + 1e-12)\n    cos_t = np.clip(cos_t, -1.0, 1.0)\n    theta = np.arccos(cos_t)  # in [0, pi]\n\n    # Capacity-urgency radius: as the vehicle fills, pull the ring outward\n    # (depot-side customers become relatively more valuable to grab first\n    # since leaving them forces a costly return).\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    dem = demands[unvisited_nodes]\n    pressure = np.clip(dem / cap, 0.0, 1.0)  # how much this pickup uses\n    fill = np.clip(1.0 - rest_capacity / (rest_capacity + 1.0), 0.0, 1.0)\n    # Ring radius target: small when nearly full -> grab far customers now?\n    # Use fill to bias the radial term: heavier when vehicle is near full.\n    target_r = 1.0 - fill  # drives toward depot-side first when full\n\n    # Geometric cost: squared polar distance to the per-step ring point.\n    # Ring point sits at (target_r, theta); candidates near the ring win,\n    # and among them the closest angularly to the current ray wins.\n    dr = r - target_r\n    # Use theta normalized to [0,1]; weight radial and angular parts equally.\n    ta = theta / np.pi\n    cost = dr * dr + ta * ta\n\n    # Cheap secondary: break near-ties by preferring the larger demand\n    # (uses remaining capacity more fully, fewer restarts).\n    order = np.argsort(cost)\n    best = order[0]\n    best_cost = cost[best]\n    chosen = best\n    best_dem = dem[best]\n    # Relative near-tie gate keeps the secondary stage scale-free.\n    spread = cost[order[-1]] - best_cost\n    window = 0.05 * spread if spread > 0 else 0.0\n    for idx in order[1:]:\n        if cost[idx] - best_cost > window:\n            break\n        if dem[idx] > best_dem:\n            best_dem = dem[idx]\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"ace2f83e8bd80e7d8e2477909bf8f3385b46eca556db831783292adb9b643d61","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"7b113c337e1e4096bf2b3c529aef0fd1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the additive demand penalty with a multiplicative capacity-urgency factor, scoring candidates by the product of the scale-free relative proximity and a radial-depot term raised to a capacity-dependent exponent, so demand pressure reshapes the geometry rather than shifting the score.","code_sha256":"eb7614dfdfd2a2d985ba39b46a3abbfa8179e7c8cf90592f7da56323fe613e7a","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.589007594586183,0.8066928795402902,0.6015035139428211,0.7082647337690922],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[18.82683276714231,19.010752491240023,19.87102141325326,21.329751293586128],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.6763671804595967,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # Scale-invariant primary score: relative proximity to current node.\n    denom = d_cur + d_dep\n    denom = np.where(denom <= 0, 1.0, denom)\n    score = d_cur / denom\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    spread = score[order[-1]] - best_score\n    if spread <= 0:\n        spread = 1.0\n    # Widened near-tie window: 20% of local spread (relative, scale-free).\n    window = 0.20 * spread\n    chosen = best\n    # Secondary tie-break: demand per unit distance (higher is better).\n    best_ratio = -np.inf\n    for idx in order:\n        if score[idx] - best_score > window:\n            break\n        n = unvisited_nodes[idx]\n        d = d_cur[idx]\n        ratio = demands[n] / d if d > 0 else demands[n] / 1e-12\n        if ratio > best_ratio:\n            best_ratio = ratio\n            chosen = idx\n    return unvisited_nodes[chosen]","code_sha256":"79b629672b0652e9c78d66e9d1e66f9f67be54e775791643d5ea463fbdb42634","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"a00660cd72a542489ab3a40abe9cd43b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"8a53362c0e27cc773cac395e019b845b0ac575bd3ea2d29e38668c821ddf4908","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[0.03424891468667012,0.08712342220565956,0.00625594348448174,-0.011826939313930302],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.25395738997413,11.43915191177391,12.485350938110647,12.338535826909322],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_refe