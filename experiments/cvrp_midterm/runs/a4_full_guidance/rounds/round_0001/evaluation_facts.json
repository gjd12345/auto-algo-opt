de][unvisited_nodes]\n    d_back = distance_matrix[unvisited_nodes][depot]\n\n    # Round-trip distance current -> candidate -> depot.\n    round_trip = d_cur + d_back\n\n    # Scale-invariant score: fraction of the round-trip cost paid to reach the\n    # candidate first. Ties in the denominator are broken by raw d_cur.\n    denom = np.where(round_trip > 0.0, round_trip, 1.0)\n    scores = d_cur / denom\n\n    # Prefer small score; break exact ties by smaller absolute approach distance.\n    scores = scores + 1e-12 * d_cur\n\n    return int(unvisited_nodes[int(np.argmin(scores))])","code_sha256":"76494a2bef5eece405ce7110ba3888a11f955d8bc7ccc3ea009acb982d8fb875","elapsed_seconds":0.235,"error_code":"candidate_error","error_detail":null,"evaluation_id":"ea13ed535cff4723abf534bcdd59301f","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    \n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    \n    # Primary score: savings-like term - distance to current minus distance back to depot,\n    # normalized by current-node distance to avoid scale sensitivity of absolute lengths.\n    # Using ratio d_dep / (d_cur + eps) as \"return savings\" priority.\n    eps = 1e-9\n    score = d_dep / (d_cur + eps)\n    \n    # Secondary: among near-ties in primary score, prefer closer to current node.\n    max_score = np.max(score)\n    tie_tol = 0.02 * max_score\n    near = score >= (max_score - tie_tol)\n    candidates = unvisited_nodes[near]\n    if candidates.size == 0:\n        candidates = unvisited_nodes\n    best_idx = np.argmin(distance_matrix[current_node][candidates])\n    return int(candidates[best_idx])","code_sha256":"3b194009da7f8a073e7a34c9f2d9ea4f42e50278d592c85c49020a9ec1e06b2f","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"3ab4525256774919a5814b81959d011e","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[-0.00662153606720827,0.005065932241880166,0.012087565969586371,-0.014535745195554053],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.769717324613472,10.575709846207817,12.557708128879609,12.304713109261714],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0010009457628239464,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    # capacity term replaced: normalized demand pressure (prefer large demands\n    # relative to remaining capacity to fill the vehicle efficiently)\n    cap_term = dem / cap\n    scores = d_cur + d_dep - cap_term * (d_cur.mean() + d_dep.mean()) * 0.0\n    # keep effect readable: pure ratio term added to distances\n    scores = d_cur + d_dep + (cap - dem) / cap * (d_cur + d_dep).std() if (d_cur.size and (d_cur + d_dep).std() > 0) else d_cur + d_dep\n    # simpler, scale-normalized capacity term: penalty proportional to remaining slack fraction\n    slack = (cap - dem) / cap\n    scale = np.median(d_cur + d_dep) + 1e-12\n    scores = d_cur + d_dep + slack * scale\n    return int(unvisited_nodes[int(np.argmin(scores))])","code_sha256":"79bbfc48674989c356346e43775fad57bf35ab31edab9c0b982d41e1012442bd","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"10a7785129fd4974ad349360619fcfb4","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[0.154539189754676,0.2040827570207955,-0.02735142133405677,0.07531103380211152],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.67917706792581,12.669845291312985,12.068359866821599,13.426558811901529],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.10164538981088157,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    cur = distance_matrix[current_node][unvisited_nodes]\n    back = distance_matrix[depot][unvisited_nodes]\n    savings = cur + back - distance_matrix[current_node][unvisited_nodes[0]] * 0.0\n    # recompute properly: d(cur,0) + d(0,c) - d(cur,c) relative to span\n    d_cur_0 = distance_matrix[current_node][depot]\n    span = cur + back\n    denom = np.where(span > 0.0, span, 1.0)\n    rel_savings = (d_cur_0 + back - cur) / denom\n    idx = int(np.argmax(rel_savings))\n    return int(unvisited_nodes[idx])","code_sha256":"7cef002a9dc5e907acdc1045dbf39a6b71a6e2403e73914431e96068b122e94f","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"32daf3303f654778ae5e102a64cc9d69","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.11446009230298058,0.04679438318246023,3.526270399757876e-05,0.05014855516422855],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[13.204313091345776,11.014793467811545,12.408166417491215,13.112374832880883],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.05285957333841674,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = distance_matrix[current_node][unvisited_nodes]\n    # savings: gain from visiting cand directly from current instead of via depot\n    savings = distance_matrix[current_node][depot] + d_dep - d_cd\n    scale = distance_matrix[current_node][depot]\n    if scale <= 0:\n        scale = 1.0\n    # primary: effective cost = d_cur - savings/scale term with span-proportional normalization\n    score = d_cur - savings * (d_cur / (d_cur + scale + 1e-12))\n    # secondary tie-break: smaller depot distance\n    order = np.lexsort((d_dep, score))\n    return int(unvisited_nodes[order[0]])","code_sha256":"61f16d00992e7aed9245ef1e45edd25dcf87800f362dfa28deb37e5d3e74e246","elapsed_seconds":0.234,"error_code":"forbidden_attribute","error_detail":"lexsort","evaluation_id":"ed948d021827401e94b4fa0300a1abfb","generation_parents":[],"generation_request_ref":"rounds/round_0001/eo