city)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Capacity pressure in [0, 1]: how full the vehicle is relative to its capacity.\n    total_demand = float(np.sum(demands[unvisited_nodes])) + float(rest_capacity)\n    if total_demand > 0:\n        pressure = 1.0 - float(rest_capacity) / total_demand\n    else:\n        pressure = 0.0\n\n    # Distance-balance term: prefer nodes that are close to current AND\n    # not too far from depot (so route stays compact and return is cheap).\n    # This is a harmonic-style combination (scale-invariant by construction\n    # since it uses a ratio of distances).\n    eps = 1e-9\n    balance = d_cur / (d_cur + d_dep + eps)\n\n    # Regret proxy: use the spread of the node's distance to depot vs current\n    # as a measure of how \"committal\" visiting it now is.\n    # Larger spread => visiting now vs later differs more => higher priority.\n    spread = np.abs(d_cur - d_dep)\n    # Normalize spread by the local distance scale so it is dimensionless.\n    local_scale = d_cur + d_dep + eps\n    regret = spread / local_scale\n\n    # Depot pull grows with capacity pressure: when nearly full we weight\n    # proximity to the depot more heavily so the route closes cheaply.\n    depot_pull = d_dep / (d_dep + d_cur + eps)\n\n    # Final composite score: prioritize high regret, then balance, and\n    # modulate by capacity-dependent depot pull.  All terms dimensionless.\n    score = regret + 0.5 * balance + pressure * depot_pull\n\n    # Cheap second ordering stage: break near-ties by raw closeness to current.\n    max_score = float(np.max(score))\n    span = float(np.max(score) - np.min(score)) if score.size > 1 else 0.0\n    tol = 0.05 * (span + eps)\n    near_mask = score >= (max_score - tol)\n    candidates = unvisited_nodes[near_mask]\n    if candidates.size == 0:\n        candidates = unvisited_nodes\n\n    best_idx = int(np.argmin(distance_matrix[current_node][candidates]))\n    return int(candidates[best_idx])","code_sha256":"a0b2193b9457545b324656629d4c19537e586a170505b66b8c31e1707f587a2d","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"cc99173c67374cf18f228014b9abd384","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"3b194009da7f8a073e7a34c9f2d9ea4f42e50278d592c85c49020a9ec1e06b2f","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"3b194009da7f8a073e7a34c9f2d9ea4f42e50278d592c85c49020a9ec1e06b2f","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[0.21483811666622624,0.6786299776717072,0.24508984874841358,0.18875309891896333],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.393609029654437,17.663222892654865,15.448737283749308,14.84302019949599],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.3318277605013276,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    eps = 1e-9\n    # Term 1 (unchanged form): distance to current node appears in denominator.\n    # Term 2 (changed): depot distance replaced by capacity-aware demand density:\n    #   prefer customers whose demand fills the remaining capacity well,\n    #   relative to how far off-route they are -> dem / (rest_capacity + eps).\n    #   Combined with 1/(d_cur+eps) and a small depot pull via d_dep.\n    cap_frac = dem / (rest_capacity + eps)\n    score = cap_frac / (d_cur + eps) + 1.0 / (d_dep + eps)\n\n    # Scale-free secondary: near-ties on primary score (relative tolerance\n    # proportional to score spread) resolved by proximity to current node.\n    s_min = np.min(score)\n    s_max = np.max(score)\n    span = s_max - s_min\n    if span <= eps:\n        return int(unvisited_nodes[np.argmin(d_cur)])\n    tie_tol = 0.02 * span\n    near = score >= (s_max - tie_tol)\n    candidates = unvisited_nodes[near]\n    if candidates.size == 0:\n        candidates = unvisited_nodes\n    best_idx = np.argmin(distance_matrix[current_node][candidates])\n    return int(candidates[best_idx])","code_sha256":"813182144641df38f88a49559c6813b619cadefa9735f579c0dbc58633d3a23b","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"16fa7d63595d4bf1802db9522a12615d","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"3b194009da7f8a073e7a34c9f2d9ea4f42e50278d592c85c49020a9ec1e06b2f","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[0.22009672888204926,0.2694396827949918,0.09265530708191463,0.19011419004118071],"lineage_status"