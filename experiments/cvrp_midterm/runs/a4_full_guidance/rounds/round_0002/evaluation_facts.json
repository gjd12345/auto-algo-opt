" from current node plus depot leg is largest\n    # (i.e. strongest detour saving), breaking residual ties by nearest.\n    cand_dep = distance_matrix[depot][candidates]\n    cand_cur = distance_matrix[current_node][candidates]\n    secondary = cand_cur + cand_dep  # maximizes the amount \"absorbed\" next step\n    best_idx = int(np.argmax(secondary))\n    return int(candidates[best_idx])","code_sha256":"2e9f970ca06908e1a4cc4e00ea350acf1d33943694592a117dd734a9dbaaf0b9","elapsed_seconds":0.234,"error_code":null,"error_detail":null,"evaluation_id":"210aca6921d143a089ca473b1a874a1d","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"3b194009da7f8a073e7a34c9f2d9ea4f42e50278d592c85c49020a9ec1e06b2f","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_12.json","instance_objectives":[-0.03058648109575165,-0.0497627223120946,-0.00948670752135641,-0.10147434974056418],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.48577657199319,9.998780588912833,12.290020392460935,11.219179482008855],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.047827565167441716,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"3077b0c309c58fe39c86a30dd514339b37a9dbecd6e06c1ad62f8caebed6186a"},"dual_budget":{"baseline_attempts":2,"novel_candidate_evaluations":10,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":2,"total_evaluation_attempts":14},"evaluator_hash"