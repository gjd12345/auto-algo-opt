e-9\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Scale-free savings ratio (candidate closer to depot than to current node\n    # gets a boost), minus a demand-density penalty: serving a demand-heavy\n    # node now frees up future capacity, so reward it by shrinking the\n    # effective return distance d_dep by the fraction of capacity it consumes.\n    cap = max(rest_capacity, eps)\n    fill = np.clip(dem / cap, 0.0, 1.0)\n    score = (d_dep - d_cur) / (d_dep + d_cur + eps) + 0.25 * fill\n\n    s_max = np.max(score)\n    s_min = np.min(score)\n    span = s_max - s_min\n    tol = 0.05 * span\n    near = score >= (s_max - tol)\n    candidates = unvisited_nodes[near]\n    if candidates.size == 0:\n        candidates = unvisited_nodes\n\n    cand_cur = distance_matrix[current_node][candidates]\n    best = candidates[int(np.argmin(cand_cur))]\n    return int(best)","code_sha256":"1ee5ad6158541446d38359b222d58a5bdba2b1de930996d1ae93a5dfaa17c9ff","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"eb812dec7f8145bd8624221f1cfc0314","generation_parents":[{"algorithm":"Replace the composite radial/shell score with a single normalized savings term `d_dep - d_cur` (clamped to be scale-free by dividing by `d_dep + d_cur`), then break near-ties by nearest distance to the current node.","code_sha256":"d1afed2e20e9c58bb100916f1f1992f314d6de36449d97ae1eb38a703e1d6bb3","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_18.json","instance_objectives":[0.028202859762182966,-0.04561997115710954,-0.08435333383585529,0.025580400623489985],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.182322700906504,10.042372290486517,11.361095590434836,12.805611709029392],"referenc