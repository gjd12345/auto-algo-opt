e58e81","generation_parents":[{"algorithm":"Replace the ratio score with the Clarke–Wright savings form s = d(depot,current) + d(depot,j) − d(current,j), gated scale-invariantly, then break ties by largest demand served per unit added detour, so heavier nodes that are cheap to insert are preferred.","code_sha256":"8c8831a769c282285cec8ff47841814f8a7adfa36ab46f9654bc93655b9c4a92","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.09175821301697486,0.06930632984645475,-0.05341929487291121,0.062038065649011966],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.935337356885055,11.251673266792151,11.744916759279938,13.26082975127247],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.042420828409882594,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    eps = 1e-9\n\n    # Primary: depot distance as a multiplicative weight on current-node proximity.\n    # This is a product form (distinct from ratio d_dep/d_cur and additive d_dep-d_cur).\n    score = d_dep * (1.0 / (d_cur + eps))\n\n    s_max = float(np.max(score))\n    # Scale-invariant (multiplicative) near-tie band: candidates within a relative\n    # fraction of the best score. Independent of coordinate scale.\n    band = score >= (s_max * 0.85)\n    candidates = unvisited_nodes[band]\n    if candidates.size == 0:\n        candidates = unvisited_nodes\n\n    cand_demands = demands[candidates]\n    cand_dep = distance_matrix[depot][candidates]\n    cand_cur = distance_matrix[current_node][candidates]\n\n    # Secondary: capacity slack preserved per unit of depot distance, blended with\n    # the routing savings gain so both capacity and distance inform the tie-break.\n    slack = rest_capacity - cand_demands\n    savings_gain = cand_dep - cand_cur\n    secondary = (slack * (savings_gain + 1.0)) / (cand_dep + 1.0)\n\n    best_idx = int(np.argmax(secondary))\n    return int(candidates[best_idx])","code_sha256":"43712b13445a47982a2fac212e8049539906e507abf1bbb95ffe51b17016416b","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"c12232b3b5e443bca2a2a191e9f6c729","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"24de7b805ba445474baebe98ee794dfb3917eddfd1b98491b2a4e3b86806a515","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the ratio-based primary score with a capacity-aware additive score (distance to depot minus distance to current node) and use a scale-invariant span-proportional near-tie gate, then break ties by the largest residual capacity slack per unit depot distance.","code_sha256":"647d699758bd24735311efb92b94f449bba7d32b427acd8de41a8c32f2290d84","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[-0.10174318931287799,0.03377753865794286,-0.0901801972300177,0.08347080048234333],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_o