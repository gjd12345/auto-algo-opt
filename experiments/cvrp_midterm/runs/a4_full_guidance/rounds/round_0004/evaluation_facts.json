idates]\n    cand_dep = distance_matrix[depot][candidates]\n    capacity_factor = rest_capacity - cand_demands  # residual slack after serving\n\n    eps = 1e-9\n    secondary = capacity_factor / (cand_dep + eps)\n    best_idx = int(np.argmax(secondary))\n    return int(candidates[best_idx])","code_sha256":"647d699758bd24735311efb92b94f449bba7d32b427acd8de41a8c32f2290d84","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"66d4bf49fb1b4585af9ca9e4a9ed0707","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"24de7b805ba445474baebe98ee794dfb3917eddfd1b98491b2a4e3b86806a515","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_20.json","instance_objectives":[-0.02921534026181697,0.011470393610100936,-0.023971839745889897,0.11907783401536326],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.502022082252951,10.643100176512286,12.11029279892049,13.973040247132586],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.019340261904439333,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = float(distance_matrix[current_node][depot])\n\n    # Clarke-Wright style savings: reward inserting j between depot and current.\n    score = d_cd + d_dep - d_cur\n\n    s_min = float(np.min(score))\n    s_max = float(np.max(score))\n    span = s_max - s_min\n    tol = 0.15 * span\n    near = score >= (s_max - tol)\n    candidates = unvisited_nodes[near]\n    if candidates.size == 0:\n        candidates = unvisited_nodes\n\n    cand_demands = demands[candidates]\n    cand_cur = distance_matrix[current_node][candidates]\n    cand_dep = distance_matrix[depot][candidates]\n\n    # Secondary: demand served per unit of added detour (scale-invariant).\n    detour = cand_cur + cand_dep - float(distance_matrix[current_node][depot])\n    eps = 1e-9\n    secondary = cand_demands / (detour + eps)\n    best_idx = int(np.argmax(secondary))\n    return int(candidates[best_idx])","code_sha256":"8c8831a769c282285cec8ff47841814f8a7adfa36ab46f9654bc93655b9c4a92","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"0238e768bd054e368e3309da7b7027aa","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"24de7b805ba445474baebe98ee794dfb3917eddfd1b98491b2a4e3b86806a515","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the ratio-based primary score with a capacity-aware additive score (distance to depot minus distance to current node) and use a scale-invariant span-proportional near-tie gate, then break ties by the largest residual capacity slack per unit depot distance.","code_sha256":"647d699758bd24735311efb92b94f449bba7d32b427acd8de41a8c32f2290d84","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[-0.03814216530064788,-0.05313342983112173,-0.06342183459294755,-0.047125405213657545],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objecti