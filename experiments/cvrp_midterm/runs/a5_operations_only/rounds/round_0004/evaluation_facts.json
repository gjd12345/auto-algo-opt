rrent_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n    dem = demands[unvisited_nodes]\n    fill = dem / cap\n\n    primary = 1.0 * d_cur - 0.5 * savings - 0.3 * fill\n\n    best_val = primary.min()\n    tol = 1e-9\n    close = np.where(primary <= best_val + tol)[0]\n\n    if close.size > 1:\n        candidates = unvisited_nodes[close]\n        secondary = -demands[candidates] / cap + 1e-6 * distance_matrix[current_node][candidates]\n        return int(candidates[np.argmin(secondary)])\n\n    return int(unvisited_nodes[int(np.argmin(primary))])","code_sha256":"0e3c274aaed0898bfd0d2d52545e60549f85c50de219017ba00008c3b8dac037","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"9f821d0d56a842e3901c13d4895470d0","generation_parents":null,"generation_request_ref":null,"instance_objectives":[0.03711502781271528,0.0015078162880885128,-0.07749908573235913,-0.11219452414824474],"lineage_status":null,"metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.287915586712526,10.538269912448916,11.44614124263013,11.085325138815113],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03776769144495002,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n  