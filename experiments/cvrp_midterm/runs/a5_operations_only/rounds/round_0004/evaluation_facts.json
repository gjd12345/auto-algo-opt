ry))])\n\n    return int(unvisited_nodes[int(np.argmin(primary))])","code_sha256":"2c4e562c907b3ae93832e7529a8c74651527aeec462874873c3056c424524104","elapsed_seconds":0.437,"error_code":null,"error_detail":null,"evaluation_id":"a31752dcb03148b9add25a7e68ad8ee6","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"0e3c274aaed0898bfd0d2d52545e60549f85c50de219017ba00008c3b8dac037","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the distance-to-current term with a squared-distance form while keeping the savings and fill terms, and use a nearest-to-current secondary tie-breaker among near-equal primary scores.","code_sha256":"6bf3d0237a4d6782d68374c951a4bbad5273e2d6e70b4cc119ed0da29c72ec04","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[0.006650057815128385,0.03981954100387522,-0.011818206174590075,0.014777922472585537],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.926961430574622,10.941401360152229,12.261091789270226,12.670729704057711],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.012357328779249766,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n    dem = demands[unvisited_nodes]\n    fill = dem / cap\n\n    # Replaced term: squared distance-to-current -> round-trip estimate per unit capacity\n    trip = (d_cur + d_dep) / (cap + 1e-6)\n\n    primary = 1.1 * trip - 0.8 * savings - 0.5 * fill\n\n    best_val = primary.min()\n    tol = 1e-6 * (abs(best_val) + 1.0)\n    close = np.where(primary <= best_val + tol)[0]\n\n    if close.size > 1:\n        candidates = unvisited_nodes[close]\n        secondary = -0.6 * demands[candidates] / cap + distance_matrix[current_node][candidates] / (cap + 1e-6)\n        return int(candidates[np.argmin(secondary)])\n\n    return int(unvisited_nodes[int(np.argmin(primary))])","code_sha256":"292076e2ea5f4a65acd68b2cd36ddd4fe7d9483687a480ded81c8132df245f09","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"50e91177a4fa4202ba20cd283c0e97a7","generation_parents":[{"algorithm":"Replace the distance-to-current term with a squared-distance form while keeping the savings and fill terms, and use a nearest-to-current secondary tie-breaker among near-equal primary scores.","code_sha256":"6bf3d0237a4d6782d68374c951a4bbad5273e2d6e70b4cc119ed0da29c72ec04","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[0.06015020179873274,0.021502649198972847,-0.060099046525605354,0.06308442578133121],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.560840253576512,10.748663623453767,11.662036211738013,13.273894823064152],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.02115955756335786,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_back = distance_matrix[current_node][depot]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    savings = d_back + d_dep - d_cur\n    dem = demands[unvisited_nodes]\n\n    # Ordinal (rank) combination: robust to scale, structurally different\n    # from additive or multiplicative scoring.\n    r_close = np.argsort(np.argsort(d_cur))\n    r_save = np.argsort(np.argsort(-savings))\n    r_small = np.argsort(np.argsort(dem))\n\n    rank_score = 1.0 * r_close + 0.8 * r_save + 0.5 * r_small\n\n    best_val = rank_score.min()\n    close = np.where(rank_score == best_val)[0]\n\n    if close.size > 1:\n        candidates = unvisited_nodes[close]\n        secondary = (-savings[close]\n                     + 1e-6 * distance_matrix[current_node][candidates])\n        return int(candidates[int(np.argmin(secondary))])\n\n    return int(unvisited_nodes[int(np.argmin(rank_score))])","code_sha256":"2432ccbbdc9e35b066a837d5d36f549f0ea87206715ae8a2a98d8fc2c4175b99","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"57b722dcfe7d4340a3df67576f6e24b5","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"0e3c274aaed0898bfd0d2d52545e60549f85c50de219017ba00008c3b8dac037","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the additive distance‑minus‑savings score with a multiplicative \"route-progress × depot-return-risk\" ranking: score = (d_cur^2 / (savings + ε)) · (d_dep / (cap·dem + ε))^α, so customers that are close, generate large savings, and are small relative to remaining capacity are preferred, with a nearest-savings tie-breaker.","code_sha256":"2c4e562c907b3ae93832e7529a8c74651527aeec462874873c3056c424524104","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.1901163874905506,0.09075833758685566,0.03898854589386553,0.1244547943859269],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.100701769493583,11.477399960139554,12.891488194585998,14.040178100623562],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.11107951633929966,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n    dem = demands[unvisited_nodes]\n    fill = dem / cap\n\n    # Replace linear distance term with squared distance term\n    primary = 1.0 * (d_cur * d_cur) - 0.5 * savings - 0.3 * fill\n\n    best_val = primary.min()\n    tol = 1e-9\n    close = np.where(primary <= best_val + tol)[0]\n\n    if close.size > 1:\n        candidates = unvisited_nodes[close]\n        secondary = -demands[candidates] / cap + 1e-6 * distance_matrix[current_node][candidates]\n        return int(candidates[np.argmin(secondary)])\n\n    return int(unvisited_nodes[int(np.argmin(primary))])","code_sha256":"e1bc0fbcf921febed36c128ccadcc64a36294473df70427ff1a4548b288b79dc","elapsed_seconds":0.36,"error_code":null,"error_detail":null,"evaluation_id":"63f6557e215440b2874099ddd45cc575","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"0e3c274aaed0898bfd0d2d52545e60549f85c50de219017ba00008c3b8dac037","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[0.005301760650789629,0.021368854051167663,0.053004707886921035,-0.05184138057115325],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.910986576005076,10.747255776847265,13.065396932637993,11.838907131604449],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.4077288874