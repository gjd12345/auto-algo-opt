node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # Saving of serving the customer now rather than leaving it for a future route\n    # (approximated by the detour it would cause from depot).\n    savings = d_cur + d_dep - distance_matrix[current_node][depot]\n    # Prefer customers that are close now but whose inclusion is \"saved\" (large saving).\n    score = d_cur - savings\n    best_idx = int(np.argmin(score))\n    return int(unvisited_nodes[best_idx])","code_sha256":"545d21904325688242e691e2fce592bb9f504b569838444ea8a2e60c5a6ada72","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"1cdb1d75b35d438a9aa9f792ad9d5c9c","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[1.0985184419745089,1.06391787321952,0.9062570229663119,1.3076310475985107],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[24.86360411392942,21.71737780911966,23.652320330706694,28.813564636455887],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":1.0940810964397127,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    # Primary score: current distance + squared depot distance term (replaces the depot term)\n    score = d_cur + (d_dep * d_dep) / (rest_capacity + 1.0)\n    order = np.argsort(score)\n    best_idx = order[0]\n    best_score = score[best_idx]\n    # Secondary ordering stage: among near-ties, prefer the node farthest from depot\n    # (to leave closer nodes for later, cheap return)\n    tie_mask = np.abs(score - best_score) <= 1e-9 + 0.05 * abs(best_score)\n    candidates = unvisited_nodes[tie_mask]\n    if candidates.size > 1:\n        cand_dep = distance_matrix[depot][candidates]\n        return int(candidates[np.argmax(cand_dep)])\n    return int(unvisited_nodes[best_idx])","code_sha256":"611272b142d4a14a620fca3175ca541920a8a6f28afaa9295d7bd47c62791e80","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"d38a96ba84a249d2891466e951d918d0","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[-0.05969584919610326,0.04303064473734623,-0.035910376591737875,0.07709188895145691],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.140883818145007,10.975189891115082,11.962162670424732,13.44879494232941],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.006129076975240502,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return 0\n\n    cur_to_depot = distance_matrix[current_node][depot]\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[unvisited_nodes][depot]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Savings-style marginal detour relative to returning toward depot.\n    savings = d_cur + d_dep - cur_to_depot\n    # Prefer customers that fill remaining capacity moderately well.\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    utilization = np.clip(dem / cap, 0.0, 1.0)\n    # Primary score: lower detour, higher utilization when distances tie.\n    primary = savings - 0.15 * utilization * (d_cur + 1.0)\n\n    order = np.argsort(primary)\n    best_idx = order[0]\n\n    # Secondary stage: among candidates within a small band of the best primary score,\n    # pick the one with the smallest pure detour; break remaining ties by distance.\n    best_primary = primary[best_idx]\n    span = 1e-9 + 0.05 * (np.max(primary) - np.min(primary) + 1e-9)\n    close = order[primary[order] <= best_primary + span]\n    if close.size > 1:\n        # Cheapest detour among close candidates.\n        detour = savings[close]\n        best_idx = close[np.argmin(detour)]\n\n    return int(unvisited_nodes[best_idx])","code_sha256":"e44d72686039e80632ca2f84bbf4ad16a94deae3afcd3c25c0e0a2600570c54d","elapsed_seconds":0.234,"error_code":"candidate_error","error_detail":null,"evaluation_id":"61badd78b9ab4ad08198b2bcc2a11433","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Capacity-weighted depot pull: as capacity runs low, returning becomes cheaper.\n    # Scale the depot distance term by the fraction of capacity already used.\n    total_cap_hint = rest_capacity + float(np.sum(dem))\n    if total_cap_hint <= 0:\n        cap_ratio = 0.0\n    else:\n        cap_ratio = max(0.0, min(1.0, (total_cap_hint - rest_capacity) / total_cap_hint))\n\n    # Primary score: nearest-neighbour distance plus a pull toward depot\n    # that grows as the vehicle gets full. The distance-to-current term keeps\n    # its original meaning; the depot term is the single replaced term.\n    scores = d_cur + cap_ratio * d_dep\n\n    # Secondary ordering stage: among near-tied candidates (within a small\n    # relative tolerance of the best score), prefer higher demand to pack\n    # more service per route, breaking final ties by distance.\n    best = float(np.min(scores))\n    tol = 1e-9 + 0.05 * abs(best)\n    near = np.where(scores <= best + tol)[0]\n    if near.size > 1:\n        # Higher demand first, then shorter distance to current node.\n        order = sorted(near.tolist(), key=lambda i: (-dem[i], d_cur[i], i))\n        pick = order[0]\n    else:\n        pick = int(np.argmin(scores))\n\n    return int(unvisited_nodes[pick])","code_sha256":"e469e378d8fb2152dfe03aee86b0111bef78dec26b02f25e218f93a0a0177bd1","elapsed_seconds":0.25,"error_code":"forbidden_syntax","error_detail":null,"evaluation_id":"efc6f85da1fa47e9ac7183b2afbc5235","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    # Modified term: distance to depot scaled by capacity utilization pressure\n    depot_term = d_dep * (1.0 + dem / cap)\n\n    primary = d_cur + depot_term\n\n    # Cheap secondary ordering: among candidates within a small band of the best, prefer larger demand\n    best = np.min(primary)\n    band = best * 1.05 + 1e-9\n    mask = primary <= band\n    idxs = np.where(mask)[0]\n\n    if idxs.size > 1:\n        # secondary: higher demand first, tie-break by smaller primary score\n        order = idxs[np.lexsort((primary[idxs], -dem[idxs]))]\n        best_idx = order[0]\n    else:\n        best_idx = idxs[0] if idxs.size == 1 else int(np.argmin(primary))\n\n    return int(unvisited_nodes[best_idx])","code_sha256":"7ee1ed9d6099cf30a666d646f416e0bc3458932