 - d_cur\n    best = np.max(savings)\n    # Secondary ordering: among near-tied top candidates, pick nearest to current.\n    tol = 1e-9 * (1.0 + abs(best))\n    mask = savings >= best - tol\n    candidates = unvisited_nodes[mask]\n    if candidates.size == 1:\n        return int(candidates[0])\n    cand_d_cur = distance_matrix[current_node][candidates]\n    return int(candidates[np.argmin(cand_d_cur)])","code_sha256":"a57cf34c01ea028417b5849c62aaf28ba1a9917c6c661736deb836e877ecb288","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"0c3ffa25010e4aeeb2dbe54d271bab6b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[0.056145246352053244,0.12005216293316417,-0.003554566074448146,-0.09146903881082971],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.513388858950467,11.78564142690284,12.363624795256001,11.344107890075541],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.020293451099984892,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n    dem = demands[unvisited_nodes]\n    fill = dem / cap\n\n    primary = 1.0 * d_cur - 0.5 * savings - 0.3 * fill\n\n    best_val = primary.min()\n    tol = 1e-9\n    close = np.where(primary <= best_val + tol)[0]\n\n    if close.size > 1:\n        candidates = unvisited_nodes[close]\n        secondary = -demands[candidates] / cap + 1e-6 * distance_matrix[current_node][candidates]\n        return int(candidates[np.argmin(secondary)])\n\n    return int(unvisited_nodes[int(np.argmin(primary))])","code_sha256":"0e3c274aaed0898bfd0d2d52545e60549f85c50de219017ba00008c3b8dac037","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"fab3f6a0d9f4410eaaf0a2a83f8ee8ba","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[0.03711502781271528,0.0015078162880885128,-0.07749908573235913,-0.11219452414824474],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.287915586712526,10.538269912448916,11.44614124263013,11.085325138815113],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03776769144495002,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    # remaining slack after serving this node, normalized\n    slack = np.maximum(cap - dem, 0.0) / cap\n    # urgency: prefer nodes whose service leaves little slack (tight packing),\n    # while penalizing long hops, multiplicative form\n    urgency = (d_cur + 1e-9) * (1.0 + 2.0 * slack)\n\n    best = urgency.min()\n    tol = 1e-9 * (abs(best) + 1.0)\n    ties = np.where(urgency <= best + tol)[0]\n\n    if ties.size > 1:\n        cand = unvisited_nodes[ties]\n        # secondary: prefer node closest to depot (good for route seeding)\n        return int(cand[np.argmin(d_dep[ties])])\n\n    return int(unvisited_nodes[int(np.argmin(urgency))])","code_sha256":"d3d397dbdbb7dbe18857292e7cd5426d7a41bd0679e675ca5c2b9bf5cbe50006","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"53f551ca0b5c4df0ba64589f54704a2c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Replace the distance-to-current-node term with a blended score combining distance-to-current, a depot-savings term (how much is saved by serving this node now versus returning to depot), and a capacity-utilization term, then apply a cheap secondary tie-break by demand to better pack routes.","code_sha256":"0e3c274aaed0898bfd0d2d52545e60549f85c50de219017ba00008c3b8dac037","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[-0.00470458600332117,0.11067738124101738,-0.044667143015318905,-0.07867369250614924],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.792429675642332,11.686996185961746,11.853511086710474,11.503873264258482],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0043420100709429844,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    # Savings-style score: prefer nodes that are close to current node but also\n    # relatively close to the depot (small d(cur,n) but not pulling route outward).\n    score = cur + 0.5 * to_depot\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"fc9865c1d897ea25df00c592ee405de317084cf6cba081a4130549df17dbca69","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"3dbaab230f6644a8b0eec0c567239306","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[0.0030311650950023057,0.14178742623354246,0.015578654772215258,-0.01718650814325659],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.88408417292263,12.014348649704628,12.601024612264537,12.271615127845216],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.03580268448937586,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    # headroom after serving this node, normalized to (0,1]\n    headroom = np.maximum(cap - dem, 0.0) / cap + 1e-6\n\n    # squared distance penalized by tight headroom -> prefer near nodes that\n    # also leave useful slack; multiplicative form keeps scale invariance\n    urg = (d_cur * d_cur) / headroom\n\n    best = urg.min()\n    tol = 1e-6 * (abs(best) + 1.0)\n    ties = np.where(urg <= best + tol)[0]\n\n    if ties.size > 1:\n        cand = unvisited_nodes[ties]\n        return int(cand[np.argmin(d_dep[ties])])\n\n    return int(unvisited_nodes[int(np.argmin(urg))])","code_sha256":"23fae0725c877f95a4b312d55e36b9ea1a3b6321f6d2a689a89e6c10d7d0dcf0","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"de97b6090b60442295bf74004a3714bb","generation_parents":[{"algorithm":"The backbone is a greedy nearest-neighbour construction with capacity filtering; the new algorithm replaces the additive priority score with a multiplicative urgency factor (distance-to-current raised to a power divided by a normalized remaining-capacity-plus-demand term), so candidates far but affordable become attractive when capacity is tight, then uses a cheap second-stage tie-break by depot distance to seed the next route.","code_sha256":"d3d397dbdbb7dbe18857292e7cd5426d7a41bd0679e675ca5c2b9bf5cbe50006","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rou