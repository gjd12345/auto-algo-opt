min(score))\n    best_val = score[best_idx]\n    best_node = int(unvisited_nodes[best_idx])\n\n    # secondary stage: among near-ties pick closest to current node\n    span = float(np.max(score) - np.min(score)) if score.size > 1 else 0.0\n    tol = 1e-6 + 0.02 * span\n    mask = score <= (best_val + tol)\n    if np.count_nonzero(mask) > 1:\n        cand_nodes = unvisited_nodes[mask]\n        cand_d = d_cur[mask]\n        best_node = int(cand_nodes[int(np.argmin(cand_d))])\n\n    return best_node","code_sha256":"7fdb78727494028f0c5950cd4dbe8372b055b2e34346f6fc77c914a1e0ad040f","elapsed_seconds":0.203,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"731c125be18f4a4faea68efa2fae2930","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = distance_matrix[current_node][depot]\n\n    span = float(max(d_dep.max(), d_cur.max()))\n    eps = 1e-9 + 1e-6 * span\n    denom = max(d_cd, eps)\n\n    # Scale-invariant detour ratio replaces the absolute distance-to-depot term.\n    detour_ratio = (d_cur + d_dep - d_cd) / denom\n\n    dem = demands[unvisited_nodes].astype(float)\n\n    primary = d_cur + detour_ratio\n\n    # Secondary ordering stage: within a cheap relative near-tie band,\n    # prefer the larger demand-to-detour ratio.\n    p_min = primary.min()\n    tie_band = p_min * 1e-6 + eps\n    close = np.where(primary - p_min <= tie_band)[0]\n\n    if close.size > 1:\n        ratios = dem[close] / (d_cur[close] + eps)\n        best = close[np.argmax(ratios)]\n    else:\n        best = int(np.argmin(primary))\n\n    return int(unvisited_nodes[best])","code_sha256":"9e3725bb86a99b9dfbd775ae14f090a8af3c4556def401e182576ca3fe8532c1","elapsed_seconds":0.218,"error_code":null,"error_detail":null,"evaluation_id":"bd97f107103a4fd18debe38dd921a298","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[0.004691076755534115,0.03761016017183959,0.0057751225042272135,-0.04786443343537892],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.903751089146024,10.918153362314651,12.479385041744266,11.888564126587097],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":5.2981499055500605e-05,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Scale-normalized savings-style score: prefer nodes close to current\n    # and far from depot, expressed as a ratio to avoid absolute-length scale.\n    eps = 1e-12\n    score = d_cur / (d_dep + eps)\n\n    best_idx = int(np.argmin(score))\n    best_score = score[best_idx]\n\n    # Near-tie gate: relative to the best score's magnitude (scale-invariant).\n    span = float(score.max() - score.min())\n    if span < eps:\n        gate = eps\n    else:\n        gate = 0.05 * span  # relative fraction of the observed spread\n\n    candidates = np.where(score <= best_score + gate)[0]\n    if candidates.size == 1:\n        return int(unvisited_nodes[best_idx])\n\n    # Secondary stage: among near-ties, prefer larger demand (better packing).\n    cand_demands = demands[unvisited_nodes[candidates]]\n    best_cand = candidates[int(np.argmax(cand_demands))]\n    return int(unvisited_nodes[best_cand])","code_sha256":"ca2eb8c5f02cc4901070bb43bab9f5c88979067ddb8238544c9c4cf1a26ac3b6","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"7690febbc4394d45aa357fc56624d666","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[0.05606874797202056,0.06481681028374849,-0.010088503134874034,-0.03936547481795682],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[12.512482493107573,11.204432727917107,12.28255347564277,11.99468390414881],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.01785789507573455,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    mean_dep = float(np.mean(d_dep)) if d_dep.size > 0 else 0.0\n    if mean_dep > 0.0:\n        radial = d_dep / mean_dep\n    else:\n        radial = d_dep\n\n    # Primary score: keep distance-to-current raw; replace depot term with\n    # scale-invariant radial ratio.  Also add a mild capacity-fill preference\n    # via remaining-capacity-normalized demand handled through a small tie-break.\n    score = d_cur + radial\n\n    # Secondary ordering: among near-tied candidates, prefer larger demand\n    # (fills the vehicle, fewer routes); scale-invariant since it's demand-based.\n    span = float(np.max(score) - np.min(score))\n    if span > 0.0:\n        gate = 0.02 * span\n    else:\n        gate = 0.0\n\n    order = np.argsort(score)\n    best = order[0]\n    best_score = score[best]\n    best_demand = demands[unvisited_nodes[best]]\n\n    for idx in order[1:]:\n        s = score[idx]\n        if s - best_score > gate:\n            break\n        d = demands[unvisited_nodes[idx]]\n        if d > best_demand:\n            best = idx\n            best_demand = d\n\n    return int(unvisited_nodes[best])","code_sha256":"d67a4a5344de1c3fbf9b922c9c9cb2fc2f2fea6785a7963d30900b08acd825a2","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"5dc2599875484c56a2ae285892ded668","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[0.23088659180993926,0.3565841918547166,0.07587627944136409,0.19150348626675034],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.583754098015177,14.274527008398366,13.349181191714754,14.877362112040123],"reference_kind":["solver_reference","solver_reference","solve