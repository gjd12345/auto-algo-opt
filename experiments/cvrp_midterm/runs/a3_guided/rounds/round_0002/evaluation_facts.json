em / (1.0 + dem)\n    score = base * (1.0 + pressure)\n    return int(unvisited_nodes[int(np.argmax(score))])","code_sha256":"3de1cea0e6ee9ce5a0efd38287138253c513c22a647f5afae2e27f5fd4a25ddd","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"807fe90ad9c042e1bcc96fe6613906f8","generation_parents":[{"algorithm":"Replace the ratio-normalised savings term with a scale-free form that subtracts a span-proportional penalty for going far from the depot, and add a cheap second-order tie-break by demand saturation, leaving distance-to-current and depot-distance terms intact.","code_sha256":"aed816831cf8ccbc0193352f819fa857f79dfb060634946e11d0954c20d3ef8c","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[-0.0091086480135631,0.09475598956179418,-0.08598942607092273,0.05826067853775875],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.74024959843852,11.519464869511982,11.340795401547306,13.213664504557542],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.014479648503766773,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[unvisited_nodes, depot]\n    stem = distance_matrix[current_node, depot]\n    # Pure Clarke-Wright style savings, no span normalisation.\n    score = stem + to_depot - cur\n    # Cheap second-order stage: among near ties, prefer the node that\n    # leaves the largest capacity headroom (i.e. smallest demand).\n    order = np.argsort(-score)\n    best_score = score[order[0]]\n    tol = 1e-9 * (abs(best_score) + 1.0)\n    tied = order[score[order] >= best_score - tol]\n    if tied.size > 1:\n        dem = demands[unvisited_nodes[tied]]\n        best = tied[int(np.argmin(dem))]\n    else:\n        best = order[0]\n    return int(unvisited_nodes[best])","code_sha256":"7d0a6686f8ae127c7f73833c1cb3c8fd26b3d84cdc7253380ccc289114b99598","elapsed_seconds":0.203,"error_code":null,"error_detail":null,"evaluation_id":"cfe0fa06d83e4e9eb764c9ea01a21dda","generation_parents":[{"algorithm":"Replace the ratio-normalised savings term with a scale-free form that subtracts a span-proportional penalty for going far from the depot, and add a cheap second-order tie-break by demand saturation, leaving distance-to-current and depot-distance terms intact.","code_sha256":"aed816831cf8ccbc0193352f819fa857f79dfb060634946e11d0954c20d3ef8c","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_11.json","instance_objectives":[-0.01088467441988962,-0.035289160382148285,-0.07955394939818419,0.021501249872857318],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.719206934919567,10.151077255730304,11.420645051363962,12.75467857830318],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486