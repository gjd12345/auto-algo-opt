    cap_term = 0.6 * fill + 0.4 * (4.0 * fill * (1.0 - fill))\n\n    # Primary score: proximity to current + centrality vs depot + capacity use.\n    primary = 1.0 - (0.55 * cur_n + 0.25 * dep_n) + 0.20 * cap_term\n\n    order = np.argsort(-primary)\n    best_local = order[0]\n    best_score = primary[best_local]\n\n    # Cheap second ordering stage: among near-ties, pick the geometrically\n    # closest node to the current position (nearest-neighbor refinement).\n    tol = 0.02 * (primary.max() - primary.min() + 1e-12)\n    tie_mask = primary >= (best_score - tol)\n    if np.count_nonzero(tie_mask) > 1:\n        tie_idx = np.nonzero(tie_mask)[0]\n        nn = tie_idx[np.argmin(cur[tie_idx])]\n        return int(unvisited_nodes[nn])\n\n    return int(unvisited_nodes[best_local])","code_sha256":"fd94bc88ec85222e065effd4722a93a7458c1545437f95b2c0ede1d14d55ff7f","elapsed_seconds":0.235,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"ac55352eef8c47beb9a9f87dd9955a16","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_8.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[unvisited_nodes, depot]\n    stem = distance_matrix[current_node, depot]\n    # Savings from inserting the node before returning, relative to replaced leg.\n    savings = stem + to_depot - cur\n    # Span-proportional normaliser (max depot distance among candidates), scale-free.\n    span = float(np.max(to_depot)) if to_depot.size > 0 else 1.0\n    span = span if span > 1e-12 else 1.0\n    score = savings / span\n    # Cheap second-order stage: prefer higher demand saturation on near ties.\n    order = np.argsort(-score)\n    best = order[0]\n    best_score = score[best]\n    tol = 1e-9\n    # Among candidates within tol of the best score, break ties by demand ratio.\n    tied = order[score[order] >= best_score - tol]\n    if tied.size > 1:\n        cap = rest_capacity if rest_capacity > 1e-12 else 1.0\n        dem_ratio = demands[unvisited_nodes[tied]] / cap\n        best = tied[int(np.argmax(dem_ratio))]\n    return int(unvisited_nodes[best])","code_sha256":"aed816831cf8ccbc0193352f819fa857f79dfb060634946e11d0954c20d3ef8c","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"9641c309e4f34aacb6438c4ea48cf0de","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[-0.014351542118523157,-0.0014463634748596375,-0.11240880431230435,-0.020838359264966064],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.678130895629158,10.50718483931666,11.012990918954035,12.226017349791574],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10