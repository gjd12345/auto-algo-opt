e leg it replaces.\n-    savings = stem + to_depot - cur\n-    score = savings / (cur + 1e-12)\n-    return int(unvisited_nodes[np.argmax(score)])+    # Detour added if we visit this node before heading back to the depot.\n+    detour = cur + to_depot - distance_matrix[current_node, depot]\n+    # Span-proportional denominator keeps the score scale-invariant.\n+    span = cur + to_depot\n+    # Capacity pressure: when capacity is tight, prefer bigger-demand nodes.\n+    dem = demands[unvisited_nodes]\n+    cap_pressure = dem / (rest_capacity + 1e-9)\n+    score = detour / (span + 1e-9) + 0.25 * cap_pressure\n+    return int(unvisited_nodes[np.argmin(score)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"81d07aa1f0b3fa3ffeaf2e35d3da13640b1801a2166ed0b1581e42ed260fe660","evaluation_id":"10eabf8530d0463f8fe734e4b1e27ce1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[0],"selected_parent_position":0}],"instance_objectives":[0.11446009230298058,0.04679438318246023,3.526270399757876e-05,0.05014855516422855],"lineage_status":"verified","objective":0.05285957333841674,"origin":"generated","revision":"original","source_request_index":14,"valid":true},"generated_count":5},"suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6"}
