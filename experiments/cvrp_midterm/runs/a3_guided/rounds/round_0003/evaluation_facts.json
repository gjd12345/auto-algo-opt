ent_node, depot]\n    a = stem\n    b = to_depot\n    c = cur\n    denom = 2.0 * np.sqrt(np.maximum(a * b, 1e-12))\n    cos_theta = np.clip((a * a + b * b - c * c) / denom, -1.0, 1.0)\n    detour = 1.0 - cos_theta\n\n    dem = demands[unvisited_nodes]\n    fill = dem / (rest_capacity + dem + 1e-12)\n\n    # Look-ahead return term: cheaper to return when capacity after service is ample\n    rem_after = np.maximum(rest_capacity - dem, 1e-12)\n    return_term = to_depot / (rem_after + 1e-12)\n\n    # Scale-normalize the return term by its own candidate-set mean\n    rmean = np.mean(return_term) + 1e-12\n    ret_norm = return_term / rmean\n\n    score = 0.7 * detour - 0.4 * fill + 0.35 * ret_norm\n\n    order = np.argsort(score)\n    best = order[0]\n    # Cheap second ordering stage: among near-ties, prefer larger capacity margin\n    margin = rest_capacity - dem\n    if order.size > 1 and (score[order[1]] - score[best]) < 0.05 * (abs(score[best]) + 1e-12):\n        tied = order[(score[order] - score[best]) < 0.05 * (abs(score[best]) + 1e-12)]\n        best = tied[np.argmax(margin[tied])]\n\n    return int(unvisited_nodes[best])","code_sha256":"54da64ecfe352eb9889850822d3ccc1382232d10b778994025c73a4d2f87ef19","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"152171b78c7f4fd6ab69b3e8eecb4716","generation_parents":[{"algorithm":"Replace the savings ratio with an additive polar-coordinate score that penalizes the angular detour from the current heading and rewards demand utilization, choosing the customer that best continues the sweep while filling the vehicle.","code_sha256":"73a1f19d233447606a7711699cd1a063a23c8a63eee7d2adec734403bfd4f954","population_member_indices":[2],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_16.json","instance_objectives":[0.23416250268186206,0.3616858548025538,0.11181332640089452,0.27249949019948866],"lineage_status":"verified","metrics":{"fitness_defini