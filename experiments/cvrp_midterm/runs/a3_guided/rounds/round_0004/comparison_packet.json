 Index of the next node to visit, or 0 to return to the depot early.\n-    \"\"\"\n     if unvisited_nodes.size == 0:\n         return depot\n+\n     cur = distance_matrix[current_node][unvisited_nodes]\n     to_depot = distance_matrix[unvisited_nodes, depot]\n     stem = distance_matrix[current_node, depot]\n-    savings = stem + to_depot - cur\n-    score = savings / (stem + 1e-12)\n-    return int(unvisited_nodes[np.argmax(score)])+\n+    # Marginal detour of inserting c before the return leg (>= 0 by triangle ineq).\n+    detour = cur + to_depot - stem\n+\n+    # Dimensionless demand pressure: defer heavy stops when capacity is tight.\n+    demand_frac = demands[unvisited_nodes] / (rest_capacity + 1e-12)\n+\n+    # Scale-free normalized cost: detour per unit return distance, penalized\n+    # by how much of the remaining capacity this stop would consume.\n+    cost = detour / (to_depot + 1e-12) + demand_frac\n+    return int(unvisited_nodes[np.argmin(cost)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":5},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"a449bee640ae9561c7faf07d064e5b1e387f34c438f16c954e6ab8bf52d445e5","evaluation_id":"0f2bbace43334f1a91ed4baa19ad73c5","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[0],"selected_parent_position":0}],"instance_objectives":[-0.07096711615848021,-0.032431723698829226,-0.14855556629067174,-0.06413588678364318],"lineage_status":"verified","objective":-0.07902257323290608,"origin":"generated","revision":"original","source_request_index":20,"valid":true},"generated_count":5},"suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6"}
