e scale-free penalty: demand fraction still to be carried on this\n    # trip (how \"heavy\" the stop is relative to remaining capacity), plus a\n    # proportional detour cost. Both are dimensionless so the score is\n    # invariant to coordinate scale.\n    demand_frac = demands[unvisited_nodes] / (rest_capacity + 1e-12)\n    scale = stem + 1e-12\n    detour = to_depot / scale  # relative extra distance if we detour now\n\n    score = savings / scale - demand_frac - 0.5 * detour\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"6726c9133153189fdcceaf70e88c66598f8f719aaab5a3733a513b19906fed86","elapsed_seconds":0.219,"error_code":null,"error_detail":null,"evaluation_id":"6e3a373d944741e59eee78c86318a372","generation_parents":[{"algorithm":"Replace the savings-ratio score with a scale-invariant normalized savings term that divides by the stem distance instead of the current leg, keeping all other terms and the CVRP feasibility structure unchanged.","code_sha256":"a449bee640ae9561c7faf07d064e5b1e387f34c438f16c954e6ab8bf52d445e5","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_21.json","instance_objectives":[-0.05970358090552693,0.027952460903046965,-0.03813652394971091,-0.06761641533198977],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.140792211534176,10.816531148316352,11.934541237543556,11.641936743206909],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.03437601482104516,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[unvisited_nodes, depot]\n    stem = distance_matrix[current_node, depot]\n    savings = stem + to_depot - cur\n    # Capacity-aware denominator: penalise leaving lots of unused capacity\n    # relative to the scale of the current leg (scale-invariant).\n    cap_frac = demands[unvisited_nodes] / (rest_capacity + 1e-12)\n    denom = (cur + 1e-12) * (1.0 + cap_frac)\n    score = savings / denom\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"18c662f9a52cc52a2f2d45b2c74602bc288d2b36897462e9842d900034576936","elapsed_seconds":0.235,"error_code":null,"error_detail":null,"evaluation_id":"ea4267cbdf4c49e39caffafde02fa657","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"254310d5f6f237ba81171e2db12733e1a41f497aa4eda3217fec16a3ee75783b","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.