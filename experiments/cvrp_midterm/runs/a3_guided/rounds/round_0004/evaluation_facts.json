nt normalized savings term that divides by the stem distance instead of the current leg, keeping all other terms and the CVRP feasibility structure unchanged.","code_sha256":"a449bee640ae9561c7faf07d064e5b1e387f34c438f16c954e6ab8bf52d445e5","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Replace the multiplicative savings normalization with an additive, scale-free penalty that subtracts both the remaining-capacity pressure and the return-to-depot detour from the raw savings, so the score becomes a net benefit (savings minus insertion cost) rather than a ratio.","code_sha256":"6726c9133153189fdcceaf70e88c66598f8f719aaab5a3733a513b19906fed86","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.2924909259284884,0.28327630853020447,0.22084919034177528,0.1651048053432956],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[15.31365274678981,13.5031518392586,15.147965766187177,14.547742652336321],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.24043030753594094,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[unvisited_nodes, depot]\n    stem = distance_matrix[current_node, depot]\n    # Savings if we insert this customer via the depot stem\n    savings = stem + to_depot - cur\n    # Utilization weighting: full vehicle favors far customers\n    load = demands[unvisited_nodes]\n    total_demand = float(np.sum(demands))\n    util = 1.0 - rest_capacity / (total_demand + 1e-12)\n    util = float(np.clip(util, 0.0, 1.0))\n    weight = 1.0 + util * to_depot / (stem + 1e-12)\n    score = weight * savings / (stem + 1e-12)\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"378b957eb0f82ae233f204e5cdc38040f82337ddb685988289f077e0acdcb336","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"32a2d13430414120a4df3f345cad94e9","generation_parents":[{"algorithm":"Replace the savings-ratio score with a scale-invariant normalized savings term that divides by the stem distance instead of the current leg, keeping all other terms and the CVRP feasibility structure unchanged.","code_sha256":"a449bee640ae9561c7faf07d064e5b1e387f34c438f16c954e6ab8bf52d445e5","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[0.1228476375702139,-0.007812966565485371,-0.05895617896370517,-0.02992254209285407],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-re