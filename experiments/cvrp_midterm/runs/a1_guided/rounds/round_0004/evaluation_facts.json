se = d_cur - 0.6 * d_dep\n\n    order = np.argsort(base)\n    best_idx = order[0]\n    best_score = base[best_idx]\n\n    span = float(base[order[-1]] - base[order[0]])\n    band = 1e-2 * span + 1e-12\n\n    near = order[base[order] <= best_score + band]\n    if near.size <= 1:\n        return int(unvisited_nodes[best_idx])\n\n    near_nodes = unvisited_nodes[near]\n    slack = rest_capacity - demands[near_nodes]\n    feasible = slack >= 0\n    if not np.any(feasible):\n        return int(unvisited_nodes[best_idx])\n\n    # refine: balance capacity fit with route-closing cost\n    scale = span if span > 0.0 else 1.0\n    fit = np.where(feasible, slack / (rest_capacity + 1e-12), np.inf)\n    close_cost = distance_matrix[depot][near_nodes] / scale\n    score = fit + 0.15 * close_cost\n    score = np.where(feasible, score, np.inf)\n    pick_local = int(np.argmin(score))\n    return int(near_nodes[pick_local])","code_sha256":"8b6a4ff6893e481814dd1132a2d09f19d38c90aed8d976c9508c2d7707720c2e","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"d6b4484131da44788552d1502a0dfbdd","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"e6792bef77ce8feeb72e5ed270628a1bd52685b2f7b01e219ed644f5f6997c80","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_22.json","instance_objectives":[-0.003536428674306673,-0.049370293940090244,-0.06234242745639311,-0.012013897537173154],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[11.806270202744907,10.002909878807756,11.63420094935759,12.336201427372043],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.0318157619019908,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    nodes = unvisited_nodes\n    d_cur = distance_matrix[current_node][nodes]\n    d_dep = distance_matrix[depot][nodes]\n    dem = demands[nodes]\n\n    # scale-free normalization of each signal across candidates\n    cur_span = float(np.max(d_cur) - np.min(d_cur))\n    dep_span = float(np.max(d_dep) - np.min(d_dep))\n    cur_scale = cur_span if cur_span > 0.0 else 1.0\n    dep_scale = dep_span if dep_span > 0.0 else 1.0\n\n    n_cur = (d_cur - np.min(d_cur)) / cur_scale\n    n_dep = (d_dep - np.min(d_dep)) / dep_scale\n\n    # capacity utilization: how full the vehicle becomes after serving this node\n    cap = rest_capacity if rest_capacity > 0.0 else 1.0\n    used = np.clip(dem / cap, 0.0, 1.0)\n    # prefer using more of the remaining capacity, but not overflowing\n    fit = 1.0 - used\n\n    # continuous multiplicative-ish combination, no tie band\n    score = n_cur + 0.55 * n_dep + 0.9 * fit\n\n    return int(nodes[int(np.argmin(score))])","code_sha256":"29b158b5803e0bb59c455261065ded3b65144c6fda30bf128ad4d49cac6a518d","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"ac5b6dd0ccd940f68898b14bb76a3f8d","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"e6792bef77ce8feeb72e5ed270628a1bd52685b2f7b01e219ed644f5f6997c80","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Sort all feasible customers by the base score d_cur - 0.6*d_dep, then among a scale-free near-tie window defined by the span of base scores, refine by a composite priority that rewards tight capacity fit (small slack) while penalizing distance back to the depot, so the next stop balances route-closing cost against packing the vehicle fuller.","code_sha256":"8b6a4ff6893e481814dd1132a2d09f19d38c90aed8d976c9508c2d7707720c2e","population_member_indices":[2],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_23.json","instance_objectives":[0.1907698206120329,0.12419453271691226,0.1096230996197459,0.14712208080421768],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[14.108443756469965,11.829229115534272,13.767902587300636,14.323206586926071],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":0.1429273834382272,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    base = d_cur - 0.6 * d_dep\n\n    order = np.argsort(base)\n    best_idx = order[0]\n    best_score = base[best_idx]\n\n    span = float(base[order[-1]] - base[order[0]])\n    band = 1e-2 * span + 1e-12\n\n    near = order[base[order] <= best_score + band]\n    if near.size <= 1:\n        return int(unvisited_nodes[best_idx])\n\n    near_nodes = unvisited_nodes[near]\n    near_base = base[near]\n    slack = rest_capacity - demands[near_nodes]\n    d_dep_near = d_dep[near]\n\n    feasible = slack >= 0\n    if np.any(feasible):\n        # capacity-fit refinement: prefer small slack, blended with depot proximity\n        slack_norm = np.where(feasible, slack, np.inf)\n        max_slack = float(np.max(slack_norm[np.isfinite(slack_norm)])) if np.any(np.isfinite(slack_norm)) else 1.0\n        if max_slack <= 0:\n            max_slack = 1.0\n        fit = slack_norm / max_slack\n        dep_norm = d_dep_near / (float(np.max(d_dep_near)) + 1e-12)\n        refined = 0.7 * fit + 0.3 * dep_norm\n        refined = np.where(feasible, refined, np.inf)\n        pick_local = int(np.argmin(refined))\n        return int(near_nodes[pick_local])\n\n    return int(unvisited_nodes[best_idx])","code_sha256":"94fd75f1cd1cdaa82716783a2bd042d772addb62838cd943ecb48b499e41fe5a","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"8f1ce10bbc6b4e3d810e4cad78653585","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"e6792bef77ce8feeb72e5ed270628a1bd52685b2f7b01e219ed644f5f6997c80","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_24.json","instance_objectives":[-0.003536428674306673,-0.049370293940090244,-0.06234242745639311,-0.012013897537173154],"lineage_status":"verified","metrics":{"fitness_definition":"mean((raw_objective-ref