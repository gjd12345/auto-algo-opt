near_mask)[0]\n    # Capacity-fit refinement: prefer largest demand that still fits,\n    # i.e. minimize remaining slack after serving.\n    dem = demands[unvisited_nodes[near_idx]]\n    # Prefer larger demand (tighter packing), break ties by distance\n    fit_slack = rest_capacity - dem\n    # Score: minimize slack (maximize demand used), tie-break by base distance\n    # Use base value scaled small so demand dominates subtly\n    score = fit_slack * 1e-9 + base[near_idx]\n    chosen = near_idx[int(np.argmin(score))]\n    return int(unvisited_nodes[chosen])","code_sha256":"2ddde3d7f6be67d43717b4af95c6b9e6c78738dd977b00a888bc96e8645f0766","elapsed_seconds":0.234,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"c8e9c665d6514d70ace036380829c539","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":false},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    base = d_cur - 0.6 * d_dep\n\n    span = float(base.max() - base.min()) if base.size > 1 else 0.0\n    band = 1e-3 * span + 1e-12\n\n    best = int(np.argmin(base))\n    best_score = base[best]\n\n    mask = base <= best_score + band\n    candidates = unvisited_nodes[mask]\n    cand_base = base[mask]\n\n    if candidates.size == 1:\n        return int(candidates[0])\n\n    # Capacity-fit refinement: prefer customer filling the remaining capac