node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    base = d_cur - 0.6 * d_dep\n\n    order = np.argsort(base)\n    best_idx = order[0]\n    best_score = base[best_idx]\n\n    span = float(base[order[-1]] - base[order[0]])\n    band = 1e-3 * span + 1e-12\n\n    # collect near-ties within the scale-free band\n    near = order[base[order] <= best_score + band]\n    if near.size <= 1:\n        return int(unvisited_nodes[best_idx])\n\n    # refine: prefer best capacity fit (smallest remaining slack after serving)\n    near_nodes = unvisited_nodes[near]\n    slack = rest_capacity - demands[near_nodes]\n    # among near-ties, pick smallest nonnegative slack; fall back to best base\n    feasible = slack >= 0\n    if np.any(feasible):\n        slack_masked = np.where(feasible, slack, np.inf)\n        pick_local = int(np.argmin(slack_masked))\n        return int(near_nodes[pick_local])\n\n    return int(unvisited_nodes[best_idx])","code_sha256":"e6792bef77ce8feeb72e5ed270628a1bd52685b2f7b01e219ed644f5f6997c80","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"ed04b8a7f30c459094634b8b93cc40be","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[-0.07483430192061301,-0.10745995457127756,-0.06234242745639311,-0.08937557253763181],"lineage_status":"no_parent","metrics":{"fitness_definition":"mean((raw_objective-reference_objective)/reference_objective)","raw_objectives":[10.961520850486027,9.391666997925519,11.63420094935759,11.370247348478046],"reference_kind":["solver_reference","solver_reference","solver_reference","solver_reference"],"reference_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943]},"objective":-0.08350306412147887,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"3735556bcd35e48a2980433e0430fbf0a299984320a011ef95af9c549dd5d8d6","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    base = d_cur - 0.6 * d_dep\n\n    order = np.argsort(base)\n    best_idx = order[0]\n    best_score = float(base[best_idx])\n\n    span = float(d_cur.max() - d_cur.min()) if d_cur.size > 1 else 0.0\n    band = 1e-2 * span + 1e-12\n\n    second_score = float(base[order[1]])\n    if second_score - best_score > band:\n        return int(unvisited_nodes[best_idx])\n\n    # Near-tie: refine with capacity-fit term among candidates within band.\n    cap = float(rest_capacity)\n    best_val = None\n    best_node = int(unvisited_nodes[best_idx])\n    for i in range(unvisited_nodes.size):\n        b = float(base[i])\n        if b - best_score > band:\n            continue\n        dem = float(demands[unvisited_nodes[i]])\n        # Prefer candidates that fit snugly: smaller leftover capacity is better.\n        fit = dem / cap if cap > 0 else 0.0\n        val = b - 0.5 * fit * (span if span > 0 else 1.0)\n        if best_val is None or val < best_val:\n            best_val = val\n            best_node = int(unvisited_nodes[i])\n    return best_node","code_sha256":"158420516dab4983f2985d3988aeadb483784973e804762b5e1180fe120566de","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"1cc08a7679dd4697b6ae3cae0efdaf59","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[-0.0205777383996028,-0.049370293940090244,-0.06380137711629989,-0.012013897537173154],"lineage_status":"no_parent","metrics":{"fitness_