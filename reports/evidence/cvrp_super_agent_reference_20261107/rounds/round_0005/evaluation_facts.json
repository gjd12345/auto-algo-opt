urrent_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings: how much we gain by inserting j between current and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n\n    # Capacity-aware boost: larger demands get bonus when capacity is tight\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n\n    effective = savings * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"e101bc3e429041169f9cace3e1c927ce","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings: how much we gain by inserting j between current and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n\n    # Capacity-aware boost: larger demands get bonus when capacity is tight\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n\n    effective = savings * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"b3882a59e81d4bc4853f288c20b7141a","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    u = np.asarray(unvisited_nodes)\n    d_cur = distance_matrix[current_node][u]\n    d_depot = distance_matrix[depot][u]\n    d_cur_depot = float(distance_matrix[current_node][depot])\n    dem = demands[u].astype(float)\n    cap = max(float(rest_capacity), 1e-9)\n\n    # Immediate insertion cost: distance added minus the depot-return it displaces.\n    insert_cost = d_cur + d_depot - d_cur_depot\n\n    # Capacity-fit reward: prefer customers whose demand consumes remaining capacity well.\n    fit = 1.0 - np.abs(cap - dem) / cap\n\n    # One-step lookahead: cheapest feasible next move after serving this customer.\n    lookahead = np.empty(u.size)\n    for k in range(u.size):\n        rem = cap - dem[k]\n        if rem <= 1e-9 or u.size == 1:\n            lookahead[k] = d_depot[k]\n            continue\n        others = np.delete(u, k)\n        feas = others[demands[others].astype(float) <= rem + 1e-9]\n        if feas.size == 0:\n            lookahead[k] = d_depot[k]\n        else:\n            lookahead[k] = float(np.min(distance_matrix[u[k]][feas]))\n\n    # Additive blend: lower is better.\n    score = insert_cost + 0.3 * lookahead - 0.2 * cap * fit\n\n    idx = int(np.argmin(score))\n    return int(u[idx])","code_sha256":"fd4349076b6ab329c492838c0764dff7a66d0c9cd79da8455ced0ae57e9c27e4","elapsed_seconds":0.25,"error_code":"forbidden_attribute","error_detail":"empty","evaluation_id":"111900c40e984275a44c8762e7cf370b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0005/eoh_run/results/exchanges/request_18.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    n = int(unvisited_nodes.size)\n    if n == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = float(distance_matrix[current_node][depot])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n    effective = savings * (1.0 + demand_bonus)\n\n    # Shortlist a few promising customers by incumbent savings score.\n    k = min(4, n)\n    order = np.argsort(-effective)\n    shortlist = order[:k]\n\n    weights = np.linspace(1.0, 0.3, k)\n    best_val = None\n    best_idx = int(unvisited_nodes[shortlist[0]])\n\n    for rank, pos in enumerate(shortlist):\n        cust = int(unvisited_nodes[pos])\n        rem_after = float(rest_capacity) - float(demands[cust])\n\n        # Lookahead: best next feasible continuation distance after this pick.\n        candidates = unvisited_nodes[unvisited_nodes != cust]\n        if candidates.size > 0:\n            feas = candidates[demands[candidates] <= rem_after + 1e-9]\n        else:\n            feas = candidates\n\n        if feas.size > 0:\n            d_to_cust = float(distance_matrix[current_node][cust])\n            next_d = float(np.min(distance_matrix[cust][feas]))\n            lookahead = d_to_cust + next_d\n        else:\n            lookahead = float(distance_matrix[current_node][cust]) + float(\n                distance_matrix[cust][depot]\n            )\n\n        # Blend savings-based preference with lookahead (modest weight).\n        primary = float(effective[pos])\n        val = primary - 0.35 * weights[rank] * lookahead\n\n        if best_val is None or val > best_val:\n            best_val = val\n            best_idx = cust\n\n    return best_idx","code_sha256":"4e6714f7b2795d29299479369736181ce7eca7e68ec7caeffd2b4beab419dbad","elapsed_seconds":0.266,"error_code":"forbidden_attribute","error_detail":"linspace","evaluation_id":"5b4b60c94f1740f09374ecc85b25f382","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0005/eoh_run/results/exchanges/request_19.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false}],"comparison_packet":{"ref":"rounds/round_0005/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"9d8c1bc9b58a29ebfe2ee588aa43e7c791125669527a1266aa5d09c83836413c"},"dual_budget":{"baseline_attempts":5,"novel_candidate_evaluations":14,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":8,"total_evaluation_attempts":27},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:f54f152d42bb4c598d86d6a950864860"