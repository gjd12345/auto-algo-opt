])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"95d50c8a69524142976cbf0cda98181a","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return int(depot)\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cap = max(float(rest_capacity), 1e-9)\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n    d_cur_dep = float(distance_matrix[current_node][depot])\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Normalized distance signal in [0, ~1]\n    dmax = max(float(np.max(d_cur)), 1e-9)\n    dist_term = d_cur / dmax\n\n    # Depot-detour penalty: how much returning costs relative to moving on\n    detour = (d_cur + d_dep - d_cur_dep) / max(d_cur_dep + float(np.max(d_cur + d_dep)), 1e-9)\n\n    # Residual-capacity fit: prefer demands that either fill the vehicle\n    # or leave a reasonable remainder for future stops.\n    frac_used = dem / cap                      # fraction of remaining capacity consumed\n    residual_after = (cap - dem) / cap         # fraction remaining afterwards\n    # Desirable when frac_used is moderate-to-high but not overloaded\n    fill_term = 1.0 - np.abs(frac_used - 0.75)  # peak preference near 75% fill\n    # Penalize leaving too much unused capacity (waste) mildly\n    waste_term = 0.3 * residual_after\n\n    score = 0.55 * dist_term + 0.35 * detour - 0.30 * fill_term + 0.10 * waste_term\n\n    # Early-return branch: if best candidate is worse than going home,\n    # return to depot to restart with full capacity.\n    best_idx = int(np.argmin(score))\n    best_improvement = d_cur[best_idx] - d_cur_dep\n    if best_improvement > 0.5 * d_cur_dep and rest_capacity < 0.35 * cap:\n        return int(depot)\n\n    return int(unvisited_nodes[best_idx])","code_sha256":"45b1efa2aebdec27ca3b9b7e7ff6e2757b047e05e185575c0c73ce26744a5c63","elapsed_seconds":0.343,"error_code":null,"error_detail":null,"evaluation_id":"032756e34fb9479dace86cd63bc02669","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_12.json","instance_objectives":[13.027373793184804,11.788356930944435,11.26552694207383,13.253361251919625,13.46423536