ne more stop.\n    frac = dem[local] / cap\n    # Quadratic peak near frac ~ 0.6, plus penalty for very small fills.\n    fit = 1.0 - np.abs(frac - 0.6) - 0.25 * (frac < 0.15)\n    # Break ties with geographic proximity (smaller distance is better).\n    dist_local = d_cur[local]\n    dmax = max(float(np.max(dist_local)), 1e-9)\n    proximity = 1.0 - dist_local / dmax\n\n    score = 0.55 * fit + 0.45 * proximity\n    best = int(local[int(np.argmax(score))])\n    best_node = int(unvisited_nodes[best])\n\n    # Step 3: depot-return check. If the chosen stop is far and remaining\n    # capacity is mostly spent, finishing the route is cheaper.\n    detour_cost = float(d_cur[best]) + float(d_dep[best]) - d_cur_dep\n    if detour_cost > d_cur_dep and cap < 0.30 * float(np.sum(dem) + cap):\n        return int(depot)\n\n    return best_node","code_sha256":"72aa4bb2bb57df8057db9f856b2754cfd7c4336369cf1b04b2058b8de4c9db9e","elapsed_seconds":0.312,"error_code":"invalid_route","error_detail":null,"evaluation_id":"e02accbb6f50484d94631c774c75e2ec","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"At each step, choose the unvisited customer that minimizes a composite score blending nearest-neighbor distance, a residual-capacity fit term (encouraging demands that fill remaining capacity or leave room for more), and a depot-return penalty, with an explicit depot branch when no customer improves the current route.","code_sha256":"45b1efa2aebdec27ca3b9b7e7ff6e2757b047e05e185575c0c73ce26744a5c63","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7