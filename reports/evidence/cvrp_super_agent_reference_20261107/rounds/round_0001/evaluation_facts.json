es.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_leg = distance_matrix[current_node][depot]\n\n    incremental = d_cur + d_depot - d_leg\n    demand = demands[unvisited_nodes].astype(float)\n\n    if rest_capacity > 0:\n        pressure = demand / max(rest_capacity, 1e-9)\n    else:\n        pressure = demand\n\n    # Prefer depot-aware savings while slightly favoring customers that\n    # use more of the remaining capacity (packing pressure).\n    score = incremental - 0.1 * pressure * d_leg\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"4d02c83c2f3a9f975e53ebb90be3509fb6304192241ecb0292aefbc37a3bd58f","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"cf00c04b9ba84db1aa28f1690fe26729","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[11.854379065252886,11.307784522987255,12.654970815152538,12.687992133528931,13.049766865546285,11.910985751779302],"lineage_status":"no_parent","objective":12.244313192374534,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur_depot = distance_matrix[current_node][depot]\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n\n    # Incremental distance if we go current -> j -> depot, compared with\n    # the direct current -> depot return leg.\n    extra = d_cur + d_depot - d_cur_depot\n\n    # Capacity pressure: when remaining capacity is small relative to demands,\n    # slightly favor larger demands to reduce fragmented routes.\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    pressure = dem / cap_scale  # in [0,1] for feasible nodes\n\n    # Small weighted combination; primary signal is depot-aware extra distance.\n    score = extra - 0.05 * pressure * max(d_cur_depot, 1e-9)\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"1c6f1776cd64e261c3fb556c6be88ddd59bdaf063991e0f2222d65f1404be111","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"c699063c843549ab805b2014f0488749","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[11.700367111598865,11.307784522987255,12.654970815152538,12.687992133528931,13.015800008622929,11.910985751779302],"lineage_status":"no_parent","objective":12.212983390611639,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node in a CVRP construction using depot-aware savings.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_leg = distance_matrix[current_node][depot]\n    demand_vals = demands[unvisited_nodes]\n\n    # Incremental route cost: detour incurred by inserting j now.\n    incremental = d_cur + d_dep - d_leg\n\n    # Capacity pressure: lower remaining capacity after serving j -> higher pressure.\n    # Normalize demands by rest_capacity to stay scale-free.\n    cap_frac = np.maximum(rest_capacity, 1e-9)\n    pressure = demand_vals / cap_frac  # in (0, 1] roughly\n\n    # Blend: prioritize low detour cost, but reward packing more demand\n    # when the vehicle is nearly full (pressure-weighted savings).\n    # Score lower is better.\n    score = incremental * (1.0 - 0.5 * pressure) - 0.5 * pressure * d_dep\n\n    best_idx = np.argmin(score)\n    return int(unvisited_nodes[best_idx])","code_sha256":"018b8aadadd03a8ab0f748c288dc8f966a9946192afbe0fda6241c7fff763134","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"cbec1369b1d848a58c1be40f3aad3ecd","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[12.091672699475696,11.823078630335853,12.632624029536082,12.747018664125584,14.836291645103946,12.146077835197314],"lineage_status":"no_parent","objective":12.712793917295746,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings: how much we gain by inserting j between current and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n\n    # Capacity-aware boost: larger demands get bonus when capacity is tight\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n\n    effective = savings * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"833b0d5097c34b01bdeeb784be6bc588","generation_parents":[{"algorithm":"Use a depot-return-aware savings score per candidate: prefer customers that minimize the extra distance to visit them and return to the depot relative to continuing from the current node, while adding a small capacity-pressure term that favors serving larger demands 