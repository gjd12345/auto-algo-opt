licit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"b13dddf383404f1ca09f87cccca40e08","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"2272a7adc3b846059a0434d0d6fe253d","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    k = int(min(5, unvisited_nodes.size))\n    if k < unvisited_nodes.size:\n        order = np.argsort(-savings)[:k]\n        cand = unvisited_nodes[order]\n    else:\n        cand = unvisited_nodes\n\n    dc = distance_matrix[cur][cand].astype(float)\n    dd = distance_matrix[dep][cand].astype(float)\n    dem = demands[cand].astype(float)\n\n    cap_scale = max(float(rest_capacity), 1e-9)\n    depot_scale = np.maximum(dd, 1e-9)\n\n    # Dimensionless components: demand fraction filled, extra cost relative to\n    # direct depot distance, and fraction of the direct depot leg saved.\n    demand_frac = np.clip(dem / cap_scale, 0.0, 1.5)\n    extra_ratio = np.clip(dc / depot_scale, 0.0, 4.0)\n    detour_ratio = np.clip((dc + dd - d_cur_depot) / (d_cur_depot + 1e-9), 0.0, 4.0)\n\n    # Pressure increases as capacity tightens relative to total remaining demand.\n    total_dem = float(dem.sum())\n    tight = 1.0 - min(float(rest_capacity) / max(total_dem, 1e-9), 1.0)\n\n    if cur == dep:\n        composite = 0.55 * demand_frac - 0.30 * extra_ratio - 0.15 * detour_ratio\n    else:\n        composite = (\n            (0.30 + 0.35 * tight) * demand_frac\n            - (0.35 - 0.20 * tight) * extra_ratio\n            - 0.25 * detour_ratio\n        )\n\n    best = float(composite[0])\n    best_j = 0\n    for j in range(1, cand.size):\n        v = float(composite[j])\n        if v > best + 1e-12:\n            best = v\n            best_j = j\n        elif abs(v - best) <= 1e-12:\n            if dc[j] < dc[best_j] - 1e-12:\n                best_j = j\n\n    return int(cand[best_j])","code_sha256":"27f65d54c3af88e8d33ea44aa64e5c27b13db1029e98f03da418f6fffd2d5dce","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"9a49b23f41e5439cb802a4a2ba74fe73","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0014/eoh_run/results/exchanges/request_45.json","instance_objectives":[13.179985220284856,11.132061738328193,13.398683758077876,13.113911430606908,11.571085396412675,12.3466993539478],"lineage_status":"verified","objective":12.45707114960972,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    # Absolute Clarke-Wright savings: primary signal.\n    savings = d_cur_depot + d_depot - d_cur\n\n    # Detect near-ties among the top candidates to refine with a normalized score.\n    order = np.argsort(-savings)\n    best_saving = float(savings[order[0]])\n    tol = 0.02 * max(abs(best_saving), 1e-9) + 1e-12\n    tie_mask = savings >= (best_saving - tol)\n\n    if int(tie_mask.sum()) <= 1:\n        return int(unvisited_nodes[order[0]])\n\n    # Normalized secondary ranking applied only within the near-tie set.\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    route_scale = np.maximum(d_cur + d_depot, 1e-9)\n    normalized_saving = savings / route_scale\n\n    demand_penalty = dem / cap_scale\n    local_score = normalized_saving - 0.1 * demand_penalty\n\n    tie_indices = np.nonzero(tie_mask)[0]\n    best_local = tie_indices[np.argmax(local_score[tie_indices])]\n\n    return int(unvisited_nodes[best_local])","code_sha256":"ccdab29f7d08ab162145ae7e