licit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"8f99b34df68d417d915431da3bd4aa6b","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur