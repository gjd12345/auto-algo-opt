nt, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    total_dem = max(dem.sum(), 1e-9)\n    cap_pressure = 1.0 - min(float(rest_capacity) / total_dem, 1.0)\n\n    # Dimensionless radial scale: the two depot radii\n    radial_scale = float(distance_matrix[dep][cur]) + d_depot\n    radial_scale = np.maximum(radial_scale, 1e-9)\n    radial_change = (d_cur - d_depot) / radial_scale\n\n    # Small bounded near-tie adjustment modulated by capacity pressure\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        coeff = 0.02 + 0.10 * cap_pressure\n        alignment = 1.0 + coeff * cos_ang * np.tanh(radial_change)\n\n    effective = savings * alignment\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"7a7de3c5f7e2666c47bc3b071118a1ed09cdbb0bb094c3f8cfcac4d64c3fe8d4","elapsed_seconds":0.296,"error_code":"forbidden_attribute","error_detail":"tanh","evaluation_id":"4360f5c312d14ff29986ed10a0e4920b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0012/eoh_run/results/exchanges/request_39.json","instance_obj