em, 1e-9), 1.0)\n    if cur == dep:\n        coeff = 0.0\n    else:\n        coeff = 0.08 * (0.5 + 0.5 * tightness)\n\n    # Near-tie radial adjustment: prefer nodes with low radial detour.\n    score = base * (1.0 - coeff * (1.0 - radial))\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"d866092d1581af3cb55c39b026e48981413dbbd9a79f701331537fe5fb141483","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"e49fc03fb9ea44a881727f9d1cafba42","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0012/eoh_run/results/exchanges/request_40.json","instance_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943,12.86311599862195,12.465101170764052],"lineage_status":"verified","objective":12.098788332984556,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0012/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"589a36eeae4258e7ba10c2e8d93177908c588c7fe38402f075e655066d4d2526"},"dual_budget":{"baseline_attempts":12,"novel_candidate_evaluations":28,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":22,"total_evaluation_attempts":62},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:d62442562b4a4a9d8f2f58ec776167e1","evaluation:8f99b34df68d417d915431da3bd4aa6b","evaluation:c5dddbfdd77c41d9b967ff960881434c","evaluation:4360f5c312d14ff29986ed10a0e