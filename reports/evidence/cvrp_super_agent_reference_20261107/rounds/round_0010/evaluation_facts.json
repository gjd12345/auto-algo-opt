licit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"8ce66f76f8e049528464986858194fa9","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.438,"error_code":null,"error_detail":null,"evaluation_id":"a0d33eae22fa49ba89c9684162ba75eb","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n    n = int(unvisited_nodes.size)\n\n    dem = demands[unvisited_nodes].astype(float)\n    d_depot_cust = distance_matrix[dep][unvisited_nodes].astype(float)\n\n    # For each feasible customer, find its tightest peer among the other feasible customers.\n    peer_min = np.full(n, np.inf)\n    for i in range(n):\n        node_i = int(unvisited_nodes[i])\n        best = np.inf\n        for j in range(n):\n            if i == j:\n                continue\n            node_j = int(unvisited_nodes[j])\n            dij = float(distance_matrix[node_i][node_j])\n            if dij < best:\n                best = dij\n        peer_min[i] = best\n\n    if cur == dep:\n        # Cluster-aware depot start: balance radial closeness with tight peer coupling.\n        radial = d_depot_cust\n        peer = np.where(np.isfinite(peer_min), peer_min, 0.0)\n        max_radial = float(np.max(radial)) if n > 0 else 1.0\n        max_peer = float(np.max(peer)) if n > 0 else 1.0\n        max_radial = max(max_radial, 1e-9)\n        max_peer = max(max_peer, 1e-9)\n        score = (radial / max_radial) + (peer / max_peer)\n        idx = int(np.argmin(score))\n        return int(unvisited_nodes[idx])\n\n    cap_scale = max(float(rest_capacity), 1e-9)\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n\n    # Insertion-flavored delta: cost of going current->candidate plus candidate->nearest peer\n    # minus current->peer (approximating insertion into a best position).\n    peer = np.where(np.isfinite(peer_min), peer_min, 0.0)\n    delta = d_cur + peer\n\n    # Prefer nodes that are close to current, tightly clustered, and moderately sized in demand.\n    dem_norm = dem / cap_scale\n    score = delta * (1.0 + 0.15 * dem_norm) - 0.10 * d_depot_cust\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"d6732d0980f67eff1fe148b671750ad9952e2633113ce73f6ae2e3cccc009733","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"d0c50e2b49ed442c98e40adf0002fcbe","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0010/eoh_run/results/exchanges/request_33.json","instance_objectives":[12.640627856377527,12.35128811483504,12.399797994044363,12.848245971503886,14.208494599893703,11.296649388850707],"lineage_status":"verified","objective":12.624183987584203,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n    nodes = unvisited_nodes\n    n = int(nodes.size)\n\n    d_cur = distance_matrix[cur][nodes].astype(float)\n    d_depot = distance_matrix[dep][nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    if cur == dep:\n        # Two-signal cluster-start anchor: radial distance + nearest other peer.\n        best_idx = 0\n        best_score = None\n        for i in range(n):\n            ni = int(nodes[i])\n            peer_min = float(\"inf\")\n            for j in range(n):\n                if j == i:\n                    continue\n                nj = int(nodes[j])\n                dij = float(distance_matrix[ni][nj])\n                if dij < peer_min:\n                    peer_min = dij\n            if peer_min == float(\"inf\"):\n                peer_min = 0.0\n            radial = float(d_depot[i])\n            # Anchor favors close radial distance and a near peer (compact cluster start).\n            score = radial + 0.5 * peer_min\n            if best_score is None or score < best_score:\n                best_score = score\n                best_idx = i\n        return int(nodes[best_idx])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    n_unvis = float(n)\n    scarcity = 1.0 / (1.0 + n_unvis)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    # Stronger alignment weight (0.75 base) with gentler capacity scaling (0.2).\n    strength = 0.75 * (1.0 - 0.5 * scarcity) * (1.0 - 0.2 * tightness)\n    alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.04 + 0.18 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(nodes[idx])","code_sha256":"91a7049e72acf6d81eab99f4ca5e800df3bfbb02bed3a53c0678ef027c1c935c","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"e311a15e2a6c45239062951d9b998b1c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0010/eoh_run/results/exchanges/request_34.json","instance_objectives":[10.07423163401352,10.241856457891192,12.318055960776327,11.99786615998587,11.752829761720706,11.866366267485427],"lineage_status":"verified","objective":11.375201040312172,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0010/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"48243702689e63b0388fed5d1d03ce315e977fe6d6274860fe4aa20d901fecbe"},"dual_budget":{"baseline_attempts":10,"novel_candidate_evaluations":24,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":18,"total_evaluation_attempts":52},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:27f737241f5740549ef39ad2210e65e8","evaluation:8ce66f76f8e049528464986858194fa9","evaluation:a0d33eae22fa49ba89c9684162ba75eb","evaluation:d0c50e2b49ed442c98e40adf0002fcbe","evaluation:e311a15e2a6c45239062951d9b998b1c","rounds/round_0010/execution_delta.json","rounds/round_0010/comparison_packet.json"],"execution_delta":{"generated_count":2,"ref":"rounds/round_0010/execution_delta.js