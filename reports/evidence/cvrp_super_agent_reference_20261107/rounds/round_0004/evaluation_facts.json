])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"cfcf9321f00e47adb28e859cf0ea63c0","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings for inserting j between current node and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    # Balance-fit: how close the remaining capacity after serving j is\n    # to the mean demand of feasible customers (smaller imbalance = better).\n    mean_dem = max(float(dem.mean()), 1e-9)\n    leftover = cap_scale - dem\n    imbalance = np.abs(leftover - mean_dem) / max(cap_scale, 1e-9)\n\n    # Discount savings when the residual load is poorly balanced.\n    effective = savings * (1.0 - 0.5 * imbalance)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"e1d91b80dac36171ae13d8a8814826047e30b7cbecfc2e259dad8b041611367b","elapsed_seconds":0.25,"error_code":null,"error_detail":null,"evaluation_id":"bc4eabcf74ec4b4789502705642f8c2a","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_15.json","instance_objectives":[13.413024533112026,10.75273552090371,11.402172498227035,12.286172504487952,12.501985755868434,11.873712054991655],"lineage_status":"verified","objective":12.0383004779318,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-9)\n\n    # Mild demand reward: prefer filling the vehicle a bit.\n    demand_reward = 0.5 * (dem / cap)\n\n    # Light balance penalty based on residual capacity vs mean feasible demand.\n    mean_dem = max(float(dem.mean()), 1e-9)\n    leftover = cap - dem\n    imbalance = np.abs(leftover - mean_dem) / cap\n    balance_penalty = 0.25 * imbalance\n\n    score = savings + demand_reward - balance_penalty\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"54dd80adb5c86159f0ac8471d7fdcd331544c87354b311bcfe7007831e6ea14a","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"0c2fc141b32f4e24b4e5191af36dd56a","generation_parents":[{"algorithm":"Use a savings score but replace the multiplicative demand bonus with a route-fit penalty that ranks customers by savings discounted by the fraction of remaining capacity their demand would leave unbalanced relative to the average feasible demand.","code_sha256":"e1d91b80dac36171ae13d8a8814826047e30b7cbecfc2e259dad8b041611367b","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_16.json","instance_objectives":[12.899785132095904,10.882788412412614,11.935190195233