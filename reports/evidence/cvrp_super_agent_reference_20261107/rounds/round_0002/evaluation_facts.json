it_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings: how much we gain by inserting j between current and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n\n    # Capacity-aware boost: larger demands get bonus when capacity is tight\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n\n    effective = savings * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"19c5bfb14f3349dc9637098bcd795976","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings: how much we gain by inserting j between current and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n\n    # Capacity-aware boost: larger demands get bonus when capacity is tight\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n\n    effective = savings * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"27d3c24177134bc5b2f35327d025dce9","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_depot = distance_matrix[depot][unvisited_nodes]\n\n    # Explicit route-start rule: at the depot pick the farthest anchor\n    if current_node == depot:\n        return int(unvisited_nodes[int(np.argmax(d_depot))])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Demand-weighted savings: gain from inserting j between current and depot\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n\n    # Stronger capacity-tightness boost than the incumbent\n    demand_bonus = (dem / cap_scale) * (0.2 + 0.6 * tightness)\n\n    effective = savings * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"5f581ef220dae03a735c5aba9154d48567a1228fc9568aa8e68b942db853b0bc","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"36900298a79f4afaad0ebf9c6de814ba","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[13.059245959782853,10.64967551826498,12.626178463668126,12.536008981674465,11.673083761487323,11.864429388018793],"lineage_status":"verified","objective":12.068103678816088,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Route start: deliberate anchor selection away from the depot\n    if current_node == depot:\n        d_depot = distance_matrix[depot][unvisited_nodes].astype(float)\n        total_dem = max(float(dem.sum()), 1e-9)\n        # Distance-dominant anchor with a mild demand weighting to break ties\n        score = d_depot * (1.0 + 0.3 * (dem / total_dem))\n        idx = int(np.argmax(score))\n        return int(unvisited_nodes[idx])\n\n    # In-route: proximity-first with capacity-pressure adaptive blend\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(cap_scale / max(float(dem.sum()), 1e-9), 1.0)\n\n    # Normalise to comparable ranges\n    d_max = max(float(d_cur.max()), 1e-9)\n    dem_max = max(float(dem.max()), 1e-9)\n\n    prox = d_cur / d_max                      # smaller is better\n    dem_term = dem / dem_max                  # larger demand helpful when tight\n\n    # When capacity is tight, favour large-demand (fill-up) customers;\n    # when capacity is loose, favour proximity.\n    combined = (1.0 - 0.5 * tightness) * prox - (0.5 * tightness) * dem_term\n    idx = int(np.argmin(combined))\n    return int(unvisited_nodes[idx])","code_sha256":"2f136e8b045ce3ff18b0bf3ab6edf66b885547634d82e85bcdf478c76e237e51","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"e0c662fa26fe4458bb3bb590f652e673","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[14.142053778989425,14.403412396989111,15.067216690545045,15.525759161426917,14.388689564966183,13.946802731258687],"lineage_status":"verified","objective":14.578989054029229,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0002