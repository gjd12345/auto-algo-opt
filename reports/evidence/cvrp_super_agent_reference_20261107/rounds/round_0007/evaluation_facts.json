x])","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"ff596214db7247698b559f07de5c0230","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.198583758374369,11.350909666644094,12.0969780407392,12.247127512087909,11.791115863158351,11.692073087149602],"lineage_status":null,"objective":11.562797988025588,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    # Savings term (same family as incumbent) keeps constructive progress.\n    savings = d_cur_depot + d_depot - d_cur\n\n    # Directional cohesion via cosine law at the depot.\n    # If current is the depot (route start), there is no meaningful ray;\n    # use a neutral alignment of 1.0 for all candidates.\n    denom_cur = max(d_cur_depot, 1e-9)\n    # cos of angle at depot between (current - depot) and (candidate - depot):\n    # cos = (|cur|^2 + |cand|^2 - |cur-cand|^2) / (2*|cur|*|cand|)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Map cos in [-1,1] to a positive weight in [0.2, 1.2]\n        # Strong alignment (cos ~ 1) -> larger; backward -> smaller.\n        alignment = 0.7 + 0.5 * cos_ang\n\n    # Capacity-aware demand bonus, kept light so direction dominates.\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tightness)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"372075932f7ca48337ac9708518c5423e8b453a9351f31e4af8a23f6846c96b3","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"5647a0f8f20b429f8667081491401e62","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0007/eoh_run/results/exchanges/request_24.json","instance_objectives":[10.77200488855452,10.72974989762625,12.252748381950541,10.874326126090313,11.19760119578341,11.963293666179878],"lineage_status":"verified","objective":11.298287359364151,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    r_cur = float(distance_matrix[cur][dep])\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-9)\n\n    # Proximity: prefer close feasible candidates (normalised).\n    prox = d_cur / (d_cur.mean() + 1e-9)\n\n    # Radial cohesion: at route start, prefer mid-radius customers to seed\n    # coherent sectors; en route, penalise candidates drifting far from the\n    # current route's radial band around r_cur.\n    if cur == dep:\n        r_cand = d_depot\n        radial = r_cand / (r_cand.mean() + 1e-9)\n        radial_w = 0.15\n    else:\n        radial = np.abs(d_depot - r_cur) / (r_cur + 1e-9)\n        radial_w = 0.35\n\n    # Capacity-tightness demand bonus: when nearly full, favour small demands\n    # so the route can pack more stops; when empty, favour large demands.\n    fill = 1.0 - min(cap / max(dem.sum(), 1e-9), 1.0)\n    demand_term = (dem / cap) * (0.5 - 1.0 * fill)\n\n    score = 1.0 * prox + radial_w * radial + 0.4 * demand_term\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"a53f1caca194394f949263b634d436886fc802f07e49e17bba0a11c453050fac","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"0e440be73764498bb693a8a846ccfde2","generation_parents":[{"algorithm":"For each candidate, compute a sector-cohesion score from the cosine-law angle at the depot between the current-node ray and candidate ray, multiply by a savings term and a capacity-tightness demand bonus, then pick the maximum.","code_sha256":"372075932f7ca48337ac9708518c5423e8b453a9351f31e4af8a23f6846c96b3","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0007/eoh_run/results/exchanges/request_25.json","instance_objectives":[11.62435006080541,11.860067096657914,12.214215426573208,12.786782332431956,10.984802633909393,11.978358621373488],"lineage_status":"verified","objective":11.908096028625229,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0007/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"777cef62c1fec1a9b3b422165520170c20b8d9f8bfe647094cbf69b7912fb669"},"dual_budget":{"baseline_attempts":7,"novel_candidate_evaluations":18,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":12,"total_evaluation_attempts":37},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:f90ebc688a7c4d8e9575