licit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"94d84b8c752343a09012728635e68920","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        # Adaptive bounded alignment strength: softer when few options remain\n        # or capacity is nearly exhausted.\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"a80509020f434ec5962c1702fc64a478","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.13936722045008,10.72974989762625,12.252748381950541,11.35139704211339,11.270433754285351,10.923313615035399],"lineage_status":null,"objective":11.111168318576835,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    # Scale-normalized savings: divide by sum of the two depot radii.\n    radius_sum = np.maximum(d_cur_depot + d_depot, 1e-9)\n    norm_savings = savings / radius_sum\n\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n        strength = 0.5 * (1.0 - 0.6 * scarcity) * (1.0 - 0.3 * tightness)\n        alignment = (1.0 - strength) + strength * (1.0 + cos_ang)\n\n    tight_cap = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.05 + 0.25 * tight_cap)\n\n    effective = norm_savings * alignment * (1.0 + demand_bonus)\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"4139643259064f2e40ab90e0299a1436cdd50e851d3265f3206150fa3bb0086c","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"eb112940cd894315a842915b7970d937","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fb4e765586cd662b95365895b30b3f80e2618300e9bd9b4435ad6620bf80cfc8","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0013/eoh_run/results/exchanges/request_42.json","instance_objectives":[11.334934015068542,9.673084298761323,11.631659654315905,12.274132170846684,12.03840725584789,12.023420556364174],"lineage_status":"verified","objective":11.495939658534086,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = int(current_node)\n    dep = int(depot)\n\n    d_cur = distance_matrix[cur][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[dep][unvisited_nodes].astype(float)\n    d_cur_depot = float(distance_matrix[cur][dep])\n\n    # Classical savings, clipped to non-negative part for stability.\n    savings = d_cur_depot + d_depot - d_cur\n    savings_pos = np.maximum(savings, 0.0)\n\n    # Bounded scale-normalized savings: savings / (radius sum + savings).\n    radius_sum = d_cur_depot + d_depot\n    norm_savings = savings_pos / np.maximum(radius_sum + savings_pos, 1e-9)\n\n    # Cosine of angle at depot between cur and candidate.\n    denom_cur = max(d_cur_depot, 1e-9)\n    num = denom_cur * denom_cur + d_depot * d_depot - d_cur * d_cur\n    den = 2.0 * denom_cur * np.maximum(d_depot, 1e-9)\n    cos_ang = np.clip(num / den, -1.0, 1.0)\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n\n    # Capacity pressure: 0 when slack is ample, rises toward 1 when tight.\n    total_dem = max(dem.sum(), 1e-9)\n    pressure = 1.0 - min(float(rest_capacity) / total_dem, 1.0)\n\n    if cur == dep:\n        alignment = np.ones_like(cos_ang)\n    else:\n        n_unvis = float(unvisited_nodes.size)\n        scarcity = 1.0 / (1.0 + n_unvis)\n        strength = 0.45 * (1.0 - 0.5 * scarcity) * (1.0 - 0.25 * pressure)\n        alignment = 1.0 + strength * cos_ang\n\n    demand_bonus = (dem / cap_scale) * (0.03 + 0.22 * pressure)\n\n    effective = norm_savings * alignment + demand_bonus * norm_savings + 1e-12 * (1.0 / np.maximum(d_cur + d_depot, 1e-9))\n\n    idx = int(np.argmax(effective))\n    return int(unvisited_nodes[idx])","code_sha256":"9d4fe9f42cbe3b67f94cb1752ad4521506d2aeca748f11d9c33daea8a3be974f","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"21ba583689424b84a723545008a12dc1","generation_parents":[{"algorithm":"Replace the pure nearest-neighbor rule with a scale-normalized savings score that divides the classical Clarke-Wright savings by the sum of the two depot radii (current-depot plus customer-depot distances), retaining a bounded angular alignment term and a tight-capacity demand bonus so distant and near-depot customers are balanced.","code_sha256":"4139643259064f2e40ab90e0299a1436cdd50e851d3265f3206150fa3bb0086c","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"round