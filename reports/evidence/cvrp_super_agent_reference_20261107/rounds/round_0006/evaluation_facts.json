e:\n            continuation = float(distance_matrix[cand][depot])\n\n        load_frac = dem[k] / cap\n        score = step + 0.7 * continuation + 0.15 * float(dep[k]) + 0.1 * load_frac\n\n        if score < best_score:\n            best_score = score\n            best_node = cand\n\n    return best_node","code_sha256":"1ff66401a6a6f897c7ac20ebc117cc56157397d2b702fa9c8746109eee744a5d","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"4ed61f6e015c4457b959920595eeb23d","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0006/eoh_run/results/exchanges/request_21.json","instance_objectives":[13.06182022876659,13.493644864202032,11.681935606481794,12.616321803633005,14.83188206059604,13.19879538872563],"lineage_status":"verified","objective":13.147399992067514,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    n_feasible = int(unvisited_nodes.size)\n    if n_feasible == 0:\n        return int(depot)\n    if n_feasible == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap_scale = max(float(rest_capacity), 1e-9)\n    tightness = 1.0 - min(float(rest_capacity) / max(dem.sum(), 1e-9), 1.0)\n    demand_bonus = (dem / cap_scale) * (0.1 + 0.4 * tightness)\n    effective = savings * (1.0 + demand_bonus)\n\n    # Build a small shortlist of high-effective candidates via Python loop.\n    order = np.argsort(-effective)\n    short_k = min(4, n_feasible)\n    short_positions = [int(order[i]) for i in range(short_k)]\n\n    # For each candidate, estimate a one-step continuation:\n    # from candidate, go to its nearest other feasible stop (if capacity\n    # allows) and then to the depot; otherwise just go to the depot.\n    best_choice = int(unvisited_nodes[short_positions[0]])\n    best_cost = float(\"inf\")\n\n    for pos in short_positions:\n        cust = int(unvisited_nodes[pos])\n        c_dem = float(demands[cust])\n        remaining_after = float(rest_capacity) - c_dem\n\n        local_first = float(distance_matrix[current_node][cust])\n        local_best_cont = float(distance_matrix[cust][depot])\n\n        if remaining_after > 1e-9:\n            # find nearest remaining feasible stop to cust\n            for q in range(n_feasible):\n                other = int(unvisited_nodes[q])\n                if other == cust:\n                    continue\n                if float(demands[other]) <= remaining_after + 1e-9:\n                    step = float(distance_matrix[cust][other])\n                    back = float(distance_matrix[other][depot])\n                    cont = step + back\n                    if cont < local_best_cont:\n                        local_best_cont = cont\n\n        total = local_first + local_best_cont\n        if total < best_cost - 1e-12:\n            best_cost = total\n            best_choice = cust\n\n    return int(best_choice)","code_sha256":"d1b6045a19241c184c7ff5c6592091183964ae42a526c80c214223d803fb9328","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"b602cc167fca449c86a0f06f53e627c8","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"fdfd28b58f24a10098e122140b5b522a514e85ee80607711a7df83b91959023e","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0006/eoh_run/results/exchanges/request_22.json","instance_objectives":[14.462357040540567,11.661034317830143,13.887930185350402,14.523395543048725,15.0429519105272,15.365773577411856],"lineage_status":"verified","objective":14.157240429118147,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0006/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"4e5d4adc749295ea02695a952505ad7215d839d7bdb2bea88d0632426c949172"},"dual_budget":{"baseline_attempts":6,"novel_candidate_evaluations":16,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":10,"total_evaluation_attempts":32},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:6031443cfc884d239d73a2274318f3c6","evaluation:a03f5f3320544dbb8bf8949ffd404d36","evaluation:96511de64548405cb15939b6159f3bf4","evaluation:4ed61f6e015c4457b959920595eeb23d","evaluation:b602cc167fca4