,"code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[unvisited_nodes][depot]\n\n    base = cur + to_depot - distance_matrix[current_node][depot]\n\n    dem = demands[unvisited_nodes].astype(float)\n    if rest_capacity > 0:\n        load_after = (rest_capacity - dem) / rest_capacity\n        mid_penalty = np.abs(load_after - 0.35)\n    else:\n        mid_penalty = np.zeros_like(dem)\n\n    score = base + 0.15 * mid_penalty\n\n    if current_node == depot:\n        score = distance_matrix[depot][unvisited_nodes]\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"9954996aaf5387eb968afbf41f106b78026e335498f0b1c2ca850ff2f507ab40","elapsed_seconds":0.297,"error_code":"candidate_error","error_detail":null,"evaluation_id":"daec721af9594ecda4f1cd3d06d43eee","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return 0\n\n    unvisited_nodes = np.asarray(unvisited_nodes)\n    current_node = int(current_node)\n    depot = int(depot)\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_back = distance_matrix[current_node][depot]\n\n    # Route-closure detour cost\n    detour = d_cur + d_depot - d_back\n\n    # Demand-fit correction: prefer customers that help use capacity well\n    dem = demands[unvisited_nodes].astype(float)\n    if rest_capacity > 0:\n        fill_ratio = dem / float(rest_capacity)\n    else:\n        fill_ratio = np.ones_like(dem, dtype=float)\n\n    # Mild correction: reward filling capacity, but keep distance dominant\n    # Scale by typical distance scale to keep units comparable\n    scale = float(np.mean(d_cur)) if len(d_cur) > 0 and np.mean(d_cur) > 0 else 1.0\n    correction = scale * 0.10 * (1.0 - np.clip(fill_ratio, 0.0, 1.0))\n\n    scores = detour + correction\n\n    # Special handling at depot start: detour degenerates to 2*d_depot - 0,\n    # which is radial ranking; add demand correction similarly.\n    if current_node == depot:\n        scores = 2.0 * d_depot + correction\n\n    idx = int(np.argmin(scores))\n    return int(unvisited_nodes[idx])","code_sha256":"6f7086c81dbbfe3df96cde1486bbe074b3abdbf9f1b0fac21c88a7a7496a13c7","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"83ef5da25e594e9aa11fe91d9a93fa50","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[11.700367111598865,11.307784522987255,13.265526