fit = np.abs(rest_capacity - dem)\n\n    score = closure - 1e-6 * fit\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"a58bbc87ab2e8745ec05b3d0a7dd49beacbbf79aafc8fccb3f9bf652c7e56b7d","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"eb24ec4d44ce4589aea342a14425c011","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[11.700367111598865,11.40444429920327,12.875478981149193,13.174573286939689,13.234050118423133,11.992499707258132],"lineage_status":"no_parent","objective":12.396902250762047,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node]\n    d_depot_cur = distance_matrix[current_node][depot]\n\n    best_node = int(unvisited_nodes[0])\n    best_score = float(\"inf\")\n\n    for j in unvisited_nodes:\n        j = int(j)\n        dj = distance_matrix[j][depot]\n        closure = cur[j] + dj - d_depot_cur\n\n        dem = float(demands[j])\n        if rest_capacity > 0:\n            fit_penalty = 0.05 * dem / rest_capacity\n        else:\n            fit_penalty = 0.0\n\n        score = closure + fit_penalty\n\n        if score < best_score:\n            best_score = score\n            best_node = j\n\n    return best_node","code_sha256":"5c1eb1aa5415e2296f6606e41983385d8278155203ee1e3d3c3fb2ce7f6466e1","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"ecd0120c0b4543a89881082524595cb9","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[11.700367111598865,11.946667875375029,13.461841406682005,14.203083331734794,13.234050118423133,11.928480296548225],"lineage_status":"no_parent","objective":12.745748356727008,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return 0\n\n    unvisited_nodes = np.asarray(unvisited_nodes)\n    current_node = int(current_node)\n    depot = int(depot)\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_depot = distance_matrix[depot][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n\n    # capacity fill factor in (0, 1]\n    if rest_capacity > 0:\n        fill = np.clip(dem / float(rest_capacity), 0.0, 1.0)\n    else:\n        fill = np.ones_like(dem, dtype=float)\n\n    # prefer larger fills (well-utilised capacity) -> divide by (0.5 + fill)\n    cap_factor = 0.5 + fill\n\n    if current_node == depot:\n        # radial base at depot start\n        base = d_depot + 0.5 * d_depot\n    else:\n        # travel distance with mild pull back toward depot\n        base = d_cur + 0.5 * d_depot\n\n    scores = base / cap_factor\n    idx = int(np.argmin(scores))\n    return int(unvisited_nodes[idx])","code_sha256":"4c2b3b7fff29fc1d499bcc266c2f0babcfc62371dfb88d4feafb1837a379d802","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"8f2934a085f2489b8f1e019eff4df6d0","generation_parents":[{"algorithm":"Score each feasible candidate by its detour cost d(current,j)+d(j,depot)-d(current,depot), adjusted by a demand-fit bonus favoring demands close to remaining capacity, and pick the minimum-cost candidate.","code_sha256":"6f7086c81dbbfe3df96cde1486bbe074b3abdbf9f1b0fac21c88a7a7496a13c7","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[14.596742526918321,11.06451289752663,12.094677847933129,13.134611434920355,12.952851886113839,11.97552566673098],"lineage_status":"verified","objective":12.636487043357208,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return 0\n\n    unvisited_nodes = np.asarray(unvisited_nodes)\n    current_node = int(current_node)\n    depot = int(depot)\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_back = distance_matrix[current_node][depot]\n\n    detour = d_cur + d_depot - d_back\n\n    dem = demands[unvisited_nodes].astype(float)\n    if rest_capacity > 0:\n        fill_ratio = np.clip(dem / float(rest_capacity), 0.0, 1.0)\n    else:\n        fill_ratio = np.ones_like(dem, dtype=float)\n\n    scale = float(np.mean(d_cur)) if len(d_cur) > 0 and np.mean(d_cur) > 0 else 1.0\n\n    # Stronger preference for fuller capacity usage (squared fill reward)\n    correction = -scale * 0.35 * (fill_ratio * fill_ratio)\n\n    # Slight preference for not returning to depot too early\n    remaining_after = rest_capacity - dem\n    early_return_penalty = scale * 0.05 * np.where(remaining_after > 0, 1.0, 0.0)\n\n    scores = detour + correction + early_return_penalty\n\n    if current_node == depot:\n        scores = 2.0 * d_depot + correction + early_return_penalty\n\n    idx = int(np.argmin(scores))\n    return int(unvisited_nodes[idx])","code_sha256":"5483a174d4c5a4346b3697836ba278a51294786e65a084f41857bd122f631559","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"6c442b72668b4afdb0804b88a17a6496","generation_parents":[{"algorithm":"Score each feasible candidate by its detour cost d(current,j)+d(j,depot)-d(current,depot), adjusted by a demand-fit bonus favoring demands close to remaining capacity, and pick the minimum-cost candidate.","code_sha256":"6f7086c81dbbfe3df96cde1486bbe074b3abdbf9f1b0fac21c88a7a7496a13c7","population_member_indices":[0],"selected_parent_position":0}],"generat