       rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_dem = demands[unvisited_nodes]\n\n    # Discount the radial-to-depot closure term so the current leg stays dominant,\n    # while still discouraging drifting far from the depot.\n    alpha = 0.35\n    beta = 0.10\n\n    # Over-weight demand slightly to fill vehicles more fully before closing.\n    max_d = np.max(d_dem) if d_dem.size > 0 else 1.0\n    demand_norm = d_dem / max_d if max_d > 0 else d_dem\n\n    score = d_cur + alpha * d_dep - beta * demand_norm\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"19a64237ca3266816afaf0e9e3b285a0f6fe670db2120009a998ab68e186faf4","elapsed_seconds":0.266,"error_code":null,"error_detail":null,"evaluation_id":"44cabf094e694976a1dafba80d34a11e","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[11.141881132691088,11.71054393727798,13.216737564833636,13.337019085436715,13.158900998306958,12.681028098286404],"lineage_status":"verified","objective":12.54101846947213,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Savings-style score: combining current-leg distance with a\n    # discounted radial term and an insertion-style combined distance.\n    # Favour small: d(cur,u) + alpha * d(u,depot) - beta * d(cur,depot)\n    alpha = 0.4\n    beta = 0.25\n    score = cur + alpha * d_depot - beta * d_cur_depot\n\n    # Blend with a pure radial-discounted metric to avoid near-depot bias\n    radial = d_depot - 0.3 * cur\n    combined = score + 0.15 * radial\n\n    # Determine whether to return to depot early: if all remaining customers\n    # are far relative to the cost of returning, do so.\n    best_idx = int(np.argmin(combined))\n    best_cost = combined[best_idx]\n\n    # Early depot return check: if continuing is much worse than returning\n    return_cost = d_cur_depot\n    if return_cost < 0.5 * best_cost and cur[best_idx] > return_cost:\n        return depot\n    return int(unvisited_nodes[best_idx])","code_sha256":"603c8e12512dc03dc9edcedb54d4f8f0ad3b5bef447813fd82e8d73187b9ace4","elapsed_seconds":0.344,"error_code":"invalid_route","error_detail":null,"evaluation_id":"3bdc60b095254cf3b81bff4c0ceb7a61","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false}],"comparison_packet":{"ref":"rounds/round_00