_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    w = 0.6\n    nodes = np.asarray(unvisited_nodes)\n    n = nodes.size\n\n    d_cur = distance_matrix[current_node][nodes].astype(float)\n    d_dep = distance_matrix[depot][nodes].astype(float)\n    base = d_cur - w * d_dep\n    dem = demands[nodes].astype(float)\n\n    # Near-tie band around the best base score\n    best_base = float(np.min(base))\n    span = float(np.max(base) - best_base)\n    band = 1e-3 * (span + 1.0)\n    mask = base <= (best_base + band)\n\n    if mask.sum() >= 2 and current_node != depot:\n        # Distance-scaled capacity-fit term inside the band.\n        # Prefer candidates that leave a small residual gap relative to local distance.\n        # cap_fit small when demand well matches remaining capacity; scale by local distance.\n        cap_gap = np.abs(rest_capacity - dem)\n        local_scale = np.maximum(d_cur, 1e-9)\n        cap_term = 0.01 * (cap_gap / local_scale) * mask.astype(float)\n\n        corrected = base + cap_term - 1e-6 * dem\n\n        best_idx = None\n        best_val = None\n        for idx in range(n):\n            if mask[idx]:\n                val = corrected[idx]\n            else:\n                val = base[idx] - 1e-6 * dem[idx]\n            if best_val is None or val < best_val:\n                best_val = val\n                best_idx = idx\n        return int(nodes[best_idx])\n\n    # Fallback: pure incumbent scoring\n    best_idx = None\n    best_val = None\n    for idx in range(n):\n        val = base[idx] - 1e-6 * dem[idx]\n        if best_val is None or val < best_val:\n            best_val = val\n            best_idx = idx\n    return int(nodes[best_idx])","code_sha256":"141d99b6f7c62e60313feb2c520889a957da9ae00fd5138798f4de3c30e25627","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"4d5fb44736274f83b9795110cbaafd68","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.961520850486027,9.391666997925519,10.37381233447071,11.370247348478046,12.067167664225265,11.353612576888555],"lineage_status":null,"objective":10.919671295412352,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    w = 0.6\n    nodes = np.asarray(unvisited_nodes)\n    n = nodes.size\n\n    d_cur = distance_matrix[current_node][nodes].astype(float)\n    d_dep = distance_matrix[depot][nodes].astype(float)\n    base = d_cur - w * d_dep\n    dem = demands[nodes].astype(float)\n\n    # Near-tie band around the best base score\n    best_base = float(np.min(base))\n    span = float(np.max(base) - best_base)\n    band = 1e-3 * (span + 1.0)\n    mask = base <= (best_base + band)\n\n    if mask.sum() >= 2 and current_node != depot:\n        # Distance-scaled capacity-fit term inside the band.\n        # Prefer candidates that leave a small residual gap relative to local distance.\n        # cap_fit small when demand well matches remaining capacity; scale by local distance.\n        cap_gap = np.abs(rest_capacity - dem)\n        local_scale = np.maximum(d_cur, 1e-9)\n        cap_term = 0.01 * (cap_gap / local_scale) * mask.astype(float)\n\n        corrected = base + cap_term - 1e-6 * dem\n\n        best_idx = None\n        best_val = None\n        for idx in range(n):\n            if mask[idx]:\n                val = corrected[idx]\n            else:\n                val = base[idx] - 1e-6 * dem[idx]\n            if best_val is None or val < best_val:\n                best_val = val\n                best_idx = idx\n        return int(nodes[best_idx])\n\n    # Fallback: pure incumbent scoring\n    best_idx = None\n    best_val = None\n    for idx in range(n):\n        val = base[idx] - 1e-6 * dem[idx]\n        if best_val is None or val < best_val:\n            best_val = val\n            best_idx = idx\n    return int(nodes[best_idx])","code_sha256":"141d99b6f7c62e60313feb2c520889a957da9ae00fd5138798f4de3c30e25627","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"bda11b1d99b14afd97df53d9f5970b02","generation_parents":null,"generation