parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n    w = 0.6\n    best_val = None\n    best_node = 0\n    for j in unvisited_nodes:\n        j = int(j)\n        d_cur = float(distance_matrix[current_node][j])\n        d_dep = float(distance_matrix[depot][j])\n        score = d_cur - w * d_dep\n        # light demand tie-break: prefer larger demand to fill capacity\n        tie = -1e-6 * float(demands[j])\n        val = score + tie\n        if best_val is None or val < best_val:\n            best_val = val\n            best_node = j\n    return best_node","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"d77ae828be074dad8b8b1c858655ba4b","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.961520850486027,9.391666997925519,11.63420094935759,11.370247348478046,11.937005519861426,11.220618849112642],"lineage_status":null,"objective":11.085876752536874,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n    w = 0.6\n    best_val = None\n    best_node = 0\n    for j in unvisited_nodes:\n        j = int(j)\n        d_cur = float(distance_matrix[current_node][j])\n        d_dep = float(distance_matrix[depot][j])\n        score = d_cur - w * d_dep\n        # light demand tie-break: prefer larger demand to fill capacity\n        tie = -1e-6 * float(demands[j])\n        val = score + tie\n        if best_val is None or val < best_val:\n            best_val = val\n            best_node = j\n    return best_node","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"92a81116fe6e4569b0d95fad09ca034b","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.961520850486027,9.391666997925519,11.63420094935759,11.370247348478046,11.937005519861426,11.220618849112642],"lineage_status":null,"objective":11.085876752536874,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    w = 0.6\n    nodes = np.asarray(unvisited_nodes)\n    n = nodes.size\n\n    # Base linear score (incumbent structure)\n    d_cur = distance_matrix[current_node][nodes].astype(float)\n    d_dep = distance_matrix[depot][nodes].astype(float)\n    base = d_cur - w * d_dep\n    dem = demands[nodes].astype(float)\n\n    # Near-tie band: candidates within a small window of the best base score\n    best_base = float(np.min(base))\n    span = float(np.max(base) - best_base)\n    band = 1e-3 * (span + 1.0)\n    mask = base <= (best_base + band)\n\n    if mask.sum() >= 2 and current_node != depot:\n        # Directional cosine correction only inside the near-tie band.\n        # Direction from depot to current node.\n        dx = float(distance_matrix[depot][current_node])\n        # We need geometric direction; reconstruct from distance matrix is not\n        # possible, so use a proxy: angular coherence via cosine law on triangle\n        # (depot, current, candidate) using only distances.\n        d_dc = d_cur  # depot-current-to-candidate distances\n        dc = dx\n        # cosine of angle at current between (depot - current) and (candidate - current)\n        # via law of cosines: cos = (d_cur^2 + dc^2 - d_dep^2) / (2*d_cur*dc)\n        denom = 2.0 * d_dc * (dc if dc > 1e-12 else 1e-12)\n        num = d_dc * d_dc + dc * dc - d_dep * d_dep\n        cosv = num / (denom if np.ndim(denom) == 0 else np.where(denom > 1e-12, denom, 1e-12))\n        # If very close to depot (dc tiny), no direction; skip correction.\n        cosv = np.where(d_dc > 1e-12, cosv, 0.0)\n\n        corrected = base.copy()\n        # Small bounded correction favoring forward-going candidates (cos in [-1,1])\n        corrected = corrected + 0.02 * (-cosv) * mask.astype(float)\n        # Demand tie-break (same spirit as incumbent, scaled)\n        corrected = corrected - 1e-6 * dem\n\n        # Among band, pick by corrected; outside band keep base order.\n        best_idx = None\n        best_val = None\n        for idx in range(n):\n            if mask[idx]:\n                val = corrected[idx]\n            else:\n                val = base[idx] - 1e-6 * dem[idx] if False else base[idx]\n                # keep outside-band ranking purely by base + small demand tie-break\n                val = base[idx] - 1e-6 * dem[idx]\n            if best_val is None or val < best_val:\n                best_val = val\n                best_idx = idx\n        return int(nodes[best_idx])\n\n    # Fallback: pure incumbent scoring\n    best_idx = None\n    best_val = None\n    for idx in range(n):\n        val = base[idx] - 1e-6 * dem[idx]\n        if best_val is None or val < best_val:\n            best_val = val\n            best_idx = idx\n    return int(nodes[best_idx])","code_sha256":"b1c283b4155a6162e66f23c30bc9a2267c684c839a1735bb0247044bcac8c6ca","elapsed_seconds":0.265,"error_code":null,"error_detail":null,"evaluation_id":"c6e4280e8aba499c88de