.append(d_cur - w * d_dep)\n\n    base_arr = np.array(base, dtype=np.float64)\n    order = np.argsort(base_arr)\n    best_idx = int(order[0])\n    best_node = int(unvisited_nodes[best_idx])\n\n    # Only away from depot: apply small directional tie correction on near-tied set\n    if current_node != depot:\n        # near-tied threshold relative to best score\n        span = base_arr[order[-1]] - base_arr[order[0]]\n        thresh = base_arr[best_idx] + max(1e-9, 0.05 * (span + 1e-12))\n        near = base_arr <= thresh\n\n        # cosine-law directional correction: small penalty for turning back\n        # vector from depot->current\n        dc_x = float(distance_matrix[depot][current_node])\n        # avoid zero\n        if dc_x > 1e-12:\n            best_val = None\n            cand = best_node\n            for k in range(unvisited_nodes.size):\n                if not bool(near[k]):\n                    continue\n                jj = int(unvisited_nodes[k])\n                d_cur = float(distance_matrix[current_node][jj])\n                d_dep = float(distance_matrix[depot][jj])\n                # cos angle at current between (current->depot) and (current->jj)\n                # using sides: a = dist(depot,current), b = dist(current,jj), c = dist(depot,jj)\n                a = dc_x\n                b = d_cur\n                c = d_dep\n                denom = 2.0 * a * b\n                if denom > 1e-12:\n                    cosang = (a * a + b * b - c * c) / denom\n                    if cosang > 1.0:\n                        cosang = 1.0\n                    elif cosang < -1.0:\n                        cosang = -1.0\n                else:\n                    cosang = 0.0\n                # penalty for large cos (moving back toward depot direction)\n                val = base_arr[k] + 0.02 * b * cosang\n                if best_val is None or val < best_val:\n                    best_val = val\n                    cand = jj\n            best_node = cand\n\n    return best_node","code_sha256":"c5c469aaf8f035eba3a707a9472e150df002fa4e51b5dde67b48207560f95c74","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"55877299c4924450be8bdfe8f3b7eeea","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0005/eoh_run/results/exchanges/request_19.json","instance_objectives":[10.988637092106847,9.391666997925519,11.63420094935759,11.370247348478046,11.937005519861426,11.542629894526437],"lineage_status":"verified","objective":11.144064633709313,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0005/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"1091b52483016ebed09bb9e416c59743f827f37234a083564a64964dcc2d1f85"},"dual_budget":{"baseline_attempts":5,"novel_candidate_evaluations":14,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":8,"total_evaluation_attempts":27},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:3d2a61711b04465aaf793d434034d563","evaluation:d77ae828be074dad8b8b1c858655ba4b","evaluation:92a81116fe6e4569b0d95fad09ca034b","evaluation:c6e4280e8aba499c88ded6935915feff","evaluation:55877299c4924450be8bdfe8f3b7eeea","rounds/round_0005/execution_delta.json","rounds/round_0005/comparison_packet.json"],"execution_delta":{"generated_count":2,"ref":"rounds/round_0005/execution_delta.json","sha256":"5ed7f6e2552a2bfa855463a40a97c66463257ea67fb651c375b0b25839d40f0