ot early.\n+    \"\"\"\n+    if unvisited_nodes.size == 0:\n+        return 0\n+    w = 0.6\n+    best_val = None\n+    best_node = 0\n+    for j in unvisited_nodes:\n+        j = int(j)\n+        d_cur = float(distance_matrix[current_node][j])\n+        d_dep = float(distance_matrix[depot][j])\n+        score = d_cur - w * d_dep\n+        # light demand tie-break: prefer larger demand to fill capacity\n+        tie = -1e-6 * float(demands[j])\n+        val = score + tie\n+        if best_val is None or val < best_val:\n+            best_val = val\n+            best_node = j\n+    return best_node","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":2},"first_invalid":{"candidate_id":"candidate_1","code_sha256":"c63069e3a517e52ec868f02c3842a242eca58a1b5711efb5c98f31576f1cb259","error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"34972e32ce8f4f7daa5a65a21e527c6c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"instance_objectives":[],"lineage_status":"verified","origin":"generated","revision":"original","source_request_index":12,"valid":false},"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"c63069e3a517e52ec868f02c3842a242eca58a1b5711efb5c98f31576f1cb259","error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"34972e32ce8f4f7daa5a65a21e527c6c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa5