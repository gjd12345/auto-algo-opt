       rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cand = np.asarray(unvisited_nodes, dtype=np.int64)\n    d_cur = distance_matrix[current_node][cand]\n    d_dep = distance_matrix[depot][cand]\n\n    w = 0.5\n    scores = d_cur - w * d_dep\n\n    # light demand tie-break: prefer larger demand among near-equal scores\n    min_score = np.min(scores)\n    tol = 1e-9\n    mask = scores <= min_score + tol\n    if np.count_nonzero(mask) > 1:\n        sub = cand[mask]\n        sub_dem = demands[sub]\n        best = sub[np.argmax(sub_dem)]\n        return int(best)\n\n    idx = int(np.argmin(scores))\n    return int(cand[idx])","code_sha256":"c63069e3a517e52ec868f02c3842a242eca58a1b5711efb5c98f31576f1cb259","elapsed_seconds":0.282,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"34972e32ce8f4f7daa5a65a21e527c6c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"90b233618b839fa519829c738023b8ba29fc267cfa38b52569eda4df0572c992","population_member_indices":[0],"selected_parent_position":1}],"generation_r