 / max(rest_capacity, 1e-9)\n\n    # Depot attraction grows as capacity shrinks so late-stage nodes hug the depot.\n    deficit = rest_capacity / max(rest_capacity + total_demand, 1e-9)\n    w = 0.55 + 0.30 * (1.0 - deficit)\n\n    score = d_cur - w * d_dep - 0.25 * cap_fit * d_dep / max(d_cur + 1e-9, 1.0)\n\n    # Tiny deterministic tie-break on higher demand when scores tie.\n    score = score - 1e-6 * dem\n\n    return int(nodes[int(np.argmin(score))])","code_sha256":"afa61e899ba65ee051d542d5fdfc3921e0a007d399c19841bea36b3de9cd33b1","elapsed_seconds":0.265,"error_code":"candidate_error","error_detail":null,"evaluation_id":"22dc86853a524ab0a53e9ac6ae6757e5","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"141d99b6f7c62e60313feb2c520889a957da9ae00fd5138798f4de3c30e25627","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"141d99b6f7c62e60313feb2c520889a957da9ae00fd5138798f4de3c30e25627","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0007/eoh_run/results/exchanges/request_24.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    w = 0.6\n    nodes = np.asarray(unvisited_nodes)\n    n = nodes.size\n\n    d_cur = distance_matrix[current_node][nodes].astype(float)\n    d_dep = distance_matrix[depot][nodes].astype(float)\n    base = d_cur - w * d_dep\n    dem = demands[nodes].astype(float)\n\n    best_base = float(np.min(base))\n    span = float(np.max(base) - best_base)\n    band = 1e-3 * (span + 1.0)\n    mask = base <= (best_base + band)\n\n    # Strict shortlist: only the mask members when tie branch activates\n    if mask.sum() >= 2 and current_node != depot:\n        cap_gap = np.abs(rest_capacity - dem)\n        local_scale = np.maximum(d_cur, 1e-9)\n        # Bounded secondary correction, applied only inside the shortlist\n        cap_term = 0.01 * (cap_gap / local_scale)\n        cap_term = np.minimum(cap_term, 1.0) * mask.astype(float)\n\n        corrected = base + cap_term - 1e-6 * dem\n\n        best_idx = None\n        best_val = None\n        for idx in range(n):\n            if not mask[idx]:\n                continue\n            val = corrected[idx]\n            if best_val is None or val < best_val:\n                best_val = val\n                best_idx = idx\n        return int(nodes[best_idx])\n\n    # Fallback: pure incumbent scoring (unchanged)\n    best_idx = None\n    best_val = None\n    for idx in range(n):\n        val = base[idx] - 1e-6 * dem[idx]\n        if best_val is None or val < best_val:\n            best_val = val\n            best_idx = idx\n    return int(nodes[best_idx])","code_sha256":"f7b36da3931c39c376adaa5fc0258503166afc65e69bf42d01947c77708f081c","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"e21daa5f8b19432da925906