parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n    w = 0.6\n    best_val = None\n    best_node = 0\n    for j in unvisited_nodes:\n        j = int(j)\n        d_cur = float(distance_matrix[current_node][j])\n        d_dep = float(distance_matrix[depot][j])\n        score = d_cur - w * d_dep\n        # light demand tie-break: prefer larger demand to fill capacity\n        tie = -1e-6 * float(demands[j])\n        val = score + tie\n        if best_val is None or val < best_val:\n            best_val = val\n            best_node = j\n    return best_node","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"d4694fdce6234731ac9408b53d311b03","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.961520850486027,9.391666997925519,11.63420094935759,11.370247348478046,11.937005519861426,11.220618849112642],"lineage_status":null,"objective":11.085876752536874,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n    w = 0.6\n    best_val = None\n    best_node = 0\n    for j in unvisited_nodes:\n        j = int(j)\n        d_cur = float(distance_matrix[current_node][j])\n        d_dep = float(distance_matrix[depot][j])\n        score = d_cur - w * d_dep\n        # light demand tie-break: prefer larger demand to fill capacity\n        tie = -1e-6 * float(demands[j])\n        val = score + tie\n        if best_val is None or val < best_val:\n            best_val = val\n            best_node = j\n    return best_node","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"c3d87541ba494fa8b4706813d631389c","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.961520850486027,9.391666997925519,11.63420094935759,11.370247348478046,11.937005519861426,11.220618849112642],"lineage_status":null,"objective":11.085876752536874,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    # Current heading relative to depot: use distance geometry to approximate\n    # the direction the vehicle is traveling from the depot's perspective.\n    d_cur_dep = float(distance_matrix[current_node][depot])\n    d_cur_nodes = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep_nodes = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    # Angular alignment proxy via law of cosines: larger value = same bearing.\n    denom = 2.0 * np.maximum(d_cur_dep, 1e-9) * np.maximum(d_dep_nodes, 1e-9)\n    cos_theta = (d_cur_dep * d_cur_dep + d_dep_nodes * d_dep_nodes\n                 - d_cur_nodes * d_cur_nodes) / np.maximum(denom, 1e-9)\n    cos_theta = np.clip(cos_theta, -1.0, 1.0)\n\n    # Normalized demand: heavier customers favored to fill the vehicle sooner.\n    dem = demands[unvisited_nodes].astype(float)\n    max_dem = float(np.max(dem)) if dem.size > 0 else 1.0\n    dem_norm = dem / np.maximum(max_dem, 1e-9)\n\n    # Bounded capacity-adjusted coefficient: sweep harder when capacity is tight.\n    cap_ratio = rest_capacity / max(rest_capacity + float(np.sum(dem)), 1e-9)\n    w_ang = 0.55 + 0.35 * (1.0 - cap_ratio)\n\n    scores = d_cur_nodes - w_ang * (cos_theta + 1.0) * d_dep_nodes - 1e-6 * dem_norm\n    best_idx = int(np.argmin(scores))\n    return int(unvisited_nodes[best_idx])","code_sha256":"152c6296cbc887b71a1800509dad743a0222e247c5b523fe1e043b6b157ded7b","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"81482a24612243bca303d270f82726a2","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7272ea3c5de58ef64d527d36e530970e7027a089373ee6e9b0b07c08bc65a96f","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_15.json","instance_objectives":[13.027609104174081,10.788601510188224,12.320196649317715,12.634057827624126,12.121562221372812,11.46789355761118],"lineage_status":"verified","objective":12.059986811714689,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(float)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(float)\n\n    dem = demands[unvisited_nodes].astype(float)\n    max_dem = float(np.max(dem)) if dem.size > 0 else 1.0\n    dem_norm = dem / np.maximum(max_dem, 1e-9)\n\n    total_remaining = float(np.sum(dem))\n    cap_ratio = rest_capacity / max(rest_capacity + total_remaining, 1e-9)\n\n    # Base radial coefficient around the winning 0.60, bounded nearby.\n    w = 0.60 + 0.15 * (1.0 - cap_ratio)\n\n    # At the start of a route (vehicle at depot), bias more strongly toward\n    # farther depot-distance customers to spread coverage outward.\n    at_depot = (int(current_node) == int(depot))\n    if at_depot:\n        w = w * 1.10\n\n    scores = d_cur - w * d_dep - 1e-6 * dem_norm\n    best_idx = int(np.argmin(scores))\n    return int(unvisited_nodes[best_idx])","code_sha256":"2943171c804540aaf39db9935276079e12f9289dbd3d1d20ae841c0e9051d6ac","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"c1b1bb7d27fe41408e1b9a3a4ec52149","generation_parents":[{"algorithm":"The common backbone is a greedy score combining proximity to the current node with a radial depot attraction; the new algorithm replaces the linear penalty with an angular sweep that prefers customers whose direction from the depot aligns with the vehicle's current heading, adjusted by remaining capacity.","code_sha256":"152c6296cbc887b71a1800509dad743a0222e247c5b523fe1e043b6b157ded7b","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/reque