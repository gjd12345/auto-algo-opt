\n    cosv = (cpos * cpos + dpos * dpos - d_0cur * d_0cur) / denom\n    cosv = np.clip(cosv, -1.0, 1.0)\n\n    tie_fill = fill[tie_idx]\n    correction = -0.08 * cosv + 0.06 * tie_fill\n    j = int(np.argmin(correction))\n    return int(cand[j])","code_sha256":"16b53a649a747432942f7fa6869ca735eb30b30db2ba33dd22a7240cc735e5bb","elapsed_seconds":0.266,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"8cb88d1f341a4d8aa408fa29c0f4faf9","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"9187b462f849a5c77333b5a05166f0c1deb2c948ac2ad5d69f9cda4f0c01fbb4"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":10,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":4,"total_evaluation_attempts":17},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:bf9ce8bb51e34d6f8ac1f9d30141147b","evaluation:0b85b2bc165d4f088803daaf5f489fc4","evaluation:d84d256aa6284760ba8fa2fed743c973","evaluation:5503f65fcf174141812b0d32d61173e6","evaluation:8cb88d1f341a4d8aa408fa29c0f4faf9","rounds/round_0003/execution_delta.json","rounds/round_0003/comparison_packet.json"],"execution_delta":{"generate