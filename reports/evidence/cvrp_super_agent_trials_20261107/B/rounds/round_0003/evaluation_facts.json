st_capacity > 0 else 1.0\n    # Capacity fit: prefer customers that fill remaining capacity nicely\n    fit = np.abs(demand / cap - 0.5)\n\n    # Angular alignment: reward continuing away from depot, penalize heading back\n    cur_dep = float(distance_matrix[depot][current_node])\n    if cur_dep > 1e-9 and current_node != depot:\n        # cosine of angle between (current - depot) and (candidate - depot)\n        # using law of cosines: cos = (d0c^2 + d0j^2 - dcj^2) / (2*d0c*d0j)\n        num = cur_dep * cur_dep + d_dep * d_dep - d_cur * d_cur\n        den = 2.0 * cur_dep * d_dep\n        den = np.where(den > 1e-9, den, 1.0)\n        align = np.clip(num / den, -1.0, 1.0)\n    else:\n        align = np.zeros_like(d_dep)\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n\n    # Primary score: close to current, good capacity fit, aligned outward\n    score = d_cur / dmax - 0.20 * align + 0.25 * fit\n\n    best_val = float(np.min(score))\n    # Near-tie band: rerank ties by pure nearest neighbor distance\n    band = 0.05\n    tie_mask = score <= best_val + band * (1.0 + abs(best_val))\n    if np.count_nonzero(tie_mask) > 1:\n        tie_idx = np.nonzero(tie_mask)[0]\n        local = d_cur[tie_idx]\n        best_local = int(tie_idx[int(np.argmin(local))])\n        return int(unvisited_nodes[best_local])\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"ed6b05beba5be3b6916008c414d95a543a5178a11995541d00eb91a4e767aaf9","elapsed_seconds":0.266,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"5503f65fcf174141812b0d32d61173e6","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[0],"select