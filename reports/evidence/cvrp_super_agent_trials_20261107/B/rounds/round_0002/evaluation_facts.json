parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    dep_norm = d_dep / dmax\n\n    score = d_cur - 0.45 * d_dep + 0.20 * (1.0 - fill) * d_dep + 0.25 * dep_norm * dmax\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"7e6d52bd331c1990704d380821d34be9511220436029f2e967364d344f8f8883","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"10969ecf1ff0439eab043ef961e3d7ad","generation_parents":null,"generation_request_ref":null,"instance_objectives":[12.158862981925234,10.37379084130805,11.811567980554083,10.785984527414724,13.084444890687477,11.331871442971794],"lineage_status":null,"objective":11.591087110810227,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    dep_norm = d_dep / dmax\n\n    score = d_cur - 0.45 * d_dep + 0.20 * (1.0 - fill) * d_dep + 0.25 * dep_norm * dmax\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"7e6d52bd331c1990704d380821d34be9511220436029f2e967364d344f8f8883","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"88a09fdce2284e60801cc3f1ff102cf8","generation_parents":null,"generation_request_ref":null,"instance_objectives":[12.158862981925234,10.37379084130805,11.811567980554083,10.785984527414724,13.084444890687477,11.331871442971794],"lineage_status":null,"objective":11.591087110810227,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    dep_norm = d_dep / dmax\n\n    # Incumbent structure: current distance minus fill-weighted depot radius\n    score = d_cur - 0.20 * fill * d_dep\n\n    # Modest bounded angular sector penalty away from the depot direction\n    dx_cur = distance_matrix[current_node][depot]\n    if dx_cur <= 0:\n        dx_cur = 1.0\n    # cosine of angle at depot between current node and each candidate\n    # using law of cosines: cos = (d(cur,depot)^2 + d(cand,depot)^2 - d(cur,cand)^2) / (2*d(cur,depot)*d(cand,depot))\n    d_cd = d_cur\n    denom = 2.0 * dx_cur * d_dep + 1e-12\n    cos_ang = (dx_cur * dx_cur + d_dep * d_dep - d_cd * d_cd) / denom\n    cos_ang = np.clip(cos_ang, -1.0, 1.0)\n    sector_pen = 0.10 * dmax * (1.0 - cos_ang) * 0.5  # bounded in [0, 0.10*dmax]\n    score = score + sector_pen\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"9ad58749bf6308084ace0d97f52ac2b869488888bf35ba051452574b6d6af990","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"54ee315a03b94728a2d53da0bbd9f57c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7e6d52bd331c1990704d380821d34be9511220436029f2e967364d344f8f8883","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[12.158862981925234,10.37379084130805,12.108805073565687,10.785984527414724,13.084444890687477,11.331871442971794],"lineage_status":"verified","objective":11.64062662631216,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    # Clarke-Wright savings relative to depot for inserting node j after current\n    savings = d_0cur + d_dep - d_cur\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    # Prefer high savings, push radially outward early, penalize draining capacity\n    score = -savings / dmax + 0.15 * radial + 0.10 * fill\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"dc1135d6c6f94e7597a2d5bd4b923c01","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7e6d52bd331c1990704d380821d34be9511220436029f2e967364d344f8f8883","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7e6d52bd331c1990704d380821d34be9511220436029f2e967364d344f8f8883","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[10.916202994711067,9.884793575563295,11.422537750988724,12.145807891593172,12.516141516538696,11.628154443517097],"lineage_status":"verified","objective":11.418939695485342,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"6cc4593e6af8db3690c465fc4fde1bba88cf4639761f349bebbd171fb8489592"},"dual_budget":{"baseline_attempts":2,"novel_candidate_evaluations":8,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":2,"total_evaluation_attempts":12},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:091635bef2284a22a514c2ca62842e41","evaluation:10969ecf1ff043