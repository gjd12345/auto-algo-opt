date_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    eps = 1e-9\n\n    # Clarke-Wright savings: benefit of inserting j on current partial route\n    # versus serving j via a dedicated depot round trip.\n    savings = d_0cur + d_dep - d_cur\n\n    # Additive composite score (not multiplicative):\n    #  - savings drives the choice (more positive savings is better)\n    #  - fill penalty: reward nodes that consume remaining capacity efficiently\n    #    (use a concave sqrt shape to avoid over-favoring the largest demand)\n    fill_bonus = np.sqrt(fill)\n    #  - radial term: gentle far-first bias to avoid stranding distant nodes\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    score = savings + 0.30 * fill_bonus * (d_0cur + eps) + 0.15 * radial * dmax\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"2db24c04a8c484d85100837727a6893bc1d86b7c5ee01c3f2f1ab0836fd41b4f","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"b6689d25a0634830bf7eceacc350748f","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"68cd510af3df75d8f1b45182b248f07d7e38cedc4bfc1d74f5669a6b9ad81727","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"68cd510af3df75d8f1b45182b248f07d7e38cedc4bfc1d74f5669a6b9ad81727","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0008/eoh_run/results/exchanges/request_27.json","instance_objectives":[11.7047799357965,10.295326740547152,12.152645207948892,12.116676493528798,11.811603351399663,11.491009309059583],"lineage_status":"verified","objective":11.595340173046765,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    eps = 1e-9\n\n    savings = d_0cur + d_dep - d_cur\n    leg_scale = d_0cur + d_cur + eps\n    sav_norm = savings / leg_scale\n\n    fill_pressure = fill * fill\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    score = (sav_norm + 1.0) * (1.0 + 0.35 * fill_pressure) * (1.0 + 0.20 * radial)\n\n    best = float(np.max(score))\n    band = 0.02 * (abs(best) + eps)\n    near = score >= (best - band)\n\n    if np.count_nonzero(near) <= 1:\n        idx = int(np.argmax(score))\n        return int(unvisited_nodes[idx])\n\n    # Small bounded correction among near-equal candidates:\n    # reward positive depot savings (benefit direction preserved).\n    pos_sav = np.maximum(savings, 0.0) / leg_scale\n    corrected = np.where(near, score + 0.005 * pos_sav, score)\n    idx = int(np.argmax(corrected))\n    return int(unvisited_nodes[idx])","code_sha256":"43bb275f080174c96ddfc561ba9db20a901e2fb4ab3d0ed2100de82515ac1d0d","elapsed_seconds":0.281,"error_code":"forbidden_attribute","error_detail":"count_nonzero","evaluation_id":"81209e8fd38a40999c9197fb07708b38","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"68cd510af3df75d8f1b45182b248f07d7e38cedc4bfc1d74f5669a6b9ad81727","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0008/eoh_run/results/exchanges/request_28.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":false}],"comparison_packet":{"ref":"rounds/round_0008/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"ebacffdfefb2378ea3a526fce962c0dcb93eb8e30d4561b24b8067d02340e556"},"dual_budget":{"baseline_attempts":8,"novel_candidate_evaluations":20,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":14,"total_evaluat