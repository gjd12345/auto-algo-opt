parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    # Clarke-Wright savings relative to depot for inserting node j after current\n    savings = d_0cur + d_dep - d_cur\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    # Prefer high savings, push radially outward early, penalize draining capacity\n    score = -savings / dmax + 0.15 * radial + 0.10 * fill\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"532134a6788f427a8de2901584d95cc0","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.916202994711067,9.884793575563295,11.422537750988724,12.145807891593172,12.516141516538696,11.628154443517097],"lineage_status":null,"objective":11.418939695485342,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    # Clarke-Wright savings relative to depot for inserting node j after current\n    savings = d_0cur + d_dep - d_cur\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    # Prefer high savings, push radially outward early, penalize draining capacity\n    score = -savings / dmax + 0.15 * radial + 0.10 * fill\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"44ba527c7c28452d940347e87099bf43","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.916202994711067,9.884793575563295,11.422537750988724,12.145807891593172,12.516141516538696,11.628154443517097],"lineage_status":null,"objective":11.418939695485342,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    # Clarke-Wright savings relative to depot for inserting node j after current\n    savings = d_0cur + d_dep - d_cur\n\n    # Primary score: savings normalized by the marginal detour distance,\n    # so both large saving and cheap transition are rewarded jointly.\n    eps = 1e-9\n    denom = d_cur + eps\n    ratio = savings / denom\n\n    best_ratio = float(np.max(ratio))\n\n    # Near-tie mask: candidates whose ratio is close to the best one.\n    tol = 1e-6 + 0.02 * abs(best_ratio)\n    close_mask = ratio >= (best_ratio - tol)\n    close_count = int(close_mask.sum())\n\n    if close_count <= 1:\n        idx = int(np.argmax(ratio))\n        return int(unvisited_nodes[idx])\n\n    # Secondary (tie-break) score among near-ties only:\n    # prefer a moderate capacity fill (avoid draining, avoid tiny leftovers),\n    # plus slight radial preference to visit far-first.\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    secondary = 0.20 * radial - 0.15 * fill\n\n    # Restrict to near-tie candidates by masked selection of the best.\n    best_secondary = np.inf\n    best_idx_local = -1\n    for i in range(unvisited_nodes.size):\n        if close_mask[i]:\n            s = float(secondary[i])\n            if s < best_secondary:\n                best_secondary = s\n                best_idx_local = i\n\n    if best_idx_local < 0:\n        idx = int(np.argmax(ratio))\n    else:\n        idx = best_idx_local\n    return int(unvisited_nodes[idx])","code_sha256":"87ee65a894f16b3de8a3da36d5d64067d2ce446e907efa6dd9792b80e6e924c0","elapsed_seconds":0.296,"error_code":null,"error_detail":null,"evaluation_id":"f400d4884ad24391849bbc9fc37ef9e6","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_15.json","instance_objectives":[10.971257061399394,9.809639027211034,10.566749295182408,12.736176045565257,13.295225316928146,10.977298601199761],"lineage_status":"verified","objective":11.392724224581,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    dmin = float(np.min(d_cur))\n    mask = (d_cur <= dmin + 1e-9)\n    tie_count = int(mask.sum())\n    if tie_count == 1:\n        idx = int(np.argmin(d_cur))\n        return int(unvisited_nodes[idx])\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    savings = d_0cur + d_dep - d_cur\n    radial = d_dep / dmax\n\n    tie_score = -savings / dmax + 0.15 * radial + 0.10 * fill\n\n    tie_idx = np.where(mask)[0]\n    best_local = int(tie_idx[np.argmin(tie_score[tie_idx])])\n    return int(unvisited_nodes[best_local])","code_sha256":"0a7df8791255f25e162ec5a773385a5bf1e696c5e5de12dcd4ed792bb5478d31","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"f46b80230af94a30b60462b002318dca","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2836c7ddb7855d20af509728f202036e9aa17a424aebdf7b768f6c40483cae5e","population_member_indices":[1],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0004/eoh_run/results/exchanges/request_16.json","instance_objectives":[11.84817041232914,10.522404060217072,12.407728887420175,12.486209468554943,12.960655515185401,12.465101170764052],"lineage_status":"verified","objective":12.115044919078464,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true}],"comparison_packet":{"ref":"rounds/round_0004/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"e6cb3a81502e8f3fc39a58afbb0ae61e53053accbca7925826816d9a752b04e1"},"dual_budget":{"baseline_attempts":4,"novel_candidate_evaluations":12,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":6,"total_evaluation_attempts":22},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989