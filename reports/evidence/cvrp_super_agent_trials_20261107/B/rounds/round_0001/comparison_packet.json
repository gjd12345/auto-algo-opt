sus going straight from depot to customer.\n+    detour = np.maximum(d_cur - d_dep, 0.0)\n+\n+    # Sector cohesion: prefer customers whose depot-distance keeps them on the\n+    # current outward ray (continuing away from depot without backtracking).\n+    d_cur_depot = float(distance_matrix[depot][current_node])\n+    if d_cur_depot > 0.0:\n+        ray = d_dep / (d_cur_depot + d_dep + 1e-9)\n+        outward = np.clip(ray - 0.5, -0.5, 0.5)\n     else:\n         outward = np.zeros_like(d_cur)\n \n-    score = d_cur - 0.30 * d_dep + 0.15 * (1.0 - fill) * d_dep - 0.10 * outward * d_dep\n+    # Score: small = good. Encourage demand fill, low detour, outward cohesion.\n+    score = (1.0 + 0.75 * detour\n+             - 0.55 * fill * d_dep\n+             - 0.35 * outward * d_dep)\n \n     idx = int(np.argmin(score))\n-    return int(unvisited_nodes[idx])+    return int(nodes[idx])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":6},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"06cd8f5025d3c0762c4d6d582bb45dd06790e0a561e18130b29d05ec17b0be94","evaluation_id":"c920a06d04004127ac8d3afa58a08b2b","generation_parents":[],"instance_objectives":[12.043493758014042,11.408468208127866,10.681304763524613,12.58323395730276,13.069434997627416,12.506710619481614],"lineage_status":"no_parent","objective":12.048774384013052,"origin":"generated","revision":"original","source_request_index":2,"valid":true},"generated_count":6},"suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e"}
