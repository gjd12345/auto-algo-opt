ate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n\n    eps = 1e-9\n\n    # Detour cost: extra distance relative to a direct depot round-trip.\n    detour = (d_0cur + d_dep - d_cur)\n    denom = d_0cur + d_dep + eps\n    detour_norm = detour / denom\n\n    # Slack penalty: prefer using capacity, discourage leaving large slack.\n    slack = np.clip(1.0 - demand / cap, 0.0, 1.0)\n\n    # Angular alignment: cosine between current->j and centroid direction.\n    # Compute centroid of unvisited nodes using their coordinates derived\n    # from the distance matrix is not directly available; instead use a\n    # proxy: vector from current to j compared to vector from current to\n    # the unvisited node farthest from depot (a \"spread anchor\").\n    d_cur_all = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    anchor_idx = int(np.argmax(d_dep))\n    anchor = int(unvisited_nodes[anchor_idx])\n    v_cur_j = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    v_anchor = float(distance_matrix[current_node][anchor])\n\n    # Use distance-difference as an alignment proxy: how much closer to the\n    # anchor each candidate is than the anchor's own leg (smaller = better flow).\n    align = np.clip(1.0 - (d_cur + v_cur_j - d_cur) / (2.0 * v_anchor + eps), 0.0, 1.0)\n\n    # Additive polar-ish cost: minimize detour and slack, maximize alignment.\n    cost = 0.55 * detour_norm + 0.30 * slack + 0.15 * (1.0 - align)\n\n    idx = int(np.argmin(cost))\n    return int(unvisited_nodes[idx])","code_sha256":"056eac885ac0a233f033b917013ce364e4d697057660cb7b3ac59700f9bad280","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"75261fe261f74b83a2a250d963735916","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"68cd510af3df75d8f1b45182b248f07d7e38cedc4bfc1d74f5669a6b9ad81727","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"68cd510af3df75d8f1b45182b248f07d7e38cedc4bfc1d74f5669a6b9ad81727","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0007/eoh_run/results/exchanges/request_24.json","instance_objectives":[35.625394090816776,30.75934125566605,36.23313124094523,37.76975964279518,32.396952327363614,35.42663826620059],"lineage_status":"verified","objective":34.701869470631244,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"0b6b5cedb1c2e053ccbc4968827f02b0d7b50c50e6a868c7fde37aa576e7797e","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes].astype(np.float64)\n    d_dep = distance_matrix[depot][unvisited_nodes].astype(np.float64)\n    d_0cur = float(distance_matrix[depot][current_node])\n\n    demand = demands[unvisited_nodes].astype(np.float64)\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = np.clip(demand / cap, 0.0, 1.0)\n\n    eps = 1e-9\n\n    savings = d_0cur + d_dep - d_cur\n    leg_scale = d_0cur + d_cur + eps\n    sav_norm = savings / leg_scale\n\n    fill_pressure = fill * fill\n\n    dmax = float(np.max(d_dep)) if d_dep.size > 0 else 1.0\n    if dmax <= 0:\n        dmax = 1.0\n    radial = d_dep / dmax\n\n    # State-dependent radial weight: stronger far-first when vehicle is nearly\n    # full (low remaining capacity fraction), weaker when mostly empty.\n    cap_frac = np.clip(cap / (cap + np.sum(demand) + eps), 0.0, 1.0)\n    radial_weight = 0.12 + 0.20 * (1.0 - cap_frac)\n\n    score = (sav_norm + 1.0) * (1.0 + 0.35 * fill_pressure) * (1.0 + radial_weight * radial)\n\n    idx = int(np.argmax(score))\n    return int(unvisited_nodes[idx])","code_sha256":"c9763ed5cb5efcaf5e538350086beba335e83dcfe23bfbb81d5e9224a20dace3","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"8c41a33dae044b