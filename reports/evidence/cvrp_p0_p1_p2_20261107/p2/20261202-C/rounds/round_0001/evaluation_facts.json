,"code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Deterministic route start: farthest feasible customer from depot.\n        return int(unvisited_nodes[np.argmax(distance_matrix[depot][unvisited_nodes])])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    depot_savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Bounded capacity-fill factor: as capacity is used up, favor savings more.\n    total_demand_unvisited = float(np.sum(demands[unvisited_nodes]))\n    if total_demand_unvisited > 0:\n        fill = 1.0 - min(1.0, max(0.0, rest_capacity / (total_demand_unvisited + rest_capacity)))\n    else:\n        fill = 0.0\n\n    # Score: prefer small next-leg distance, but reward depot savings more near full load.\n    scores = d_cur - (0.25 + 0.25 * fill) * depot_savings\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"f7c1ce43e611440ab8b1a952b8556810","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[13.074607088744637,11.598773154484839,10.22842975642259,11.47934388663775,11.91962973056604,13.084171238562112],"lineage_status":"no_parent","objective":11.897492475902993,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    # Fallback if no feasible customers\n    if unvisited_nodes.size == 0:\n        return 0\n\n    cur = current_node\n    un = unvisited_nodes\n\n    d_cur = distance_matrix[cur][un]            # current -> candidates\n    d_dep = distance_matrix[depot][un]          # depot   -> candidates\n    d_cur_dep = distance_matrix[cur][depot]     # current -> depot\n\n    # Depot savings: closing via depot vs direct leg\n    savings = d_cur_dep + d_dep - d_cur\n\n    # Bounded capacity interaction: lambda in [0, 0.5]\n    # When capacity is nearly full, prioritize savings less (closer to greedy nearest).\n    total_dem = demands[un].sum()\n    if rest_capacity > 0:\n        frac_left = float(total_dem) / float(rest_capacity)\n        frac_left = min(1.0, max(0.0, frac_left))\n    else:\n        frac_left = 1.0\n    lam = 0.5 * frac_left\n\n    # Score: prefer small d_cur, but reward savings\n    score = d_cur - lam * savings\n\n    # At the depot, savings vanish (d_cur_dep = 0, d_dep = d_cur for cur=depot),\n    # so score reduces to d_cur. Use nearest from depot deterministically.\n    if cur == depot:\n        return int(un[np.argmin(d_cur)])\n\n    best_idx = int(np.argmin(score))\n    return int(un[best_idx])","code_sha256":"7a26a8e29afb447bc57bad0b8f0f3144602d1f15a92b5a83ef7a9bbd232be3b1","elapsed_seconds":0.296,"error_code":null,"error_detail":null,"evaluation_id":"132c5dda5f224966b72967bb9b4d6454","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[13.797618821595943,14.311264249466701,10.937464930162763,11.907534433252259,11.788806526910351,12.215045266188156],"lineage_status":"no_parent","objective":12.492955704596028,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return 0\n\n    if current_node == depot:\n        d0 = distance_matrix[depot][unvisited_nodes]\n        return unvisited_nodes[np.argmin(d0)]\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = distance_matrix[current_node][depot]\n\n    if len(unvisited_nodes) == 1:\n        return unvisited_nodes[0]\n\n    savings = d_cd + d_dep - d_cur\n    radial = np.abs(d_dep - d_cd)\n    w = rest_capacity / (rest_capacity + 1e-9)\n    score = d_cur - w * (savings - 0.5 * radial)\n    return unvisited_nodes[np.argmin(score)]","code_sha256":"bb9feb98db2db37b84e532cace8ed46b4b9831fb817e053991327a0a1bb44eae","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"8a481926ca304fb2a81529cf552fd9d0","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[13.744602347254201,12.456863308960925,10.821551186091702,12.084485400308553,12.591577843751368,12.215045266188156],"lineage_status":"no_parent","objective":12.319020892092484,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Explicit deterministic start: nearest feasible customer to depot.\n        d = distance_matrix[depot][unvisited_nodes]\n        return int(unvisited_nodes[int(np.argmin(d))])\n\n    cu = unvisited_nodes\n    d_cur = distance_matrix[current_node][cu]\n    d_depot = distance_matrix[depot][cu]\n    d_cross = distance_matrix[current_node][cu]\n    savings = distance_matrix[current_node][depot] + d_depot - d_cross\n\n    # Bounded capacity interaction: fuller loads favor savings more strongly.\n    cap = float(rest_capacity)\n    load_ratio = 0.0\n    total_cap = cap\n    # Use remaining capacity relative to the largest remaining demand as a proxy.\n    max_dem = float(np.max(demands[cu])) if cu.size else 0.0\n    if total_cap > 0.0:\n        load_ratio = float(np.clip((total_cap - max_dem) / total_cap, 0.0, 1.0))\n\n    weight = 0.5 + 0.3 * (1.0 - load_ratio)\n    score = d_cur - weight * savings\n\n    return int(cu[int(np.argmin(score))])","code_sha256":"3fc4daa0732a494a0a5a7b8a7a4c749c348818e16e55ee81c7341d281cc719f3","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"d25f4309e6ba4f45b3b15efc43062b92","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[12.929135148270282,13.35495715790675,9.533428835137927,11.907534433252259,11.781987456092695,12.83468080266732],"lineage_status":"no_parent","objective":12.056953972221203,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cu = unvisited_nodes\n\n    if current_node == depot:\n        d_depot = distance_matrix[depot][cu]\n        # Mixed deterministic start: balance nearest and farthest to avoid radial bias.\n        med = float(np.median(d_depot))\n        scores = np.abs(d_depot - med)\n        return int(cu[int(np.argmin(scores))])\n\n    d_cur = distance_matrix[current_node][cu]\n    d_depot = distance_matrix[depot][cu]\n    d_close = distance_matrix[current_node][depot]\n\n    # Detour-insertion cost: extra distance if we insert j before returning to depot.\n    detour = d_cur + d_depot - d_close\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    dem = demands[cu].astype(float)\n\n    # Capacity interaction: reward filling remaining capacity with larger demands,\n    # normalized so the term stays bounded in [0, 1].\n    fill_bonus = dem / cap\n    fill_bonus = np.clip(fill_bonus, 0.0, 1.0)\n\n    # Normalize detour by a local scale to keep it comparable across candidates.\n    scale = float(np.max(d_cur)) if cu.size else 1.0\n    if scale <= 0.0:\n        scale = 1.0\n\n    score = (detour / scale) - 0.5 * fill_bonus\n\n    return int(cu[int(np.argmin(score))])","code_sha256":"2fcac43edf64c1ad9c01d8b9d12f21b4e83582f4c274727b3c5e8236853bc26c","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"6e7d8d715f744991ba9eeb938030be0a","generation_parents":[{"algorithm":"Select at the depot the farthest customer from the depot to start a route, and otherwise rank feasible customers by a blend of nearest-neighbor distance and depot savings, weighted by a bounded capacity-fill factor, to keep routes coherent and radiality controlled.","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"At each step, score each feasible customer by a capacity-weighted blend of the direct current-to-customer distance and its depot savings, choosing the deterministic best score with a nearest-neighbor start at the depot.","code_sha256":"3fc4daa0732a494a0a5a7b8a7a4c749c348818e16e55ee81c7341d281cc719f3","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[15.024801962446999,16.827636751731067,14.428841466742647,15.112426765564184,16.664976684180424,14.345902847645707],"lineage_status":"verified","objective":15.400764413051837,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Deterministic start: farthest feasible customer to seed the route.\n        return int(unvisited_nodes[np.argmax(distance_matrix[depot][unvisited_nodes])])\n\n    # If only one feasible customer, take it.\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Look-ahead: distance from each candidate to its nearest other unvisited\n    # customer (excluding itself). This rewards candidates that sit on a chain.\n    sub = distance_matrix[np.ix_(unvisited_nodes, unvisited_nodes)].astype(float)\n    n = unvisited_nodes.size\n    big = float(np.max(distance_matrix)) + 1.0\n    eye_penalty = np.eye(n, dtype=bool)\n    sub2 = np.where(eye_penalty, big, sub)\n    nearest_other = np.min(sub2, axis=1)\n\n    # Capacity-fill ratio in [0,1]: how full the vehicle is relative to load.\n    total_dem = float(np.sum(demands[unvisited_nodes])) + float(rest_capacity)\n    if total_dem > 0.0:\n        fill = 1.0 - min(1.0, max(0.0, float(rest_capacity) / total_dem))\n    else:\n        fill = 0.0\n\n    # When few candidates remain, be purely greedy to close the route cleanly.\n    if n <= 2:\n        return int(unvisited_nodes[np.argmin(d_cur)])\n\n    # Weight look-ahead by fill: early (empty -> fill ~1) emphasize chaining,\n    # late (full -> fill ~0) emphasize short legs and radial consolidation.\n    chain_w = 0.15 + 0.45 * fill\n    radial_w = 0.10\n\n    scores = d_cur + chain_w * nearest_other + radial_w * d_dep\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"78cced0a379b57aa6ed065a16d99e39bb0d3fe73ad82674b53e88b89e3e02eeb","elapsed_seconds":0.328,"error_code":"forbidden_attribute","error_detail":"ix_","evaluation_id":"fd3ef17e467f43a5a0a9d8457c1457f7","generation_parents":[{"algorithm":"Select at the depot the farthest customer from the depot to start a route, and otherwise rank feasible customers by a blend of nearest-neighbor distance and depot savings, weighted by a bounded capacity-fill factor, to keep routes coherent and radiality controlled.","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Select at the depot the farthest customer from the depot to start a route, and otherwise rank feasible customers by a blend of nearest-neighbor distance and depot savings, weighted by a bo