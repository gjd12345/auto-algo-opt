.0 - min(1.0, max(0.0, rest_capacity / (total_demand_unvisited + rest_capacity)))\n-    else:\n-        fill = 0.0\n+    # Detour-insertion cost: extra distance if we insert j before returning to depot.\n+    detour = d_cur + d_depot - d_close\n \n-    # Score: prefer small next-leg distance, but reward depot savings more near full load.\n-    scores = d_cur - (0.25 + 0.25 * fill) * depot_savings\n+    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n+    dem = demands[cu].astype(float)\n \n-    return int(unvisited_nodes[np.argmin(scores)])+    # Capacity interaction: reward filling remaining capacity with larger demands,\n+    # normalized so the term stays bounded in [0, 1].\n+    fill_bonus = dem / cap\n+    fill_bonus = np.clip(fill_bonus, 0.0, 1.0)\n+\n+    # Normalize detour by a local scale to keep it comparable across candidates.\n+    scale = float(np.max(d_cur)) if cu.size else 1.0\n+    if scale <= 0.0:\n+        scale = 1.0\n+\n+    score = (detour / scale) - 0.5 * fill_bonus\n+\n+    return int(cu[int(np.argmin(score))])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":6},"first_invalid":{"candidate_id":"candidate_6","code_sha256":"78cced0a379b57aa6ed065a16d99e39bb0d3fe73ad82674b53e88b89e3e02eeb","error_code":"forbidden_attribute","error_detail":"ix_","evaluation_id":"fd3ef17e467f43a5a0a9d8457c1457f7","generation_parents":[{"algorithm":"Select at the depot the farthest customer from the depot to start a route, and otherwise rank feasible customers by a blend of nearest-neighbor distance and depot savings, weighted by a bounded capacity-fill factor, to keep routes coherent and radiality controlled.","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Select at the depot the farthest customer from the depot to start a route, and otherwise rank feasible customer