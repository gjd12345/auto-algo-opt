_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Deterministic route start: farthest feasible customer from depot.\n        return int(unvisited_nodes[np.argmax(distance_matrix[depot][unvisited_nodes])])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    depot_savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Bounded capacity-fill factor: as capacity is used up, favor savings more.\n    total_demand_unvisited = float(np.sum(demands[unvisited_nodes]))\n    if total_demand_unvisited > 0:\n        fill = 1.0 - min(1.0, max(0.0, rest_capacity / (total_demand_unvisited + rest_capacity)))\n    else:\n        fill = 0.0\n\n    # Score: prefer small next-leg distance, but reward depot savings more near full load.\n    scores = d_cur - (0.25 + 0.25 * fill) * depot_savings\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","elapsed_seconds":0.39,"error_code":null,"error_detail":null,"evaluation_id":"64870f390b5341ee8608938943761f00","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.074607088744637,11.598773154484839,10.22842975642259,11.47934388663775,11.91962973056604,13.084171238562112],"lineage_status":null,"objective":11.897492475902993,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Deterministic route start: farthest feasible customer from depot.\n        return int(unvisited_nodes[np.argmax(distance_matrix[depot][unvisited_nodes])])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    depot_savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Bounded capacity-fill factor: as capacity is used up, favor savings more.\n    total_demand_unvisited = float(np.sum(demands[unvisited_nodes]))\n    if total_demand_unvisited > 0:\n        fill = 1.0 - min(1.0, max(0.0, rest_capacity / (total_demand_unvisited + rest_capacity)))\n    else:\n        fill = 0.0\n\n    # Score: prefer small next-leg distance, but reward depot savings more near full load.\n    scores = d_cur - (0.25 + 0.25 * fill) * depot_savings\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"7cc093b1f1c3405293291d070d75596f","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.074607088744637,11.598773154484839,10.22842975642259,11.47934388663775,11.91962973056604,13.084171238562112],"lineage_status":null,"objective":11.897492475902993,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        return int(unvisited_nodes[np.argmax(distance_matrix[depot][unvisited_nodes])])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    depot_savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    scores = d_cur - 0.20 * depot_savings\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"5eae31efbed37069e9869c6a09c9c0835b6c3870d59419ee2c7dca315104e2d6","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"35ba8363eab2456a877a85980ecaec71","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_12.json","instance_objectives":[14.676623616040398,11.711186138620704,10.166876350929781,11.435693895146237,11.91962973056604,12.44146794840431],"lineage_status":"verified","objective":12.058579613284579,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    if current_node == depot:\n        return int(unvisited_nodes[np.argmax(d_dep)])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_back = distance_matrix[current_node][depot]\n    detour = d_cur + d_dep - d_back\n\n    # Relative detour: small when heading homeward-ish, used as a soft pull to depot.\n    scale = d_cur + d_dep + 1e-9\n    pull_home = d_dep / scale\n\n    # Capacity pressure: favors customers that help close out the load.\n    cap_ratio = rest_capacity / (rest_capacity + float(np.sum(demands[unvisited_nodes])) + 1e-9)\n\n    scores = (0.5 * d_cur\n              - 0.35 * detour\n              + 0.4 * cap_ratio * pull_home * d_cur\n              + 0.15 * (1.0 - cap_ratio) * d_dep)\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"c3cf951113d194344d5192834d0346818fa545ec09b4fe0924ff26fd3aecb186","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"89109f70335c420ab2c6456860b2ef04","generation_parents":[{"algorithm":"Building on the parent's farthest-start and savings-based score, keep the same in-route backbone but use a smaller fixed savings coefficient of 0.20 (slightly below the parent's 0.25 base) with no capacity-fill scaling, so the intercept change is isolated and minimal.","code_sha256":"5eae31efbed37069e9869c6a09c9c0835b6c3870d59419ee2c7dca315104e2d6","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"5509c2d27b3ead16756a4e6e3bd4d549fa7cf6d3bf45a8b96272c127c790291d","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[12.363799546870407,12.268548798323154,10.888163898076211,11.405471718910087,11.712912790953292,11.71017420558936],"l