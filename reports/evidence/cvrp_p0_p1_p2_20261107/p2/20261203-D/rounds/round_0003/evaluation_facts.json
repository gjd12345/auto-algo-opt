tance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cur_dep = distance_matrix[current_node][depot]\n\n    # Insertion detour: going current -> candidate -> depot versus current -> depot.\n    detour = d_cur + d_dep - d_cur_dep\n\n    demands_unvisited = demands[unvisited_nodes]\n    max_d = float(np.max(demands_unvisited)) if demands_unvisited.size else 1.0\n    if max_d <= 0:\n        max_d = 1.0\n\n    load_ratio = rest_capacity / max_d\n    score = detour\n\n    if load_ratio < 3.0:\n        pressure = 1.0 - load_ratio / 3.0\n        if pressure < 0.0:\n            pressure = 0.0\n        score = score - 0.30 * pressure * d_cur_dep * (demands_unvisited / max_d)\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"4eede0e3f913888a493bddb7f79dc8dde4739ec3f44da9d7b7ec06a336ada0d7","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"4c2c0f7198a84a2887e7a140135ee750","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"a4ca35764f567a8e13b275d5e4f56ee797d96464c680d8c8f3c17eae74b74c39","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"a4ca35764f567a8e13b275d5e4f56ee7