isited_nodes]\n     d_dep = distance_matrix[depot][unvisited_nodes]\n     d_cur_dep = distance_matrix[current_node][depot]\n \n     if current_node == depot:\n-        # Start with a near but demand-friendly customer: distance minus a mild\n-        # demand bonus normalized by remaining capacity.\n-        demands_unvisited = demands[unvisited_nodes]\n-        max_d = float(np.max(demands_unvisited)) if demands_unvisited.size else 1.0\n-        if max_d > 0:\n-            score = d_cur - 0.15 * d_cur_dep * (demands_unvisited / max_d)\n-        else:\n-            score = d_cur\n-        return int(unvisited_nodes[np.argmin(score)])\n+        # Start: pick customer that minimizes a fixed reference direction\n+        # (use the farthest node as an anchor ray, then sweep).\n+        # Deterministic: choose the customer with the largest depot distance\n+        # among the two \"extreme\" ones, then take nearest along the sweep start.\n+        # Simpler coherent rule: choose the customer minimizing angle proxy\n+        # cos(theta) = (d_dep^2 + d_cur_dep^2 - d_cur^2) / (2*d_dep*d_cur_dep)\n+        # At depot, use distance to farthest customer as reference ray.\n+        far_idx = int(np.argmax(d_dep))\n+        ref_d = d_dep[far_idx] if d_dep[far_idx] > 0 else 1.0\n+        # cos of angle between (depot->candidate) and (depot->far)\n+        cos_ang = (d_dep * d_dep + ref_d * ref_d - distance_matrix[unvisited_nodes, far_idx] ** 2) / (\n+            2.0 * np.maximum(d_dep, 1e-12) * ref_d\n+        )\n+        cos_ang = np.clip(cos_ang, -1.0, 1.0)\n+        # Sweep starts near pi (opposite to reference) picking largest angle first\n+        return int(unvisited_nodes[np.argmin(cos_ang)])\n \n-    savings = d_cur_dep + d_dep - d_cur\n+    # Heading from depot to current node.\n+    if d_cur_dep <= 1e-12:\n+        return int(unvisited_nodes[np.argmin(d_cur)])\n \n-    demands_unvisited = demands[unvisited_nodes]\n-    max_d = float(np.max(demands_unvisited)) if demands_unvisited.size else 1.0\n-    cap_ratio = rest_capacity / max(1e-9, max_d)\n+    # Angle between (depot->current) and (depot->candidate) via cosine law.\n+    cos_ang = (d_dep * d_dep + d_cur_dep * d_cur_dep - d_cur * d_cur) / (\n+        2.0 * np.maximum(d_dep, 1e-12) * d_cur_dep\n+    )\n+    cos_ang = np.clip(cos_ang, -1.0, 1.0)\n+    ang = np.arccos(cos_ang)  # 0 = same direction, pi = opposite\n \n-    # Blend an explicit distance penalty into savings so route closure and\n-    # short extensions are jointly considered.\n-    score = savings - 0.25 * d_cur\n-\n-    if cap_ratio < 2.5 and max_d > 0:\n-        # Stronger high-demand bias when capacity is tight.\n-        tightness = max(0.0, 1.0 - cap_ratio / 2.5)\n-        score = score + (0.02 + 0.08 * tightness) * (demands_unvisited / max_d)\n-\n-    return int(unvisited_nodes[np.argmax(score)])+    # Prefer continuing roughly in the same angular direction (small ang),\n+    # with distance as a tie-breaker.\n+    score = ang + 0.05 * d_cur / np.maximum(d_dep, 1e-12)\n+    return int(unvisited_nodes[np.argmin(score)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":6},"first_invalid":{"candidate_id":"candidate_4","code_sha256":"dc66ddcb00c54c73594122ac2d0c664deabdd420c7d5cacc8073201dc5e652e0","error_code":"candidate_error","evaluation_id":"b2b55bf1040f443d89baeb5d488f2399","generation_parents":[],"instance_objectives":[],"lineage_status":"no_parent","origin":"generated","revision":"original","source_request_index":5,"valid":false},"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"06b6a1c7603b1022d9568440ba97dd1fa8b84de2f35d15f4e804f3630243c79b","evaluation_id":"863ab80a98d9402d906335b20f5640d8","generation_parents":[],"instance_objectives":[13.312652299925906,12.664523487305207,10.419380466059964,12.247196234744282,11.359141069507809,9.86440551581159],"lineage_status":"no_parent","objective":11.64454984555912