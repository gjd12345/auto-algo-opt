nt","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    scores = d_cur - 0.35 * d_dep\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","elapsed_seconds":0.391,"error_code":null,"error_detail":null,"evaluation_id":"2532cf38fe60468dafda6f1eaebe4b38","generation_parents":null,"generation_request_ref":null,"instance_objectives":[9.899910653312942,11.664112344246693,10.831653246703038,12.27317921859646,12.760871024814843,12.125451987514783],"lineage_status":null,"objective":11.592529745864793,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    scores = d_cur - 0.35 * d_dep\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","elapsed_seconds":0.39,"error_code":null,"error_detail":null,"evaluation_id":"cc65035880ad4f6da2761d1d8f9e52e3","generation_parents":null,"generation_request_ref":null,"instance_objectives":[9.899910653312942,11.664112344246693,10.831653246703038,12.27317921859646,12.760871024814843,12.125451987514783],"lineage_status":null,"objective":11.592529745864793,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Savings of inserting a node between current position and depot:\n    # serving it now avoids a separate depot round-trip later.\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Normalise demand influence so heavier (harder-to-place) customers\n    # get a mild priority when their insertion cost is low.\n    dem_norm = dem / (rest_capacity + 1e-9)\n\n    # Composite score: we want high savings, low detour, prefer heavier\n    # demands slightly, and avoid long repositioning.\n    scores = -savings + 0.30 * d_cur - 0.15 * d_dep - 0.25 * dem_norm * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"4227bf42a78fc959757bbe21a74e5197bfa5f28cc02fa784ef84ce09b0e5f68a","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"2eb24ee76db54a69b710bc90ec9dabf4","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[10.040613523626416,12.071499531886666,11.159866793367542,11.126940789750748,12.650671650834848,11.012221211530022],"lineage_status":"verified","objective":11.343635583499372,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    # Use distances to reconstruct pseudo-coordinates via the depot and\n    # the current node (distance matrix only). Instead, use the screening\n    # of angular structure through the triangle relation:\n    # We rank by \"sweep continuity\": how well the move current->candidate\n    # aligns with the current node's radial direction from the depot.\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    r_cur = distance_matrix[depot][current_node]\n    dem = demands[unvisited_nodes]\n\n    # Law-of-cosines proxy for the cosine of the angle between the\n    # (depot -> current) and (depot -> candidate) rays.\n    # cos_theta ~ (r_cur^2 + d_dep^2 - d_cur_to_cand^2) / (2 * r_cur * d_dep)\n    # but we only have d_cur (current->cand). Use it directly:\n    denom = 2.0 * max(r_cur, 1e-9) * np.maximum(d_dep, 1e-9)\n    cos_theta = (r_cur * r_cur + d_dep * d_dep - d_cur * d_cur) / denom\n    cos_theta = np.clip(cos_theta, -1.0, 1.0)\n\n    # Prefer smooth angular continuation (cos near +1 = same radial direction)\n    # and moderate distance. Fill capacity with heavier demands when tied.\n    fill = dem / (rest_capacity + 1e-9)\n\n    scores = -cos_theta + 0.5 * d_cur / (r_cur + 1e-9) - 0.2 * fill\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"6fd752dd5f628bbbe78378f9a943a28c3a4db6027ec88efda0523946331b1607","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"3a642d837ece40e8a49be6e1580e522d","generation_parents":[{"algorithm":"The heuristic ranks candidates using a regret-based score that combines proximity to the current node, proximity to the depot, and demand-weighted savings, selecting the node whose insertion most reduces estimated route cost.","code_sha256":"4227bf42a78fc959757bbe21a74e5197bfa5f28cc02fa784ef84ce09b0e5f68a","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The heuristic ranks candidates using a regret-based score that combines proximity to the current node, proximity to the depot, and demand-weighted savings, selecting the node whose insertion most reduces estimated route cost.","code_sha256":"4227bf42a78fc959757bbe21a74e5197bfa5f28cc02fa784ef84ce09b0e5f68a","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[9.991854423411604,12.890590834752345,12.167255294292927,11.740192704380831,12.46078925457963,13.188669664219628],"lineage_status":"verified","objective":12.073225362606161,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/compari