25 * dem_norm * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"4227bf42a78fc959757bbe21a74e5197bfa5f28cc02fa784ef84ce09b0e5f68a","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"87abea4f7faf43dcb9cf1aabae174a8b","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.040613523626416,12.071499531886666,11.159866793367542,11.126940789750748,12.650671650834848,11.012221211530022],"lineage_status":null,"objective":11.343635583499372,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Savings from inserting the node between current position and depot.\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Demand normalised by remaining capacity.\n    dem_norm = dem / (rest_capacity + 1e-9)\n\n    # Different weighting: stronger pull toward savings, stronger penalty\n    # on repositioning distance, and higher demand priority.\n    scores = -savings + 0.40 * d_cur - 0.10 * d_dep - 0.45 * dem_norm * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"3be5e9f1b95e810d43e2847ae891eede8ba17a00e6bb4106a5bb669e986189a4","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"286712876ffd45a6ae0e5b620a667b0c","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"4227bf42a78fc959757bbe21a74e5197bfa5f28cc02fa784ef84ce09b0e5f68a","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_12.json","instance_objectives":[9.99450486528379,12.29069218462562,10.281039164479633,11.134351968576468,11.957243762751249,10.860941569558635],"lineage_status":"verified","objective":11.0864622525459,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Stage 1: keep the nearest fraction of candidates by current distance.\n    k = max(1, int(np.ceil(0.35 * unvisited_nodes.size)))\n    order = np.argsort(d_cur)\n    near_idx = order[:k]\n    cand = unvisited_nodes[near_idx]\n    dc = d_cur[near_idx]\n    dd = d_dep[near_idx]\n    dm = dem[near_idx]\n\n    # Stage 2: ratio combining return savings, demand usage, proximity.\n    eps = 1e-9\n    save = distance_matrix[current_node][depot] + dd - dc\n    dem_ratio = dm / (rest_capacity + eps)\n    score = (save + dem_ratio * dd) / (dc + eps)\n\n    return int(cand[np.argmax(score)])","code_sha256":"638b680a0acc4d62ebbe7a43ce1ec77d46bec30c48d0e39756957bf2edbdbe4c","elapsed_seconds":0.343,"error_code":null,"error_detail":null,"evaluation_id":"b8590d6ed4074d3b978b25812309aed4","generation_parents":[{"algorithm":"Adjust the composite scoring weights to emphasize depot-return savings and penalize repositioning distance more strongly while moderately prioritizing high-demand customers.","code_sha256":"3be5e9f1b95e810d43e2847ae891eede8ba17a00e6bb4106a5bb669e986189a4","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Adjust the composite scoring weights to emphasize depot-return savings and penalize repositioning distance more strongly while moderately prioritizing high-demand customers.","code_sha256":"3be5e9f1b95e810d43e2847ae891eede8ba17a00e6bb4106a5bb669e986189a4","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[10.25305418215426,12.548498520783438,12.577563117158165,11.022168325207762,13.96621329364136,12.365608381923735],"lineage_status":"verified","objective":12.12218430347812,"origin":"generated