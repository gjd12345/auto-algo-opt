trix[current_node][unvisited_nodes]\n+\n+    # Cosine of angle at depot between current and each candidate\n+    denom = 2.0 * d_dep_cur * d_dep_cand\n+    denom = np.where(denom <= 0, 1.0, denom)\n+    cos_ang = (d_dep_cur ** 2 + d_dep_cand ** 2 - d_cur_cand ** 2) / denom\n+    cos_ang = np.clip(cos_ang, -1.0, 1.0)\n+\n+    # Prefer candidates \"ahead\" angularly (cos near -1 means opposite direction = continue sweep)\n+    angular_score = 1.0 + cos_ang  # range [0, 2]\n+\n+    # Normalized radial distance to avoid jumping far away\n+    max_d = d_dep_cand.max() if d_dep_cand.size else 1.0\n+    if max_d <= 0:\n+        max_d = 1.0\n+    radial_score = d_dep_cand / max_d\n+\n+    scores = 0.6 * angular_score + 0.4 * radial_score\n     return int(unvisited_nodes[np.argmin(scores)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":6},"first_invalid":{"candidate_id":"candidate_5","code_sha256":"9bee3d5d086715b5b727db2c1642d7dad4a8b9362bdc44fbfe3b5069076b96e0","error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"358ac78b3917460a877d256d8b16f840","generation_parents":[{"algorithm":"Select the feasible unvisited customer that minimizes the sum of distance from the current node plus a capacity-utilization penalty favoring customers whose demand better fills remaining capacity, breaking ties by nearest distance.","code_sha256":"62fd2f15ccf869d2a593cf97095b3268077b7b9ec1184b71b1d4dd56d6051995","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"The heuristic scores each feasible unvisited customer by a weighted combination of distance from the current node and distance from the depot, favoring nearby customers that are farther from the depot to avoid inefficient early returns, then selects the minimum-score customer.","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","population_member_indices":[0],"selected_