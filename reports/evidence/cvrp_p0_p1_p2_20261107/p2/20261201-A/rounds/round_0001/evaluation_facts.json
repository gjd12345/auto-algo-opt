":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    distances = distance_matrix[current_node][unvisited_nodes]\n    node_demands = demands[unvisited_nodes]\n\n    # Favor customers that use a larger share of remaining capacity,\n    # while still prioritizing close customers.\n    if rest_capacity > 0:\n        fill_ratio = node_demands / rest_capacity\n    else:\n        fill_ratio = np.zeros_like(node_demands, dtype=float)\n\n    # Penalize low fill ratios modestly so distance remains dominant.\n    scores = distances + 0.5 * (1.0 - fill_ratio) * distances.max()\n\n    best_idx = int(np.argmin(scores))\n    return int(unvisited_nodes[best_idx])","code_sha256":"62fd2f15ccf869d2a593cf97095b3268077b7b9ec1184b71b1d4dd56d6051995","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"dacd090eca774b79be729bd59d470881","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[10.904893742153648,13.132528952255543,11.161111042160137,10.699950208419134,13.148985743318274,10.970729704760043],"lineage_status":"no_parent","objective":11.669699898844463,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    scores = d_cur - 0.35 * d_dep\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"80f116ea1ae9497fa10ce5333114b62b","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[9.899910653312942,11.664112344246693,10.831653246703038,12.27317921859646,12.760871024814843,12.125451987514783],"lineage_status":"no_parent","objective":11.592529745864793,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n\n    # Prefer nearby customers, but penalize those far from depot and\n    # reward filling capacity with larger demands.\n    score = cur + 0.35 * to_depot - 0.15 * (dem / cap) * to_depot\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"87cddf88ea017216ea8aed0929b04a4690ee77c7e16e4420fafa54b1b9c2d065","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"35e2e3c279e24a608f0c81b2a415cba9","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[11.516499603687809,13.672354085339128,11.27038479861106,11.865186882299586,13.599551386060668,12.131722601358598],"lineage_status":"no_parent","objective":12.342616559559476,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    max_dep = max(float(np.max(d_dep)), 1e-9)\n    urgency = d_dep / max_dep\n\n    # Slight preference for closer customers, moderated by depot urgency.\n    scores = d_cur - 0.1 * urgency\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"0047c084dbf71a072a2d3f51f58413967ade592b695fad73aac187485881c2cb","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"acd6094c03b64bcfb8201952cc369387","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[10.592641879729218,12.501342426176729,11.405406598898585,12.827722082970588,13.417167669470315,12.544778551015984],"lineage_status":"no_parent","objective":12.214843201376903,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Build lookahead: for each candidate, find the nearest other feasible\n    # customer reachable from it, to gauge future travel cost.\n    sub = distance_matrix[np.ix_(unvisited_nodes, unvisited_nodes)].astype(float)\n    np.fill_diagonal(sub, np.inf)\n    nearest_other = sub.min(axis=1)\n\n    # Marginal cost of visiting candidate i now and continuing to its\n    # nearest neighbor: d(cur,i) + nearest(i,j) - d(cur,j_best_alt)\n    # Approximate j_best_alt by the overall nearest neighbor's distance.\n    order = np.argsort(d_cur)\n    nn = order[0]\n    second_nn = order[1]\n    d_cur_nn = d_cur[nn]\n    d_cur_second = d_cur[second_nn]\n\n    # Insertion-style regret: extra distance vs. skipping to the second\n    # nearest customer.\n    regret = d_cur + nearest_other - d_cur_second\n\n    # Prefer customers that keep some distance from the depot (avoid\n    # early inefficient returns) without dominating distance.\n    scores = regret - 0.2 * d_dep\n\n    best_idx = int(np.argmin(scores))\n    return int(unvisited_nodes[best_idx])","code_sha256":"9bee3d5d086715b5b727db2c1642d7dad4a8b9362bdc44fbfe3b5069076b96e0","elapsed_seconds":0.328,"error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"358ac78b3917460a877d256d8b16f840","generation_parents":[{"algorithm":"Select the feasible unvisited customer that minimizes the sum of distance from the current node plus a capacity-utilization penalty favoring customers whose demand better fills remaining capacity, breaking ties by nearest distance.","code_sha256":"62fd2f15ccf869d2a593cf97095b3268077b7b9ec1184b71b1d4dd56d6051995","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"The heuristic scores each feasible unvisited customer by a weighted combination of distance from the current node and distance from the depot, favoring nearby customers that are farther from the depot to avoid inefficient early returns, then selects the minimum-score customer.","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[],"lineage_status":"verified","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":false},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n    if current_node == depot:\n        return int(unvisited_nodes[np.argmin(distance_matrix[depot][unvisited_nodes])])\n\n    # Coordinates from distance matrix via law of cosines are unavailable;\n    # instead use angular proxy: angle at depot between current and candidate\n    # using only distances (triangle side lengths).\n    d_dep_cur = distance_matrix[depot][current_node]\n    d_dep_cand = distance_matrix[depot][unvisited_nodes]\n    d_cur_cand = distance_matrix[current_node][unvisited_nodes]\n\n    # Cosine of angle at depot between current and each candidate\n    denom = 2.0 * d_dep_cur * d_dep_cand\n    denom = np.where(denom <= 0, 1.0, denom)\n    cos_ang = (d_dep_cur ** 2 + d_dep_cand ** 2 - d_cur_cand ** 2) / denom\n    cos_ang = np.clip(cos_ang, -1.0, 1.0)\n\n    # Prefer candidates \"ahead\" angularly (cos near -1 means opposite direction = continue sweep)\n    angular_score = 1.0 + cos_ang  # range [0, 2]\n\n    # Normalized radial distance to avoid jumping far away\n    max_d = d_dep_cand.max() if d_dep_cand.size else 1.0\n    if max_d <= 0:\n        max_d = 1.0\n    radial_score = d_dep_cand / max_d\n\n    scores = 0.6 * angular_score + 0.4 * radial_score\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"c55a229e1e47bc9556f69206424988f4d635dba765074b72aeaa31cf5d9d7226","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"11a93a8661b44e449e71cad2c679578d","generation_parents":[{"algorithm":"Select the feasible unvisited customer that minimizes the sum of distance from the current node plus a capacity-utilization penalty favoring customers whose demand better fills remaining capacity, breaking ties by nearest distance.","code_sha256":"62fd2f15ccf869d2a593cf97095b3268077b7b9ec1184b71b1d4dd56d6051995","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"The heuristic scores each feasible unvisited customer by a weighted combination of distance from the current node and distance from the depot, favoring nearby customers that are farther from the depot to avoid inefficient early returns, then selects the minimum-score customer.","code_sha256":"d404eaccbb970a802728212a617f4658f3d8e963c59f8ce4d3697140001b81b9","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_7.json","instance_objectives":[29.94409126617004,35.2414047855881,32.53179059066142,29.93001605626571,36.52819043729069,31.271962187032923],"lineage_status":"verified","objective":32.574575887168145,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd",