code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    dists = distance_matrix[current_node][unvisited_nodes]\n    dems = demands[unvisited_nodes]\n    scores = dems / (dists + 1e-9)\n    best = np.argmax(scores)\n    # tie-breaker: smaller distance\n    cand = unvisited_nodes[scores >= scores[best] - 1e-12]\n    cand_d = distance_matrix[current_node][cand]\n    return int(cand[np.argmin(cand_d)])","code_sha256":"bd3d138910022f1f03ba1148c35c4dbc7517e5d85f02ffaa6685e941833995bf","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"2caa84e4dee146e898f6ee9e7b75f4d3","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[13.882398927187527,13.516295262226631,12.359215579229708,13.5786077687386,14.117972164292228,13.381300240591726],"lineage_status":"no_parent","objective":13.472631657044404,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + to_depot - cur\n\n    best = np.argmax(savings)\n    best_saving = savings[best]\n    # Tie-break: among maximal savings, choose nearest customer\n    candidates = np.where(savings == best_saving)[0]\n    if candidates.size == 1:\n        return int(unvisited_nodes[best])\n    nearest = candidates[np.argmin(cur[candidates])]\n    return int(unvisited_nodes[nearest])","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"af0fa36eafc64a4b9c0eec148204c984","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[12.719510222400071,11.591097317511329,10.0355630679924,11.975501427921271,12.655688485687397,13.863385389902218],"lineage_status":"no_parent","objective":12.140124318569114,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d = distance_matrix[current_node][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = dem / cap\n\n    # Prefer close customers, and mildly reward those that use remaining capacity well.\n    score = d - 0.5 * fill * (d + 1e-9)\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"6e84dc996b4d2528cd69063786ffef292b2f44a90ac527e34860c839614959e3","elapsed_seconds":0.296,"error_code":null,"error_detail":null,"evaluation_id":"3b1a93b0c3194aa5a8f0cd237dec767d","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[13.091431735908023,13.372062210068798,12.894743496820615,10.961315809920128,12.528285017025354,12.235120074482555],"lineage_status":"no_parent","objective":12.513826390704246,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    candidates = np.asarray(unvisited_nodes)\n    d_cur = distance_matrix[current_node][candidates]\n    d_dep = distance_matrix[depot][candidates]\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    dem = demands[candidates].astype(float) / cap\n\n    alpha = 1.0\n    scores = d_cur - alpha * dem * d_dep\n\n    return int(candidates[int(np.argmin(scores))])","code_sha256":"15a73a42a82bd2064740b03cf38637991cf1381f18a2214934d320f63ad16905","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"73ffcfa47f574cc2bbee3e1421347a76","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[13.132608213461348,14.168296771420808,11.819818584401627,12.011227131444954,12.60163755278793,12.008972136745383],"lineage_status":"no_parent","objective":12.623760065043674,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill = dem / cap\n\n    # Urgency: how far the route is dragged from the depot by going here,\n    # scaled by the share of remaining capacity the customer will consume.\n    # Fewer future options are left after a large demand is taken, so\n    # prioritize customers whose service leaves the route far from home.\n    max_dist = np.max(distance_matrix) + 1e-9\n    norm_cur = d_cur / max_dist\n    norm_dep = d_dep / max_dist\n\n    score = norm_cur + 0.5 * fill * norm_dep\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"0847bce90fb82612394d0d456ac4f5eb08070ed77df752dc395247806273e2f8","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"cc87f01a5d1d448aa19ea81ffda9dca8","generation_parents":[{"algorithm":"Use a Clarke–Wright-style savings surrogate: score each feasible customer by its round-trip saving when appended to the current route, i.e. d(current,depot)+d(depot,c)-d(current,c), and pick the customer maximising this saving, breaking ties by nearest distance.","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The heuristic scores each feasible unvisited customer by distance from the current node minus a capacity-utilization reward, favoring nearby customers that help use remaining capacity efficiently, then selects the best-scoring node deterministically.","code_sha256":"6e84dc996b4d2528cd69063786ffef292b2f44a90ac527e34860c839614959e3","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[13.898079645540387,14.455877486808411,12.410011194245786,12.871613710867656,12.519642666250142,13.300469339246266],"lineage_status":"verified","objective":13.24261567382644,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    d = demands[unvisited_nodes].astype(float)\n\n    max_cur = np.max(cur) if cur.size > 0 else 1.0\n    if max_cur <= 0:\n        max_cur = 1.0\n    dist_term = cur / max_cur\n\n    cap = float(rest_capacity) if rest_capacity > 0 else 1.0\n    fill_term = np.abs(d - cap) / cap\n\n    # lower is better: prioritize filling capacity snugly while staying near\n    scores = 0.6 * dist_term + 0.4 * fill_term\n\n    best = np.argmin(scores)\n    best_score = scores[best]\n    candidates = np.where(scores == best_score)[0]\n    if candidates.size == 1:\n        return int(unvisited_nodes[best])\n    nearest = candidates[np.argmin(cur[candidates])]\n    return int(unvisited_nodes[nearest])","code_sha256":"6a2905b68d5cb05c9b7ab2e1ba6aaf51a9852639eefe4ff0da74195dd0ee3531","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"dd8357fbd49044fda6637ddb7d0d7ed2","generation_parents":[{"algorithm":"Use a Clarke–Wright-style savings surrogate: score each feasible customer by its round-trip saving when appended to the current route, i.e. d(current,depot)+d(depot,c)-d(current,c), and pick the customer maximising this saving, breaking ties by nearest distance.","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Use a Clarke–Wright-style savings surrogate: score each feasible customer by its round-trip saving when appended to the current route, i.e. d(current,depot)+d(depot,c)-d(current,c), and pick the customer maximising this saving, breaking ties by nearest distance.","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[0],"selected_parent_pos