_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + to_depot - cur\n\n    best = np.argmax(savings)\n    best_saving = savings[best]\n    # Tie-break: among maximal savings, choose nearest customer\n    candidates = np.where(savings == best_saving)[0]\n    if candidates.size == 1:\n        return int(unvisited_nodes[best])\n    nearest = candidates[np.argmin(cur[candidates])]\n    return int(unvisited_nodes[nearest])","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"99946e37fe8e425bbe3d67aa80efda61","generation_parents":null,"generation_request_ref":null,"instance_objectives":[12.719510222400071,11.591097317511329,10.0355630679924,11.975501427921271,12.655688485687397,13.863385389902218],"lineage_status":null,"objective":12.140124318569114,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + to_depot - cur\n\n    best = np.argmax(savings)\n    best_saving = savings[best]\n    # Tie-break: among maximal savings, choose nearest customer\n    candidates = np.where(savings == best_saving)[0]\n    if candidates.size == 1:\n        return int(unvisited_nodes[best])\n    nearest = candidates[np.argmin(cur[candidates])]\n    return int(unvisited_nodes[nearest])","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"773ccd45666b4d5b97728e13a5e3eb0f","generation_parents":null,"generation_request_ref":null,"instance_objectives":[12.719510222400071,11.591097317511329,10.0355630679924,11.975501427921271,12.655688485687397,13.863385389902218],"lineage_status":null,"objective":12.140124318569114,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + to_depot - cur\n\n    d_cur_depot = distance_matrix[current_node][depot]\n    if d_cur_depot < 1e-12:\n        d_cur_depot = 1e-12\n    nn_term = 1.0 - cur / d_cur_depot\n\n    d = demands[unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 1e-12 else 1e-12\n    fill_term = d / cap\n\n    score = savings / (d_cur_depot + 1e-12) + 0.5 * nn_term + 0.5 * fill_term\n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"e160a9750580b5d0ef8e43914118bf3dd6941ae911ab5718a14659255d553412","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"51f7b9d9fff44e73a5601e1ab9c74c49","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_12.json","instance_objectives":[13.170475183894883,13.897614064147566,10.856580063486435,11.599642475105686,11.23355056626833,11.317601699729767],"lineage_status":"verified","objective":12.012577342105445,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    n = unvisited_nodes.size\n    best_score = None\n    best_node = int(unvisited_nodes[0])\n\n    for i in range(n):\n        cand = int(unvisited_nodes[i])\n        d_ci = cur[i]\n        d_id = to_depot[i]\n        # detour cost of inserting cand before returning to depot\n        detour = d_ci + d_id - d_cur_depot\n\n        # find best & second-best continuation from cand among remaining\n        other_mask = np.arange(n) != i\n        if np.any(other_mask):\n            d_cand_other = distance_matrix[cand][unvisited_nodes[other_mask]]\n            other_depot = to_depot[other_mask]\n            cont = d_cand_other + other_depot\n            srt = np.sort(cont)\n            best_cont = srt[0]\n            second_cont = srt[1] if srt.size > 1 else srt[0]\n            regret = second_cont - best_cont\n        else:\n            best_cont = 0.0\n            regret = 0.0\n\n        urgency = 2.0 * to_depot[i] - d_ci\n        cap_ratio = demands[cand] / rest_capacity if rest_capacity > 1e-12 else 0.0\n        score = regret - detour + 0.25 * urgency + 0.5 * cap_ratio\n\n        if best_score is None or score > best_score:\n            best_score = score\n            best_node = cand\n\n    return best_node","code_sha256":"2431ff915df494a6482354fcd1954ec431eaea00497aa15281140f78f33a9a95","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"abe8125ee065455fa9a7bef0add26722","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Reuse the round-1 savings-based selection but replace the argmax-with-tie-break step with a single composite score that blends Clarke-Wright savings, a nearest-neighbor term, and a capacity-fill incentive, then pick the highest-scoring feasible customer.","code_sha256":"e160a9750580b5d0ef8e43914118bf3dd6941ae911ab5718a14659255d553412","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[13.478180190898787,14.145927828152631,12.192104846445599,12.211131380680335,13.799215089304896,13.75802171902119],"line