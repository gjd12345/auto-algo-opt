np.maximum(rest_capacity - dem, 0.0))\n\n    # Combined score: prefer near current node, near depot, small demand,\n    # and penalize far customers as capacity shrinks.\n    urgency = np.maximum(rest_capacity, 1e-12)\n    near_score = cur + 0.35 * to_depot * (dem / urgency)\n\n    # slight tie-preference for customers with demand closest to remaining capacity\n    fit = np.abs(rest_capacity - dem)\n    score = near_score + 0.15 * fit * load_factor * 0.0 + 0.05 * fit / max(urgency, 1.0)\n\n    best = int(np.argmin(score))\n    return int(unvisited_nodes[best])","code_sha256":"4c7f9191609d7f162af603f7bc4594c1910681045afe8d1273486ee4fe194088","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"a0b60cd8afc74c7eac2b46ae6bd86dd2","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"2b093c79224a95d6de73ec995a380519730f0e4fc0561a7eee69a50366a5854a","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[13.062883689642087,14.395579444160346,11.4733954978018,12.275266825117388,14.41620829255432,13.247616713460328],"lineage_status":"verified","objective":13.145158410456043,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"8f8f102534b3b44d521c6455442e941a01a04abb8febc1103a52480821178b4f"},"dual_budget":{"baseline_attempts":2,"novel_candidate_evaluations":8,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":2,"total_evaluation_attempts":12},"evaluator_hash":"89ab003b467