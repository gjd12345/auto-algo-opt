":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Distance saving of inserting the customer before returning to depot.\n    saving = d_cur + d_dep - distance_matrix[depot][current_node]\n\n    # Prefer nearby feasible customers with good depot-return geometry.\n    score = d_cur + 0.35 * d_dep - 0.15 * saving\n\n    # Mildly prefer customers whose demand fits the remaining capacity well.\n    if rest_capacity > 0:\n        fill = dem / rest_capacity\n        score = score - 0.05 * fill\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"d2bd96576bf0acbf6fe31ef314e6e6f0b4e3b3bd33cf868658f0ceff34c473a7","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"a1a481427ec144fba157d8fc47a984fb","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[13.906615790753827,14.830725343237525,10.708846541380595,12.290295681983666,11.455148462005672,10.986332208941548],"lineage_status":"no_parent","objective":12.362994004717137,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d = distance_matrix[current_node][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n\n    # Density-like score: prefer near customers whose demand fills remaining capacity well.\n    # Lower score is better.  The demand ratio term is bounded in [0, 1].\n    scores = d - d.mean() * (dem / cap)\n\n    return int(unvisited_nodes[int(np.argmin(scores))])","code_sha256":"cc95a0bf9f01ba0923c03b08404c5031fbbd268f4601dcafb2b61178f419fe0f","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"231f509f7c2c47488d60c380f328c53b","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[13.257350457325371,11.938053874485785,11.06440834609845,12.288699565560373,13.658651041032236,11.31345856267252],"lineage_status":"no_parent","objective":12.253436974529123,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Prefer nearby nodes, but penalize returning far from the depot and\n    # large demands that consume scarce remaining capacity.  The weights are\n    # fixed to keep the rule deterministic and cheap to evaluate.\n    score = d_cur + 0.5 * d_dep + 0.2 * dem\n\n    idx = int(np.argmin(score))\n    return int(unvisited_nodes[idx])","code_sha256":"ef9d6fa1a04516ed8165479345ed3ab1d19c8aa5212a66744e847ceb193c0d7f","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"86ba33b0fa364488878dc1199d170550","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[15.337774993941313,17.47201435276867,16.390062660059126,16.969794442118786,16.487346658908933,16.83814855222226],"lineage_status":"no_parent","objective":16.582523610003182,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Prefer nearest neighbors, but reward customers that consume more capacity\n    # (higher demand relative to remaining capacity), which tends to pack routes\n    # and reduce the number of trips from the depot.\n    capacity_scale = rest_capacity if rest_capacity > 0 else 1.0\n    fill_bonus = (dem / capacity_scale) * (d_cur + d_dep + 1.0) * 0.5\n\n    scores = d_cur - fill_bonus\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"2184e0fdaedc27c961e1718f1935d97274f33d1e5184a34df1b45a8b7c7356dc","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"98cfe1ec1e0c4090a334b66e914feda4","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[15.759397834632667,13.358535677655585,11.567504052077792,16.23107259247487,13.32263990598926,12.828007258211343],"lineage_status":"no_parent","objective":13.844526220173586,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d = distance_matrix[current_node][unvisited_nodes].astype(float)\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n    mean_d = float(np.mean(d)) if d.size > 0 else 1.0\n    scale = mean_d if mean_d > 1e-12 else 1.0\n\n    # Stronger demand reward, depot-savings weighting: prefer near, high-demand\n    # customers whose inclusion reduces the need for an extra depot round-trip.\n    depot_d = distance_matrix[depot][unvisited_nodes].astype(float)\n    savings = distance_matrix[depot][current_node] + depot_d - d\n\n    scores = (d / scale) - 2.0 * (dem / cap) - 0.5 * (savings / scale)\n\n    return int(unvisited_nodes[int(np.argmin(scores))])","code_sha256":"97f8c592da3967b3bc8417310ccd49ab34dd7f8d95154c1227165ceb93874bdf","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"629b6403201f4472805a3bffe16d6c11","generation_parents":[{"algorithm":"Shift from pure nearest-neighbor by scoring each feasible customer with a distance term minus a reward proportional to its demand (a density-like savings cue), so the heuristic prefers nearby high-demand customers and tends to empty capacity-efficiently before returning to the depot.","code_sha256":"cc95a0bf9f01ba0923c03b08404c5031fbbd268f4601dcafb2b61178f419fe0f","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[12.58771915506648,14.213906795990843,11.160182875847347,13.734420742793523,12.967328175694014,11.91136061029467],"lineage_status":"verified","objective":12.762486392614479,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Clarke-Wright insertion savings: benefit of linking current -> node -> depot\n    # instead of current -> depot plus a fresh depot -> node leg.\n    savings = d_cur_depot + to_depot - cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n    fill_bonus = (dem / cap) * (d_cur_depot + 1e-9) * 0.5\n\n    scores = savings + fill_bonus\n\n    return int(unvisited_nodes[int(np.argmax(scores))])","code_sha256":"78ae050d9bd1ba7767d7d227fdca0e1c4c4e8d6bedb8558f4cb9ff17e76c3685","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"caa26ef095dd4c9ba34c2f4b8b71465e","generation_parents":[{"algorithm":"Shift from pure nearest-neighbor by scoring each feasible customer with a distance term minus a reward proporti