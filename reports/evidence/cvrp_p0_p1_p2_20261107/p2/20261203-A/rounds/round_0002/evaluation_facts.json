","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Clarke-Wright insertion savings: benefit of linking current -> node -> depot\n    # instead of current -> depot plus a fresh depot -> node leg.\n    savings = d_cur_depot + to_depot - cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n    fill_bonus = (dem / cap) * (d_cur_depot + 1e-9) * 0.5\n\n    scores = savings + fill_bonus\n\n    return int(unvisited_nodes[int(np.argmax(scores))])","code_sha256":"78ae050d9bd1ba7767d7d227fdca0e1c4c4e8d6bedb8558f4cb9ff17e76c3685","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"479e237eb9104436994442fb7373c604","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.356608695068342,12.405072366213743,10.439204294644968,11.325624137213527,11.665088192548671,11.477549548276684],"lineage_status":null,"objective":11.778191205660988,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Clarke-Wright insertion savings: benefit of linking current -> node -> depot\n    # instead of current -> depot plus a fresh depot -> node leg.\n    savings = d_cur_depot + to_depot - cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n    fill_bonus = (dem / cap) * (d_cur_depot + 1e-9) * 0.5\n\n    scores = savings + fill_bonus\n\n    return int(unvisited_nodes[int(np.argmax(scores))])","code_sha256":"78ae050d9bd1ba7767d7d227fdca0e1c4c4e8d6bedb8558f4cb9ff17e76c3685","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"4553ab227ece444d86df4cb6a0aba4cf","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.356608695068342,12.405072366213743,10.439204294644968,11.325624137213527,11.665088192548671,11.477549548276684],"lineage_status":null,"objective":11.778191205660988,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Clarke-Wright style savings: linking current -> node -> depot.\n    savings = d_cur_depot + to_depot - cur\n\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n\n    # Weighted capacity fill: prefer nodes using a large fraction of remaining\n    # capacity, but scale by the depot fallback distance so far nodes still\n    # contribute meaningfully to route extension.\n    fill_ratio = dem / cap\n    proximity = to_depot\n    fill_weight = 0.35 * (d_cur_depot + 1e-9) / (np.mean(proximity) + 1e-9)\n\n    scores = savings + fill_weight * fill_ratio * proximity\n\n    return int(unvisited_nodes[int(np.argmax(scores))])","code_sha256":"5a74ec2be95645ae921d2f376528663a63d2ae4a353a33a586de0733d19387ee","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"b4c6e94f21284f5880b613595dfe84d3","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"78ae050d9bd1ba7767d7d227fdca0e1c4c4e8d6bedb8558f4cb9ff17e76c3685","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[13.162913477403887,11.59290619398173,10.718464369675962,11.76295111995088,11.827054555200084,12.154354869959835],"lineage_status":"verified","objective":11.869774097695398,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cur_dists = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n    cap = max(float(rest_capacity), 1e-12)\n\n    # Route-extension cost: distance to go there directly.\n    extension = cur_dists\n\n    # Capacity pressure: large-demand nodes are at risk of being stranded;\n    # penalize picking a small-demand node while big ones still fit.\n    max_dem_left = float(np.max(dem))\n    stranded_risk = max_dem_left / cap  # high when tight packing needed\n\n    # Regret: how close is this candidate to \"next best\"? Nodes near a cluster\n    # should be deferred if a more isolated node would otherwise be costly.\n    n = unvisited_nodes.size\n    if n > 1:\n        # nearest-neighbor distance of each candidate to some other unvisited\n        # node (excluding self) via full submatrix\n        sub = distance_matrix[np.ix_(unvisited_nodes, unvisited_nodes)].copy()\n        np.fill_diagonal(sub, np.inf)\n        min_other = np.min(sub, axis=1)\n    else:\n        min_other = np.full(n, np.inf)\n\n    # Composite: minimize extension, avoid stranding large demands, and\n    # prefer isolated nodes (large min-other means few close alternatives,\n    # so serve them while we are nearby).\n    isolation_bonus = np.where(np.isfinite(min_other), min_other, to_depot)\n\n    # Capacity utilization: prefer using a good chunk of remaining capacity.\n    fill_ratio = dem / cap\n\n    score = (\n        extension\n        + 0.30 * stranded_risk * (max_dem_left - dem)  # penalize leaving big ones behind\n        - 0.25 * isolation_bonus                        # reward isolated nodes\n        - 0.20 * fill_ratio * to_depot                  # reward filling capacity\n    )\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"e639136552e53e1a89bd5fd967907dc84d2037fccc6c65f65f68ad918406d1be","elapsed_seconds":0.297,"error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"3fcf761b34eb40c98d77581208c6b6ca","generation_parents":[{"algorit