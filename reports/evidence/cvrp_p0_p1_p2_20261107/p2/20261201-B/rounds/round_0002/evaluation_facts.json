nt","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    best = None\n    best_score = -np.inf\n    for i in range(unvisited_nodes.size):\n        node = unvisited_nodes[i]\n        # savings of visiting now rather than from depot on a later trip\n        saving = d_dep[i] + d_dep[i] - distance_matrix[node][depot]\n        # balance proximity and savings; use demand ratio to prefer filling vehicle\n        demand_ratio = demands[node] / (rest_capacity + 1e-12)\n        score = saving - d_cur[i] + 0.1 * demand_ratio\n        if score > best_score:\n            best_score = score\n            best = node\n    return int(best)","code_sha256":"056b8fffe75575d78637477cb747712724b3130da180efe4c11d5037e7f768a0","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"2b58301c560e4270a4c915b6d9144eab","generation_parents":null,"generation_request_ref":null,"instance_objectives":[11.237097701944716,11.395620355443075,10.667202095849925,11.339330926097714,13.570807953571125,11.360382628090195],"lineage_status":null,"objective":11.595073610166125,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    best = None\n    best_score = -np.inf\n    for i in range(unvisited_nodes.size):\n        node = unvisited_nodes[i]\n        # savings of visiting now rather than from depot on a later trip\n        saving = d_dep[i] + d_dep[i] - distance_matrix[node][depot]\n        # balance proximity and savings; use demand ratio to prefer filling vehicle\n        demand_ratio = demands[node] / (rest_capacity + 1e-12)\n        score = saving - d_cur[i] + 0.1 * demand_ratio\n        if score > best_score:\n            best_score = score\n            best = node\n    return int(best)","code_sha256":"056b8fffe75575d78637477cb747712724b3130da180efe4c11d5037e7f768a0","elapsed_seconds":0.406,"error_code":null,"error_detail":null,"evaluation_id":"fcd1a7b0ff8a4d6e83d7eb2959eae8f1","generation_parents":null,"generation_request_ref":null,"instance_objectives":[11.237097701944716,11.395620355443075,10.667202095849925,11.339330926097714,13.570807953571125,11.360382628090195],"lineage_status":null,"objective":11.595073610166125,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    demands_u = demands[unvisited_nodes]\n\n    # nearest distance from current node to all feasible nodes\n    nearest = np.min(d_cur)\n\n    best = None\n    best_score = -np.inf\n    for i in range(unvisited_nodes.size):\n        node = unvisited_nodes[i]\n        demand = demands_u[i]\n        # marginal travel cost to serve this customer now\n        travel_cost = d_cur[i]\n        # return trip cost avoided by serving it now (vs. depot round trip later)\n        return_saving = 2.0 * d_dep[i]\n        # regret: how much worse off we'd be if forced to pick the nearest instead\n        regret = d_cur[i] - nearest\n        # density: demand packed per unit of marginal travel\n        density = demand / (travel_cost + 1e-9)\n        # opportunity cost: relative capacity fraction consumed\n        cap_frac = demand / (rest_capacity + 1e-12)\n        score = return_saving - travel_cost - regret + density + 0.5 * cap_frac\n        if score > best_score:\n            best_score = score\n            best = node\n    return int(best)","code_sha256":"854a098c2ec948120a20096099fef42d0b97c1dc11cbe0a2b2967b38ad74f766","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"5f38126e5d714c9785ed8c0157db14e1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"056b8fffe75575d78637477cb747712724b3130da180efe4c11d5037e7f768a0","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"056b8fffe75575d78637477cb747712724b3130da180efe4c11d5037e7f768a0","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[12.527356485892133,13.974572243843362,11.885506059897772,10.961334366583554,16.059622561868846,13.134919364868122],"lineage_status":"verified","objective":13.090551847158965,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    # Normalize distances by the max current leg to keep scores in comparable range\n    scale = np.max(d_cur) + 1e-9\n    prox = 1.0 - (d_cur / scale)               # higher = closer\n    fill = dem / (rest_capacity + 1e-9)        # higher = uses capacity\n    # depot-return pressure: prefer nodes whose return leg is short (easier to close route)\n    return_pressure = 1.0 - (d_dep / (np.max(d_dep) + 1e-9))\n\n    # Weighted composite: proximity dominates, filling and closing are secondary\n    score = 1.0 * prox + 0.35 * fill + 0.15 * return_pressure\n\n    # Penalize very small remaining capacity relative to demand to avoid bad fit\n    fit_penalty = np.where(dem > rest_capacity, 10.0, 0.0)\n\n    final = score - fit_penalty\n\n    return int(unvisited_nodes[np.argmax(final)])","code_sha256":"8881447ab7b403182eaad78582e5fae23b642f35afb51778f0c98ce2dc6acc48","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"a19c0e2356e744e495ccfe865add78bb","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"056b8fffe75575d78637477cb747712724b3130da180efe4c11d5037e7f768a0","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"056b8fffe75575d78637477cb747712724b3130da180efe4c11d5037e7f768a0","population_