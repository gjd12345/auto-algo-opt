s = pressure * d_depot\n\n    scores = d_cur - 0.5 * savings - 0.25 * fill * d_cur_depot + 0.3 * depot_bias\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"1fc7a95f77b55b0aef21cf7368df4a3a7989dab0db0c6ee1c4ac6949caf61dad","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"c7029e097bfa44a5bf295f94228ceb5a","generation_parents":[{"algorithm":"Adjust the incumbent's savings coefficient modestly from 0.5 to 0.55 and the capacity bonus from 0.15 to 0.20 while keeping the far-anchor start unchanged, to test whether slightly stronger route-continuation weighting improves total distance.","code_sha256":"e84b5f68ff6acf2c23a61efc45a86288b3ab611a941d2eb4187e32ae22b7090e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Adjust the incumbent's savings coefficient modestly from 0.5 to 0.55 and the capacity bonus from 0.15 to 0.20 while keeping the far-anchor start unchanged, to test whether slightly stronger route-continuation weighting improves total distance.","code_sha256":"e84b5f68ff6acf2c23a61efc45a86288b3ab611a941d2eb4187e32ae22b7090e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[9.74920284706559,11.882343665139933,9.830063819772956,11.718173144192292,11.811412403301517,11.645860083013398],"lineage_status":"verified","objective":11.106175993747614,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"e31febf704b85f08c3dea58623a364063d89f2c6fdb0bf7347b76463ee875928"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":10,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":4,"total_eval