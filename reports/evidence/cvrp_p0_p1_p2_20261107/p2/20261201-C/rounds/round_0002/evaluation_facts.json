sited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Depot savings: how much is saved by going directly rather than\n    # current -> j -> depot.\n    savings = d_cur_depot + d_depot - d_cur\n\n    # Bounded capacity interaction: mildly prefer larger feasible demands\n    # when distances are comparable, encouraging fuller routes.\n    dem = demands[unvisited_nodes]\n    cap_scale = np.maximum(rest_capacity, 1e-9)\n    cap_bonus = 0.05 * (dem / cap_scale)\n\n    scores = d_cur - 0.5 * savings - cap_bonus\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"b967c62b59b6ac1a30332dd535461b27edef945d49e829a16da898d6630fa77e","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"98b4b7db8a7643438c976945bb63db66","generation_parents":null,"generation_request_ref":null,"instance_objectives":[9.924088454500755,11.591382698337567,10.90662246061193,10.804571255117482,11.851428192964256,11.463606230375389],"lineage_status":null,"objective":11.090283215317896,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        d_depot = distance_matrix[depot][unvisited_nodes]\n        dem = demands[unvisited_nodes]\n        scores = d_depot - 0.05 * dem\n        return int(unvisited_nodes[np.argmax(scores)])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    savings = d_cur_depot + d_depot - d_cur\n\n    dem = demands[unvisited_nodes]\n    cap_scale = np.maximum(rest_capacity, 1e-9)\n    cap_bonus = 0.15 * (dem / cap_scale)\n\n    scores = d_cur - 0.5 * savings - cap_bonus\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"0f8d845352526fe801f357a23fd9598e12481cdce3851233b4eca5790b78393c","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"a68c25f8af70490a9b4a569ea6512ae1","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"b967c62b59b6ac1a30332dd535461b27edef945d49e829a16da898d6630fa77e","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"b967c62b59b6ac1a30332dd535461b27edef945d49e829a16da898d6630fa77e","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[9.726053861778544,12.290912130493476,10.621315112794804,10.952395259987608,11.851428192964256,11.075887005962478],"lineage_status":"verified","objective":11.086331927330194,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n\n    if current_node == depot:\n        # Far-anchor start: strongly prefer far customers, mild demand tie-break.\n        scores = d_depot + 0.02 * dem\n        return int(unvisited_nodes[np.argmax(scores)])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Radial distance from depot for each candidate (proxy for being far out).\n    radial = d_depot\n\n    # Capacity fill fraction: how much of remaining capacity this demand uses.\n    cap_scale = np.maximum(rest_capacity, 1e-9)\n    fill = dem / cap_scale  # in (0, 1]\n\n    # Bounded fill penalty: saturating function, pushes toward filling vehicle.\n    fill_penalty = 1.0 - np.exp(-3.0 * fill)\n\n    # Combined score (minimize): near to current, prefer far-from-depot candidates\n    # that extend the route outward, and reward filling capacity.\n    scores = d_cur + 0.35 * d_cur_depot - 0.20 * radial + 0.60 * fill_penalty * d_cur\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"4ef6758f573a92f16c3a02710efd184a2bba98e8f9ed6448711d991c725385d3","elapsed_seconds":0.282,