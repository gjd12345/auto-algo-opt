ent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    if current_node == depot:\n        # Deterministic nearest-neighbor start.\n        return int(unvisited_nodes[np.argmin(d_dep)])\n\n    d_cur_to = distance_matrix[current_node][unvisited_nodes]\n    d_depot_to = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + d_depot_to - d_cur_to\n\n    # Capacity interaction: when capacity is tight, favor closing/returning\n    # savings more strongly (radial preference toward depot).\n    cap_ratio = 0.0\n    total_cap = rest_capacity + float(np.sum(demands[unvisited_nodes]))\n    if total_cap > 1e-12:\n        cap_ratio = float(rest_capacity) / total_cap\n    cap_ratio = max(0.0, min(1.0, cap_ratio))\n\n    # Score: lower is better. Blend route-coherent increment with depot savings.\n    # Tight capacity -> higher weight on savings (depot-aware radial preference).\n    w_save = 0.35 + 0.45 * (1.0 - cap_ratio)\n    w_cur = 1.0 - 0.5 * (1.0 - cap_ratio)\n\n    score = w_cur * d_cur_to - w_save * savings\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","elapsed_seconds":0.391,"error_code":null,"error_detail":null,"evaluation_id":"d13af4ec27c64ad7afcc200c469f3753","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.851035927904913,11.206255353550592,11.119346484851912,11.070227664115535,12.47019817926194,12.072111421910027],"lineage_status":null,"objective":11.46486250526582,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    if current_node == depot:\n        # Deterministic nearest-neighbor start.\n        return int(unvisited_nodes[np.argmin(d_dep)])\n\n    d_cur_to = distance_matrix[current_node][unvisited_nodes]\n    d_depot_to = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + d_depot_to - d_cur_to\n\n    # Capacity interaction: when capacity is tight, favor closing/returning\n    # savings more strongly (radial preference toward depot).\n    cap_ratio = 0.0\n    total_cap = rest_capacity + float(np.sum(demands[unvisited_nodes]))\n    if total_cap > 1e-12:\n        cap_ratio = float(rest_capacity) / total_cap\n    cap_ratio = max(0.0, min(1.0, cap_ratio))\n\n    # Score: lower is better. Blend route-coherent increment with depot savings.\n    # Tight capacity -> higher weight on savings (depot-aware radial preference).\n    w_save = 0.35 + 0.45 * (1.0 - cap_ratio)\n    w_cur = 1.0 - 0.5 * (1.0 - cap_ratio)\n\n    score = w_cur * d_cur_to - w_save * savings\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","elapsed_seconds":0.375,"error_code":null,"error_detail":null,"evaluation_id":"e0e75314c50046d1bcbc78ac9c864f7f","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.851035927904913,11.206255353550592,11.119346484851912,11.070227664115535,12.47019817926194,12.072111421910027],"lineage_status":null,"objective":11.46486250526582,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited]\n    d_dep = distance_matrix[depot][unvisited]\n\n    if current_node == depot:\n        return int(unvisited[np.argmin(d_dep)])\n\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    w_save = 0.65\n    w_cur = 1.0\n    w_radial = 0.10\n\n    score = w_cur * d_cur - w_save * savings + w_radial * d_dep\n    return int(unvisited[np.argmin(score)])","code_sha256":"1797b50b9eb3ba00da56f8efaade81e30c70fbb33b7e1b85f2c1dbcb1cd6ff73","elapsed_seconds":0.343,"error_code":null,"error_detail":null,"evaluation_id":"332b26080f464cc0b26dc747352d42df","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_12.json","instance_objectives":[9.899910653312942,11.664112344246693,10.831653246703038,12.27317921859646,12.760871024814843,12.125451987514783],"lineage_status":"verified","objective":11.592529745864793,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited_nodes.size == 0:\n        return int(depot)\n\n    if current_node == depot:\n        return int(unvisited_nodes[np.argmin(distance_matrix[depot][unvisited_nodes])])\n\n    d_cur_to = distance_matrix[current_node][unvisited_nodes]\n    d_depot_to = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n    dem = demands[unvisited_nodes]\n\n    # Insertion-like merge cost relative to returning to depot now.\n    merge_cost = d_cur_to + d_depot_to - d_cur_depot\n\n    # Demand-density: reward customers whose demand per unit detour is high.\n    eps = 1e-9\n    density = dem / (d_depot_to + eps)\n    max_density = float(np.max(density)) if density.size > 0 else 0.0\n    if max_density > eps:\n        density_norm = density / max_density\n    else:\n        density_norm = np.zeros_like(density, dtype=np.float64)\n\n    cap_ratio = 0.0\n    if rest_capacity > 1e-12:\n        cap_ratio = float(rest_capacity) / (float(rest_capacity) + float(np.sum(dem)))\n    cap_ratio = max(0.0, min(1.0, cap_ratio))\n\n    # Weight: tighten capacity -> more emphasis on high demand density.\n    w_density = 0.30 + 0.30 * (1.0 - cap_ratio)\n    w_merge = 1.0 - 0.35 * (1.0 - cap_ratio)\n\n    score = w_merge * merge_cost - w_density * d_cur_depot * density_norm\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"5fca91534d9ea52edc898143fa380e338712f19c37bb4dbd79d53e61f0e1d613","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"2489405bba5e49eb894002f9bd5d1614","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0003/eoh_run/results/exchanges/request_13.json","instance_objectives":[13.315497428312545,15.0373179608326,14.094239597774267,12.947996962916456,15.47887974538484,13.850398894621664],"lineage_status":"verified","objective":14.120721764973728,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true}],"comparison_packet":{"ref":"rounds/round_0003/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"61e970e202546a5596959838eb0c5961585b93118681af641e5a7182d66074a5"},"dual_budget":{"baseline_attempts":3,"novel_candidate_evaluations":10,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":4,"total_evaluation_attempts":17},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:1836b33f46164582a24f88bd082e6b4f","evaluation:d13af4ec27c64ad7afcc200c469f3753","evaluation:e0e75314c50046d1bcbc78ac9c864f7f","evaluation:332b26080f464cc0b26dc747352d42df","evaluation:2489405bba5e49eb894002f9bd5d1614","rounds/round_0003/execution_delta.json","rounds/round_0003/comparison_packet.json"],"execution_delta":{"gener