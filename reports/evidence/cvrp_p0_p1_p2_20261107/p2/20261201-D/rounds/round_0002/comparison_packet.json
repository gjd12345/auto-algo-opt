d_nodes].astype(np.float64)\n \n-    # Capacity interaction: when capacity is tight, favor closing/returning\n-    # savings more strongly (radial preference toward depot).\n-    cap_ratio = 0.0\n-    total_cap = rest_capacity + float(np.sum(demands[unvisited_nodes]))\n-    if total_cap > 1e-12:\n-        cap_ratio = float(rest_capacity) / total_cap\n-    cap_ratio = max(0.0, min(1.0, cap_ratio))\n+    total_dem = float(np.sum(dem))\n+    fill = 0.0\n+    if total_dem + float(rest_capacity) > 1e-12:\n+        fill = float(rest_capacity) / (float(rest_capacity) + total_dem)\n+    fill = max(0.0, min(1.0, fill))\n \n-    # Score: lower is better. Blend route-coherent increment with depot savings.\n-    # Tight capacity -> higher weight on savings (depot-aware radial preference).\n-    w_save = 0.35 + 0.45 * (1.0 - cap_ratio)\n-    w_cur = 1.0 - 0.5 * (1.0 - cap_ratio)\n-\n-    score = w_cur * d_cur_to - w_save * savings\n+    # Composite: balance proximity, savings, and radial pull toward depot\n+    # as capacity depletes.\n+    radial = d_dep - 0.5 * d_cur_to\n+    score = (\n+        (1.15 - 0.55 * fill) * d_cur_to\n+        - (0.30 + 0.55 * (1.0 - fill)) * savings\n+        + (0.25 + 0.45 * (1.0 - fill)) * radial\n+        + 0.10 * dem\n+    )\n \n     return int(unvisited_nodes[np.argmin(score)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":2},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"9b7cd7f236754b8256214a106b991e3792cb6e3a8807f84078559555e26bedb6","evaluation_id":"ec203ae67ceb4d59a34c3ca37bb81244","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0]