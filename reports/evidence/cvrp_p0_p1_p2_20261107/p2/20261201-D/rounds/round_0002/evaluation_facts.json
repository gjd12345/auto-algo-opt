n        + (0.25 + 0.45 * (1.0 - fill)) * radial\n        + 0.10 * dem\n    )\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"353b668b747361f00ceb1ce3f5581160eec55a92a2f50a1f224d9c36fa1121b9","elapsed_seconds":0.391,"error_code":null,"error_detail":null,"evaluation_id":"12f239cbf01942af8aa121af0130f26b","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[12.924755732650466,15.063379177738499,12.868416863307203,14.244425904399725,14.40980989113935,15.624132302343194],"lineage_status":"verified","objective":14.189153311929742,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true}],"comparison_packet":{"ref":"rounds/round_0002/comparison_packet.json","schema_version":"algorithm-optimization-comparison-packet/v1","sha256":"1480c033f3e59e8586a8a769e1ae40727eff31cccac2d614a68c3fb34ea6c301"},"dual_budget":{"baseline_attempts":2,"novel_candidate_evaluations":8,"phase_evaluation_attempts":{},"repair_attempts":0,"seed_reevaluation_attempts":2,"total_evaluation_attempts":12},"evaluator_hash":"89ab003b4671c329cc023908f327c29c05a355e16aa989267b8cdea13f849234","evidence_refs":["evaluation:12ae94fec5e148eaa7b206c19da11b4f","evaluation:2552f37a8a834b2998c452ae501a9b6b","evaluation:512ab94960d048c6ae833c9d598cd56e","evaluation:ec203ae67ceb4d59a34c3ca37bb81244","evaluation:12f239cbf01942af8aa121af0130f26b","rounds/round_0002/execution_delta.json","rounds/round_0002/comparison_packet.json"],"execution_delta":{"generated_count":2,"ref":"r