nt","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    if current_node == depot:\n        # Deterministic nearest-neighbor start.\n        return int(unvisited_nodes[np.argmin(d_dep)])\n\n    d_cur_to = distance_matrix[current_node][unvisited_nodes]\n    d_depot_to = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + d_depot_to - d_cur_to\n\n    # Capacity interaction: when capacity is tight, favor closing/returning\n    # savings more strongly (radial preference toward depot).\n    cap_ratio = 0.0\n    total_cap = rest_capacity + float(np.sum(demands[unvisited_nodes]))\n    if total_cap > 1e-12:\n        cap_ratio = float(rest_capacity) / total_cap\n    cap_ratio = max(0.0, min(1.0, cap_ratio))\n\n    # Score: lower is better. Blend route-coherent increment with depot savings.\n    # Tight capacity -> higher weight on savings (depot-aware radial preference).\n    w_save = 0.35 + 0.45 * (1.0 - cap_ratio)\n    w_cur = 1.0 - 0.5 * (1.0 - cap_ratio)\n\n    score = w_cur * d_cur_to - w_save * savings\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"2552f37a8a834b2998c452ae501a9b6b","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.851035927904913,11.206255353550592,11.119346484851912,11.070227664115535,12.47019817926194,12.072111421910027],"lineage_status":null,"objective":11.46486250526582,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    if current_node == depot:\n        # Deterministic nearest-neighbor start.\n        return int(unvisited_nodes[np.argmin(d_dep)])\n\n    d_cur_to = distance_matrix[current_node][unvisited_nodes]\n    d_depot_to = distance_matrix[depot][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + d_depot_to - d_cur_to\n\n    # Capacity interaction: when capacity is tight, favor closing/returning\n    # savings more strongly (radial preference toward depot).\n    cap_ratio = 0.0\n    total_cap = rest_capacity + float(np.sum(demands[unvisited_nodes]))\n    if total_cap > 1e-12:\n        cap_ratio = float(rest_capacity) / total_cap\n    cap_ratio = max(0.0, min(1.0, cap_ratio))\n\n    # Score: lower is better. Blend route-coherent increment with depot savings.\n    # Tight capacity -> higher weight on savings (depot-aware radial preference).\n    w_save = 0.35 + 0.45 * (1.0 - cap_ratio)\n    w_cur = 1.0 - 0.5 * (1.0 - cap_ratio)\n\n    score = w_cur * d_cur_to - w_save * savings\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"7f9bb34914091da78e67b0807fab42d1303e25a4713e251acab1240bac210b44","elapsed_seconds":0.391,"error_code":null,"error_detail":null,"evaluation_id":"512ab94960d048c6ae833c9d598cd56e","generation_parents":null,"generation_request_ref":null,"instance_objectives":[10.851035927904913,11.206255353550592,11.119346484851912,11.070227664115535,12.47019817926194,12.072111421910027],"lineage_status":null,"objective":11.46486250526582,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"d902f9a7fe9f3bbe31e0896b0658afe1447ffc7cdcd208bd714b67ed4e6882bd","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited = np.asarray(unvisited_nodes, dtype=np.int64)\n    if unvisited.size == 0:\n        return int(depot)\n\n    if int(current_node) == int(depot):\n        # Open a new route from the nearest customer (deterministic).\n        return int(unvisited[np.argmin(distance_matrix[depot][unvisited])])\n\n    d_cur = distance_matrix[current_node][unvisited]\n    d_dep = distance_matrix[depot][unvisited]\n    d_cur_dep = distance_matrix[current_node][depot]\n\n    # \"Regret\" of not going home now: extra distance incurred by visiting\n    # this customer before eventually returning to the depot.\n    detour = d_cur + d_dep - d_cur_dep\n\n    # Radial closeness: customers far from depot are more expensive to\n    # visit later, so mildly prefer them while capacity still allows.\n    total_remaining_demand = float(np.sum(demands[unvisited]))\n    cap_ratio = 1.0\n    if total_remaining_demand + rest_capacity > 1e-12:\n        cap_ratio = float(rest_capacity) / (\n            float(rest_capacity) + total_remaining_demand\n        )\n    cap_ratio = max(0.0, min(1.0, cap_ratio))\n\n    # Weight on radial pull grows as capacity slack grows.\n    slack = cap_ratio\n    score = detour - 0.15 * slack * d_dep\n\n    return int(unvisited[np.argmin(score)])","code_sha256":"9b7cd7f236754b8256214a106b991e3792cb6e3a8807f84078559555e26bedb6","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"ec203ae67ceb4d59a34c3ca37bb81244","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"7f9bb349140