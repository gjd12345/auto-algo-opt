","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n\n    # Depot savings: benefit of current->j over current->depot->j.\n    savings = distance_matrix[current_node][depot] + d_depot - d_cur\n\n    # Milder capacity interaction than the reference heuristic.\n    dem = demands[unvisited_nodes]\n    cap_ratio = np.clip(dem / max(rest_capacity, 1e-9), 0.0, 1.0)\n\n    if current_node == depot:\n        # Nearest-neighbor start: deterministic and compact.\n        score = -d_depot + 1e-6 * savings\n        return int(unvisited_nodes[np.argmax(score)])\n\n    # Stronger proximity weight, weaker capacity modulation.\n    score = savings - 0.45 * d_cur - 0.2 * cap_ratio * d_cur\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"3aecabda5a1e7bf08a522b1b1a0001ef8ebfd3dd18fb6d323341548f28090a51","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"8d85110018d943f0a55415e31fc02ef2","generation_parents":null,"generation_request_ref":null,"instance_objectives":[11.754623352079623,12.676859492102029,9.694919213786543,12.697527747046404,11.14121937267751,10.751660601804435],"lineage_status":null,"objective":11.45280162991609,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n\n    # Depot savings: benefit of current->j over current->depot->j.\n    savings = distance_matrix[current_node][depot] + d_depot - d_cur\n\n    # Milder capacity interaction than the reference heuristic.\n    dem = demands[unvisited_nodes]\n    cap_ratio = np.clip(dem / max(rest_capacity, 1e-9), 0.0, 1.0)\n\n    if current_node == depot:\n        # Nearest-neighbor start: deterministic and compact.\n        score = -d_depot + 1e-6 * savings\n        return int(unvisited_nodes[np.argmax(score)])\n\n    # Stronger proximity weight, weaker capacity modulation.\n    score = savings - 0.45 * d_cur - 0.2 * cap_ratio * d_cur\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"3aecabda5a1e7bf08a522b1b1a0001ef8ebfd3dd18fb6d323341548f28090a51","elapsed_seconds":0.36,"error_code":null,"error_detail":null,"evaluation_id":"2950135f82bc49e69d0a57286684cbae","generation_parents":null,"generation_request_ref":null,"instance_objectives":[11.754623352079623,12.676859492102029,9.694919213786543,12.697527747046404,11.14121937267751,10.751660601804435],"lineage_status":null,"objective":11.45280162991609,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = distance_matrix[current_node][depot]\n\n    dem = demands[unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n\n    if current_node == depot:\n        # Nearest-neighbor start.\n        score = -d_dep\n        return int(unvisited_nodes[np.argmax(score)])\n\n    # Normalized distances to reduce scale sensitivity.\n    scale = max(d_cd, 1e-9)\n    prox = d_cur / scale\n    save = (d_cd + d_dep - d_cur) / scale\n    cap_ratio = np.clip(dem / cap, 0.0, 1.0)\n\n    # Gentler demand weighting; emphasize proximity + savings.\n    score = save - 0.55 * prox - 0.15 * cap_ratio * prox\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"d4c3f19e772f666970c0d443629279a2b3ee89187c7c734d72fe4e7ee711b2fc","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"2a18aeae5a7a4632a4943604bc18bc53","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"3aecabda5a1e7bf08a522b1b1a0001ef8ebfd3dd18fb6d323341548f28090a51","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[12.732260977057532,11.820978774599673,9.694919213786543,11.75605672912817,11.14121937267751,10.751660601804435],"lineage_status":"verified","objective":11.316182611508978,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_cd = distance_matrix[current_node][depot]\n\n    dem = demands[unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n    cap_ratio = np.clip(dem / cap, 0.0, 1.0)\n\n    if current_node == depot:\n        # First node: nearest neighbor from depot, tie-break by smaller demand.\n        score = -d_dep - 1e-6 * dem\n        return int(unvisited_nodes[np.argmax(score)])\n\n    # Regret-style detour: how much worse than returning to depot now.\n    detour = d_cur + d_dep - d_cd\n\n    # Capacity pressure grows nonlinearly as the vehicle fills.\n    fill = 1.0 - cap / max(cap + np.sum(dem) + 1e-9, 1e-9)\n    pressure = cap_ratio * (1.0 + 1.5 * fill)\n\n    # Proximity term normalized by depot distance to keep scale stable.\n    scale = max(d_cd, 1e-9)\n    prox = d_cur / scale\n\n    score = -detour / scale - 0.35 * pressure * prox + 0.15 * (d_dep / scale)\n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"ba50e149e2a9fd0dc7841cf3a5babc81d293ccd62747218c834f6d903736b888","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"5ee822966f244038a08d5b19660ba30b","generati