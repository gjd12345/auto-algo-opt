      return int(unvisited_nodes[np.argmax(score)])\n\n    # Stronger proximity weight, weaker capacity modulation.\n    score = savings - 0.45 * d_cur - 0.2 * cap_ratio * d_cur\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"3aecabda5a1e7bf08a522b1b1a0001ef8ebfd3dd18fb6d323341548f28090a51","elapsed_seconds":0.343,"error_code":null,"error_detail":null,"evaluation_id":"75d7bf7ea3b2469da26bf8048d000b3e","generation_parents":[{"algorithm":"The heuristic ranks feasible candidates by a weighted combination of current-to-candidate distance and depot savings, using an explicit deterministic depot start and a bounded capacity-based weighting to favor route-coherent choices.","code_sha256":"2483a07865014c50ddf3d03f26de134f7c3cd8f385e948e81ec361d420afcd74","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[11.754623352079623,12.676859492102029,9.694919213786543,12.697527747046404,11.14121937267751,10.751660601804435],"lineage_status":"verified","objective":11.45280162991609,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur_depot = distance_matrix[current_node][depot]\n\n    # Insertion cost of detouring through j relative to going straight to depot.\n    insertion = d_cur + d_depot - d_cur_depot\n\n    # Radial term: how far the customer sits from the depot.\n    radial = d_depot\n\n    dem = demands[unvisited_nodes]\n    cap = max(rest_capacity, 1e-9)\n    # Capacity tightness in [0,1]: 1 means nearly full.\n    tightness = np.clip(1.0 - cap / (cap + dem.sum() + 1e-9), 0.0, 1.0)\n    # Urgency to consume high-demand customers when capacity is tight.\n    urgency = tightness * (dem / cap)\n\n    if current_node == depot:\n        # Start with the farthest unvisited customer to build wide routes,\n        # tie-broken by higher demand (deterministic).\n        score = radial + 1e-6 * dem\n        return int(unvisited_nodes[np.argmax(score)])\n\n    alpha = 0.55\n    beta = 0.30\n    gamma = 0.35\n    score = -(alpha * insertion) - (beta * radial) + (gamma * urgency * d_depot)\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"846b4582befede2957c4372692431a816a4da145f236588b5a7962ada8afb3d1","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"fbe67e52697f42d3b1dc8fbfd2f45fca","generation_parents":[{"algorithm":"The new algorithm keeps the same depot-savings and proximity framework but rebalances weights—using a stronger proximity penalty, a milder capacity modulation, and a nearest-neighbor start at the depot—to favor shorter, more compact routes.","code_sha256":"3aecabda5a1e7bf08a522b1b1a0001ef8ebfd3dd18fb6d323341548f28090a51","population_member_indices":[0],"selected_parent_position":0},{"algori