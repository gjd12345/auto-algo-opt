":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n\n    # Depot savings: how much is saved by going current->j instead of current->depot->j.\n    savings = distance_matrix[current_node][depot] + d_depot - d_cur\n\n    # Bounded capacity interaction: as capacity runs low, slightly favor nearer/closing nodes.\n    dem = demands[unvisited_nodes]\n    cap_ratio = np.clip(dem / max(rest_capacity, 1e-9), 0.0, 1.0)\n\n    if current_node == depot:\n        # Explicit deterministic start: farthest from depot (radial seed), tie-broken by index.\n        score = d_depot - 1e-6 * savings\n        return int(unvisited_nodes[np.argmax(score)])\n\n    # Route-coherent score: prefer large savings but keep proximity; capacity modulates slightly.\n    score = savings - 0.25 * d_cur - 0.5 * cap_ratio * d_cur\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"2483a07865014c50ddf3d03f26de134f7c3cd8f385e948e81ec361d420afcd74","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"59555f3a1e814c289e9afd21572fe423","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[11.929464273086113,12.105560839485724,9.643604264390342,11.60414555541088,11.814809897482624,11.858402979494912],"lineage_status":"no_parent","objective":11.492664634891767,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes, dtype=int)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    demands = np.asarray(demands, dtype=float)\n    dist = distance_matrix\n\n    if current_node == depot:\n        # Deterministic depot start: nearest feasible customer, tie by demand fit.\n        d0 = dist[depot][unvisited_nodes]\n        # Prefer slightly larger demand when distances are close to use capacity well.\n        demand_fit = demands[unvisited_nodes]\n        score = d0 - 1e-9 * demand_fit\n        return int(unvisited_nodes[np.argmin(score)])\n\n    # Depot-aware savings: d(cur, j) versus depot savings d(cur,0)+d(j,0)-d(cur,j).\n    d_cur_j = dist[current_node][unvisited_nodes]\n    d_j_depot = dist[unvisited_nodes][depot]\n    d_cur_depot = dist[current_node][depot]\n    savings = d_cur_depot + d_j_depot - d_cur_j\n\n    # Blend route extension and savings; savings help keep routes coherent/radial.\n    # Capacity pressure: near full, prefer nodes closer to depot for cleaner closure.\n    capacity_ratio = 0.0\n    if rest_capacity > 0:\n        capacity_ratio = 1.0 - (rest_capacity / max(rest_capacity + demands[unvisited_nodes].sum() / max(unvisited_nodes.size, 1), 1e-12))\n    capacity_ratio = float(np.clip(capacity_ratio, 0.0, 1.0))\n\n    score = d_cur_j - 0.5 * savings + capacity_ratio * 0.2 * d_j_depot\n\n    best_idx = int(np.argmin(score))\n    return int(unvisited_nodes[best_idx])","code_sha256":"5bcb235923da9b0b6dd871962996500640bd51f0916398b7fb8e55462e1eb206","elapsed_seconds":0.281,"error_code":"candidate_error","error_detail":null,"evaluation_id":"9267e3137f0e470aa5b034f2f8ab5062","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":false},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Deterministic start: farthest feasible customer (largest radial distance)\n        return int(unvisited_nodes[np.argmax(distance_matrix[depot][unvisited_nodes])])\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_edge = distance_matrix[current_node][depot]\n\n    savings = d_edge + d_depot - d_cur\n\n    # Capacity-aware radial bias: as remaining capacity shrinks, slightly favor\n    # customers closer to depot to keep routes compact.\n    fill_ratio = 1.0 - (rest_capacity / (rest_capacity + demands[unvisited_nodes].sum()))\n    radial_weight = 0.15 * fill_ratio\n\n    score = d_cur - savings + radial_weight * d_depot\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"0ab0d5d94b3518a916e40fbc1e68c378b1e46c4e227b77955832dd8c298076bf","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"4007fba7257d421c88b5183ace6f2ec8","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[11.929219950905562,11.525723510377327,10.984529793296751,11.496206334948646,11.329349967373606,11.788694047768956],"lineage_status":"no_parent","objective":11.508953934111808,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep = distance_matrix[depot][unvisited_nodes]\n\n    if current_node == depot:\n        return int(unvisited_nodes[np.argmin(dep)])\n\n    savings = distance_matrix[current_node][depot] + dep - cur\n    score = cur + 0.5 * dep - 0.1 * savings\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"ff97262800b9cd050f35ec405b33342766b7bff47d96345be95c30a01c9d8736","elapsed_seconds":0.281,"error_code":nu