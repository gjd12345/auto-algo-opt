r customers).\n    bonus = util * util * d_dep\n\n    score = saving + bonus\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"cc2a2385cfb5c504ba57f1caac560ec9265110768c95eb48ff9048e54e6f7e47","elapsed_seconds":0.422,"error_code":null,"error_detail":null,"evaluation_id":"2b8d41ccfb3e48b9bf560e9e346d9a48","generation_parents":null,"generation_request_ref":null,"instance_objectives":[14.586025186780859,12.850683301265699,11.57637420593949,11.306957247765524,12.598462672592037,10.639971096542295],"lineage_status":null,"objective":12.259745618480984,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_base = distance_matrix[depot][current_node]\n\n    saving = d_base + d_dep - d_cur\n\n    dem = demands[unvisited_nodes]\n    util = np.clip((dem + 1e-9) / (rest_capacity + 1e-9), 0.0, 1.0)\n\n    # New: slack-based bonus with higher exponent on utilization and inverse\n    # distance weighting to prefer nearby customers that also fill capacity.\n    slack_bonus = 0.6 * (util ** 3) * d_dep / (d_cur + 1.0)\n\n    score = saving + slack_bonus\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"f79609e986276721e350324739163b484bc6e25fbf559b97eedbad128147e323","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"a07c46236cde4678a22a54a73268b135","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"cc2a2385cfb5c504ba57f1caac560ec9265110768c95eb48ff9048e54e6f7e47","population_member_