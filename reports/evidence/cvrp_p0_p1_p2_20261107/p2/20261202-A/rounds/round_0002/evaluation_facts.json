candidate triangle.\n    d_dep_cur = float(distance_matrix[depot][current_node]) + 1e-9\n\n    # Cosine of the angle at the depot between (depot->current) and\n    # (depot->candidate). Small |cos deviation| keeps direction continuity.\n    cos_ang = (d_dep_cur * d_dep_cur + d_dep_c * d_dep_c - d_cur * d_cur) / (\n        2.0 * d_dep_cur * d_dep_c + 1e-9\n    )\n    cos_ang = np.clip(cos_ang, -1.0, 1.0)\n\n    # Radial term: prefer candidates that keep a low turning angle (high cos)\n    # while still making progress away from the depot.\n    radial = cos_ang * d_dep_c\n\n    # Lookahead: distance from candidate to its nearest remaining neighbor\n    # (excluding itself). Candidates with a nearby partner are good anchors.\n    sub = distance_matrix[np.ix_(unvisited_nodes, unvisited_nodes)].copy()\n    np.fill_diagonal(sub, np.inf) if False else None\n    eye_mask = np.eye(sub.shape[0], dtype=bool)\n    sub[eye_mask] = np.inf\n    nearest = np.min(sub, axis=1)\n\n    # Capacity utilization: mild push toward filling the truck.\n    dem = demands[unvisited_nodes]\n    util = np.clip((dem + 1e-9) / (rest_capacity + 1e-9), 0.0, 1.0)\n    cap_term = util * util * d_dep_c\n\n    # Score: travel cost is folded in by preferring close candidates.\n    score = -d_cur + 0.35 * radial - 0.30 * nearest + 0.20 * cap_term\n\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"48e5143d4255081b4c49900cc678ed3d5d21c1431e5b7bfc6cef1bd54c0e1735","elapsed_seconds":0.375,"error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"34a03bf4a0d648e38df1c92ed08d9899","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"cc2a2385cfb5c504ba57f1caac560ec9265110768c95eb48ff9048e54e6f7e47","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"cc2a2385cfb5c504ba57f1caac560ec9265110768c95eb48ff9048e54e6f7e47","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":