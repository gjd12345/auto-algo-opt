code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n    cur = distance_matrix[current_node][unvisited_nodes]\n    dep = distance_matrix[depot][unvisited_nodes]\n    adjusted = cur + dep\n    return int(unvisited_nodes[np.argmin(adjusted)])","code_sha256":"9d9641e6747b3c4e26dab6d19c7fd9ad573ce2ff79a7d1f31db9f02954077b93","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"3295414fcce543e8bbaf85b7f3fd0ed0","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[12.405598475352434,14.248015439692901,12.141751451732615,11.62750209089761,13.785164882498174,14.998590790379513],"lineage_status":"no_parent","objective":13.201103855092207,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    unvisited_nodes = np.asarray(unvisited_nodes)\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node, unvisited_nodes]\n    d_dep = distance_matrix[depot, unvisited_nodes]\n\n    if unvisited_nodes.size == 1:\n        return int(unvisited_nodes[0])\n\n    # For each candidate i, compute the distance to its nearest other customer\n    # among remaining unvisited nodes (excluding itself).\n    sub = distance_matrix[np.ix_(unvisited_nodes, unvisited_nodes)]\n    sub = sub.astype(float)\n    np.fill_diagonal(sub, np.inf)\n    nearest_other = sub.min(axis=1)\n\n    # Combined score: prefer close nodes, but also prefer leaving customers\n    # that are close to another remaining customer (so we don't strand far ones).\n    # A small weight encourages serving isolated customers earlier.\n    isolation = d_dep + nearest_other\n    score = d_cur - 0.15 * nearest_other + 0.05 * isolation\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"518ac0432e15fa2080faf2e55ddab355ef4644c512cfa68d266422d4a2bcb121","elapsed_seconds":0.297,"error_code":"forbidden_attribute","error_detail":"fill_diagonal","evaluation_id":"f03999f8122f4deb849a604e4bff294b","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":false},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    back = distance_matrix[depot][unvisited_nodes]\n    cap = rest_capacity if rest_capacity > 0 else 1.0\n    dem = demands[unvisited_nodes].astype(float) / cap\n    scores = cur + 0.5 * back * dem\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"0074450dd2c11f25c27c67bd292a7bb7bc65214b4db06aab6ca865ee43949f50","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"5d2baa7356204183ba9d028e6d1c965a","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[13.898079645540387,14.455877486808411,12.410011194245786,12.871613710867656,12.519642666250142,13.300469339246266],"lineage_status":"no_parent","objective":13.24261567382644,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    d = distance_matrix[current_node][unvisited_nodes]\n    dem = demands[unvisited_nodes]\n    # Encourage filling capacity: prefer larger demands relative to remaining capacity,\n    # while staying close to the current node.\n    urgency = dem / (rest_capacity + 1e-9)\n    score = d - 0.5 * urgency * d\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"44f16693562403075333aa42ab8b2fc0b0eff0403565f51e07bb03d1fbe865bb","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"8b2378d5ea584ef9b78f0dd232c2e041","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[13.091431735908023,13.372062210068798,12.894743496820615,10.961315809920128,12.528285017025354,12.235120074482555],"lineage_status":"no_parent","objective":12.513826390704246,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_base = distance_matrix[depot][current_node]\n\n    denom_in = d_base + 1e-9\n    denom_out = d_dep + 1e-9\n\n    cos_angle = (d_base * d_base + d_dep * d_dep - d_cur * d_cur) / (2.0 * d_dep * denom_in + 1e-9)\n    cos_angle = np.clip(cos_angle, -1.0, 1.0)\n    angle = np.arccos(cos_angle)\n\n    dem = demands[unvisited_nodes]\n    fill = dem / (rest_capacity + 1e-9)\n\n    score = angle * d_dep + d_cur - 0.5 * fill * d_cur\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"41d4c606caaeff05eb127e755da5238690455df2e8ea84d70d99e8bf00db5316","elapsed_seconds":0.297,"error_code":null,"error_detail":null,"evaluation_id":"7d727b58c593469787340b7e75312cd2","generation_parents":[{"algorithm":"Score each feasible customer by a weighted combination of proximity to the current node and urgency based on demand relative to remaining capacity, choosing the minimum.","code_sha256":"44f16693562403075333aa42ab8b2fc0b0eff0403565f51e07bb03d1fbe865bb","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Design a regret-based insertion heuristic that scores each feasible next customer by the increase in route distance relative to returning to the depot, then selects the customer minimizing this adjusted cost so short trips are avoided and better-aligned customers are prioritized.","code_sha256":"9d9641e6747b3c4e26dab6d19c7fd9ad573ce2ff79a7d1f31db9f02954077b93","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[11.838022008854788,14.736906732446386,11.247640296564406,11.425020636192684,12.334618663728737,12.494237532086297],"lineage_status":"verified","objective":12.34607431164555,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    d_base = distance_matrix[depot][current_node]\n\n    # Clarke-Wright style saving: serving candidate directly from current node\n    # instead of a separate current->depot plus depot->candidate trip.\n    saving = d_base + d_dep - d_cur\n\n    # Capacity utilization of the vehicle *after* serving the candidate.\n    dem = demands[unvisited_nodes]\n    util = (dem + 1e-9) / (rest_capacity + 1e-9)\n    util = np.clip(util, 0.0, 1.0)\n\n    # Bonus for customers that nearly fill the remaining capacity, scaled by\n    # how far the customer is from the depot (avoid stranding far customers).\n    bonus = util * util * d_dep\n\n    score = saving + bonus\n    return int(unvisited_nodes[np.argmax(score)])","code_sha256":"cc2a2385cfb5c504ba57f1caac560ec9265110768c95eb48ff9048e54e6f7e47","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"703e36a6dac942169a68177ff3a8ce13","generation_parents":[{"algorithm":"Score each feasible customer by the angular deviation between the incoming direction (depot/current node vector) and the outgoing direction to the candidate, penalized by distance and reward for high demand, selecting the minimum to keep routes spatially coherent and capacity-efficient.","code_sha256":"41d4c606caaeff05eb127e755da5238690455df2e8ea84d70d99e8bf00db5316","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"Score each feasible customer by the angular deviation between the incoming direction (depot/current node vector) and the outgoing direction to the candidate, penalized by distance and reward for high demand, selecting the minimum to keep routes spatially coherent and capacity-efficient.","code_sha256":"41d4c606caaeff05eb127e755da5238690455df2e8ea84d70d99e8bf00db5316","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_7.json","instance_objectives":