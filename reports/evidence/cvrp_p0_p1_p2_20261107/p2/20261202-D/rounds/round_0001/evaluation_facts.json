,"code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    # Deterministic start: at depot, pick the farthest feasible customer\n    # (encourages outer customers first, leaving shorter returns).\n    if current_node == depot:\n        d0 = distance_matrix[depot][unvisited_nodes]\n        return int(unvisited_nodes[int(np.argmax(d0))])\n\n    cur_to_j = distance_matrix[current_node][unvisited_nodes]\n    j_to_depot = distance_matrix[unvisited_nodes][depot]\n    depot_savings = (\n        distance_matrix[current_node][depot] + j_to_depot - cur_to_j\n    )\n\n    # Route-coherent score: prefer nearby customers while accounting for\n    # depot savings (larger savings => better closure toward depot direction).\n    score = cur_to_j - 0.5 * depot_savings\n\n    # Bounded capacity interaction: when capacity is tight, mildly favor\n    # customers whose demand leaves enough slack for a coherent next step.\n    demand_ratio = demands[unvisited_nodes] / np.maximum(rest_capacity, 1e-12)\n    score = score + 0.1 * cur_to_j * demand_ratio\n\n    return int(unvisited_nodes[int(np.argmin(score))])","code_sha256":"92b531527341a25fb509d770ae5c7dda942bea30e8e7837dd2295a6703493f48","elapsed_seconds":0.328,"error_code":"candidate_error","error_detail":null,"evaluation_id":"06ae84c111ab49ae949d64ea946f8262","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":false},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return 0\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    if current_node == depot:\n        return int(unvisited_nodes[np.argmin(d_dep)])\n\n    d_between = distance_matrix[current_node][unvisited_nodes]\n    savings = distance_matrix[current_node][depot] + d_dep - d_between\n\n    total_demand = float(np.sum(demands[unvisited_nodes]))\n    cap_ratio = 0.0\n    if rest_capacity > 0:\n        cap_ratio = min(1.0, total_demand / (rest_capacity + 1e-12))\n    w = 0.35 + 0.4 * cap_ratio\n\n    score = d_cur - w * savings\n    best = int(np.argmin(score))\n    return int(unvisited_nodes[best])","code_sha256":"df6963b512dfbfc5a4083820ae7700de70661378349c9938c57c77b512da3cce","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"e08deb5eadf2462a978c6334d3b720d5","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[12.929135148270282,13.052344186509922,9.533428835137927,11.907534433252259,11.868514573291165,12.83468080266732],"lineage_status":"no_parent","objective":12.020939663188145,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        # Deterministic start: farthest feasible customer from depot,\n        # tie-broken by larger demand and then index.\n        d0 = distance_matrix[depot][unvisited_nodes]\n        dem = demands[unvisited_nodes]\n        max_d0 = np.max(d0)\n        mask = d0 >= max_d0 - 1e-12\n        cand = unvisited_nodes[mask]\n        if cand.size == 0:\n            cand = unvisited_nodes\n        cand_d0 = distance_matrix[depot][cand]\n        cand_dem = demands[cand]\n        # Prefer farther, then larger demand, then smaller index.\n        best_pos = 0\n        for i in range(1, cand.size):\n            if (cand_d0[i] > cand_d0[best_pos] + 1e-12 or\n                (abs(cand_d0[i] - cand_d0[best_pos]) <= 1e-12 and\n                 (cand_dem[i] > cand_dem[best_pos] + 1e-12 or\n                  (abs(cand_dem[i] - cand_dem[best_pos]) <= 1e-12 and\n                   cand[i] < cand[best_pos])))):\n                best_pos = i\n        return int(cand[best_pos])\n\n    cur_to = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    from_cur_to_depot = distance_matrix[current_node][depot]\n\n    # Depot savings: serving j after current instead of returning to depot first.\n    savings = from_cur_to_depot + to_depot - cur_to\n\n    # Capacity-fill term: reward demands that fit well without forcing an early return.\n    demands_u = demands[unvisited_nodes].astype(float)\n    cap = float(rest_capacity)\n    if cap <= 1e-12:\n        return depot\n    fill_ratio = np.clip(demands_u / cap, 0.0, 1.0)\n\n    # Bounded combination: nearest distance is primary, savings shapes tie preference,\n    # capacity fill slightly discourages tiny stops late in a route.\n    score = cur_to - 0.35 * savings - 0.15 * fill_ratio\n\n    best = np.argmin(score)\n    return int(unvisited_nodes[best])","code_sha256":"88b701d43a649911b829ee1620f883579d37897f00c1831d3eac0a0da9b134f9","elapsed_seconds":0.281,"error_code":null,"error_detail":null,"evaluation_id":"dc758519a143481684e73957608e232b","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[13.410920696868494,11.753335673942678,10.051118086722667,11.303386569573172,10.680431153540374,12.386312229476973],"lineage_status":"no_parent","objective":11.59758406835406,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cand = np.asarray(unvisited_nodes)\n    demands_arr = np.asarray(demands)\n\n    d_cur = distance_matrix[current_node][cand]\n    d_dep = distance_matrix[depot][cand]\n\n    if current_node == depot:\n        # Explicit deterministic start: choose farthest to encourage radial coverage,\n        # with a slight preference for higher demand to use capacity early.\n        score = d_dep - 0.05 * demands_arr[cand]\n        return int(cand[np.argmax(score)])\n\n    # Depot savings: removing j from current route saves depot round-trip contribution.\n    savings = distance_matrix[current_node][depot] + d_dep - d_cur\n\n    # Route-closure increment vs depot savings blend.\n    # Favor large savings and small current-arc length.\n    score = savings - 0.5 * d_cur\n\n    # Bounded capacity interaction: mildly prefer customers leaving less slack,\n    # but only among close candidates (small weight to avoid domination).\n    slack = rest_capacity - demands_arr[cand]\n    score = score - 0.02 * slack\n\n    best_idx = int(np.argmax(score))\n    return int(cand[best_idx])","code_sha256":"bb62a841586649e9088cfa1b3642ac95405ce720b561d3dff1691d860e42878d","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"f82951780a904bd3a2f2a765d015b6ad","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[12.853158851235255,12.388207697523416,10.668866746190714,13.001525613786749,10.623581267156311,12.327954941763192],"lineage_status":"no_parent","objective":11.977215852942606,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    cand = np.asarray(unvisited_nodes)\n    demands_arr = np.asarray(demands)\n\n    if current_node == depot:\n        d_dep = distance_matrix[depot][cand]\n        score = d_dep + 0.01 * demands_arr[cand]\n        return int(cand[np.argmax(score)])\n\n    d_cur = distance_matrix[current_node][cand]\n    d_dep = distance_matrix[depot][cand]\n    d_cd = distance_matrix[current_node][depot]\n\n    insertion_cost = d_cur + d_dep - d_cd\n    radial = d_cur + d_dep\n    angle_term = (d_cd * d_cd + d_cur * d_cur - d_dep * d_dep) / (\n        2.0 * np.maximum(d_cd * d_cur, 1e-12)\n    )\n    capacity_pressure = demands_arr[cand] / np.maximum(rest_capacity, 1e-12)\n\n    score = insertion_cost + 0.15 * radial + 0.2 * angle_term - 0.1 * capacity_pressure\n    return int(cand[np.argmin(score)])","code_sha256":"7e5c24e143a7519af17a0624f976793e382752bd943105db5d05a23b38769bf8","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"d2bb0825fbe74d719472b8381a6c7cd7","generation_parents":[{"algorithm":"Use a nearest-neighbor base rule, but when leaving the depot choose a deterministic first customer, and otherwise blend current-to-candidate distance with depot-savings and a bounded capacity-fill term to prefer route-coherent feasible customers.","code_sha256":"88b701d43a649911b829ee1620f883579d37897f00c1831d3eac0a0da9b134f9","population_member_indices":[0],"selected_parent_position":0},{"algorithm":"The heuristic ranks each feasible customer by a blend of nearest-neighbor distance from the current node and depot savings, with a deterministic explicit start at the depot and a mild capacity-utilization tie-breaking term, while always returning a feasible customer when one exists.","code_sha256":"bb62a841586649e9088cfa1b3642ac95405ce720b561d3dff1691d860e42878d","population_member_indices":[1],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_6.json","instance_objectives":[15.078847184413164,15.096017727746037,12.72699026997144,14.724413805737434,14.296032732909167,13.802882485223058],"lineage_status":"verified","objective":14.287530701000051,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"fb20e1aec32f8cd74666545e9ec70ae8b57bf268d6a3285dcb516d9fd1aaa83c","valid":true},{"candidate_id":"candidate_6","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    if current_node == depot:\n        d0 = distance_matrix[depot][unvisited_nodes]\n        dem = demands[unvisited_nodes]\n        max_d0 = np.max(d0)\n        mask = d0 >= max_d0 - 1e-12\n        cand = unvisited_nodes[mask]\n        if cand.size == 0:\n            cand = unvisited_nodes\n        cand_d0 = distance_matrix[depot][cand]\n        cand_dem = demands[cand]\n        best_pos = 0\n        for i in range(1, cand.size):\n            if (cand_d0[i] > cand_d0[best_pos] + 1e-12 or\n                (abs(cand_d0[i] - cand_d0[best_pos]) <= 1e-12 and\n                 (cand_dem[i] > cand_dem[best_pos] + 1e-12 or\n                  (abs(cand_dem[i] - cand_dem[best_pos]) <= 1e-12 and\n                   cand[i] < cand[best_pos])))):\n                best_pos = i\n        return int(cand[best_pos])\n\n    cur_to = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    cur_depot = distance_matrix[current_node][depot]\n\n    detour = cur_to + to_depot - cur_depot\n    denom = cur_to + 1e-12\n    normalized = detour / denom\n\n    cap = float(rest_capacity)\n    if cap <= 1e-12:\n        return depot\n    fill = demands[unvisited_nodes].astype(float) / cap\n    fill = np.clip(fill, 0.0, 1.0)\n\n    score = normalized - 0.6 * fill * fill\n\n    best = np.argmin(score)\n    return int(unvisited_nodes[best])","code_sha256":"3a554a8487ea47fff10b050798c23dd754d1dc52772665cf4e9824424dee776f","elapsed_seconds":0.359,"error_code":null,"error_detail":null,"evaluation_id":"91c758c441a24266a91f28873fd9112b","generation_parents":[{"algorithm":"Use a nearest-neighbor base rule, but when leaving the depot choose a deterministic first customer, and otherwise blend current-to-candidate distance with depot-savings and a bounded capacity-fill term to prefer route-coherent feasible customers.","code_sha256":"88b701d43a64