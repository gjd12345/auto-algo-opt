,"code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Capacity pressure: when little capacity remains, prefer customers closer to depot\n    total_cap_denom = max(rest_capacity, 1e-9)\n    used_frac = 1.0 - (rest_capacity - dem) / total_cap_denom  # how much would remain after serving\n    # Penalize leaving hard-to-return customers when capacity nearly exhausted\n    pressure = np.clip((dem / max(rest_capacity, 1e-9)), 0.0, 1.0)\n\n    score = d_cur + 0.2 * pressure * d_dep + 0.05 * used_frac * d_dep\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","elapsed_seconds":0.391,"error_code":null,"error_detail":null,"evaluation_id":"519474c05b6d4a7b9dbd88c5a036de33","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.114096220957073,12.956380770944403,11.322795272723909,13.359923636959854,10.980355064254418,10.895609602784784],"lineage_status":null,"objective":12.104860094770741,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[un