 # Clarke-Wright style savings: serving this node directly from current\n+    # instead of forcing a separate depot round-trip.\n+    savings = d_cur + d_dep - distance_matrix[current_node][depot]\n \n-    score = d_cur + 0.2 * pressure * d_dep + 0.05 * used_frac * d_dep\n+    # Look-ahead detour: added cost of the node relative to going straight home.\n+    detour = d_cur + d_dep\n+\n+    # Normalise detour by savings so that nodes with high relative savings win,\n+    # while nodes close to the current position remain attractive.\n+    safe_savings = np.maximum(savings, 1e-9)\n+    score = detour / safe_savings\n+\n     return int(unvisited_nodes[np.argmin(score)])","truncated":false},"source_relation":"different"},"status":"available"}},"status_summary":{"behavior_status_counts":{"unsupported":2},"first_invalid":null,"first_noncomparable":{"candidate_id":"candidate_1","code_sha256":"dbf6d1e3627ffe268a42d832adaa71032370103c289f30f2e2af87cc782697c3","evaluation_id":"6d846fd4411a487891773b87562ea4c9","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","population_member_indices":[0],"selected_parent_position":0}],"instance_objectives":[13.114096220957073,12.956380770944403,11.377353946863606,14.612566288442178,13.036795901803082,10.895609602784784],"lineage_status":"verified","objective":12.665467121965856,"origin":"generated","revision":"original","source_request_index":9,"valid":true},"generated_count":2},"suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d"}
