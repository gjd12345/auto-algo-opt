"code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Capacity pressure: when little capacity remains, prefer customers closer to depot\n    total_cap_denom = max(rest_capacity, 1e-9)\n    used_frac = 1.0 - (rest_capacity - dem) / total_cap_denom  # how much would remain after serving\n    # Penalize leaving hard-to-return customers when capacity nearly exhausted\n    pressure = np.clip((dem / max(rest_capacity, 1e-9)), 0.0, 1.0)\n\n    score = d_cur + 0.2 * pressure * d_dep + 0.05 * used_frac * d_dep\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"b6abc394fda44ca19c9fab15b9bf19d9","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.114096220957073,12.956380770944403,11.322795272723909,13.359923636959854,10.980355064254418,10.895609602784784],"lineage_status":null,"objective":12.104860094770741,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"explicit_parent","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Capacity pressure: when little capacity remains, prefer customers closer to depot\n    total_cap_denom = max(rest_capacity, 1e-9)\n    used_frac = 1.0 - (rest_capacity - dem) / total_cap_denom  # how much would remain after serving\n    # Penalize leaving hard-to-return customers when capacity nearly exhausted\n    pressure = np.clip((dem / max(rest_capacity, 1e-9)), 0.0, 1.0)\n\n    score = d_cur + 0.2 * pressure * d_dep + 0.05 * used_frac * d_dep\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","elapsed_seconds":0.328,"error_code":null,"error_detail":null,"evaluation_id":"9971213f35a243d19138acede40942db","generation_parents":null,"generation_request_ref":null,"instance_objectives":[13.114096220957073,12.956380770944403,11.322795272723909,13.359923636959854,10.980355064254418,10.895609602784784],"lineage_status":null,"objective":12.104860094770741,"origin":"explicit_parent","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_1","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        unvisited_nodes: array of feasible unvisited customer indices\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = max(rest_capacity, 1e-9)\n    demand_frac = np.clip(dem / cap, 0.0, 1.0)\n    fill_frac = 1.0 - (rest_capacity - dem) / cap\n\n    # When capacity is tight, favor closer-to-depot customers; when it is\n    # plentiful, favor customers far from the depot (consolidate farther trips).\n    tightness = demand_frac\n    score = d_cur + 0.25 * tightness * d_dep - 0.05 * (1.0 - tightness) * d_dep\n    score = score + 0.02 * fill_frac * d_cur\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"dbf6d1e3627ffe268a42d832adaa71032370103c289f30f2e2af87cc782697c3","elapsed_seconds":0.344,"error_code":null,"error_detail":null,"evaluation_id":"6d846fd4411a487891773b87562ea4c9","generation_parents":[{"algorithm":"Explicit parent","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","population_member_indices":[0],"selected_parent_position":0}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_9.json","instance_objectives":[13.114096220957073,12.956380770944403,11.377353946863606,14.612566288442178,13.036795901803082,10.895609602784784],"lineage_status":"verified","objective":12.665467121965856,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        unvisited_nodes: array of feasible unvisited customer indices\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n\n    # Clarke-Wright style savings: serving this node directly from current\n    # instead of forcing a separate depot round-trip.\n    savings = d_cur + d_dep - distance_matrix[current_node][depot]\n\n    # Look-ahead detour: added cost of the node relative to going straight home.\n    detour = d_cur + d_dep\n\n    # Normalise detour by savings so that nodes with high relative savings win,\n    # while nodes close to the current position remain attractive.\n    safe_savings = np.maximum(savings, 1e-9)\n    score = detour / safe_savings\n\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"db039a15869286a746bcd31abf6755d39f9bb28e6c022d94668a8b50433c586a","elapsed_seconds":0.282,"error_code":null,"error_detail":null,"evaluation_id":"f791113bdfeb4fd581eafdb1192e99e0","generation_parents":[{"algorithm":"Compute a composite score combining current distance, depot-return distance weighted by the demand fraction of remaining capacity, and a farthest-from-depot bonus that grows as capacity is consumed, then pick the minimizing customer via argmin.","code_sha256":"dbf6d1e3627ffe268a42d832adaa71032370103c289f30f2e2af87cc782697c3","population_member_indices":[1],"selected_parent_position":0},{"algorithm":"Explicit parent","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","population_member_indices":[0],"selected_parent_position":1}],"generation_request_ref":"rounds/round_0002/eoh_run/results/exchanges/request_10.json","instance_objectives":[37.82076046037607,37.631643083018695,33.65230414661607,36.57865678050706,35.34272246698152,38.32