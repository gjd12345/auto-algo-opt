":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n\n    current_distances = distance_matrix[current_node][unvisited_nodes]\n    depot_distances = distance_matrix[depot][unvisited_nodes]\n\n    # Favor nearby customers, but mildly avoid picking ones that are far from\n    # the depot (these are better left for dedicated routes).\n    scores = current_distances - 0.15 * depot_distances\n\n    return int(unvisited_nodes[np.argmin(scores)])","code_sha256":"d6c1adbc6e537def00e357986e0472c2706d30b6c433a712f5d3472086f1745a","elapsed_seconds":0.36,"error_code":null,"error_detail":null,"evaluation_id":"f84d4fd1d21a4bb28513ec020781d858","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_2.json","instance_objectives":[14.238441023596218,13.497421677842386,10.317946953427795,12.931622154914669,11.511772504312436,10.332102843015218],"lineage_status":"no_parent","objective":12.138217859518122,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_2","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    # Capacity pressure: when little capacity remains, prefer customers closer to depot\n    total_cap_denom = max(rest_capacity, 1e-9)\n    used_frac = 1.0 - (rest_capacity - dem) / total_cap_denom  # how much would remain after serving\n    # Penalize leaving hard-to-return customers when capacity nearly exhausted\n    pressure = np.clip((dem / max(rest_capacity, 1e-9)), 0.0, 1.0)\n\n    score = d_cur + 0.2 * pressure * d_dep + 0.05 * used_frac * d_dep\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"a8a61a312a22a4d3b88abd8ca8c042c8bbdb42edbe14a83f20e6afbebfd3fa36","elapsed_seconds":0.312,"error_code":null,"error_detail":null,"evaluation_id":"ec6bb466b9044869b7d2cf0995266466","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_3.json","instance_objectives":[13.114096220957073,12.956380770944403,11.322795272723909,13.359923636959854,10.980355064254418,10.895609602784784],"lineage_status":"no_parent","objective":12.104860094770741,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_3","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if len(unvisited_nodes) == 0:\n        return depot\n\n    d_cur_depot = distance_matrix[current_node][depot]\n    d_depot = distance_matrix[depot][unvisited_nodes]\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    savings = d_cur_depot + d_depot - d_cur\n\n    # Primary: maximize savings; secondary: minimize distance from current node.\n    order = np.lexsort((d_cur, -savings))\n    return int(unvisited_nodes[order[0]])","code_sha256":"4c73962e4ac38a2e06eb7ba21c5cf497399cfdf631c76454a43e182f8ed668d7","elapsed_seconds":0.297,"error_code":"forbidden_attribute","error_detail":"lexsort","evaluation_id":"71f3c244bd5c41b1a75865dd363efc50","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_4.json","instance_objectives":[],"lineage_status":"no_parent","objective":null,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":false},{"candidate_id":"candidate_4","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    \"\"\"Select the next node to visit in a CVRP greedy construction.\n\n    Args:\n        current_node:    index of the current node (0 = depot)\n        depot:           index of the depot (always 0)\n        unvisited_nodes: array of feasible unvisited customer indices\n                         (already filtered to satisfy remaining capacity)\n        rest_capacity:   remaining vehicle capacity\n        demands:         demand of every node (index 0 = depot demand = 0)\n        distance_matrix: pairwise Euclidean distance matrix\n    Returns:\n        Index of the next node to visit, or 0 to return to the depot early.\n    \"\"\"\n    if unvisited_nodes.size == 0:\n        return depot\n    cur = distance_matrix[current_node][unvisited_nodes]\n    to_depot = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n    # Prefer nodes close to current, close to depot (so return trip is cheap),\n    # and with larger demand to fill capacity efficiently.\n    score = cur + 0.3 * to_depot - 0.2 * dem\n    return int(unvisited_nodes[np.argmin(score)])","code_sha256":"c5607366e901aa1ab7654977bff70871ed54f1d0fe5e441333fdf06f043e2735","elapsed_seconds":0.313,"error_code":null,"error_detail":null,"evaluation_id":"d78f592b843d40dfb23d2c7d9f9432d1","generation_parents":[],"generation_request_ref":"rounds/round_0001/eoh_run/results/exchanges/request_5.json","instance_objectives":[15.632320583064976,14.854147825319478,15.997617383155118,16.370857465151936,15.493225920327424,16.493660609248238],"lineage_status":"no_parent","objective":15.806971631044528,"origin":"generated","repair_request_ref":null,"revision":"original","suite_hash":"b8083c7b2ebe9bca3a0edd18ffcdf2508a2a9287b42e1271421cbf24bbf7364d","valid":true},{"candidate_id":"candidate_5","code":"def select_next_node(current_node: int, depot: int, unvisited_nodes: np.ndarray,\n                     rest_capacity: float, demands: np.ndarray,\n                     distance_matrix: np.ndarray) -> int:\n    if unvisited_nodes.size == 0:\n        return depot\n\n    d_cur = distance_matrix[current_node][unvisited_nodes]\n    d_dep = distance_matrix[depot][unvisited_nodes]\n    dem = demands[unvisited_nodes].astype(float)\n\n    cap = max(res