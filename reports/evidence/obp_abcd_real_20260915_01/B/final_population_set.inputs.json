      },
      {
        "generation": 26,
        "member_index": 1,
        "algorithm": "Break ties away from best-fit by scoring bins to intentionally balance residual space after placement, spreading items rather than hugging the tightest gap.",
        "algorithm_text_sha256": "edbe4d58a8986049f246068f5cfb305737c0b3300f50dca651c90e9c12758522",
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    residual = bins - item\n    mean_residual = residual.mean() if residual.size else 0.0\n    return -np.abs(residual - mean_residual)",
        "code_sha256": "7fc6b745697a521579937d71f2d10144fc9ea535e7d4669d967a67a1e2bc32b3",
        "objective": 0.14821428571428572,
        "evaluation_id": "2a4f5fce1a71479a80485c15597d50ea",
