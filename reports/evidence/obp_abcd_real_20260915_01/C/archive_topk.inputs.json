      {
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    remaining_after = bins - item\n\n    # Target a small but nonzero slack band: too tight harms future flexibility,\n    # too loose wastes capacity.\n    target_slack = 0.15 * item\n    band_score = -np.abs(remaining_after - target_slack)\n\n    # Reward bins where placement meaningfully increases packing density.\n    fill_score = item / (bins + 1e-12)\n\n    # Slightly prefer bins whose remaining capacity after placement is small,\n    # but only within the band logic above.\n    compact_score = -remaining_after\n\n    return band_score + 0.5 * fill_score + 1e-6 * compact_score",
