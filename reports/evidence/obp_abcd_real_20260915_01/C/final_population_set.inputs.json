  "selection": {
    "schema_version": "algorithm-optimization-frozen-selection/v1",
    "selection_kind": "final_population_set",
    "members": [
      {
        "generation": 25,
        "member_index": 0,
        "algorithm": "Use a best-fit priority that ranks feasible open bins by smallest remaining capacity after placement, then breaks ties toward more fully packed bins to reduce fragmentation and bin count.",
        "algorithm_text_sha256": "461326672d6e5fd7c234bf1af3038bc62ba82c5e6aa74fb4652c96cdc552dc0a",
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    remaining_after = bins - item\n    utilization = 1.0 - (remaining_after / (remaining_after + item + 1e-12))\n    return -remaining_after + 1e-6 * utilization",
        "code_sha256": "3e92736fb8fbb920556d455bef3c89b929074c624d1a53cd3db8f96f65d06e5c",
        "objective": 0.0,
        "evaluation_id": "36f44e359fdd4dd4b799e0bd38df3ce0",
        "revision": "original",
        "origin": "official_eoh",
        "metric_spec_hash": "08550f7999f0bc40a0c55f06449a60209e693ba7848fbff4b21bddeb829fc53e"
      },
      {
        "generation": 25,
        "member_index": 1,
        "algorithm": "A quantized residual-slack priority that maps each post-placement remaining capacity to a small integer bucket and prefers bins whose slack lands in a favorable bucket while softly avoiding both exact-fit and near-full extremes.",
        "algorithm_text_sha256": "bfb0935342927a1ead2bebd4e107337b223a33fd5fc1cc53b18c204846fbee49",
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    residual = bins - item\n    scale = np.maximum(bins, item) + 1e-12\n    normalized = residual / scale\n\n    # Quantize slack into coarse buckets, then reward middle-low slack bands.\n    buckets = np.floor(np.clip(normalized, 0.0, 1.0) * 8.0)\n    bucket_score = -np.abs(buckets - 2.0)\n\n    # Mildly penalize exact fits and very loose fits without using best-fit order.\n    edge_penalty = -0.25 * np.exp(-20.0 * normalized) - 0.25 * normalized\n\n    # Deterministic tiny term based on item fraction for stable tie behavior.\n    tie = 1e-6 * (item / scale)\n\n    return bucket_score + edge_penalty + tie",
        "code_sha256": "f0405b8a15c133aa41bbfb40b3e53b5c83606f484afce21c578c65e99edfe400",
        "objective": 0.0625,
        "evaluation_id": "dbda25c0007e414f923e1e7b8b62e96d",
        "revision": "original",
        "origin": "official_eoh",
        "metric_spec_hash": "08550f7999f0bc40a0c55f06449a60209e693ba7848fbff4b21bddeb829fc53e"
      }
    ],
