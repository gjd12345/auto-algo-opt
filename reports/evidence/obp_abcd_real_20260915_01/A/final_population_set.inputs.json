    "members": [
      {
        "generation": 49,
        "member_index": 0,
        "algorithm": "Best-fit priority: assign the largest priority to the feasible bin with the smallest remaining capacity after placement, equivalently return the negative remaining capacity so the dustiest fitting bin is chosen first.",
        "algorithm_text_sha256": "d429295e776de65bb972e3e4f0006146fd026a88a3317169c0c4e19c6e2988fc",
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    return -bins",
        "code_sha256": "cb38e163bacfde2c59a06684267d8f5a1210b6b719376ec591ddb808f5bfb963",
        "objective": 0.0,
        "evaluation_id": "e8c162de7c3b4c139bd591ded7e9d337",
        "revision": "original",
        "origin": "official_eoh",
        "metric_spec_hash": "08550f7999f0bc40a0c55f06449a60209e693ba7848fbff4b21bddeb829fc53e"
      },
      {
        "generation": 49,
        "member_index": 1,
        "algorithm": "Instead of ranking by raw residual capacity, score each bin by how closely its residual after placing the item matches a target leftover size derived from the item and current bin statistics, encouraging balanced residual slack rather than purely tightest fit.",
        "algorithm_text_sha256": "20afd7c11c5a0ab1096e44a42237768499978af8db7ef06d7ae3ae40616d9c41",
        "code": "import numpy as np\n\ndef priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    residual = bins - item\n    n = bins.size\n    if n == 0:\n        return np.zeros(0, dtype=np.float64)\n    mean_res = float(np.mean(residual))\n    std_res = float(np.std(residual))\n    if std_res < 1e-12:\n        # All residuals equal: prefer tightest fit as a tie-breaker.\n        return -residual\n    # Target: slightly below mean residual to favor tighter-than-average fits.\n    target = mean_res - 0.5 * std_res\n    # Gaussian-like score: larger when residual is near target.\n    z = (residual - target) / (std_res + 1e-12)\n    return -np.abs(z)",
        "code_sha256": "8f49188b2e9779cf8d3e2009a5977a62720e86893f667cb7ec61f0992528dbd3",
        "objective": 0.0625,
        "evaluation_id": "17fb62b32588495796254853dbafee09",
        "revision": "original",
        "origin": "official_eoh",
        "metric_spec_hash": "08550f7999f0bc40a0c55f06449a60209e693ba7848fbff4b21bddeb829fc53e"
      }
    ],
