        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    remaining = bins - item\n    total = bins\n    used = item\n\n    # Normalized residual after placement: smaller is better (tighter fit)\n    residual_score = 1.0 - (remaining / (total + 1.0))\n\n    # Relative fill balance: preference for placing item where it fits\n    # proportionally well without extreme imbalance\n    balance_score = 1.0 - (np.abs(remaining - used) / (total + 1.0))\n\n    # Weighted nonlinear combination\n    gamma = 1.5\n    lam = 0.35\n    return residual_score ** gamma + lam * balance_score",
