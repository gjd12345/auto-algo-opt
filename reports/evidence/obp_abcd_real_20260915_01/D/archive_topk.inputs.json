        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    residual = bins - item\n    total = bins\n    eps = 1e-12\n    # Prefer tight fits (small residual) but softly penalize wasting large bins:\n    # score = -residual / (total + eps) - 0.15 * residual / (item + eps)\n    return -(residual / (total + eps)) - 0.15 * (residual / (item + eps))",
