  "selection": {
    "schema_version": "algorithm-optimization-frozen-selection/v1",
    "selection_kind": "final_population_set",
    "members": [
      {
        "generation": 25,
        "member_index": 0,
        "algorithm": "Prefer the feasible bin with the smallest remaining capacity after placing the item (best-fit), but use a nonlinear residual-capacity score that increasingly favors tighter fits; this is equivalent to maximizing -bins but with an extra nonlinear penalty for leaving large slack.",
        "algorithm_text_sha256": "1096525b860d022df74afe1fbb1a82231492507739a7575ee45b9f87e2bfb632",
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    remaining = bins - item\n    return -remaining - 0.5 * (remaining ** 2) / (bins + 1.0)",
        "code_sha256": "74ad7d2167f6eb299ecfdcefd98027c0663e9e24771a5cb14ead733516fc849b",
        "objective": 0.0,
        "evaluation_id": "a52e0d12fd854047b7e4ecd4edcdac16",
        "revision": "original",
        "origin": "official_eoh",
        "metric_spec_hash": "08550f7999f0bc40a0c55f06449a60209e693ba7848fbff4b21bddeb829fc53e"
      },
      {
        "generation": 25,
        "member_index": 1,
        "algorithm": "The new algorithm prioritizes bins by a weighted nonlinear combination of residual capacity and item size, penalizing bins where the post-placement remaining capacity deviates from a target fraction of the original bin capacity, using different exponent and weighting parameters than the original balance-score heuristic.",
        "algorithm_text_sha256": "f13f3612a65e7019e3f40463094bf2adf2636f4e31d31e52a1978ef141e60e28",
        "code": "def priority(item: float, bins: np.ndarray) -> np.ndarray:\n    \"\"\"Return one priority for each feasible bin.\n\n    ``bins`` contains remaining capacities after filtering bins that cannot\n    hold ``item``.  The evaluator selects the first maximum priority and\n    opens a new bin when the array is empty.\n    \"\"\"\n    remaining = bins - item\n    total = bins + 1.0\n    target = 0.35 * total\n    return -np.abs(remaining - target) / total - 0.15 * np.sqrt(remaining / total)",
        "code_sha256": "1c2a5c1268b61f707eb637554bf9f3e17966665f4be1270a09d94e80d62d5ddb",
        "objective": 0.14821428571428572,
        "evaluation_id": "8e6f21744f1042a0825a62ff9d53e15d",
        "revision": "original",
        "origin": "official_eoh",
        "metric_spec_hash": "08550f7999f0bc40a0c55f06449a60209e693ba7848fbff4b21bddeb829fc53e"
      }
