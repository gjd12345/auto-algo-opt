      "strong_on": [
        "absolute_bks_calibration",
        "scale_stress_n100_to_n1000",
        "cross_paper_ood_benchmark"
      ],
      "weak_on": [
        "floating_point_distance_assumption"
      ],
      "scale_notes": "Set X 全量 100 例按 X-S (100-250)、X-M (251-500)、X-L (501-1000) 三档统计；官方 .sol 路线在 euc_2d_nint 下 100/100 精确零误差复算。"
    },
    "math_formulation": [
      {
        "expr": "d_nint(i, j) = floor(sqrt((x_i - x_j)^2 + (y_i - y_j)^2) + 0.5)",
        "variables": {
          "(x_i, y_i)": "节点二维坐标",
          "d_nint(i,j)": "TSPLIB / CVRPLib 标准整数欧氏距离"
        },
        "preconditions": "EDGE_WEIGHT_TYPE = EUC_2D；不可使用 Python 银行家舍入 round() 代替 floor(d + 0.5)"
      }
    ],
