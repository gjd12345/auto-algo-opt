  "status": "reviewed",
  "summary": "One frozen elite maximises dist(depot,u)+dist(depot,current)-dist(current,u) while constructing a route.",
  "attributes": {
    "method_family": "construction",
    "online_offline": "offline",
    "objective": "mean route length",
    "knowledge_tier": "verified_experiment",
    "problem_variant": "standard_cvrp",
    "paradigm": "sequential_construct",
    "complexity_class": "O(n^2)",
    "interface": "select_next_node",
    "eoh_map": {
      "status": "possible",
      "adapter_kind": "direct_entrypoint",
      "entrypoint": "select_next_node"
    },
    "applicable_regimes": {
      "strong_on": [
        "uniform_n50_n100",
        "loose_capacity",
        "pointwise_baseline"
      ],
      "weak_on": [
        "multi_route_global_merging",
        "large_n_cvrplib"
      ],
      "scale_notes": "原 8 规则逐点池在 hetero-288 上的固定单一最佳（SBS），但本质仍为单车顺序构造，落后于 Stage-2 R5 与并行 Clarke-Wright 合并。"
    },
    "interface_blueprint": {
      "skeleton_role": "单车顺序构造循环（与 NN 相同外层骨架），单步内最大化局部节约量",
      "evolvable_hook": "select_next_node(current_node, depot, unvisited_nodes, rest_capacity, demands, distance_matrix) -> int",
      "state_maintained": [
        "current_node",
        "rest_capacity",
        "unvisited_nodes"
      ],
      "invariants_and_constraints": [
        "仓库出发步 i=0 时 s(0,j)=0 恒成立，必须显式定义破平规则（最远客户 argmax d(0,j)）",
        "路线需求总和 <= Q"
      ],
      "typical_pitfalls": [
        "易与 1964 并行 Clarke-Wright 路径合并混淆；若忽略 i=0 处 s(0,j)=0 退化则变为按索引顺序选点"
      ]
    },
    "math_formulation": [
      {
        "expr": "s(i, j) = d(i, 0) + d(0, j) - d(i, j);  at i=0: tie-break by argmax_j d(0, j)",
        "variables": {
          "i": "当前节点",
          "j": "可行候选客户",
          "d(0,j)": "仓库到客户 j 距离"
        },
        "preconditions": "单车顺序构造接口 select_next_node，且满足三角不等式"
      }
    ],
