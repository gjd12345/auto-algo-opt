    "eoh_map": {
      "status": "possible",
      "adapter_kind": "direct_entrypoint",
      "entrypoint": "select_next_node"
    },
    "applicable_regimes": {
      "strong_on": [
        "nominal_unit_square_n50_dev_only"
      ],
      "weak_on": [
        "rescaled_coordinates_1e-3",
        "large_n_100_200",
        "eccentric_depot"
      ],
      "scale_notes": "标称单位正方形 n=50 共享 6 例为 10.9197，但因出发步耦合 (alpha=0.6<1) 在 P0-120 退化至 22.55，且在 s=1e-3 坐标缩放下崩溃 +207%（dev24 压力抽检最大漂移见 evidence_bindings）。"
    },
    "interface_blueprint": {
      "skeleton_role": "单车顺序构造 select_next_node（作为早期 PoC 冻结基线与尺度崩溃诊断靶标）",
      "evolvable_hook": "select_next_node(current_node, depot, unvisited_nodes, rest_capacity, demands, distance_matrix) -> int",
      "state_maintained": [
        "current_node",
        "rest_capacity",
        "unvisited_nodes"
      ],
      "invariants_and_constraints": [
        "严格禁止在未无量纲化的情况下混合绝对常量 1.0 与坐标距离 d_cur"
      ],
      "typical_pitfalls": [
        "band = 1e-3*(span + 1.0) 混合量纲，cap_term = 0.01*|rest_cap - dem|/d_cur 按 O(1/s^2) 爆炸"
      ]
    },
    "math_formulation": [
      {
        "expr": "base = d(i,j) - 0.6*d(0,j);  band = 1e-3*(span + 1.0);  cap_term = 0.01 * |rest_cap - q_j| / max(d(i,j), 1e-9)",
        "variables": {
          "span": "max(base) - min(base)",
          "band": "混合量纲近并列门控带宽",
          "cap_term": "非无量纲容量匹配项"
        },
        "preconditions": "仅在 s ~ 1 单位正方形上偶然工作；当坐标缩放 s -> 0 时 cap_term/base ~ O(1/s^2) 接管决策"
      }
    ],
