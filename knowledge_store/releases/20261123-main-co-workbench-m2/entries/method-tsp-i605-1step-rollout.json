    "interface_blueprint": {
      "skeleton_role": "闭环 TSP 顺序构造骨架，从城市 0 出发逐步选择下一未访城市直至收环",
      "evolvable_hook": "select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix) -> int",
      "state_maintained": [
        "current_node",
        "visited_mask",
        "tour"
      ],
      "invariants_and_constraints": [
        "返回值必须属于 unvisited_nodes 且禁止原地重复",
        "受 500 ms 单实例预算约束，超预算记 timeout"
      ],
      "typical_pitfalls": [
        "对每个候选模拟完整最近邻后缀导致单步 O(m^3)、全构造 O(n^4)，在 n>=100/TSPLIB 上极易触发 500 ms 超时，必须同时报告完成率"
      ]
    },
    "math_formulation": [
      {
        "expr": "w_dir*d(i,u) + w_tour*NN_rollout(u->dest) - w_regret*(max-min) + 0.2*max(0, d-1.5*med)/med",
        "variables": {
          "d(cur,u)": "当前城市到候选 u 距离",
          "d(dest,u)": "候选 u 到终点 0 距离"
        },
        "preconditions": "欧氏对称 TSP 距离矩阵"
      }
    ],
