    },
    "knowledge_tier": "local_implementation",
    "problem_variant": "standard_cvrp",
    "paradigm": "insertion",
    "complexity_class": "O(n^2)",
    "applicable_regimes": {
      "strong_on": [
        "global_insertion_baseline",
        "eccentric_customers",
        "scale_invariant"
      ],
      "weak_on": [
        "no_post_local_search",
        "large_n_insertion_scan_cost"
      ],
      "scale_notes": "纯距离增量比较，0.00% 坐标缩放漂移；作为不含 2-opt 的纯粹插入构造基线，与 HeurAgenix 最小代价插入+2-opt 形成清晰对照。"
    },
    "interface_blueprint": {
      "skeleton_role": "按 d(0,i) 降序遍历客户，扫描全车队所有容量可行插入切口 (prev, next)，取 argmin(d(prev,i)+d(i,next)-d(prev,next)) 与新开路线 2*d(0,i) 的较小者",
      "evolvable_hook": "insertion_priority(node, route, pos)",
      "state_maintained": [
        "routes",
        "route_loads",
        "uninserted_order"
      ],
      "invariants_and_constraints": [
        "每条路线起止于仓库 0",
        "每次插入严格满足 load + q_i <= Q"
      ],
      "typical_pitfalls": [
        "不含后续 2-opt/relocate 时，早期确定的路线骨架在末期可能出现次优交叉"
      ]
    },
    "math_formulation": [
      {
        "expr": "delta(r, pos, i) = d(prev, i) + d(i, next) - d(prev, next);  open_new = 2 * d(0, i)",
        "variables": {
          "prev, next": "路线 r 在位置 pos 的前后节点（边界为仓库 0）"
        },
        "preconditions": "客户按 d(0, i) 降序处理，仅考察 load(r) + q_i <= Q 的可行路线"
      }
    ],
